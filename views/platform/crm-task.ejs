<% var pageTitle = task.title; %>
<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
      <p class="crm-contact-site">
        <% if (task.parent_task_id) { %>
          Subtask of <a href="/dashboard/crm/tasks/<%= task.parent_task_id %>"><%= task.parent_title %></a>
        <% } else if (task.contact_id) { %>
          Follow-up on <a href="/dashboard/crm/contacts/<%= task.contact_id %>"><%= task.contact_name %></a> · <%= task.store_name || 'General inquiry' %>
        <% } else { %>
          Standalone task
        <% } %>
      </p>

      <div class="crm-contact-layout">
        <form action="/dashboard/crm/tasks/<%= task.id %>/edit" method="POST" class="admin-form">
          <label>Title *
            <input type="text" name="title" required value="<%= task.title %>" />
          </label>

          <label>Description
            <!-- Progressive enhancement: this textarea is the real,
                 always-visible field (works with no JS, or if the Quill
                 library fails to load from its CDN). The script at the
                 bottom of this file only swaps in the WYSIWYG editor once
                 Quill has actually loaded and mounted successfully, and
                 keeps this field in sync as the field submitted. -->
            <textarea id="taskDescriptionInput" name="description" rows="6" placeholder="Describe what needs to be done..."><%= task.description || '' %></textarea>
            <div id="taskDescriptionEditor" class="crm-task-editor" hidden></div>
          </label>

          <div class="form-row">
            <label>Priority
              <select name="priority">
                <% priorities.forEach(function(p) { %>
                  <option value="<%= p %>" <%= task.priority === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase() + p.slice(1) %></option>
                <% }); %>
              </select>
            </label>
            <label>Due date
              <input type="date" name="due_date" value="<%= task.due_date ? new Date(task.due_date).toISOString().slice(0,10) : '' %>" />
            </label>
          </div>

          <button type="submit" class="btn btn-primary">Save changes</button>
        </form>

        <div class="panel">
          <h2>Status &amp; assignee</h2>
          <p class="crm-task-priority crm-task-priority-<%= task.priority %>"><%= task.priority.charAt(0).toUpperCase() + task.priority.slice(1) %> priority</p>

          <form action="/dashboard/crm/tasks/<%= task.id %>/toggle" method="POST">
            <input type="hidden" name="done" value="<%= task.done ? '0' : '1' %>" />
            <button type="submit" class="btn <%= task.done ? '' : 'btn-primary' %>"><%= task.done ? 'Mark not done' : 'Mark done' %></button>
          </form>

          <form action="/dashboard/crm/tasks/<%= task.id %>/reassign" method="POST" class="crm-task-form" style="margin-top:12px;">
            <label style="width:100%;">Assigned to
              <select name="assigned_to" onchange="this.form.submit()">
                <option value="">Unassigned</option>
                <% assignableUsers.forEach(function(u) { %>
                  <option value="<%= u.id %>" <%= task.assigned_to === u.id ? 'selected' : '' %>><%= u.name %><%= u.id === account.id ? ' (you)' : '' %></option>
                <% }); %>
              </select>
            </label>
          </form>
        </div>
      </div>

      <div class="panel crm-tasks-panel" style="margin-top:24px;">
        <h2>Subtasks</h2>
        <form action="/dashboard/crm/tasks/<%= task.id %>/subtasks" method="POST" class="crm-task-form">
          <input type="text" name="title" placeholder="e.g. Draft the outline" required />
          <input type="date" name="due_date" />
          <select name="assigned_to">
            <option value="">Unassigned</option>
            <% assignableUsers.forEach(function(u) { %>
              <option value="<%= u.id %>"><%= u.name %><%= u.id === account.id ? ' (you)' : '' %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn-primary">Add subtask</button>
        </form>

        <ul class="crm-task-list">
          <% subtasks.forEach(function(t) { %>
            <li class="crm-task <%= t.done ? 'crm-task-done' : '' %>">
              <form action="/dashboard/crm/tasks/<%= t.id %>/toggle" method="POST">
                <input type="hidden" name="done" value="<%= t.done ? '0' : '1' %>" />
                <button type="submit" class="crm-task-check" aria-label="Toggle done"><%= t.done ? '✓' : '' %></button>
              </form>
              <div class="crm-task-body">
                <a class="crm-task-title" href="/dashboard/crm/tasks/<%= t.id %>"><%= t.title %></a>
                <span class="crm-task-meta">
                  <%= t.assignee_name ? t.assignee_name : 'Unassigned' %><%= t.due_date ? ' · due ' + new Date(t.due_date).toLocaleDateString() : '' %>
                </span>
              </div>
              <form action="/dashboard/crm/tasks/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Delete this subtask?');">
                <button type="submit" class="link-btn danger">Delete</button>
              </form>
            </li>
          <% }); %>
          <% if (subtasks.length === 0) { %>
            <li class="empty-state">No subtasks yet — add one above.</li>
          <% } %>
        </ul>
      </div>

      <form action="/dashboard/crm/tasks/<%= task.id %>/delete" method="POST" class="crm-task-delete-self" onsubmit="return confirm('Delete this task? This also deletes its subtasks.');" style="margin-top:16px;">
        <button type="submit" class="link-btn danger">Delete task</button>
      </form>
    </div>

    <script>
      // Upgrades the always-visible #taskDescriptionInput textarea into a
      // WYSIWYG (Quill) editor once the library has loaded -- until then,
      // the plain textarea IS the description field, so it's never blank
      // or uneditable. Quill's files are vendored locally under
      // public/vendor/quill/ (not pulled from a CDN) so this doesn't
      // depend on outbound network access working from wherever this is
      // deployed. Written to run both on a normal full-page load AND when
      // injected into the slide-over panel (public/js/crm-task-panel.js
      // re-executes any <script> tag found in fetched content) -- so it
      // loads the library into <head> itself (persists across panel
      // content swaps, loaded at most once per page session) rather than
      // via a <script src> tag in this markup, which would otherwise be
      // re-fetched/re-run on every panel refresh.
      (function () {
        function loadQuill() {
          if (window.Quill) return Promise.resolve();
          if (window.__quillLoading) return window.__quillLoading;
          window.__quillLoading = new Promise(function (resolve, reject) {
            var timer = setTimeout(function () { reject(new Error('Quill load timed out')); }, 6000);

            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = '/vendor/quill/quill.snow.css';
            document.head.appendChild(link);

            var script = document.createElement('script');
            script.src = '/vendor/quill/quill.min.js';
            script.onload = function () { clearTimeout(timer); resolve(); };
            script.onerror = function () { clearTimeout(timer); reject(new Error('Quill failed to load')); };
            document.head.appendChild(script);
          });
          return window.__quillLoading;
        }

        var container = document.getElementById('taskDescriptionEditor');
        if (!container) return;

        loadQuill()
          .then(function () {
            // The panel may have re-rendered this content again before the
            // library finished loading on a slow connection -- re-look the
            // nodes up instead of trusting the closed-over references, and
            // skip if this instance has already been initialized (or
            // replaced) since.
            var el = document.getElementById('taskDescriptionEditor');
            var hidden = document.getElementById('taskDescriptionInput');
            if (!el || !hidden || el.dataset.quillReady) return;
            el.dataset.quillReady = '1';

            var quill = new Quill(el, {
              theme: 'snow',
              placeholder: 'Describe what needs to be done...',
              modules: {
                toolbar: [
                  ['bold', 'italic', 'underline', 'strike'],
                  [{ list: 'ordered' }, { list: 'bullet' }],
                  ['link', 'image'],
                  ['clean'],
                ],
              },
            });
            // The supported way to load existing raw HTML into Quill --
            // assigning straight to quill.root.innerHTML can leave its
            // internal Delta model out of sync with what's on screen.
            quill.clipboard.dangerouslyPasteHTML(hidden.value || '');

            hidden.hidden = true;
            el.hidden = false;

            var form = el.closest('form');
            if (form) {
              form.addEventListener('submit', function () {
                hidden.value = quill.root.innerHTML;
              });
            }
          })
          .catch(function () {
            // Quill never loaded -- leave the plain textarea as the
            // (already visible, already working) description field.
          });
      })();
    </script>

<%- include('partials/footer') %>
