<%
  var pad = function (n) { return String(n).padStart(2, '0'); };
  var fd = new Date(followup.due_date);
  var fYmd = fd.getFullYear() + '-' + pad(fd.getMonth() + 1) + '-' + pad(fd.getDate());
  var fTime = followup.due_time ? String(followup.due_time).slice(0, 5) : '';
%>
<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
      <p class="crm-contact-site">
        Follow-up with <a href="/dashboard/crm/contacts/<%= followup.contact_id %>"><strong><%= followup.contact_name %></strong></a> · <%= followup.store_name || 'General inquiry' %>
      </p>

      <form action="/dashboard/crm/followups/<%= followup.id %>/edit" method="POST" class="admin-form">
        <label>What to follow up on *
          <input type="text" name="title" required maxlength="255" value="<%= followup.title %>" />
        </label>

        <div class="form-row">
          <label>Date *
            <input type="date" name="due_date" required value="<%= fYmd %>" />
          </label>
          <label>Time <span style="font-weight:400; color:#6b7280;">(optional)</span>
            <input type="time" name="due_time" value="<%= fTime %>" />
          </label>
        </div>

        <label>Assigned to
          <select name="assigned_to">
            <option value="">Unassigned</option>
            <% assignableUsers.forEach(function(u) { %>
              <option value="<%= u.id %>" <%= followup.assigned_to === u.id ? 'selected' : '' %>><%= u.name %><%= u.id === account.id ? ' (you)' : '' %></option>
            <% }); %>
          </select>
        </label>

        <label>Linked task <span style="font-weight:400; color:#6b7280;">(optional)</span>
          <select name="task_id">
            <option value="">No linked task</option>
            <%
              var linkedListed = false;
              linkableTasks.forEach(function(t) { if (t.id === followup.task_id) linkedListed = true; });
            %>
            <% if (followup.task_id && !linkedListed) { %>
              <option value="<%= followup.task_id %>" selected><%= followup.task_title %> (done)</option>
            <% } %>
            <% linkableTasks.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= followup.task_id === t.id ? 'selected' : '' %>><%= t.title %><%= t.contact_id ? '' : ' (standalone)' %></option>
            <% }); %>
          </select>
        </label>

        <label>Note
          <textarea name="note" rows="3" maxlength="2000" placeholder="What to say or ask"><%= followup.note || '' %></textarea>
        </label>

        <div style="display:flex; gap:8px;">
          <button type="submit" class="btn btn-primary">Save changes</button>
          <a href="/dashboard/crm/followups" class="btn btn-secondary">Back to follow-ups</a>
        </div>
      </form>
    </div>

<%- include('partials/footer') %>
