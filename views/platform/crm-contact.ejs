<% var pageTitle = contact.name; %>
<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
    <%
      var isCustomer = !!contact.customer_id;
      var initial = (contact.name || '?').trim().charAt(0).toUpperCase() || '?';
      var addedOn = new Date(contact.created_at).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
    %>
    <a href="/dashboard/crm/<%= isCustomer ? 'customers' : 'leads' %>" class="crm-back-link">&larr; Back to <%= isCustomer ? 'customers' : 'leads' %></a>

    <div class="crm-contact-head">
      <span class="crm-avatar" aria-hidden="true"><%= initial %></span>
      <div class="crm-contact-head-info">
        <h2 class="crm-contact-name"><%= contact.name %></h2>
        <p class="crm-contact-sub">
          <span class="status-pill <%= isCustomer ? 'status-delivered' : 'status-paid' %>"><%= isCustomer ? 'Customer' : 'Lead' %></span>
          <span><%= contact.store_name || 'General inquiry' %></span>
          <span class="crm-contact-sub-dot">·</span>
          <span>Added <%= addedOn %></span>
        </p>
      </div>

      <%# Kept outside the edit form below on purpose: a <form> can't be nested inside another <form>. %>
      <% if (!isCustomer) { %>
        <% if (contact.store_id) { %>
          <form action="/dashboard/crm/contacts/<%= contact.id %>/convert" method="POST" class="crm-convert-form" onsubmit="return confirm('Move this lead to Customers? This creates a real customer account for them if one does not already exist.');">
            <button type="submit" class="btn btn-secondary">Move to Customer</button>
          </form>
        <% } else if (stores.length) { %>
          <form action="/dashboard/crm/contacts/<%= contact.id %>/convert" method="POST" class="crm-convert-form" onsubmit="return confirm('Move this lead to Customers? This creates a real customer account for them on the site you pick.');">
            <select name="store_id" required aria-label="Site for the new customer account">
              <option value="">Choose a site…</option>
              <% stores.forEach(function(s) { %>
                <option value="<%= s.id %>"><%= s.name %></option>
              <% }); %>
            </select>
            <button type="submit" class="btn btn-secondary">Move to Customer</button>
          </form>
        <% } else { %>
          <span class="crm-contact-head-note">Add a site before you can move this contact to Customers.</span>
        <% } %>
      <% } %>
    </div>

    <div class="crm-contact-layout">
      <form action="/dashboard/crm/contacts/<%= contact.id %>/edit" method="POST" class="admin-form crm-form">
        <section class="crm-form-section">
          <h2>Contact details</h2>
          <p class="crm-form-help">Who they are and how to reach them.</p>

          <label>Name <span class="crm-req" title="Required">*</span>
            <input type="text" name="name" required maxlength="255" value="<%= contact.name %>" />
          </label>

          <div class="form-row">
            <label>Email <span class="crm-req" title="Required">*</span>
              <input type="email" name="email" required maxlength="255" value="<%= contact.email %>" />
            </label>
            <label>Phone
              <input type="tel" name="phone" maxlength="50" value="<%= contact.phone || '' %>" placeholder="+91 98765 43210" />
            </label>
          </div>
        </section>

        <section class="crm-form-section">
          <h2>Source</h2>
          <p class="crm-form-help">How this contact found you.</p>

          <label>Source
            <select name="source">
              <option value="manual" <%= contact.source === 'manual' ? 'selected' : '' %>>Added manually</option>
              <option value="contact_form" <%= contact.source === 'contact_form' ? 'selected' : '' %>>Contact form</option>
              <option value="signup" <%= contact.source === 'signup' ? 'selected' : '' %>>Account signup</option>
              <option value="order" <%= contact.source === 'order' ? 'selected' : '' %>>Order / checkout</option>
              <option value="newsletter" <%= contact.source === 'newsletter' ? 'selected' : '' %>>Newsletter</option>
              <option value="import" <%= contact.source === 'import' ? 'selected' : '' %>>Imported</option>
            </select>
          </label>
        </section>

        <section class="crm-form-section">
          <h2>Tags</h2>
          <p class="crm-form-help">Labels like "hot" or "wholesale" make contacts easy to group.</p>

          <div class="crm-tag-field">
            <label>Add tags <span class="crm-tag-hint" style="font-weight:400; color:#6b7280;">(comma-separated)</span>
              <input type="text" name="tags" data-tag-input value="<%= (contact.tags || []).join(', ') %>" placeholder="hot, wholesale" />
            </label>
            <% if (typeof popularTags !== 'undefined' && popularTags.length) { %>
              <div class="crm-tag-suggestions">
                <span class="crm-tag-suggestions-label">Choose from the most used tags:</span>
                <% popularTags.forEach(function(t) { %><button type="button" class="crm-tag-suggestion" data-tag="<%= t %>"><%= t %></button><% }); %>
              </div>
            <% } %>
          </div>
        </section>

        <div class="crm-form-actions">
          <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
      </form>

      <div class="crm-contact-side">
      <div class="panel crm-followups-panel">
        <h2>Follow-ups</h2>

        <%- include('partials/followup-form', { contactId: contact.id, today: today, redirect: '' }) %>

        <ul class="crm-fu-list">
          <% followups.forEach(function(f) { %>
            <%- include('partials/followup-row', { f: f, today: today, redirect: '/dashboard/crm/contacts/' + contact.id, showContact: false }) %>
          <% }); %>
          <% if (followups.length === 0) { %>
            <li class="empty-state">No follow-ups scheduled for this contact.</li>
          <% } %>
        </ul>
      </div>

      <div class="panel crm-tasks-panel">
        <h2>Tasks</h2>

        <form action="/dashboard/crm/contacts/<%= contact.id %>/tasks" method="POST" class="crm-task-form">
          <input type="text" name="title" placeholder="e.g. Send the proposal" required />
          <input type="date" name="due_date" />
          <select name="assigned_to">
            <option value="">Unassigned</option>
            <% assignableUsers.forEach(function(u) { %>
              <option value="<%= u.id %>"><%= u.name %><%= u.role === 'owner' ? ' (you)' : '' %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn-primary">Add task</button>
        </form>

        <ul class="crm-task-list">
          <% tasks.forEach(function(t) { %>
            <li class="crm-task <%= t.done ? 'crm-task-done' : '' %>">
              <form action="/dashboard/crm/tasks/<%= t.id %>/toggle" method="POST">
                <input type="hidden" name="done" value="<%= t.done ? '0' : '1' %>" />
                <button type="submit" class="crm-task-check" aria-label="Toggle done"><%= t.done ? '✓' : '' %></button>
              </form>
              <div class="crm-task-body">
                <span class="crm-task-title"><%= t.title %></span>
                <span class="crm-task-meta">
                  <%= t.assignee_name ? t.assignee_name : 'Unassigned' %><%= t.due_date ? ' · due ' + new Date(t.due_date).toLocaleDateString() : '' %>
                </span>
              </div>
              <form action="/dashboard/crm/tasks/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Delete this task?');">
                <button type="submit" class="link-btn danger">Delete</button>
              </form>
            </li>
          <% }); %>
          <% if (tasks.length === 0) { %>
            <li class="empty-state">No tasks yet — add one above.</li>
          <% } %>
        </ul>
      </div>
      </div>
    </div>

    <form action="/dashboard/crm/contacts/<%= contact.id %>/delete" method="POST" onsubmit="return confirm('Delete this contact? This also deletes its tasks and follow-ups.');" style="margin-top:16px;">
      <button type="submit" class="link-btn danger">Delete contact</button>
    </form>
    </div>

<%- include('partials/footer') %>
