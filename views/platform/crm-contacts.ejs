<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="flash flash-success"><%= success[0] %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="flash flash-error"><%= error[0] %></div>
    <% } %>

    <div class="panel-toolbar crm-toolbar">
      <form action="/dashboard/crm/<%= segment %>" method="GET" class="crm-filter-bar">
        <select name="store" onchange="this.form.submit()">
          <option value="">All sites</option>
          <% stores.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= selectedStore === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }); %>
        </select>
      </form>
      <div class="crm-toolbar-actions">
        <% if (segment === 'leads') { %>
          <details class="crm-import-panel">
            <summary class="btn btn-secondary">Import leads</summary>
            <div class="crm-import-body">
              <form action="/dashboard/crm/leads/import" method="POST" enctype="multipart/form-data" id="crmImportForm" class="crm-import-form">
                <label>Site <span style="font-weight:400; color:#6b7280;">(optional — leave blank for a general inquiry)</span>
                  <select name="store_id">
                    <option value="">No specific site</option>
                    <% stores.forEach(function(s) { %>
                      <option value="<%= s.id %>"><%= s.name %></option>
                    <% }); %>
                  </select>
                </label>
                <label>File
                  <input type="file" name="file" id="crmImportFile" accept=".csv,.xlsx,.xls" required />
                </label>
                <p class="crm-import-hint">First row must be headers: Name and Email are required; Phone and Tags are optional.</p>
                <div class="crm-import-actions">
                  <button type="submit" class="btn btn-primary">Import file</button>
                  <% if (googleDriveClientId && googleDriveApiKey) { %>
                    <button type="button" id="crmImportFromDrive" class="btn btn-secondary" data-google-client-id="<%= googleDriveClientId %>" data-google-api-key="<%= googleDriveApiKey %>">Import from Google Drive</button>
                  <% } %>
                </div>
              </form>
            </div>
          </details>
          <% if (googleDriveClientId && googleDriveApiKey) { %>
            <script src="/js/crm-lead-import.js?v=<%= assetVersion %>" defer></script>
          <% } %>
        <% } %>
        <a href="/dashboard/crm/contacts/new" class="btn btn-primary">+ New contact</a>
      </div>
    </div>

    <%
      var tagPalette = ['crm-tag-indigo', 'crm-tag-violet', 'crm-tag-teal', 'crm-tag-amber', 'crm-tag-rose', 'crm-tag-slate'];
      function tagColorClass(tag) {
        var hash = 0;
        for (var i = 0; i < tag.length; i++) { hash = (hash * 31 + tag.charCodeAt(i)) >>> 0; }
        return tagPalette[hash % tagPalette.length];
      }
      var maxVisibleTags = 3;
    %>
    <table class="admin-table">
      <thead>
        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Site</th><th>Tags</th><th>Source</th><th>Added</th></tr>
      </thead>
      <tbody>
        <% contacts.forEach(function(c) { %>
          <tr>
            <td><a href="/dashboard/crm/contacts/<%= c.id %>"><strong><%= c.name %></strong></a></td>
            <td><%= c.email %></td>
            <td><%= c.phone || '—' %></td>
            <td><%= c.store_name || 'General inquiry' %></td>
            <td class="crm-tags">
              <% var cTags = c.tags || []; %>
              <% cTags.slice(0, maxVisibleTags).forEach(function(t) { %><span class="crm-tag <%= tagColorClass(t) %>"><%= t %></span><% }); %>
              <% if (cTags.length > maxVisibleTags) { %><span class="crm-tag crm-tag-more">+<%= cTags.length - maxVisibleTags %></span><% } %>
              <% if (cTags.length === 0) { %><span class="crm-tags-empty">—</span><% } %>
            </td>
            <td><span class="status-pill status-paid"><%= c.source.replace('_', ' ') %></span></td>
            <td><%= new Date(c.created_at).toLocaleDateString() %></td>
          </tr>
        <% }); %>
        <% if (contacts.length === 0) { %>
          <tr><td colspan="7" class="empty-state">
            <%= segment === 'customers' ? 'No converted customers yet — a lead lands here once they create an account.' : "No leads yet — they'll show up here from your contact forms, or add one manually." %>
          </td></tr>
        <% } %>
      </tbody>
    </table>
    </div>

<%- include('partials/footer') %>
