<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
      <ul class="crm-task-list crm-task-list-wide">
        <% tasks.forEach(function(t) { %>
          <li class="crm-task <%= t.done ? 'crm-task-done' : '' %>">
            <form action="/dashboard/crm/tasks/<%= t.id %>/toggle" method="POST">
              <input type="hidden" name="done" value="<%= t.done ? '0' : '1' %>" />
              <button type="submit" class="crm-task-check" aria-label="Toggle done"><%= t.done ? '✓' : '' %></button>
            </form>
            <div class="crm-task-body">
              <span class="crm-task-title"><%= t.title %></span>
              <span class="crm-task-meta">
                <% if (t.contact_id) { %><a href="/dashboard/crm/contacts/<%= t.contact_id %>"><%= t.contact_name %></a> · <%= t.store_name || 'General inquiry' %><% } else { %>Standalone task<% } %><%= t.due_date ? ' · due ' + new Date(t.due_date).toLocaleDateString() : '' %>
              </span>
            </div>
            <a href="/dashboard/crm/tasks" class="link-btn">Hand off to someone else</a>
          </li>
        <% }); %>
        <% if (tasks.length === 0) { %>
          <li class="empty-state">Nothing assigned to you right now.</li>
        <% } %>
      </ul>
    </div>

<%- include('partials/footer') %>
