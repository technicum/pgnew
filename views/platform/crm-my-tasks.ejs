<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
      <ul class="crm-task-list crm-task-list-wide crm-task-list-dated">
        <% tasks.forEach(function(t) { %>
          <li class="crm-task <%= t.done ? 'crm-task-done' : '' %>" data-due="<%= t.due_date ? new Date(t.due_date).toISOString().slice(0,10) : '' %>" data-done="<%= t.done ? '1' : '' %>">
            <form action="/dashboard/crm/tasks/<%= t.id %>/toggle" method="POST">
              <input type="hidden" name="done" value="<%= t.done ? '0' : '1' %>" />
              <button type="submit" class="crm-task-check" aria-label="Toggle done"><%= t.done ? '✓' : '' %></button>
            </form>
            <div class="crm-task-body">
              <!-- A subtask is just a point on its parent's checklist -- no
                   detail page of its own to link into. -->
              <% if (t.parent_task_id) { %>
                <span class="crm-task-title"><%= t.title %></span>
              <% } else { %>
                <a class="crm-task-title" href="/dashboard/crm/tasks/<%= t.id %>"><%= t.title %></a>
              <% } %>
              <span class="crm-task-meta">
                <% if (t.parent_task_id) { %>Subtask of <%= t.parent_title %><% } else if (t.contact_id) { %><a href="/dashboard/crm/contacts/<%= t.contact_id %>"><%= t.contact_name %></a> · <%= t.store_name || 'General inquiry' %><% } else { %>Standalone task<% } %><%= t.due_date ? ' · due ' + new Date(t.due_date).toLocaleDateString() : '' %><%= t.priority && t.priority !== 'medium' ? ' · ' + t.priority + ' priority' : '' %>
              </span>
            </div>
            <% if (!t.parent_task_id) { %>
              <a href="/dashboard/crm/tasks/<%= t.id %>" class="link-btn">Open</a>
            <% } %>
          </li>
        <% }); %>
        <% if (tasks.length === 0) { %>
          <li class="empty-state">Nothing assigned to you right now.</li>
        <% } %>
      </ul>
    </div>

<%- include('partials/footer') %>
