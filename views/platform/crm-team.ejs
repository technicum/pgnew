<%- include('partials/header') %>

    <div class="dashboard-main crm-main">
      <p style="color:#6b7280; font-size:0.88rem; max-width:520px;">People you add here can log in and see/work your leads, customers and tasks — they get no access to any of your stores' products, orders or site editing unless you separately add them as staff on that store.</p>

      <table class="admin-table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Role</th><th>Added</th><th></th></tr>
        </thead>
        <tbody>
          <% team.forEach(function(m) { %>
            <tr>
              <td><%= m.name %></td>
              <td><%= m.email %></td>
              <td><span class="status-pill status-paid"><%= m.role %></span></td>
              <td><%= new Date(m.created_at).toLocaleDateString() %></td>
              <td class="admin-row-actions">
                <form action="/dashboard/crm/team/<%= m.id %>/remove" method="POST" onsubmit="return confirm('Remove ' + <%- JSON.stringify(m.name) %> + ' from your CRM team?');">
                  <button type="submit" class="link-btn danger">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (team.length === 0) { %>
            <tr><td colspan="5" class="empty-state">No CRM team members yet.</td></tr>
          <% } %>
        </tbody>
      </table>

      <h2 style="margin-top:32px;">Add a team member</h2>
      <form action="/dashboard/crm/team" method="POST" class="admin-form">
        <label>Name *
          <input type="text" name="name" required placeholder="Priya Sharma" />
        </label>
        <div class="form-row">
          <label>Email *
            <input type="email" name="email" required placeholder="priya@example.com" />
          </label>
          <label>Role
            <select name="role">
              <option value="member">Member</option>
              <option value="manager">Manager</option>
            </select>
          </label>
        </div>
        <label>Password <span style="font-weight:400; color:#6b7280;">(only needed if they don't already have a PageZaper login)</span>
          <input type="password" name="password" minlength="6" placeholder="At least 6 characters" />
        </label>
        <button type="submit" class="btn btn-primary">Add to CRM team</button>
      </form>
    </div>

<%- include('partials/footer') %>
