<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · PageZaper</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="dashboard-body">
  <header class="dashboard-header">
    <a href="/dashboard" class="admin-logo" style="text-decoration:none;">Page<span>Zaper</span></a>
    <div class="dashboard-header-right">
      <span class="dashboard-account-name"><%= account.name %></span>
      <a href="/dashboard/profile" class="link-btn">Your profile</a>
      <form action="/dashboard/logout" method="POST" style="display:inline;">
        <button type="submit" class="link-btn">Log out</button>
      </form>
    </div>
  </header>

  <main class="dashboard-main">
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="flash flash-success"><%= success[0] %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="flash flash-error"><%= error[0] %></div>
    <% } %>

    <div class="dashboard-title-row">
      <h1>Your sites</h1>
      <a href="/dashboard/new-store" class="btn btn-primary">Create a new site</a>
    </div>

    <% if (!stores.length) { %>
      <div class="dashboard-empty">
        <p>You don't manage any sites yet.</p>
        <a href="/dashboard/new-store" class="btn btn-primary">Create your first site</a>
      </div>
    <% } else { %>
      <div class="dashboard-store-list">
        <% stores.forEach(function(s) { %>
          <form action="/dashboard/enter" method="POST" class="dashboard-store-card">
            <input type="hidden" name="storeId" value="<%= s.store_id %>" />
            <div class="dashboard-store-info">
              <span class="dashboard-store-name"><%= s.name %></span>
              <span class="dashboard-store-domain"><%= s.subdomain %>.<%= typeof baseDomain !== 'undefined' ? baseDomain : 'pagezaper.com' %></span>
            </div>
            <span class="dashboard-store-role"><%= s.role %></span>
            <button type="submit" class="btn btn-primary">Enter site</button>
          </form>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
