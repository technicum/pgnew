<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · PageZaper</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="dashboard-body">
  <header class="dashboard-header">
    <a href="/dashboard" class="admin-logo" style="text-decoration:none;">Page<span>Zaper</span></a>
    <div class="dashboard-header-right">
      <span class="dashboard-account-name"><%= account.name %></span>
      <a href="/dashboard" class="link-btn">Your sites</a>
      <form action="/dashboard/logout" method="POST" style="display:inline;">
        <button type="submit" class="link-btn">Log out</button>
      </form>
    </div>
  </header>

  <main class="dashboard-main">
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="flash flash-success"><%= success[0] %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="flash flash-error"><%= error[0] %></div>
    <% } %>

    <div class="app-card" style="max-width:480px;">
      <div class="app-card-top">
        <h3>CRM</h3>
      </div>
      <p class="app-card-desc"><%= crmApp ? crmApp.description : 'Contacts, leads, tasks and follow-ups across every site you run.' %></p>
      <div class="app-card-bottom">
        <span class="app-card-price"><%= crmApp && crmApp.price_cents > 0 ? '₹' + Math.round(crmApp.price_cents / 100) + '/mo' : 'Free' %></span>
        <form action="/dashboard/crm/activate" method="POST">
          <button type="submit" class="btn btn-primary">Activate CRM</button>
        </form>
      </div>
    </div>
    <p style="margin-top:16px; color:#6b7280; font-size:0.88rem;">One CRM for every site you run — leads and customers land here regardless of which store they came from, with tasks and a team of your own to work them.</p>
  </main>
</body>
</html>
