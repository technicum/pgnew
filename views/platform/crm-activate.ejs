<%- include('partials/header') %>

    <div class="dashboard-main">
      <div class="app-card" style="max-width:480px;">
        <div class="app-card-top">
          <h3>CRM</h3>
        </div>
        <p class="app-card-desc"><%= crmApp ? crmApp.description : 'Contacts, leads, tasks and follow-ups across every site you run.' %></p>
        <div class="app-card-bottom">
          <span class="app-card-price"><%= crmApp && crmApp.price_cents > 0 ? '₹' + Math.round(crmApp.price_cents / 100) + '/mo' : 'Free' %></span>
          <form action="/dashboard/crm/activate" method="POST">
            <button type="submit" class="btn btn-primary">Activate CRM</button>
          </form>
        </div>
      </div>
      <p style="margin-top:16px; color:#6b7280; font-size:0.88rem;">One CRM for every site you run — leads and customers land here regardless of which store they came from, with tasks and a team of your own to work them.</p>
    </div>

<%- include('partials/footer') %>
