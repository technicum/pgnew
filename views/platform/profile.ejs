<%- include('partials/header') %>

    <div class="dashboard-main">
      <div class="panel">
        <h2>Your profile</h2>

        <% if (errors && errors.length) { %>
          <div class="flash flash-error">
            <% errors.forEach(function(e) { %>
              <div><%= e %></div>
            <% }); %>
          </div>
        <% } %>

        <form action="/dashboard/profile" method="POST" class="admin-form">
          <label>Name
            <input type="text" name="name" value="<%= values.name %>" required autofocus />
          </label>
          <label>Email
            <input type="email" name="email" value="<%= values.email %>" required />
          </label>

          <p class="field-hint">Leave the password fields blank to keep your current password.</p>

          <label>Current password
            <input type="password" name="currentPassword" autocomplete="current-password" />
          </label>
          <div class="form-row">
            <label>New password
              <input type="password" name="newPassword" minlength="6" autocomplete="new-password" />
            </label>
            <label>Confirm new password
              <input type="password" name="confirmNewPassword" minlength="6" autocomplete="new-password" />
            </label>
          </div>

          <button type="submit" class="btn btn-primary" style="margin-top:8px;">Save changes</button>
        </form>
      </div>
    </div>

<%- include('partials/footer') %>
