<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : title %> · PageZaper</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>" />
</head>
<body class="admin-body platform-body">
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <a href="/dashboard" class="admin-logo" style="text-decoration:none;">Page<span>Zaper</span></a>
      <%
        // Which of the CRM sub-screens we're on -- `crm` is only ever passed
        // by the requireCrm-gated routes (routes/platform.js), so this is
        // naturally false on the "activate CRM" screen (nothing to
        // sub-navigate there yet) even though that screen shares the top-
        // level "CRM" nav item below.
        var crmScreens = ['Leads', 'CRM Customers', 'New Contact', 'Contact', 'Tasks', 'Task', 'My Tasks', 'Follow-ups', 'Follow-up', 'Follow-up History', 'Attendance', 'CRM Team'];
        var crmOpen = typeof crm !== 'undefined' && crm && crmScreens.indexOf(title) !== -1;

        // One small line-icon per nav item -- same authoring convention as
        // lib/socialIcons.js (24x24 viewBox, stroke="currentColor" so it
        // always matches the link's own text/hover/active color, no fill of
        // its own). Kept inline here rather than in a shared lib file since,
        // unlike the social icons, nothing outside this sidebar needs them.
        var NAV_ICONS = {
          sites: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/></svg>',
          crm: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.3 19c0-3 2.5-5.2 5.7-5.2s5.7 2.2 5.7 5.2"/><circle cx="17.3" cy="8.6" r="2.2"/><path d="M15.2 14c2.1.4 3.7 2 3.7 4.2"/></svg>',
          leads: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.3"/><circle cx="12" cy="12" r="4.3"/><circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"/></svg>',
          customers: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9.3" cy="8" r="3.3"/><path d="M3.5 19.5c0-3.3 2.6-5.6 5.8-5.6s5.8 2.3 5.8 5.6"/><path d="M16.3 12.3l2 2 3.7-4"/></svg>',
          followups: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 10.5a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 14.5 6 10.5Z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg>',
          tasks: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.3 6.5h11M9.3 12h11M9.3 17.5h11"/><path d="M3.3 6.5l1 1 1.9-1.9M3.3 12l1 1 1.9-1.9M3.3 17.5l1 1 1.9-1.9"/></svg>',
          myTasks: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.3l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.8l-4.8 2.4.9-5.4-3.9-3.8 5.4-.8L12 3.3Z"/></svg>',
          attendance: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12.5" r="8.3"/><path d="M12 7.7v5l3.2 2"/><path d="M9.2 2.5h5.6"/></svg>',
          team: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.3" cy="8" r="3"/><circle cx="16" cy="9" r="2.4"/><path d="M2.6 19c0-3 2.5-5 5.7-5s5.7 2 5.7 5"/><path d="M14.7 14.3c2.3.4 4.4 2 4.4 4.7"/></svg>',
          profile: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="9.8" r="3"/><path d="M6 18.2c.9-2.6 3.1-4 6-4s5.1 1.4 6 4"/></svg>',
          logout: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>',
        };
      %>
      <nav class="admin-nav">
        <a href="/dashboard" class="<%= title === 'Your stores' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.sites %></span>Your sites</a>
        <a href="/dashboard/crm" class="<%= crmOpen || title === 'CRM' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.crm %></span>CRM</a>
        <% if (crmOpen) { %>
          <a href="/dashboard/crm/leads" class="admin-nav-sub <%= (title === 'Leads' || title === 'New Contact' || title === 'Contact') ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.leads %></span>Leads</a>
          <a href="/dashboard/crm/customers" class="admin-nav-sub <%= title === 'CRM Customers' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.customers %></span>Customers</a>
          <a href="/dashboard/crm/followups" class="admin-nav-sub <%= (title === 'Follow-ups' || title === 'Follow-up' || title === 'Follow-up History') ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.followups %></span>Follow-ups<% if (typeof crmFollowupsDue !== 'undefined' && crmFollowupsDue > 0) { %> <span class="admin-nav-badge"><%= crmFollowupsDue %></span><% } %></a>
          <a href="/dashboard/crm/tasks" class="admin-nav-sub <%= (title === 'Tasks' || title === 'Task') ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.tasks %></span>Tasks</a>
          <a href="/dashboard/crm/my-tasks" class="admin-nav-sub <%= title === 'My Tasks' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.myTasks %></span>My Tasks</a>
          <a href="/dashboard/crm/attendance" class="admin-nav-sub <%= title === 'Attendance' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.attendance %></span>Attendance</a>
          <% if (crm.role === 'owner') { %>
            <a href="/dashboard/crm/team" class="admin-nav-sub <%= title === 'CRM Team' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.team %></span>Team</a>
          <% } %>
        <% } %>

        <div class="admin-nav-divider"></div>
        <a href="/dashboard/profile" class="<%= title === 'Your profile' ? 'active' : '' %>"><span class="admin-nav-icon"><%- NAV_ICONS.profile %></span>Profile</a>
      </nav>
      <form action="/dashboard/logout" method="POST" class="admin-logout-form">
        <button type="submit" class="link-btn"><span class="admin-nav-icon"><%- NAV_ICONS.logout %></span>Log out</button>
      </form>
    </aside>
    <div class="admin-main">
      <% if (typeof impersonation !== 'undefined' && impersonation) { %>
        <div class="impersonation-banner">
          <span>You're viewing this account as <strong><%= typeof account !== 'undefined' && account ? account.name : '' %></strong>, logged in by platform admin <%= impersonation.platformAdminName %>.</span>
          <form action="/dashboard/exit-impersonation" method="POST">
            <button type="submit" class="link-btn">Return to Platform Admin</button>
          </form>
        </div>
      <% } %>
      <%
        // activeTimer only ever lands in res.locals via requireCrm (see
        // routes/platform.js) -- undefined, not just falsy, on every
        // non-CRM-gated page (dashboard, profile, signup, ...) this same
        // header is shared with, hence the typeof guard.
        var activeTimer_ = typeof activeTimer !== 'undefined' ? activeTimer : null;
        // Hidden only on the two spots that already show this exact timer
        // inline with their own stop control: the Attendance card, and the
        // Tasks drawer when it's open on the very task being timed (openTask
        // is only ever in scope when crm-tasks.ejs includes this partial).
        var onAttendance = title === 'Attendance';
        var onTimedTaskDrawer = typeof openTask !== 'undefined' && openTask && activeTimer_ && openTask.id === activeTimer_.task_id;
      %>
      <% if (activeTimer_ && !onAttendance && !onTimedTaskDrawer) { %>
        <div class="active-timer-banner">
          <span>Timer running: <strong><%= activeTimer_.task_title %></strong> <span class="live-duration" data-since="<%= new Date(activeTimer_.started_at).toISOString() %>"><%= formatClock((Date.now() - new Date(activeTimer_.started_at).getTime()) / 1000) %></span></span>
          <form action="/dashboard/crm/tasks/<%= activeTimer_.task_id %>/timer/stop" method="POST">
            <button type="submit" class="link-btn">Stop</button>
          </form>
        </div>
      <% } %>

      <header class="admin-topbar">
        <h1><%= title %></h1>
        <% if (typeof account !== 'undefined' && account) { %><span class="admin-user">Hi, <%= account.name %></span><% } %>
      </header>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <div class="flash flash-success"><%= success[0] %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <div class="flash flash-error"><%= error[0] %></div>
      <% } %>

      <div class="admin-content">
