<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · PageZaper</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-login-body">
  <div class="login-card store-select-card">
    <a href="/" class="admin-logo" style="display:inline-block; text-decoration:none;">Page<span>Zaper</span></a>
    <p class="signup-tagline">Hi <%= name %> — which store do you want to manage?</p>

    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="flash flash-error"><%= error[0] %></div>
    <% } %>

    <div class="store-select-list">
      <% stores.forEach(function(s) { %>
        <form action="/select-store" method="POST">
          <input type="hidden" name="storeId" value="<%= s.store_id %>" />
          <button type="submit" class="store-select-btn">
            <span class="store-select-name"><%= s.name %></span>
            <span class="store-select-role"><%= s.role %></span>
          </button>
        </form>
      <% }); %>
    </div>

    <p class="login-hint"><a href="/login">Log in as someone else</a></p>
  </div>
</body>
</html>
