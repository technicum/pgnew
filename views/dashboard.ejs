<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>
<div class="min-h-screen bg-background">

  <aside class="fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-sidebar text-sidebar-foreground transition-all lg:translate-x-0 translate-x-0">
    <div class="flex h-20 items-center justify-between border-b border-sidebar-border px-6">
      <a href="/" class="flex items-center gap-3" style="text-decoration:none;color:inherit;">
        <div class="grid size-9 place-items-center rounded-md bg-sidebar-primary text-sidebar-primary-foreground">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><path d="M5 12.5L10 17L19 7" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <span class="font-display text-xl font-extrabold"><%= siteName %></span>
      </a>
    </div>

    <div class="px-4 pt-6">
      <div class="flex w-full items-center gap-3 rounded-md border border-sidebar-border bg-sidebar-accent p-3 text-left">
        <div class="grid size-9 shrink-0 place-items-center rounded-md bg-accent font-display text-sm font-bold text-accent-foreground"><%= user.initials %></div>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold"><%= user.name %></span>
          <span class="block truncate text-xs text-sidebar-foreground/55"><%= siteDomain %>/<%= user.handle %></span>
        </span>
      </div>
    </div>

    <nav class="flex-1 space-y-1 px-4 py-6" aria-label="Dashboard navigation">
      <a href="/dashboard" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors bg-sidebar-accent text-sidebar-accent-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sidebar-primary"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
        <span class="flex-1 text-left">Overview</span>
      </a>
      <a href="/dashboard/builder" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.364 13.634a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506l4.013-4.009a1 1 0 0 0-3.004-3.004z"></path><path d="M14.487 7.858A1 1 0 0 1 14 7V2"></path><path d="M20 19.645V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l2.516 2.516"></path><path d="M8 18h1"></path></svg>
        <span class="flex-1 text-left">My store</span>
      </a>
      <a href="/dashboard/audience" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
        <span class="flex-1 text-left">Audience</span>
      </a>
      <a href="/dashboard/lead-magnets" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M12 8v4"></path><path d="M12 15h.01"></path></svg>
        <span class="flex-1 text-left">Lead magnets</span>
      </a>
      <a href="#" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg>
        <span class="flex-1 text-left">Products</span>
      </a>
      <a href="#" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg>
        <span class="flex-1 text-left">Orders</span>
      </a>
      <a href="#" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg>
        <span class="flex-1 text-left">Analytics</span>
      </a>
    </nav>

    <div class="space-y-1 border-t border-sidebar-border p-4">
      <a href="#" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm text-sidebar-foreground/65 hover:bg-sidebar-accent" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle></svg>
        Settings
      </a>
      <a href="#" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm text-sidebar-foreground/65 hover:bg-sidebar-accent" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>
        Help &amp; support
      </a>
      <form method="POST" action="/logout">
        <button type="submit" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm text-sidebar-foreground/65 hover:bg-sidebar-accent" style="border:none;background:none;cursor:pointer;font:inherit;color:inherit;">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
          Log out
        </button>
      </form>
    </div>
  </aside>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8">
      <div class="relative hidden max-w-md flex-1 sm:block">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
        <input class="h-10 w-full rounded-md border border-border bg-card pl-10 text-sm" style="outline:none;" placeholder="Search products, orders, customers…" />
      </div>
      <div class="ml-auto flex items-center gap-2">
        <button type="button" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold text-muted-foreground hover:bg-muted hover:text-foreground size-10 p-0 relative" aria-label="Notifications" style="border:none;background:none;cursor:pointer;">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg>
        </button>
        <div class="mx-1 h-7 w-px bg-border"></div>
        <div class="flex items-center gap-2 rounded-md p-1.5">
          <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1500px] px-4 py-7 md:px-8 md:py-9">

      <section class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-primary"><%= todayLabel %></p>
          <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Welcome, <%= user.name.split(' ')[0] %></h1>
          <p class="mt-2 text-sm text-muted-foreground">Your store is live at <%= siteDomain %>/<%= user.handle %> — here's how it's doing.</p>
        </div>
        <div class="flex gap-2" style="flex-wrap:wrap;">
          <a href="#" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold border border-border bg-background text-foreground hover:bg-muted h-10 px-4" style="text-decoration:none;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
            View my store
          </a>
          <a href="#" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 active:translate-y-px h-10 px-4" style="text-decoration:none;">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            Add what you sell
          </a>
        </div>
      </section>

      <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="animate-rise-in rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="grid size-10 place-items-center rounded-md bg-success-soft text-success">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>
          </div>
          <p class="mt-5 text-sm font-medium text-muted-foreground">Total revenue</p>
          <div class="mt-1"><strong class="font-display text-2xl font-extrabold">₹0</strong></div>
        </article>
        <article class="animate-rise-in rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="grid size-10 place-items-center rounded-md bg-success-soft text-success">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10a4 4 0 0 1-8 0"></path><path d="M3.103 6.034h17.794"></path><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path></svg>
          </div>
          <p class="mt-5 text-sm font-medium text-muted-foreground">Total sales</p>
          <div class="mt-1"><strong class="font-display text-2xl font-extrabold">0</strong></div>
        </article>
        <article class="animate-rise-in rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="grid size-10 place-items-center rounded-md bg-success-soft text-success">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
          </div>
          <p class="mt-5 text-sm font-medium text-muted-foreground">Store visitors</p>
          <div class="mt-1"><strong class="font-display text-2xl font-extrabold">0</strong></div>
        </article>
        <article class="animate-rise-in rounded-lg border border-border bg-card p-5 shadow-sm">
          <div class="grid size-10 place-items-center rounded-md bg-success-soft text-success">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline></svg>
          </div>
          <p class="mt-5 text-sm font-medium text-muted-foreground">Products live</p>
          <div class="mt-1"><strong class="font-display text-2xl font-extrabold">0</strong></div>
        </article>
      </section>

      <section class="mt-6 grid gap-4 xl:grid-cols-[minmax(0,1.7fr)_minmax(300px,0.75fr)]">
        <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-lg font-bold">Revenue overview</h2>
              <p class="mt-1 text-sm text-muted-foreground">Your earnings across all products</p>
            </div>
          </div>
          <div class="mt-7 flex items-end gap-3">
            <span class="font-display text-3xl font-extrabold">₹0</span>
          </div>
          <div class="mt-6 h-52 w-full" style="position:relative;">
            <svg viewBox="0 0 370 110" class="h-full w-full overflow-visible" preserveAspectRatio="none" role="img" aria-label="No revenue yet">
              <line x1="0" y1="10" x2="370" y2="10" class="stroke-border" stroke-width="0.7" stroke-dasharray="3 4"></line>
              <line x1="0" y1="35" x2="370" y2="35" class="stroke-border" stroke-width="0.7" stroke-dasharray="3 4"></line>
              <line x1="0" y1="60" x2="370" y2="60" class="stroke-border" stroke-width="0.7" stroke-dasharray="3 4"></line>
              <line x1="0" y1="85" x2="370" y2="85" class="stroke-border" stroke-width="0.7" stroke-dasharray="3 4"></line>
              <line x1="0" y1="98" x2="370" y2="98" stroke="var(--border)" stroke-width="1.5"></line>
            </svg>
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center; padding:0 24px;">
              <p class="text-sm text-muted-foreground">No sales yet — your revenue will show up here once you get your first order.</p>
            </div>
          </div>
        </article>

        <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
          <h2 class="text-lg font-bold">Quick actions</h2>
          <p class="mt-1 text-sm text-muted-foreground">Get your store ready to share</p>
          <div class="mt-5 space-y-3">
            <a href="/dashboard/builder" class="group flex w-full items-center gap-3 rounded-md border border-border p-3 text-left transition-colors hover:border-primary/30 hover:bg-primary/5" style="text-decoration:none;color:inherit;">
              <span class="grid size-10 place-items-center rounded-md bg-muted text-foreground group-hover:bg-success-soft group-hover:text-success">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
              </span>
              <span class="flex-1">
                <strong class="block text-sm">Add what you sell</strong>
                <span class="text-xs text-muted-foreground">A course, booking, download or membership</span>
              </span>
            </a>
            <a href="/dashboard/builder" class="group flex w-full items-center gap-3 rounded-md border border-border p-3 text-left transition-colors hover:border-primary/30 hover:bg-primary/5" style="text-decoration:none;color:inherit;">
              <span class="grid size-10 place-items-center rounded-md bg-muted text-foreground group-hover:bg-success-soft group-hover:text-success">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.364 13.634a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506l4.013-4.009a1 1 0 0 0-3.004-3.004z"></path><path d="M14.487 7.858A1 1 0 0 1 14 7V2"></path><path d="M20 19.645V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l2.516 2.516"></path></svg>
              </span>
              <span class="flex-1">
                <strong class="block text-sm">Customize your store</strong>
                <span class="text-xs text-muted-foreground">Update your look, bio and handle</span>
              </span>
            </a>
            <a href="#" class="group flex w-full items-center gap-3 rounded-md border border-border p-3 text-left transition-colors hover:border-primary/30 hover:bg-primary/5" style="text-decoration:none;color:inherit;">
              <span class="grid size-10 place-items-center rounded-md bg-muted text-foreground group-hover:bg-success-soft group-hover:text-success">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" x2="16" y1="12" y2="12"></line></svg>
              </span>
              <span class="flex-1">
                <strong class="block text-sm">Share your store</strong>
                <span class="text-xs text-muted-foreground"><%= siteDomain %>/<%= user.handle %></span>
              </span>
            </a>
          </div>
          <div class="mt-6 rounded-md bg-warning-soft p-4">
            <div class="flex items-center gap-2 text-warning">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path></svg>
              <span class="text-xs font-bold uppercase">Before you share</span>
            </div>
            <p class="mt-2 text-sm leading-6 text-foreground">Add at least one product first — a store with something to buy converts far better than an empty one.</p>
          </div>
        </article>
      </section>

      <section class="mt-6 rounded-lg border border-border bg-card shadow-sm">
        <div class="flex items-center justify-between border-b border-border p-5 md:px-6">
          <div>
            <h2 class="text-lg font-bold">Recent orders</h2>
