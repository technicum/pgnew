<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<%# Shared dashboard pieces (save status, switches, swatches, cover
    controls, copy-link box) come from the lead magnet builder's sheet;
    the payment builder's own layout is payments-dashboard.css. %>
<link rel="stylesheet" href="/css/lead-magnets.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/payments-dashboard.css?v=<%= assetVersion %>" />
</head>
<body>
<div class="min-h-screen bg-background">

  <%- include('partials/dashboard-sidebar', { navActive: '/dashboard/payment-pages' }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <div>
        <p class="text-sm font-semibold text-primary" style="line-height:1;">Payment pages</p>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <span class="pz-save-status" id="saveStatus"><span class="dot"></span><span id="saveStatusText">Saved</span></span>
        <div class="mx-1 h-7 w-px bg-border"></div>
        <div class="flex items-center gap-2 rounded-md p-1.5">
          <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1120px] px-4 py-7 md:px-8 md:py-9">

      <section class="pb-page-head">
        <div>
          <p class="text-sm font-semibold text-primary">Get paid</p>
          <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Payment pages</h1>
          <p class="mt-2 text-sm text-muted-foreground" style="max-width:64ch;">One checkout link that can hold one product or several — a course plus a physical workbook, a bundle of downloads, anything. Mix digital and physical freely; the page only asks for a shipping address when it needs one.</p>
        </div>
        <button type="button" class="pb-primary pb-create-btn" data-open-create>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
          <span>Create payment page</span>
        </button>
      </section>

      <%- include('partials/payment-mode-note', { paymentMode: paymentMode }) %>

      <!-- Builder: hidden until "Create payment page" (after the type popup) or a page's Edit -->
      <section class="pb-grid" id="builderSection" hidden>
        <div class="pb-form rounded-lg border border-border bg-card shadow-sm">
          <div class="pb-builder-top">
            <button type="button" class="pb-back" id="builderBackBtn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              All payment pages
            </button>
          </div>
          <h2 class="text-lg font-bold" id="builderHeading">Create a payment page</h2>

          <!-- Page type: sets which product options the builder offers (payment-pages.js) -->
          <div class="pb-kind" id="ppKind" role="radiogroup" aria-label="Page type">
            <button type="button" class="pb-kind-opt active" data-kind="single" role="radio" aria-checked="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-3V5a3 3 0 0 0-6 0v2H8a1 1 0 0 0-1 .89L5.6 19.78A2 2 0 0 0 7.59 22h8.82a2 2 0 0 0 2-2.22L17 7.89A1 1 0 0 0 16 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
              Single product
            </button>
            <button type="button" class="pb-kind-opt" data-kind="multiple" role="radio" aria-checked="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Multiple products
            </button>
            <button type="button" class="pb-kind-opt" data-kind="coffee" role="radio" aria-checked="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
              Buy me a coffee
            </button>
          </div>

          <div class="pb-tabs" role="tablist">
            <button type="button" class="pb-tab active" data-tab="page" role="tab">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="11" height="4" rx="1"/></svg>
              <span id="tabPageLabel">Details</span>
            </button>
            <!-- Only on multi-product pages: a single product is edited right in Details. -->
            <button type="button" class="pb-tab" data-tab="products" role="tab" id="tabProductsBtn" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-3V5a3 3 0 0 0-6 0v2H8a1 1 0 0 0-1 .89L5.6 19.78A2 2 0 0 0 7.59 22h8.82a2 2 0 0 0 2-2.22L17 7.89A1 1 0 0 0 16 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
              Products <span class="pb-count" id="tabProductCount">1</span>
            </button>
            <button type="button" class="pb-tab" data-tab="design" role="tab">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Design
            </button>
          </div>

          <form id="pageForm" novalidate>
            <!-- Details tab. On a single-product or coffee page the product's own
                 settings (type, price, delivery, media) render into #soloProduct. -->
            <div class="pb-panel active" id="tab-page">
              <div class="pb-section">
                <p class="pb-section-title" id="ppBasicsTitle">Product</p>
                <div class="pb-option">
                  <label for="ppTitle" class="pb-label" id="ppTitleLabel">Product name</label>
                  <input type="text" id="ppTitle" class="pz-field-input" maxlength="200" placeholder="e.g. Notion Budget Planner" />
                </div>
                <div class="pb-option">
                  <label for="ppDescription" class="pb-label">Short description <span class="pz-option-hint">(optional)</span></label>
                  <textarea id="ppDescription" class="pz-field-input" rows="2" maxlength="1000" placeholder="A line or two under the name"></textarea>
                </div>
              </div>

              <div id="soloProduct"></div>

              <div class="pb-note" id="ppProductsNote" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span>Add your products in the <strong>Products</strong> tab. The shipping-address section only appears on the checkout page if at least one product there is Physical.</span>
              </div>

              <div class="pb-section">
                <p class="pb-section-title">Page content</p>
                <div class="pb-option">
                  <label for="ppAbout" class="pb-label">Full description <span class="pz-option-hint">(optional — shown as an “About” section on the page)</span></label>
                  <div class="pb-rich-editor">
                  <div class="pb-rich-toolbar" role="toolbar" aria-label="Formatting">
                    <button type="button" data-format="heading" title="Heading">H</button>
                    <button type="button" data-format="bold" title="Bold"><b>B</b></button>
                    <button type="button" data-format="italic" title="Italic"><i>I</i></button>
                    <span class="pb-rich-sep" aria-hidden="true"></span>
                    <button type="button" data-format="bullet" title="Bullet list">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg>
                    </button>
                    <button type="button" data-format="numbered" title="Numbered list">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 6h10M10 12h10M10 18h10"/><path d="M4 4h1v4M4 8h2"/><path d="M4 14h2l-2 4h2"/></svg>
                    </button>
                    <button type="button" data-format="link" title="Link">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    </button>
                  </div>
                  <textarea id="ppAbout" class="pz-field-input" rows="7" maxlength="5000" placeholder="What’s included, who it’s for, what happens after they pay…&#10;&#10;## What you’ll get&#10;- 8 modules, 12 lessons&#10;- **Lifetime** access"></textarea>
                </div>
                  <p class="pz-option-hint">Use the buttons, or type <code>## Heading</code>, <code>- list item</code>, <code>**bold**</code>, <code>*italic*</code> and <code>[text](https://…)</code>.</p>
                </div>
                <div class="pb-option">
                  <label for="ppSuccessMessage" class="pb-label">Thank-you message <span class="pz-option-hint">(optional — shown on the receipt)</span></label>
                  <textarea id="ppSuccessMessage" class="pz-field-input" rows="2" maxlength="300" placeholder="Leave blank for the default."></textarea>
                </div>
                <!-- Only while editing: new pages get a link from their headline. -->
                <div class="pb-option" id="ppSlugRow" hidden>
                  <label for="ppSlug" class="pb-label">Link</label>
                  <div class="pz-slug-field">
                    <span><%= storeUrlFor(user.handle).replace(/^https?:\/\//, '') %>/pay/</span>
                    <input type="text" id="ppSlug" maxlength="60" spellcheck="false" autocapitalize="off" />
                  </div>
                  <p class="pz-option-hint">Changing this breaks any link you’ve already shared.</p>
                </div>
              </div>
            </div>

            <!-- Products tab: one card per product (payment-pages.js) -->
            <div class="pb-panel" id="tab-products">
              <div class="pb-prod-list" id="prodList"></div>
              <button type="button" class="pb-add-product" id="addProductBtn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
                Add another product
              </button>
            </div>

            <!-- Design tab -->
            <div class="pb-panel" id="tab-design">
              <p class="pz-section-label">Accent color</p>
              <p class="pz-section-sub">Used across the whole payment page — header, price and buy button.</p>
              <div class="swatch-row" id="ppSwatchRow">
                <button type="button" class="swatch active" data-accent="#1261ef" style="background:#1261ef;" aria-label="Blue"></button>
                <button type="button" class="swatch" data-accent="#c0322a" style="background:#ff6c62;" aria-label="Coral"></button>
                <button type="button" class="swatch" data-accent="#12733f" style="background:#2fae6b;" aria-label="Green"></button>
                <button type="button" class="swatch" data-accent="#7048e8" style="background:#7048e8;" aria-label="Violet"></button>
                <button type="button" class="swatch" data-accent="#07134f" style="background:#07134f;" aria-label="Navy"></button>
                <span class="swatch swatch-custom" title="Custom color">
                  <input type="color" id="ppCustomColor" value="#1261ef" />
                </span>
              </div>
              <div class="pz-divider"></div>
              <p class="pz-section-label">Cover</p>
              <p class="pz-section-sub">The banner across the top, with your headline on it.</p>
              <div class="cover-choice cover-choice-wrap" id="ppCoverChoice">
                <button type="button" class="cover-opt active" data-cover="art">Artwork</button>
                <button type="button" class="cover-opt" data-cover="image">Image</button>
                <button type="button" class="cover-opt" data-cover="video">Video</button>
                <button type="button" class="cover-opt" data-cover="color">Color</button>
                <button type="button" class="cover-opt" data-cover="none">None</button>
              </div>
              <div class="pz-cover-media" id="ppCoverImagePanel" hidden>
                <div class="pz-cover-upload">
                  <label class="pz-card-btn pz-upload-btn">
                    <input type="file" id="ppCoverImageFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m6 10 6-6 6 6"/><path d="M5 20h14"/></svg>
                    <span>Upload image</span>
                  </label>
                  <button type="button" class="pz-cover-clear" data-clear="image">Remove</button>
                </div>
                <input type="text" id="ppCoverImage" class="pz-field-input pz-brand-input" maxlength="500" placeholder="…or paste an image link (https://…)" />
                <p class="pz-option-hint">JPG, PNG, WebP or GIF, up to 5 MB. 1500 × 750 fits the banner exactly.</p>
              </div>
              <div class="pz-cover-media" id="ppCoverVideoPanel" hidden>
                <div class="pz-cover-upload">
                  <label class="pz-card-btn pz-upload-btn">
                    <input type="file" id="ppCoverVideoFile" accept="video/mp4,video/webm" hidden />
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m6 10 6-6 6 6"/><path d="M5 20h14"/></svg>
                    <span>Upload video</span>
                  </label>
                  <button type="button" class="pz-cover-clear" data-clear="video">Remove</button>
                </div>
                <input type="text" id="ppCoverVideo" class="pz-field-input pz-brand-input" maxlength="500" placeholder="…or paste a link to an .mp4 (https://…)" />
                <p class="pz-option-hint">MP4 or WebM, up to 30 MB. Plays muted on a loop.</p>
              </div>
              <p class="pz-field-error" id="ppCoverError"></p>
              <div class="pz-cover-color" id="ppCoverColorRow" hidden>
                <span class="swatch swatch-custom" title="Banner background color">
                  <input type="color" id="ppCoverColor" value="#0a2f9e" />
                </span>
                <div>
                  <p class="pz-cover-color-label">Background color</p>
                  <p class="pz-option-hint" id="ppCoverColorHint">Matches your accent color.</p>
                </div>
                <button type="button" class="pz-cover-clear" id="ppCoverColorReset" hidden>Use accent</button>
              </div>
            </div>

            <div class="pb-actions">
              <button type="submit" class="pb-primary">
                <svg id="builderSubmitIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
                <span id="builderSubmitLabel">Create payment page</span>
              </button>
              <button type="button" class="pz-card-btn" id="builderCancelBtn" style="height:40px; padding:0 14px; font-size:13.5px;">Cancel</button>
            </div>
          </form>
          <p class="pz-field-error" id="pageFormError"></p>
        </div>

        <!-- Live preview: what buyers will see -->
        <div>
          <div class="pb-preview-head">
            <h2>Live preview</h2>
            <span>What buyers will see</span>
          </div>
          <div class="pb-preview-frame" id="ppPreviewFrame">
            <div class="pb-preview-chrome">
              <span></span><span></span><span></span>
              <span class="pb-preview-url" id="ppPreviewUrl"><%= storeUrlFor(user.handle).replace(/^https?:\/\//, '') %>/pay/…</span>
            </div>
            <div class="pb-preview-screen">
              <div class="pb-preview-top" id="ppPreviewTop">
                <img id="ppPreviewCoverImage" alt="" hidden />
                <video id="ppPreviewCoverVideo" muted loop autoplay playsinline hidden></video>
                <div class="pb-preview-top-text">
                  <span class="pb-kicker"><span></span>Secure checkout</span>
                  <h3 id="ppPreviewTitle">Your payment page</h3>
                </div>
              </div>
              <p class="pb-preview-desc" id="ppPreviewDesc" hidden></p>
              <div class="pb-preview-items" id="ppPreviewItems"></div>
              <div class="pb-preview-about" id="ppPreviewAbout" hidden>
                <span class="pb-preview-label">About</span>
                <div class="pb-preview-rich" id="ppPreviewAboutBody"></div>
              </div>
              <div class="pb-preview-body">
                <span class="pb-preview-label">Buyer details</span>
                <div class="pb-preview-input">Full name</div>
                <div class="pb-preview-input">you@example.com</div>
                <div class="pb-preview-ship" id="ppPreviewShip" hidden>
                  <div class="pb-preview-input">Address line</div>
                  <div class="pb-preview-ship-row">
                    <div class="pb-preview-input">City</div>
                    <div class="pb-preview-input">Pincode</div>
                  </div>
                  <div class="pb-preview-input">Phone number</div>
                </div>
                <div class="pb-preview-totals">
                  <div class="pb-preview-total-row"><span>Subtotal</span><span id="ppPreviewSubtotal">₹0</span></div>
                  <div class="pb-preview-total-row" id="ppPreviewShipRow" hidden><span>Shipping</span><span id="ppPreviewShipAmt">Free</span></div>
                  <div class="pb-preview-total-row grand"><span>Total</span><span id="ppPreviewTotal">₹0</span></div>
                </div>
                <div class="pb-preview-btn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                  <span id="ppPreviewBtnText">Pay ₹0</span>
                </div>
                <p class="pb-preview-secure">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Secure checkout
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-6 rounded-lg border border-border bg-card shadow-sm">
        <div class="pb-list-head">
          <div>
            <h2 class="text-lg font-bold">Your payment pages</h2>
            <p id="pageCountLine"></p>
          </div>
        </div>
        <div id="pagesList"><!-- injected --></div>
        <div id="emptyPages" class="flex flex-col items-center justify-center gap-3 p-6" style="padding:56px 24px; text-align:center;" hidden>
          <div class="grid size-10 place-items-center rounded-md bg-muted text-muted-foreground">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>
          </div>
          <p class="text-sm font-semibold">No payment pages yet</p>
          <p class="text-sm text-muted-foreground" style="max-width:360px;">Create one, then share the link anywhere — Instagram bio, WhatsApp, email.</p>
          <button type="button" class="pb-primary" data-open-create>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
            <span>Create payment page</span>
          </button>
        </div>
      </section>

      <section class="mt-6 rounded-lg border border-border bg-card shadow-sm" id="coupons">
        <div class="border-b border-border p-5 md:px-6">
          <h2 class="text-lg font-bold">Coupon codes</h2>
          <p class="mt-1 text-sm text-muted-foreground">Discounts buyers enter at checkout — taken off the products, not shipping. A code counts as used once its order is paid.</p>
          <form id="couponForm" class="pp-coupon-form" novalidate>
            <input type="text" id="couponCode" class="pz-field-input" maxlength="30" placeholder="Code, e.g. LAUNCH20" autocapitalize="characters" spellcheck="false" />
            <div class="pp-coupon-discount">
              <input type="text" inputmode="decimal" id="couponValue" class="pz-field-input" placeholder="20" aria-label="Discount amount" />
              <select id="couponType" class="pz-field-input" aria-label="Discount type">
                <option value="percent">% off</option>
                <option value="flat">₹ off</option>
              </select>
            </div>
            <select id="couponPage" class="pz-field-input" aria-label="Applies to">
              <option value="">All payment pages</option>
            </select>
            <input type="number" id="couponMaxUses" class="pz-field-input" min="1" placeholder="Max uses (optional)" />
            <input type="date" id="couponExpires" class="pz-field-input" aria-label="Expiry date (optional)" title="Expiry date (optional)" />
            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-9 px-4">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
              Add code
            </button>
          </form>
          <p class="pz-field-error" id="couponFormError"></p>
        </div>
        <div id="couponsList"><!-- injected --></div>
        <p class="pp-empty-line" id="emptyCoupons" hidden>No coupon codes yet.</p>
      </section>

    </div>
  </main>
</div>

<!-- "Create payment page" popup: what kind of page, before the builder opens (payment-pages.js) -->
<div class="pz-modal-backdrop" id="kindModal" aria-hidden="true">
  <div class="pz-modal" role="dialog" aria-modal="true" aria-labelledby="kindModalTitle">
    <div class="pz-modal-head">
      <div>
        <h3 id="kindModalTitle">Create a payment page</h3>
        <p>What do you want to sell on this page?</p>
      </div>
      <button type="button" class="pz-modal-close" id="kindModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="pb-kind-modal">
      <button type="button" class="pb-kind-tile" data-pick-kind="single">
        <span class="pb-kind-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-3V5a3 3 0 0 0-6 0v2H8a1 1 0 0 0-1 .89L5.6 19.78A2 2 0 0 0 7.59 22h8.82a2 2 0 0 0 2-2.22L17 7.89A1 1 0 0 0 16 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg></span>
        <span class="pb-kind-text"><strong>Single product</strong><span>One digital download or physical item.</span></span>
      </button>
      <button type="button" class="pb-kind-tile" data-pick-kind="multiple">
        <span class="pb-kind-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
        <span class="pb-kind-text"><strong>Multiple products</strong><span>A bundle or a mix — up to 10 products on one checkout.</span></span>
      </button>
      <button type="button" class="pb-kind-tile" data-pick-kind="coffee">
        <span class="pb-kind-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg></span>
        <span class="pb-kind-text"><strong>Buy me a coffee</strong><span>Let supporters pay per coffee — no product needed.</span></span>
      </button>
    </div>
  </div>
</div>

<script>
  window.__PZ_PAYMENT_PAGES__ = <%- JSON.stringify(pages).replace(/</g, '\\u003c') %>;
  window.__PZ_COUPONS__ = <%- JSON.stringify(coupons).replace(/</g, '\\u003c') %>;
  window.__PZ_STORE_URL__ = <%- JSON.stringify(storeUrlFor(user.handle)) %>;
</script>
<script src="/js/payment-pages.js?v=<%= assetVersion %>"></script>
</body>
</html>
