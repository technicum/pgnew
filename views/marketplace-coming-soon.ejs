<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · PageZaper</title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .mp-wrap {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 24px;
    }
    .mp-logo { font-size: 1.3rem; font-weight: 800; margin-bottom: 28px; }
    .mp-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 10px;
    }
    .mp-wrap h1 { font-size: 2rem; margin: 0 0 12px; letter-spacing: -0.02em; }
    .mp-wrap p { color: var(--color-muted); max-width: 420px; margin: 0 auto 28px; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="mp-wrap">
    <div class="mp-logo">PageZaper</div>
    <div class="mp-eyebrow"><%= eyebrow %></div>
    <h1>Coming soon</h1>
    <p><%= description %></p>
    <a href="<%= rootUrl %>" class="btn btn-primary">Back to PageZaper</a>
  </div>
</body>
</html>
