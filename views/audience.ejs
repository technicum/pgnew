<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#fbfaf6" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="<%= siteName %>" />
<link rel="manifest" href="/manifest.webmanifest" />
<%- include('partials/brand-icon') %>
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/audience.css?v=<%= assetVersion %>" />
</head>
<body>
<div class="min-h-screen bg-background">

  <%- include('partials/dashboard-sidebar', { navActive: '/dashboard/audience' }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <div class="ml-auto flex items-center gap-2">
        <span class="pz-save-status" id="saveStatus"><span class="dot"></span><span id="saveStatusText">Saved</span></span>
        <%- include('partials/dashboard-header-help') %>
        <div class="mx-1 h-7 w-px bg-border"></div>
        <div class="flex items-center gap-2 rounded-md p-1.5">
          <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1100px] px-4 py-7 md:px-8 md:py-9">

      <%# Heading with the page's two actions. Stats, the add panel and the list are kept current by audience.js. %>
      <section class="pz-aud-head">
        <div>
          <p class="text-sm font-semibold text-primary">Audience</p>
          <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Your people</h1>
          <p class="mt-2 text-sm text-muted-foreground">Everyone who's booked, bought or been added by hand — one list you own, not locked inside a social platform.</p>
        </div>
        <div class="pz-aud-actions">
          <!-- A CSV of the people shown — everyone, or just those matching the search / filters (audience.js). -->
          <button type="button" id="exportContacts" class="pz-aud-btn"<%= contacts.length ? '' : ' disabled' %>>
            <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
            <span id="exportContactsLabel">Export CSV</span>
          </button>
          <button type="button" id="openAddContact" class="pz-aud-btn pz-aud-btn-primary" aria-expanded="<%= contacts.length ? 'false' : 'true' %>" aria-controls="addContactPanel">
            <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg>
            Add person
          </button>
        </div>
      </section>

      <dl class="pz-aud-stats" aria-label="Audience at a glance">
        <div><dt>People</dt><dd id="statTotal">0</dd></div>
        <div><dt>With email</dt><dd id="statEmail">0</dd></div>
        <div><dt>With phone</dt><dd id="statPhone">0</dd></div>
        <div><dt>New in 30 days</dt><dd id="statNew">0</dd></div>
      </dl>

      <section class="pz-aud-panel pz-aud-add" id="addContactPanel"<%= contacts.length ? ' hidden' : '' %>>
        <div class="pz-aud-add-head">
          <div>
            <h2>Add someone</h2>
            <p>A name plus an email or phone number — enough to actually reach them later.</p>
          </div>
          <button type="button" class="pz-icon-btn" id="closeAddContact" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <form id="addContactForm" class="pz-aud-form">
          <label class="pz-aud-field"><span>Name</span><input type="text" id="contactName" class="pz-field-input" placeholder="Priya Sharma" required /></label>
          <label class="pz-aud-field"><span>Email</span><input type="email" id="contactEmail" class="pz-field-input" placeholder="priya@example.com" /></label>
          <label class="pz-aud-field"><span>Phone</span><input type="text" id="contactPhone" class="pz-field-input" placeholder="+91 98765 43210" /></label>
          <label class="pz-aud-field"><span>Note <small>optional</small></span><input type="text" id="contactNote" class="pz-field-input" placeholder="Met at the Pune workshop" /></label>
          <div class="pz-aud-form-foot">
            <p class="pz-field-error" id="contactFormError"></p>
            <button type="submit" class="pz-aud-btn pz-aud-btn-primary">Add to audience</button>
          </div>
        </form>
      </section>

      <section class="pz-aud-panel">
        <div class="pz-aud-list-head">
          <h2>People</h2>
          <p id="contactCountLine"><%= contacts.length %> <%= contacts.length === 1 ? 'person' : 'people' %> in your audience</p>
        </div>

        <!-- Search + filters, all client-side over the list below (audience.js). -->
        <div class="pz-audience-tools">
          <div class="pz-audience-search">
            <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
            <input type="search" id="contactSearch" class="pz-field-input" placeholder="Search by name, email, phone or note…" aria-label="Search people" />
          </div>
          <select id="contactSourceFilter" class="pz-field-input pz-audience-select" aria-label="Filter by source">
            <option value="">All sources</option>
          </select>
          <select id="contactReachFilter" class="pz-field-input pz-audience-select" aria-label="Filter by contact info">
            <option value="">Any contact info</option>
            <option value="email">Has email</option>
            <option value="phone">Has phone</option>
            <option value="both">Has email and phone</option>
          </select>
          <button type="button" class="pz-audience-clear" id="contactClearFilters" hidden>Clear</button>
        </div>

        <div id="contactsList"><!-- injected --></div>

        <div id="emptyContacts" class="pz-aud-empty" style="display:none;">
          <span class="pz-aud-empty-icon">
            <svg viewBox="0 0 24 24" fill="none" width="22" height="22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>
          </span>
          <p class="pz-aud-empty-title" id="emptyContactsTitle">No one here yet</p>
          <p class="pz-aud-empty-sub" id="emptyContactsSub">Add the first person above, or come back once someone books or buys from your store.</p>
        </div>
      </section>

    </div>
  </main>
</div>

<script>
  window.__PZ_INITIAL_CONTACTS__ = <%- JSON.stringify(contacts).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/audience.js?v=<%= assetVersion %>"></script>
</body>
</html>
