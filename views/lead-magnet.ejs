<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<% if (magnet.description) { %><meta name="description" content="<%= magnet.description %>" /><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css" />
<link rel="stylesheet" href="/css/auth.css" />
<link rel="stylesheet" href="/css/lead-magnet.css" />
</head>
<%
// Per-magnet accent (Design tab in the builder) — falls back to the
// site's own blue when a magnet predates the column or wasn't customized.
function shade(hex, amount) {
  var num = parseInt(hex.slice(1), 16);
  var r = Math.min(255, Math.max(0, (num >> 16) + amount));
  var g = Math.min(255, Math.max(0, ((num >> 8) & 0xff) + amount));
  var b = Math.min(255, Math.max(0, (num & 0xff) + amount));
  return '#' + [r, g, b].map(function (c) { return c.toString(16).padStart(2, '0'); }).join('');
}
var lmAccent = /^#[0-9a-f]{6}$/i.test(magnet.accent_color) ? magnet.accent_color : '#1261ef';
var lmAccentDark = shade(lmAccent, -60);
var lmShowCover = magnet.show_cover === undefined || !!magnet.show_cover;
%>
<body class="lm-page" style="--magnet-accent:<%= lmAccent %>; --magnet-accent-dark:<%= lmAccentDark %>;">

<div class="lm-top">
  <a href="/" class="logo">
    <span class="logo-mark">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12.5L10 17L19 7" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <%= siteName %>
  </a>
</div>

<div class="lm-wrap">

  <div class="lm-visual">
    <span class="lm-kicker"><span class="dot"></span>Free download</span>
    <h1><%= magnet.title %></h1>
    <% if (magnet.description) { %><p class="lm-desc"><%= magnet.description %></p><% } %>

    <div class="lm-offer-row<%= lmShowCover ? '' : ' lm-offer-row--no-cover' %>">
      <% if (lmShowCover) { %>
      <div class="lm-cover" aria-hidden="true">
        <div class="lm-cover-bar"></div>
        <div class="lm-cover-line"></div>
        <div class="lm-cover-line"></div>
        <div class="lm-cover-line short"></div>
        <div class="lm-cover-badge">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12"/><path d="M6 12l6 6 6-6"/><path d="M5 20h14"/></svg>
        </div>
      </div>
      <% } %>
      <div class="lm-owner-row">
        <span class="lm-owner-avatar"><%= owner.name.charAt(0).toUpperCase() %></span>
        <span>Made by <strong style="color:#fff;"><%= owner.name %></strong></span>
      </div>
    </div>
  </div>

  <div class="lm-form-panel">
    <div class="lm-form-card">
      <p class="lm-eyebrow">Get instant access</p>
      <h2>Where should we send it?</h2>
      <p class="lm-sub">No spam — just the download, from <%= owner.name %>.</p>

      <% if (error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/<%= magnet.slug %>" novalidate>
        <% if (magnet.collect_name) { %>
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" value="<%= values.name %>" placeholder="Full name" autocomplete="name" required />
        </div>
        <% } %>
        <% if (magnet.collect_email) { %>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= values.email %>" placeholder="you@example.com" autocomplete="email" required />
        </div>
        <% } %>
        <% if (magnet.collect_phone) { %>
        <div class="field">
          <label for="phone">Phone<% if (magnet.collect_email) { %> <span style="font-weight:400; color:var(--muted);">(optional)</span><% } %></label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone %>" placeholder="Phone number" autocomplete="tel"<%= magnet.collect_email ? '' : ' required' %> />
        </div>
        <% } %>
        <% (magnet.extra_questions || []).forEach(function (q) { %>
        <div class="field">
          <label for="q_<%= q.id %>"><%= q.label %><% if (!q.required) { %> <span style="font-weight:400; color:var(--muted);">(optional)</span><% } %></label>
          <input type="<%= q.type === 'number' ? 'number' : 'text' %>" id="q_<%= q.id %>" name="q_<%= q.id %>" value="<%= (values.extra && values.extra[q.id]) || '' %>"<%= q.required ? ' required' : '' %> />
        </div>
        <% }) %>
        <button type="submit" class="btn btn-primary"><%= magnet.cta_text %></button>
      </form>

      <p class="lm-privacy">Your details go only to <%= owner.name %> — never sold, never spammed.</p>
    </div>
  </div>

</div>

</body>
</html>
