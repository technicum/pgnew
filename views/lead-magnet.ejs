<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<% if (magnet.description) { %><meta name="description" content="<%= magnet.description %>" /><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css" />
<link rel="stylesheet" href="/css/auth.css" />
<link rel="stylesheet" href="/css/lead-magnet.css?v=<%= assetVersion %>" />
</head>
<%
var lmShowCover = magnet.show_cover === undefined || !!magnet.show_cover;
// Top of the page (Design tab): the merchant's logo, their brand name as
// text, or — with neither set — the PageZaper mark.
var lmBrandText = String(magnet.brand_text || '').trim();
var lmBrandLogo = magnet.brand_type === 'logo' && /^https?:\/\//i.test(magnet.brand_logo_url || '') ? magnet.brand_logo_url : '';
%>
<body class="lm-page" style="<%= lmThemeStyle(magnet) %>">

<main class="lm-shell">

  <div class="lm-head">
    <% if (lmBrandLogo) { %>
    <a href="/" class="lm-brand lm-brand-logo">
      <img src="<%= lmBrandLogo %>" alt="<%= lmBrandText || owner.name %>" />
    </a>
    <% } else if (lmBrandText) { %>
    <a href="/" class="logo lm-brand"><%= lmBrandText %></a>
    <% } else { %>
    <a href="/" class="logo lm-brand">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12.5L10 17L19 7" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <%= siteName %>
    </a>
    <% } %>
  </div>

  <article class="lm-card">
    <%# With a cover the heading sits on it; with the cover off it opens the card body. %>
    <% if (lmShowCover) { %>
    <header class="lm-hero">
      <%- include('partials/lm-banner') %>
      <div class="lm-hero-text">
        <span class="lm-kicker"><span class="dot"></span>Free download</span>
        <h1><%= magnet.title %></h1>
        <% if (magnet.description) { %><p class="lm-desc"><%= magnet.description %></p><% } %>
      </div>
    </header>
    <% } %>

    <div class="lm-card-body">
      <% if (!lmShowCover) { %>
      <span class="lm-kicker"><span class="dot"></span>Free download</span>
      <h1><%= magnet.title %></h1>
      <% if (magnet.description) { %><p class="lm-desc"><%= magnet.description %></p><% } %>
      <% } %>

      <% if (error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/<%= magnet.slug %>" novalidate>
        <% if (magnet.collect_name) { %>
        <div class="field">
          <label for="name">What's your name?<span class="lm-req" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" value="<%= values.name %>" placeholder="Full name" autocomplete="name" required />
        </div>
        <% } %>
        <% if (magnet.collect_email) { %>
        <div class="field">
          <label for="email">Your email<span class="lm-req" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" value="<%= values.email %>" placeholder="you@example.com" autocomplete="email" required />
        </div>
        <% } %>
        <% if (magnet.collect_phone) { %>
        <div class="field">
          <label for="phone">Your phone number<% if (magnet.collect_email) { %> <span class="lm-opt">(optional)</span><% } else { %><span class="lm-req" aria-hidden="true">*</span><% } %></label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone %>" placeholder="Phone number" autocomplete="tel"<%= magnet.collect_email ? '' : ' required' %> />
        </div>
        <% } %>
        <%
        // Question type (Form tab in the builder) -> the input it renders as.
        var qInputTypes = { number: 'number', email: 'email', phone: 'tel', url: 'url', date: 'date' };
        (magnet.extra_questions || []).forEach(function (q) {
          var qValue = (values.extra && values.extra[q.id]) || '';
          var qOptions = q.options || [];
          // Several ticked checkboxes come back as one "A, B" answer.
          var qPicked = q.type === 'checkboxes' ? qValue.split(', ') : [qValue];
        %>
        <% if (q.type === 'checkbox') { %>
        <div class="field">
          <label class="lm-check" for="q_<%= q.id %>">
            <input type="checkbox" id="q_<%= q.id %>" name="q_<%= q.id %>" value="Yes"<%= qValue ? ' checked' : '' %><%= q.required ? ' required' : '' %> />
            <span><%= q.label %><% if (q.required) { %><span class="lm-req" aria-hidden="true">*</span><% } else { %> <span class="lm-opt">(optional)</span><% } %></span>
          </label>
        </div>
        <% } else if ((q.type === 'radio' || q.type === 'checkboxes') && qOptions.length) { %>
        <div class="field" role="group" aria-labelledby="q_<%= q.id %>_label">
          <span class="lm-group-label" id="q_<%= q.id %>_label"><%= q.label %><% if (q.required) { %><span class="lm-req" aria-hidden="true">*</span><% } else { %> <span class="lm-opt">(optional)</span><% } %></span>
          <div class="lm-choices">
            <% qOptions.forEach(function (opt, i) { %>
            <label class="lm-check" for="q_<%= q.id %>_<%= i %>">
              <input type="<%= q.type === 'radio' ? 'radio' : 'checkbox' %>" id="q_<%= q.id %>_<%= i %>" name="q_<%= q.id %>" value="<%= opt %>"<%= qPicked.indexOf(opt) !== -1 ? ' checked' : '' %> />
              <span><%= opt %></span>
            </label>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <div class="field">
          <label for="q_<%= q.id %>"><%= q.label %><% if (q.required) { %><span class="lm-req" aria-hidden="true">*</span><% } else { %> <span class="lm-opt">(optional)</span><% } %></label>
          <% if (qOptions.length) { %>
          <select id="q_<%= q.id %>" name="q_<%= q.id %>"<%= q.required ? ' required' : '' %>>
            <option value="">Choose…</option>
            <% qOptions.forEach(function (opt) { %>
            <option value="<%= opt %>"<%= opt === qValue ? ' selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>
          <% } else { %>
          <input type="<%= qInputTypes[q.type] || 'text' %>" id="q_<%= q.id %>" name="q_<%= q.id %>" value="<%= qValue %>"<%= q.required ? ' required' : '' %> />
          <% } %>
        </div>
        <% } %>
        <% }) %>
        <button type="submit" class="btn btn-primary"><%= magnet.cta_text %></button>
      </form>
    </div>

    <p class="lm-card-foot">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="13" height="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      <span>By continuing, you agree to receive updates from <%= owner.name %>. Never sold, never spammed.</span>
    </p>
  </article>

  <%- include('partials/lm-made-with') %>

</main>

</body>
</html>
