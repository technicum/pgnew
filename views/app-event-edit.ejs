<%# Edit one event (lib/appDashboard.js → /dashboard/events/:id) — a full-screen editor like the payment page builder (public/css/studio.css): three tabs on the left (Details: name, when, cover, tickets (free / paid), where, description; Attendees: who's going, paid / awaiting payment, mark paid (manual payments), cancel; Settings: seats, link, visibility, delete), the event page's live preview on the right — the real event page, drawn by the server from the unsaved fields (lib/livePreview.js, public/js/live-preview.js).
    Details and Settings are one form (the Save bar); "Save & publish" (on a hidden event) also turns it live. An attendee's Mark paid / Cancel posts its own form (#rsvpAction). %>
<%- include('partials/studio-head') %>
<% var link = storeUrlFor(user.handle) + '/event/' + event.slug;
var going = rsvps.filter(function (r) { return r.status === 'going'; });
var base = '/dashboard/events/' + event.id;
var online = event.mode !== 'venue'; %>
<div class="st">
  <aside class="st-panel">
    <div class="st-top">
      <a class="st-close" href="/dashboard/events" aria-label="Close editor" title="Back to your events">✕</a>
      <div class="st-top-title"><b><%= event.title %></b><small>Event · <a href="<%= link %>" target="_blank" rel="noopener" style="color:inherit">open page ↗</a></small></div>
      <span class="st-live<%= event.visible ? ' is-on' : '' %>"><%= event.visible ? 'Live' : 'Hidden' %></span>
    </div>
    <nav class="st-tabs" role="tablist" aria-label="Editor sections">
      <button type="button" role="tab" data-st-tab="details" aria-selected="true">Details</button>
      <button type="button" role="tab" data-st-tab="attendees" aria-selected="false">Attendees (<%= going.length %>)</button>
      <button type="button" role="tab" data-st-tab="settings" aria-selected="false">Settings</button>
    </nav>

    <form class="st-form" method="POST" action="<%= base %>" data-pv-form>
      <div class="st-scroll">
        <% if (flash) { %><div class="ax-flash ax-flash-<%= flash.kind %>" role="status"><%= flash.text %></div><% } %>

        <%# --- Details --- %>
        <div data-st-panel="details">
          <div class="st-intro"><h2>Set up your event</h2><p>What it is, when, and where it happens.</p></div>
          <section class="ax-panel">
            <div class="ax-grid">
              <label class="ax-field"><span>Event name</span><input class="ax-input" name="title" value="<%= event.title %>" required maxlength="200" placeholder="Live Q&amp;A: pricing your first product" data-st-name /></label>
              <label class="ax-field"><span>Date</span><input class="ax-input" type="date" name="date" value="<%= event.date %>" required /></label>
              <div class="st-pair">
                <label class="ax-field"><span>Starts (IST)</span><input class="ax-input" type="time" name="start_time" value="<%= event.start_time %>" required /></label>
                <label class="ax-field"><span>Ends <small>optional</small></span><input class="ax-input" type="time" name="end_time" value="<%= event.end_time %>" /></label>
              </div>
              <%- include('partials/ax-image-field', { name: 'cover_url', label: 'Cover image <small>(optional)</small>', value: event.cover_url, hint: '1500 × 700 works well — a poster, the venue, or you on stage.' }) %>
            </div>
          </section>

          <%# Tickets — pricing (free / paid) and price in rupees (lib/events.js eventFields: Free saves 0). %>
          <section class="ax-panel">
            <div class="ax-panel-head"><h2>Tickets</h2></div>
            <div class="st-cards">
              <label class="st-card"><input type="radio" name="pricing" value="free"<%= event.price ? '' : ' checked' %> /><span class="st-card-ico">🎟️</span><span><b>Free</b><small>People register with their name and email</small></span></label>
              <label class="st-card"><input type="radio" name="pricing" value="paid"<%= event.price ? ' checked' : '' %> /><span class="st-card-ico">💳</span><span><b>Paid ticket</b><small>They pay to get their seat — and the join link</small></span></label>
            </div>
            <div class="ax-grid" data-pricing-show="paid" style="margin-top:14px">
              <label class="ax-field"><span>Ticket price</span><span class="st-affix"><i class="pre">₹</i><input class="ax-input has-pre" name="price" value="<%= event.price ? String(event.price / 100) : '' %>" inputmode="decimal" placeholder="499" /></span></label>
            </div>
            <p class="ax-hint" data-pricing-show="paid" style="margin-top:10px">
              <% if (paymentMode === 'test') { %><b>Test mode</b> — buyers see a “Complete test payment” step and nothing is charged.
              <% } else if (paymentMode === 'cashfree' || paymentMode === 'razorpay') { %><b>Collected online</b> — buyers pay through <%= paymentMode === 'razorpay' ? 'Razorpay' : 'Cashfree' %> and get their ticket straight away.
              <% } else { %><b>Manual payments</b> — the seat is held while they pay you; mark it paid under Attendees.<% } %>
              Unpaid seats are freed after 30 minutes.
            </p>
          </section>

          <section class="ax-panel">
            <div class="ax-panel-head"><h2>Where it happens</h2></div>
            <div class="st-cards">
              <label class="st-card"><input type="radio" name="mode" value="online"<%= online ? ' checked' : '' %> /><span class="st-card-ico">🎥</span><span><b>Online</b><small>Webinar or video call — Google Meet, Zoom…</small></span></label>
              <label class="st-card"><input type="radio" name="mode" value="venue"<%= online ? '' : ' checked' %> /><span class="st-card-ico">📍</span><span><b>At a venue</b><small>A studio, café, hall…</small></span></label>
            </div>
            <div class="ax-grid" style="margin-top:14px">
              <label class="ax-field"><span data-where-label><%= online ? 'Join link' : 'Venue address' %></span><input class="ax-input" name="location" value="<%= event.location %>" maxlength="500" placeholder="<%= online ? 'https://meet.google.com/…' : 'Studio 4, 12 MG Road, Bengaluru' %>" />
                <small data-where-hint><%= online ? 'Only shown to people who’ve registered.' : 'Shown on the page.' %></small></label>
            </div>
          </section>

          <section class="ax-panel">
            <div class="ax-grid">
              <%- include('partials/ax-rich-field', { name: 'description', label: 'Description', value: event.description, rows: 7, maxlength: 2000, placeholder: 'What happens, who it’s for, what to bring…' }) %>
            </div>
          </section>
        </div>

        <%# --- Attendees --- %>
        <div data-st-panel="attendees" id="attendees" hidden>
          <% var paidIn = going.reduce(function (sum, r) { return sum + (r.order_id ? r.amount : 0); }, 0); %>
          <div class="st-intro"><h2>Attendees</h2><p><%= going.length %><%= event.capacity ? ' of ' + event.capacity : '' %> going<%= paidIn ? ' · ' + formatINR(paidIn) + ' in ticket sales' : '' %>. Everyone who registers also lands in your Audience.</p></div>
          <section class="ax-panel">
            <% if (!rsvps.length) { %>
            <p class="ax-empty">No one yet. Share the link to get your first <%= event.price ? 'ticket sale' : 'RSVP' %>.</p>
            <% } else { %>
            <ul class="ax-list">
              <% rsvps.forEach(function (r) { %>
              <li class="ax-row<%= r.status === 'cancelled' ? ' is-off' : '' %>">
                <div class="ax-main"><b><%= r.name %></b> <span class="ax-sub ax-block"><a href="mailto:<%= r.email %>"><%= r.email %></a><%= r.phone ? ' · ' + r.phone : '' %></span></div>
                <% if (r.status === 'cancelled') { %>
                <span class="ax-pill">Cancelled</span>
                <% } else if (r.status === 'pending') { %>
                <span class="ax-pill ax-pill-warn">Awaiting <%= formatINR(r.amount) %></span>
                <% if (paymentMode !== 'cashfree' && paymentMode !== 'razorpay') { %><button class="ax-btn" form="rsvpAction" formaction="<%= base %>/rsvps/<%= r.id %>/paid" data-confirm="Paid? Confirm">Mark paid</button><% } %>
                <button class="ax-btn ax-btn-quiet" form="rsvpAction" formaction="<%= base %>/rsvps/<%= r.id %>/cancel" data-confirm="Cancel it?">Cancel</button>
                <% } else { %>
                <% if (r.order_id) { %><span class="ax-pill">Paid <%= formatINR(r.amount) %></span><% } %>
                <button class="ax-btn ax-btn-quiet" form="rsvpAction" formaction="<%= base %>/rsvps/<%= r.id %>/cancel" data-confirm="Cancel RSVP?">Cancel</button>
                <% } %>
              </li>
              <% }) %>
            </ul>
            <% } %>
            <% if (going.some(function (r) { return r.order_id; })) { %><p class="ax-hint" style="margin-top:10px">Cancelling a paid ticket here doesn’t refund it — refund them yourself, then cancel.</p><% } %>
          </section>
        </div>

        <%# --- Settings --- %>
        <div data-st-panel="settings" hidden>
          <div class="st-intro"><h2>Settings</h2><p>Seats, link and who can find it.</p></div>
          <section class="ax-panel">
            <div class="ax-panel-head"><h2>Seats</h2></div>
            <div class="ax-grid">
              <label class="ax-field"><span>Seats <small>0 = no limit</small></span><input class="ax-input" type="number" name="capacity" value="<%= event.capacity %>" min="0" max="100000" />
                <small>Registration closes once they’re taken.</small></label>
            </div>
          </section>

          <section class="ax-panel">
            <div class="ax-panel-head"><h2>Link</h2></div>
            <div class="ax-grid">
              <label class="ax-field"><span>Link ending</span><input class="ax-input" name="slug" value="<%= event.slug %>" maxlength="60" pattern="[a-z0-9-]+" />
                <small><%= storeUrlFor(user.handle).replace(/^https?:\/\//, '') %>/event/<b><%= event.slug %></b> · <button type="button" class="ax-btn ax-btn-quiet" style="height:auto;padding:0" data-copy="<%= link %>">Copy link</button></small></label>
            </div>
          </section>

          <section class="ax-panel">
            <div class="ax-panel-head"><h2>Visibility</h2></div>
            <div class="st-cards">
              <label class="ax-check"><input type="checkbox" name="visible" value="1"<%= event.visible ? ' checked' : '' %> /> <span>Page is live <small class="ax-sub">— people with the link can register</small></span></label>
              <label class="ax-check"><input type="checkbox" name="marketplace" value="1"<%= event.marketplace ? ' checked' : '' %> /> <span>List on the <%= siteName %> marketplace <small class="ax-sub">— people browsing <a href="/explore" target="_blank" rel="noopener">Explore</a> can find it</small></span></label>
            </div>
          </section>

          <section class="ax-panel ax-danger" style="display:block">
            <p style="margin:0 0 10px">Deleting the event takes its page down and removes its attendee list. They stay in your Audience.</p>
            <button class="ax-btn ax-btn-danger" form="deleteEvent" data-confirm="Click again to delete">Delete event</button>
          </section>
        </div>
      </div>

      <div class="st-foot" data-st-foot="details settings">
        <small>Changes show in the preview — save to publish them.</small>
        <div class="st-foot-btns">
          <% if (event.visible) { %>
          <button class="st-save">Save changes</button>
          <% } else { %>
          <button class="st-save is-quiet">Save draft</button>
          <button class="st-save" name="publish" value="1">Save &amp; publish</button>
          <% } %>
        </div>
      </div>
    </form>
    <form id="deleteEvent" method="POST" action="<%= base %>/delete" hidden></form>
    <form id="rsvpAction" method="POST" hidden></form>
  </aside>

  <main class="st-canvas">
    <div class="st-canvas-head">
      <h2>Preview<small>What visitors see — updates as you type</small></h2>
      <div class="st-devices" role="group" aria-label="Preview size">
        <button type="button" data-st-view="desktop" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>Desktop</button>
        <button type="button" data-st-view="mobile" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>Mobile</button>
      </div>
    </div>
    <p class="lp-status" data-live-status hidden></p>
    <div class="st-device is-desktop" data-st-device>
      <div class="st-chrome"><i></i><i></i><i></i><span class="st-url"><%= link.replace(/^https?:\/\//, '') %></span></div>
      <div class="st-screen lp-box" data-live-preview="C:/Program Files/Git/dashboard/events/<%= event.id %>/preview"></div>
    </div>
  </main>
</div>

<script>
  (function () {
    // Where: the one location field is a join link online, an address at a venue.
    var input = document.querySelector('input[name="location"]');
    var label = document.querySelector('[data-where-label]');
    var hint = document.querySelector('[data-where-hint]');
    document.querySelectorAll('input[name="mode"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        var online = radio.value === 'online';
        label.textContent = online ? 'Join link' : 'Venue address';
        hint.textContent = online ? 'Only shown to people who’ve registered.' : 'Shown on the page.';
        input.placeholder = online ? 'https://meet.google.com/…' : 'Studio 4, 12 MG Road, Bengaluru';
      });
    });
    // Tickets: the price only shows for a paid ticket.
    var syncPricing = function () {
      var picked = (document.querySelector('input[name="pricing"]:checked') || {}).value;
      document.querySelectorAll('[data-pricing-show]').forEach(function (el) { el.hidden = el.getAttribute('data-pricing-show') !== picked; });
    };
    document.querySelectorAll('input[name="pricing"]').forEach(function (r) { r.addEventListener('change', syncPricing); });
    syncPricing();
    // A brand-new event starts on its name.
    var name = document.querySelector('[data-st-name]');
    if (name && name.value === 'Untitled event') { name.focus(); name.select(); }
  })();
</script>
<%- include('partials/studio-bottom') %>
