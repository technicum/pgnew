<%# Edit one event (lib/appDashboard.js → /dashboard/events/:id): details, place, seats, visibility, the attendee list, delete. %>
<%- include('partials/app-dash-top', { navActive: '/dashboard/events', section: 'Events', heading: event.title, back: { href: '/dashboard/events', label: 'All events' } }) %>
<% var link = storeUrlFor(user.handle) + '/event/' + event.slug; var going = rsvps.filter(function (r) { return r.status === 'going'; }); %>

<div class="ax-linkbar">
  <span>Event link</span>
  <a href="<%= link %>" target="_blank" rel="noopener"><%= link.replace(/^https?:\/\//, '') %></a>
  <button type="button" class="ax-btn ax-btn-quiet" data-copy="<%= link %>">Copy</button>
</div>

<form method="POST" action="/dashboard/events/<%= event.id %>">
  <section class="ax-panel">
    <div class="ax-panel-head"><h2>Details</h2></div>
    <div class="ax-grid">
      <label class="ax-field ax-span-3"><span>Name</span><input class="ax-input" name="title" value="<%= event.title %>" required maxlength="200" /></label>
      <label class="ax-field"><span>Date</span><input class="ax-input" type="date" name="date" value="<%= event.date %>" required /></label>
      <label class="ax-field"><span>Starts (IST)</span><input class="ax-input" type="time" name="start_time" value="<%= event.start_time %>" required /></label>
      <label class="ax-field"><span>Ends <small>(optional)</small></span><input class="ax-input" type="time" name="end_time" value="<%= event.end_time %>" /></label>
      <label class="ax-field ax-span-3"><span>Description</span><textarea class="ax-input" name="description" rows="5" maxlength="2000" placeholder="What happens, who it’s for, what to bring…"><%= event.description %></textarea>
        <small>**bold**, *italic*, “- ” for bullets and [text](https://…) for links.</small></label>
      <label class="ax-field"><span>Where</span>
        <select class="ax-input" name="mode">
          <option value="online"<%= event.mode === 'online' ? ' selected' : '' %>>Online</option>
          <option value="venue"<%= event.mode === 'venue' ? ' selected' : '' %>>At a venue</option>
        </select></label>
      <label class="ax-field ax-span-2"><span><%= event.mode === 'online' ? 'Join link' : 'Venue address' %></span><input class="ax-input" name="location" value="<%= event.location %>" maxlength="500" placeholder="<%= event.mode === 'online' ? 'https://meet.google.com/…' : 'Studio 4, 12 MG Road, Bengaluru' %>" />
        <small>Online: shown only to people who’ve registered. Venue: shown on the page.</small></label>
      <label class="ax-field"><span>Seats <small>(0 = no limit)</small></span><input class="ax-input" type="number" name="capacity" value="<%= event.capacity %>" min="0" /></label>
      <label class="ax-field"><span>Link ending</span><input class="ax-input" name="slug" value="<%= event.slug %>" maxlength="60" pattern="[a-z0-9-]+" /></label>
    </div>
  </section>

  <section class="ax-panel ax-savebar">
    <label class="ax-check"><input type="checkbox" name="visible" value="1"<%= event.visible ? ' checked' : '' %> /> <span>Page is live</span></label>
    <button class="ax-btn ax-btn-primary">Save changes</button>
  </section>
</form>

<section class="ax-panel" id="attendees">
  <div class="ax-panel-head"><h2>Attendees</h2><span class="ax-count"><%= going.length %><%= event.capacity ? ' / ' + event.capacity : '' %> going</span></div>
  <% if (!rsvps.length) { %>
  <p class="ax-empty">No RSVPs yet.</p>
  <% } else { %>
  <ul class="ax-list">
    <% rsvps.forEach(function (r) { var off = r.status !== 'going'; %>
    <li class="ax-row<%= off ? ' is-off' : '' %>">
      <div class="ax-main"><b><%= r.name %></b> <span class="ax-sub">· <a href="mailto:<%= r.email %>"><%= r.email %></a><%= r.phone ? ' · ' + r.phone : '' %></span></div>
      <% if (off) { %><span class="ax-pill">Cancelled</span><% } else { %>
      <form method="POST" action="/dashboard/events/<%= event.id %>/rsvps/<%= r.id %>/cancel"><button class="ax-btn ax-btn-quiet" data-confirm="Cancel RSVP?">Cancel</button></form>
      <% } %>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>

<form method="POST" action="/dashboard/events/<%= event.id %>/delete" class="ax-danger">
  <span>Deleting the event takes its page down and removes its attendee list. They stay in your Audience.</span>
  <button class="ax-btn ax-btn-danger" data-confirm="Click again to delete">Delete event</button>
</form>

<%- include('partials/app-dash-bottom') %>
