<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/auth.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/onboarding.css?v=<%= assetVersion %>" />
</head>
<%# Onboarding step 1 (lib/onboarding.js): the account. On success the person is logged in and goes to /onboarding. %>
<body class="auth-page ob-signup">

<div class="ob-split">
  <aside class="ob-pitch">
    <a href="/" class="logo ob-logo">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5 12.5L10 17L19 7" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <%= siteName %>
    </a>
    <div class="ob-pitch-body">
      <h2>Your business, online in 5 minutes.</h2>
      <ul class="ob-pitch-list">
        <li><svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Your own page and link</li>
        <li><svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Bookings, payments and WhatsApp</li>
        <li><svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Set up for salons, clinics, coaches and creators</li>
      </ul>
      <p class="ob-pitch-foot">Free to start. No card needed.</p>
    </div>
  </aside>

  <main class="ob-signup-main">
    <div class="ob-progress" aria-hidden="true"><% for (var i = 1; i <= 7; i++) { %><span<%= i === 1 ? ' class=on' : '' %>></span><% } %></div>
    <p class="ob-stepcount">Step 1 of 7</p>
    <h1 class="ob-title">Create your account</h1>
    <p class="ob-sub">Then we’ll set up your page together.</p>

    <% if (error) { %>
      <div class="auth-error" role="alert"><%= error %></div>
    <% } %>

    <% if (googleEnabled) { %>
      <a href="/auth/google" class="btn-google">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continue with Google
      </a>
      <div class="auth-divider"><span>or</span></div>
    <% } %>

    <form method="POST" action="/signup" class="ob-form" novalidate>
      <div class="field">
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" value="<%= values.name %>" placeholder="Meera Kapoor" autocomplete="name" maxlength="120" required />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= values.email %>" placeholder="you@example.com" autocomplete="email" maxlength="190" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="ob-password">
          <input type="password" id="password" name="password" placeholder="At least 8 characters" autocomplete="new-password" minlength="8" maxlength="200" required aria-describedby="passwordHint" />
          <button type="button" class="ob-password-toggle" data-password-toggle aria-pressed="false" aria-controls="password" hidden>Show</button>
        </div>
        <p class="field-hint" id="passwordHint">At least 8 characters.</p>
      </div>
      <div class="ob-actions">
        <button type="submit" class="ob-primary">Create account</button>
      </div>
    </form>

    <div class="auth-switch">Already have an account? <a href="/login">Log in</a></div>
  </main>
</div>

<script src="/js/onboarding.js?v=<%= assetVersion %>"></script>
</body>
</html>
