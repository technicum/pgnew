<%# Top of every public Bookings / Events / Courses page (lib/appStorefront.js):
    the lead-magnet page look (lead-magnet.css — one card over an accent
    backdrop) in the creator's store accent, plus app-public.css. Pass
    `wide: true` for the course player, which needs more room. %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/auth.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/lead-magnet.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/app-public.css?v=<%= assetVersion %>" />
</head>
<body class="lm-page" style="<%= lmThemeStyle(theme) %>">
<main class="lm-shell<%= typeof wide !== 'undefined' && wide ? ' ax-wide' : '' %>">
  <div class="lm-head">
    <a href="/" class="logo lm-brand"><%= owner.name %></a>
  </div>
