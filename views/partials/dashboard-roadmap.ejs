<%# The Overview page before the first sale (lib/dashboard.js): what's left to
    do, unfinished steps first. Needs setup and storeUrl. %>
<section class="dash-roadmap" aria-labelledby="roadmapTitle">
  <div class="dash-roadmap-head">
    <h2 id="roadmapTitle">Roadmap to launch</h2>
    <span><%= setup.done %> of <%= setup.total %> done</span>
  </div>
  <div class="dash-roadmap-bar" role="progressbar" aria-labelledby="roadmapTitle" aria-valuemin="0" aria-valuemax="<%= setup.total %>" aria-valuenow="<%= setup.done %>">
    <span style="width:<%= setup.done / setup.total * 100 %>%;"></span>
  </div>
  <ol class="dash-roadmap-steps">
    <% setup.steps.forEach(function (step) { %>
      <li class="dash-road-step<%= step.done ? ' is-done' : '' %>">
        <span class="dash-road-mark" aria-hidden="true">
          <% if (step.done) { %><svg viewBox="0 0 24 24" fill="none" width="13" height="13" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5L10 17L19 7"></path></svg><% } %>
        </span>
        <div class="dash-road-body">
          <h3><%= step.title %><% if (step.done) { %><span class="sr-only"> (done)</span><% } %></h3>
          <p><%= step.note %></p>
        </div>
        <% if (!step.done && step.copy) { %>
          <button type="button" class="dash-road-btn" data-copy-link="<%= storeUrl %>"><span data-copy-label aria-live="polite">Copy link</span></button>
        <% } else if (!step.done) { %>
          <a class="dash-road-btn" href="<%= step.action.href %>"><%= step.action.label %></a>
        <% } %>
      </li>
    <% }) %>
  </ol>
</section>
