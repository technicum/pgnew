<%# The small icon for a course item's kind (lib/courses.js KINDS) — lesson (with a video: a play triangle), quiz, download — in the outlines (app-course, app-course-learn, the editor and its preview). Pass kind, and video (true when a lesson has one). %>
<% var hasVideo = typeof video !== 'undefined' && video; %>
<span class="ck ck-<%= kind %>" title="<%= kind === 'quiz' ? 'Quiz' : kind === 'file' ? 'Download' : 'Lesson' %>" aria-hidden="true"><% if (kind === 'quiz') { %><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14"/><path d="M12 17.2h.01"/></svg><% } else if (kind === 'file') { %><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg><% } else if (hasVideo) { %><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg><% } else { %><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg><% } %></span>
