<%# A list row's ⋯ menu — every action for one service / event / course in one place (the script is in
    app-dash-scripts). Pass: label (the item's name), editHref, link (its public page), base (its
    dashboard path, e.g. /dashboard/events/12 — the visibility and delete forms post under it), visible. %>
<div class="ax-menu" data-menu>
  <button type="button" class="ax-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-label="Actions for <%= label %>">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg>
  </button>
  <div class="ax-menu-pop" role="menu" hidden>
    <a role="menuitem" href="<%= editHref %>">
      <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      Edit
    </a>
    <% if (visible) { %>
      <a role="menuitem" href="<%= link %>" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        View page
      </a>
    <% } %>
    <button type="button" role="menuitem" data-copy="<%= link %>">
      <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      <span data-label>Copy link</span>
    </button>
    <form method="POST" action="<%= base %>/visibility">
      <input type="hidden" name="visible" value="<%= visible ? '0' : '1' %>" />
      <button type="submit" role="menuitem">
        <% if (visible) { %>
          <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.7 5.1A10 10 0 0 1 12 5c7 0 10 7 10 7a13 13 0 0 1-1.7 2.7"/><path d="M6.6 6.6A13.5 13.5 0 0 0 2 12s3 7 10 7a9.7 9.7 0 0 0 5.4-1.6"/><path d="m2 2 20 20"/><path d="M14.1 14.1a3 3 0 0 1-4.2-4.2"/></svg>
          Hide from page
        <% } else { %>
          <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          Show on page
        <% } %>
      </button>
    </form>
    <form method="POST" action="<%= base %>/delete">
      <button type="submit" role="menuitem" class="is-danger" data-confirm="Click again to delete">
        <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-8 0 1 13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1l1-13"/></svg>
        <span data-label>Delete</span>
      </button>
    </form>
  </div>
</div>
