<%# Platform admin panel layout (lib/adminRoutes.js): its own sidebar, then the page. Pass section
    (overview | users | plans | fees | payments | media) to highlight it. Closed by partials/admin-bottom. %>
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/app-dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>" />
</head>
<body class="adm-body">
<%
var adminNav = [
  { key: 'overview', href: '/admin', label: 'Overview', icon: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>' },
  { key: 'users', href: '/admin/users', label: 'Users', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { key: 'plans', href: '/admin/plans', label: 'Plans', icon: '<path d="m12 2 3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21l2-7.5L2 9h7z"/>' },
  { key: 'fees', href: '/admin/fees', label: 'Transaction fees', icon: '<line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>' },
  { key: 'payments', href: '/admin/payments', label: 'Payments', icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>' },
  { key: 'blog', href: '/admin/blog', label: 'Blog', icon: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>' },
  { key: 'seo', href: '/admin/seo', label: 'SEO', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  { key: 'ideas', href: '/admin/ideas', label: 'App ideas', icon: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z"/>' },
  { key: 'media', href: '/admin/media', label: 'Media', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>' },
];
%>
<div class="adm-shell">
  <aside class="adm-side">
    <a class="adm-brand" href="/admin">
      <span class="adm-brand-mark"><svg viewBox="0 0 24 24" fill="none" width="17" height="17" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>
      <span><b><%= siteName %></b><small>Admin</small></span>
    </a>
    <nav class="adm-nav" aria-label="Admin">
      <% adminNav.forEach(function (n) { var on = n.key === section; %>
        <a href="<%= n.href %>"<%- on ? ' class="is-on" aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" fill="none" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- n.icon %></svg>
          <%= n.label %>
        </a>
      <% }) %>
    </nav>
    <div class="adm-side-foot">
      <a href="/dashboard">
        <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        My dashboard
      </a>
      <span class="adm-who"><%= user.name %><small><%= user.email %></small></span>
    </div>
  </aside>
  <main class="adm-main">
    <% if (flash) { %><div class="ax-flash <%= flash.kind === 'error' ? 'ax-flash-error' : 'ax-flash-ok' %>" role="<%= flash.kind === 'error' ? 'alert' : 'status' %>"><%= flash.text %></div><% } %>
