    </div>
  </main>
</div>
<script>
  // Image fields (partials/ax-image-field): upload the file as the request
  // body (lib/uploads.js), then put the returned link in the text field.
  document.querySelectorAll('[data-upload]').forEach(function (box) {
    var input = box.querySelector('input[name]');
    var file = box.querySelector('input[type=file]');
    var preview = box.querySelector('.ax-upload-preview');
    var label = file.parentNode;
    var show = function () {
      preview.innerHTML = '';
      if (!input.value) return;
      var img = document.createElement('img');
      img.alt = '';
      img.src = input.value;
      preview.appendChild(img);
    };
    input.addEventListener('change', show);
    box.querySelector('[data-clear]').addEventListener('click', function () { input.value = ''; show(); });
    file.addEventListener('change', async function () {
      var f = file.files[0];
      if (!f) return;
      label.firstChild.textContent = 'Uploading…';
      try {
        var res = await fetch('/dashboard/uploads', { method: 'POST', headers: { 'Content-Type': f.type }, body: f });
        var data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');
        input.value = data.url;
        show();
      } catch (err) {
        box.querySelector('small').textContent = err.message;
      }
      label.firstChild.textContent = 'Upload';
      file.value = '';
    });
  });

  // Weekly hours (partials/ax-hours): reveal the next hidden range, or
  // hide (and clear) one.
  document.querySelectorAll('[data-range-add]').forEach(function (btn) {
    var update = function () { btn.hidden = !btn.parentNode.querySelector('.ax-range[hidden]'); };
    btn.addEventListener('click', function () {
      var next = btn.parentNode.querySelector('.ax-range[hidden]');
      if (next) next.hidden = false;
      update();
    });
    btn.parentNode.querySelectorAll('[data-range-remove]').forEach(function (x) {
      x.addEventListener('click', function () {
        var range = x.parentNode;
        range.querySelectorAll('input').forEach(function (i) { i.value = ''; });
        range.hidden = true;
        update();
      });
    });
    update();
  });

  // Copy buttons for public links, and a second click to confirm deletes.
  document.addEventListener('click', function (e) {
    var copy = e.target.closest('[data-copy]');
    if (copy) {
      navigator.clipboard.writeText(copy.getAttribute('data-copy')).then(function () {
        var was = copy.textContent;
        copy.textContent = 'Copied';
        setTimeout(function () { copy.textContent = was; }, 1200);
      });
    }
    var confirmBtn = e.target.closest('[data-confirm]');
    if (confirmBtn && !confirmBtn.classList.contains('is-armed')) {
      e.preventDefault();
      confirmBtn.classList.add('is-armed');
      confirmBtn.dataset.label = confirmBtn.textContent;
      confirmBtn.textContent = confirmBtn.getAttribute('data-confirm');
      setTimeout(function () {
        confirmBtn.classList.remove('is-armed');
        confirmBtn.textContent = confirmBtn.dataset.label;
      }, 3000);
    }
  });
</script>
</body>
</html>
