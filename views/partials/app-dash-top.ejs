<%# Opening of every Bookings / Events / Courses dashboard page
    (lib/appDashboard.js): head, sidebar, sticky header, page heading and
    the ?ok= / ?error= flash. Pass navActive, section (the small label) and
    heading; optional intro, back ({ href, label }) and headAction (HTML for
    a button beside the heading, like Payment pages' "Create" button). %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#fbfaf6" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="<%= siteName %>" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="/icons/app-icon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icons/app-icon.svg" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/app-dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/ax-preview.css?v=<%= assetVersion %>" />
</head>
<body>
<div class="min-h-screen bg-background">

  <%- include('dashboard-sidebar', { navActive: navActive }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <p class="text-sm font-semibold text-primary" style="line-height:1;"><%= section %></p>
      <div class="ml-auto flex items-center gap-2">
        <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
      </div>
    </header>

    <div class="mx-auto <%= typeof wide !== 'undefined' && wide ? 'ax-wide-page' : 'max-w-[1100px]' %> px-4 py-7 md:px-8 md:py-9">
      <% if (typeof back !== 'undefined' && back) { %><a class="ax-back" href="<%= back.href %>">← <%= back.label %></a><% } %>
      <% var hasAction = typeof headAction !== 'undefined' && headAction; %>
      <section class="ax-heading<%= hasAction ? ' has-action' : '' %>">
        <div>
          <h1 class="text-3xl font-extrabold md:text-4xl"><%= heading %></h1>
          <% if (typeof intro !== 'undefined' && intro) { %><p class="mt-2 text-sm text-muted-foreground" style="max-width:64ch;"><%- intro %></p><% } %>
        </div>
        <% if (hasAction) { %><%- headAction %><% } %>
      </section>
      <% if (flash) { %><div class="ax-flash ax-flash-<%= flash.kind %>" role="status"><%= flash.text %></div><% } %>
