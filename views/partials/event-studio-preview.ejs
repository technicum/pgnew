<%# The event page (/event/:slug, views/app-event.ejs) as it looks live, drawn in the studio's device frame (app-event-edit) with public/css/studio.css's pvs-* styles: kicker, title, host, when / where / seats, description, the RSVP form.
    Bound to the editor's form by public/js/ax-preview.js (loaded in partials/studio-bottom); the window.axPreview below handles the kicker, when, where, ticket price, seats and the button. Pass event. %>
<% var initials = String(user.name || '').split(/\s+/).filter(Boolean).slice(0, 2).map(function (p) { return p[0].toUpperCase(); }).join('') || '•'; %>
<div class="pvs" data-pv-screen style="<%= lmThemeStyle(storeTheme) %>">
  <div class="pvs-bar is-center"><%= user.name %></div>
  <div class="pvs-grid is-event">
    <div class="pvs-card">
      <div class="pvs-cover" data-pv-show="cover_url"><img data-pv-img="cover_url" alt="" /></div>
      <div class="pvs-in">
        <span class="pvs-kicker" data-pv-kicker>Online event</span>
        <h3 class="pvs-title" data-pv-text="title" data-pv-empty="Your event"></h3>
        <div class="pvs-by"><span class="pvs-av"><%= initials %></span><span>by <b><%= user.name %></b><% if (user.bio) { %><small><%= user.bio %></small><% } %></span></div>
        <dl class="pvs-when">
          <div><dt>When</dt><dd data-pv-when></dd></div>
          <div><dt>Where</dt><dd data-pv-where></dd></div>
          <div><dt>Ticket</dt><dd data-pv-price></dd></div>
          <div data-pv-seats-row hidden><dt>Seats</dt><dd data-pv-seats></dd></div>
        </dl>
        <div class="pvs-rich" data-pv-rich="description"></div>
        <div class="pvs-h is-gap">Register</div>
        <div class="pvs-field"><span>Your name</span><div class="pvs-input"></div></div>
        <div class="pvs-field"><span>Your email</span><div class="pvs-input"></div></div>
        <div class="pvs-field"><span>Phone <em>(optional)</em></span><div class="pvs-input"></div></div>
        <div class="pvs-btn" data-pv-button>Register — it’s free</div>
      </div>
      <p class="pvs-foot">Your details go to <%= user.name %> only.</p>
    </div>
  </div>
</div>
<script>
  // Event-specific bits of the preview — worded as app-event.ejs and
  // lib/appStorefront.js (the "when" line).
  window.axPreview = function (get, screen) {
    var q = function (s) { return screen.querySelector(s); };
    var going = <%= Number(event.going || 0) %>;
    var time = function (t) {
      var m = /^(\d{2}):(\d{2})$/.exec(t || '');
      if (!m) return '';
      var h = Number(m[1]);
      return (h % 12 || 12) + ':' + m[2] + ' ' + (h < 12 ? 'am' : 'pm');
    };
    var when = '';
    var d = /^(\d{4})-(\d{2})-(\d{2})$/.exec(get('date'));
    if (d) {
      var date = new Date(Number(d[1]), Number(d[2]) - 1, Number(d[3]));
      var opts = { weekday: 'long', day: 'numeric', month: 'long' };
      if (date.getFullYear() !== new Date().getFullYear()) opts.year = 'numeric';
      when = date.toLocaleDateString('en-GB', opts);
      var start = time(get('start_time'));
      var end = time(get('end_time'));
      if (start) when += ', ' + start + (end ? ' – ' + end : '') + ' (IST)';
    }
    q('[data-pv-when]').textContent = when || 'Pick a date';

    var n = Number(String(get('price')).replace(/[₹,\s]/g, ''));
    var price = get('pricing') === 'paid' && isFinite(n) && n > 0 ? n : 0;
    var label = price ? '₹' + price.toLocaleString('en-IN', { maximumFractionDigits: 2 }) : 'Free';
    q('[data-pv-price]').textContent = label;
    q('[data-pv-button]').textContent = price ? 'Get ticket · ' + label : 'Register — it’s free';

    var online = get('mode') !== 'venue';
    q('[data-pv-kicker]').textContent = (online ? 'Online event' : 'Event') + ' · ' + label;
    q('[data-pv-where]').textContent = online ? 'Online — the link is shared once you register' : (get('location') || 'Venue to be announced');

    var cap = Math.max(0, Math.round(Number(get('capacity')) || 0));
    q('[data-pv-seats-row]').hidden = !cap;
    var left = Math.max(0, cap - going);
    q('[data-pv-seats]').textContent = left > 0 ? left + ' of ' + cap + ' left' : 'Full';
  };
</script>
