<%# Dashboard sidebar, shared by every dashboard page except the store
    builder (which has its own rail). The page passes navActive — the href
    of its own entry — to highlight it:
      include('partials/dashboard-sidebar', { navActive: '/dashboard/audience' })
    Needs user + siteName + siteDomain, which every dashboard view has.
    Apps (lib/apps.js) the creator has added from Explore apps sit between
    the built-in entries — installedApps comes from server.js's /dashboard
    middleware. %>
<%
var navItems = [
  { href: '/dashboard', label: 'Overview', icon: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>' },
  { href: '/dashboard/builder', label: 'My store', icon: '<path d="M14.364 13.634a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506l4.013-4.009a1 1 0 0 0-3.004-3.004z"></path><path d="M14.487 7.858A1 1 0 0 1 14 7V2"></path><path d="M20 19.645V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l2.516 2.516"></path><path d="M8 18h1"></path>' },
  { href: '/dashboard/audience', label: 'Audience', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle>' },
  { href: '#', label: 'Analytics', icon: '<path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path>' },
];
// Built-in pages, then the added apps' entries, then the rest.
navItems = navItems.slice(0, 3).concat(typeof appNav !== 'undefined' ? appNav : [], navItems.slice(3));
var exploreOn = navActive === '/dashboard/apps';
// Phone bottom tab bar (below 1024px the sidebar becomes a drawer behind
// "More"). Any page without its own tab lights up "More".
var tabItems = [
  { href: '/dashboard', label: 'Home', icon: navItems[0].icon },
  { href: '/dashboard/builder', label: 'Store', icon: navItems[1].icon },
  { href: '/dashboard/audience', label: 'Audience', icon: navItems[2].icon },
  { href: '/dashboard/apps', label: 'Apps', icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><path d="M17.5 14v7M14 17.5h7"></path>' },
];
var moreOn = !tabItems.some(function (t) { return t.href === navActive; });
%>
  <aside id="dashSide" class="dash-side fixed inset-y-0 left-0 z-40 flex w-64 flex-col bg-sidebar text-sidebar-foreground transition-all lg:translate-x-0 translate-x-0" aria-label="Menu">
    <div class="flex h-20 items-center justify-between border-b border-sidebar-border px-6">
      <a href="/" class="flex items-center gap-3" style="text-decoration:none;color:inherit;">
        <div class="grid size-9 place-items-center rounded-md bg-sidebar-primary text-sidebar-primary-foreground">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><path d="M5 12.5L10 17L19 7" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <span class="font-display text-xl font-extrabold"><%= siteName %></span>
      </a>
      <button type="button" class="dash-side-close" data-dash-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>

    <div class="px-4 pt-6">
      <div class="flex w-full items-center gap-3 rounded-md border border-sidebar-border bg-sidebar-accent p-3 text-left">
        <div class="grid size-9 shrink-0 place-items-center rounded-md bg-accent font-display text-sm font-bold text-accent-foreground"><%= user.initials %></div>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold"><%= user.name %></span>
          <span class="block truncate text-xs text-sidebar-foreground/55"><%= siteDomain %>/<%= user.handle %></span>
        </span>
      </div>
    </div>

    <nav class="flex-1 space-y-1 px-4 py-6" aria-label="Dashboard navigation">
      <% navItems.forEach(function (item) { var on = item.href === navActive; %>
      <a href="<%= item.href %>" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors <%= on ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground' %>" style="text-decoration:none;"<%- on ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"<%- on ? ' class="text-sidebar-primary"' : '' %>><%- item.icon %></svg>
        <span class="flex-1 text-left"><%= item.label %></span>
      </a>
      <% }) %>
      <a href="/dashboard/apps" class="flex h-11 w-full items-center gap-3 rounded-md px-3 text-sm font-medium transition-colors <%= exploreOn ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground/65 hover:bg-sidebar-accent hover:text-sidebar-foreground' %>" style="text-decoration:none; margin-top:10px; border:1px dashed rgba(255,255,255,.18);"<%- exploreOn ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"<%- exploreOn ? ' class="text-sidebar-primary"' : '' %>><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><path d="M17.5 14v7M14 17.5h7"></path></svg>
        <span class="flex-1 text-left">Explore apps</span>
      </a>
    </nav>

    <div class="space-y-1 border-t border-sidebar-border p-4">
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { var adminOn = false; %>
      <a href="/admin" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm <%= adminOn ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground/65 hover:bg-sidebar-accent' %>" style="text-decoration:none;"<%- adminOn ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        Platform admin
      </a>
      <% } %>
      <% var domainOn = navActive === '/dashboard/domain'; %>
      <a href="/dashboard/domain" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm <%= domainOn ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground/65 hover:bg-sidebar-accent' %>" style="text-decoration:none;"<%- domainOn ? ' aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
        Domain
      </a>
      <a href="#" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm text-sidebar-foreground/65 hover:bg-sidebar-accent" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle></svg>
        Settings
      </a>
      <a href="#" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm text-sidebar-foreground/65 hover:bg-sidebar-accent" style="text-decoration:none;">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>
        Help &amp; support
      </a>
      <form method="POST" action="/logout">
        <button type="submit" class="flex h-10 w-full items-center gap-3 rounded-md px-3 text-sm text-sidebar-foreground/65 hover:bg-sidebar-accent" style="border:none;background:none;cursor:pointer;font:inherit;color:inherit;">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
          Log out
        </button>
      </form>
    </div>
  </aside>
  <div class="dash-scrim" data-dash-close hidden></div>

  <nav class="dash-tabbar" aria-label="Quick navigation">
    <% tabItems.forEach(function (t) { var on = t.href === navActive; %>
    <a href="<%= t.href %>" class="dash-tab<%= on ? ' is-on' : '' %>"<%- on ? ' aria-current="page"' : '' %>>
      <span class="dash-tab-icon"><svg viewBox="0 0 24 24" fill="none" width="22" height="22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- t.icon %></svg></span>
      <span><%= t.label %></span>
    </a>
    <% }) %>
    <button type="button" class="dash-tab<%= moreOn ? ' is-on' : '' %>" data-dash-open aria-controls="dashSide" aria-expanded="false">
      <span class="dash-tab-icon"><svg viewBox="0 0 24 24" fill="none" width="22" height="22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg></span>
      <span>More</span>
    </button>
  </nav>

  <script>
  (function () {
    var side = document.getElementById('dashSide');
    var scrim = document.querySelector('.dash-scrim');
    var opener = document.querySelector('[data-dash-open]');
    function set(open) {
      side.classList.toggle('is-open', open);
      scrim.hidden = !open;
      document.documentElement.classList.toggle('dash-locked', open);
      opener.setAttribute('aria-expanded', String(open));
    }
    opener.addEventListener('click', function () { set(true); });
    document.querySelectorAll('[data-dash-close]').forEach(function (el) {
      el.addEventListener('click', function () { set(false); });
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    // Close when the window grows to desktop, where the sidebar is always shown.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', function (m) { if (m.matches) set(false); });
  })();
  </script>
