<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# SEO and link previews: the builder's SEO tab (lib/storeSettings.js), falling back to name and bio. %>
<% var seoTitle = store.seo.title || title; var seoDesc = store.seo.description || owner.bio || store.tagline; %>
<title><%= seoTitle %></title>
<% if (seoDesc) { %><meta name="description" content="<%= seoDesc %>" /><% } %>
<meta property="og:type" content="profile" />
<meta property="og:title" content="<%= seoTitle %>" />
<% if (seoDesc) { %><meta property="og:description" content="<%= seoDesc %>" /><% } %>
<% if (pageUrl) { %><meta property="og:url" content="<%= pageUrl %>" /><link rel="canonical" href="<%= pageUrl %>" /><% } %>
<% if (store.seo.image) { %><meta property="og:image" content="<%= store.seo.image %>" /><meta name="twitter:card" content="summary_large_image" /><% } else { %><meta name="twitter:card" content="summary" /><% } %>
<% if (store.theme === 'dark') { %><meta name="color-scheme" content="dark" /><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500;600<%= store.font === 'rounded' ? '&family=Nunito:wght@400;600;700' : '' %>&display=swap" />
<link rel="stylesheet" href="/css/store.css?v=<%= assetVersion %>" />
</head>
<body class="theme-<%= store.theme %> font-<%= store.font %> buttons-<%= store.buttons %>" style="--store-accent: <%= owner.accent %>;">

<%# The page around the store card (wide screens): a soft blur of the cover, or an accent glow. %>
<div class="store-backdrop<%= store.cover ? ' has-image' : '' %>" aria-hidden="true"<% if (store.cover) { %> style="background-image: url('<%= store.cover %>');"<% } %>></div>

<% if (store.announcement) { %>
  <%# The announcement bar, full width across the top of the page; a popup link (#form-12) opens that popup. %>
  <% var ann = store.announcement; var annExternal = ann.href && /^https?:/.test(ann.href); %>
  <% if (ann.href) { %>
    <a class="store-announce" href="<%= ann.href %>"<% if (annExternal) { %> target="_blank" rel="noopener noreferrer"<% } %>><span><%= ann.text %></span><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  <% } else { %>
    <div class="store-announce"><span><%= ann.text %></span></div>
  <% } %>
<% } %>

<main class="store<%= store.cover ? ' has-cover' : '' %>">
  <button type="button" class="store-profile-share store-share-btn" data-share-url="/" data-share-title="<%= owner.name %>" aria-label="Share this page">
    <svg viewBox="0 0 24 24" fill="none" width="17" height="17" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <% if (store.cover) { %>
    <div class="store-cover"><img src="<%= store.cover %>" alt="" /></div>
  <% } %>
  <header class="store-header">
    <% if (store.photo) { %>
      <img class="store-avatar store-avatar-img" src="<%= store.photo %>" alt="<%= owner.name %>" />
    <% } else { %>
      <div class="store-avatar" aria-hidden="true"><%= owner.initials %></div>
    <% } %>
    <h1 class="store-name"><%= owner.name %></h1>
    <% if (store.tagline) { %><p class="store-tagline"><%= store.tagline %></p><% } %>
    <% if (store.location) { %>
      <p class="store-location">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/></svg>
        <%= store.location %>
      </p>
    <% } %>
    <% if (owner.bio) { %><p class="store-bio"><%= owner.bio %></p><% } %>
    <% if (store.socialsInHeader && owner.socials.length) { %>
      <nav class="store-socials" aria-label="Find me on">
        <% owner.socials.forEach(function (s) { %>
          <a class="store-social" href="<%= s.href %>" title="<%= s.label %>" aria-label="<%= s.label %>"<% if (/^https?:/.test(s.href)) { %> target="_blank" rel="noopener noreferrer me"<% } %>>
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="19" height="19" aria-hidden="true"><%- s.icon %></svg>
          </a>
        <% }) %>
      </nav>
    <% } %>
    <% if (store.contact) { %>
      <a class="store-contact" href="<%= store.contact.href %>"<% if (store.contact.kind === 'whatsapp') { %> target="_blank" rel="noopener noreferrer"<% } %>>
        <% if (store.contact.kind === 'whatsapp') { %>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="17" height="17" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <% } else { %>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="17" height="17" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="m22 7-10 6L2 7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <% } %>
        <%= store.contact.label %>
      </a>
    <% } %>
  </header>

  <% if (!blocks.length) { %>
    <p class="store-empty">Nothing here yet — check back soon.</p>
  <% } %>

  <%# A card's share button: opens the share sheet for that card's link (a popup's own link for popups). %>
  <% function shareButton(url, title) { %>
    <button type="button" class="store-share-btn" data-share-url="<%= url %>" data-share-title="<%= title %>" aria-label="Share <%= title %>">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="19" r="1.6" fill="currentColor"/></svg>
    </button>
  <% } %>
  <div class="store-blocks">
    <% blocks.forEach(function (block) { %>
      <% if (block.type === 'text') { %>
        <section class="store-text">
          <h2><%= block.title %></h2>
          <% if (block.sub) { %><p><%= block.sub %></p><% } %>
        </section>
      <% } else if (block.type === 'testimonial') { %>
        <%# Testimonials: a card here; the slider opens in its popup (#reviews-<id>, below the list). %>
        <% if (block.items.length) { %>
          <% var n = block.items.length; %>
          <% var first = block.items[0]; var others = n - 1; %>
          <div class="store-item store-item-top">
            <a class="store-block store-block-link store-reviews-card" href="#reviews-<%= block.id %>" aria-haspopup="dialog">
              <span class="store-reviews-card-head">
                <span class="store-reviews-card-title"><%= block.title || 'What people say' %></span>
                <span class="store-reviews-card-count"><%= n %> testimonial<%= n === 1 ? '' : 's' %></span>
              </span>
              <span class="store-reviews-card-quote">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M10 7H6a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v1a2 2 0 0 1-2 2H5v2h1a4 4 0 0 0 4-4V7zm10 0h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v1a2 2 0 0 1-2 2h-1v2h1a4 4 0 0 0 4-4V7z" fill="currentColor"/></svg>
                <span><%= first.quote %></span>
              </span>
              <span class="store-reviews-card-foot">
                <span class="store-reviews-faces" aria-hidden="true">
                  <% block.items.slice(0, 3).forEach(function (item) { %>
                    <span><%= (item.name || '').split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join('') || '“' %></span>
                  <% }) %>
                </span>
                <span class="store-reviews-card-who">
                  <% if (first.name) { %><strong><%= first.name %></strong><% if (others) { %> and <%= others %> other<%= others === 1 ? '' : 's' %><% } %><% } else { %><%= n %> happy customer<%= n === 1 ? '' : 's' %><% } %>
                </span>
                <span class="store-reviews-card-cta"><%= n > 1 ? 'Read all' : 'Read' %><svg viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </span>
            </a>
            <% shareButton('#reviews-' + block.id, block.title || 'Testimonials') %>
          </div>
        <% } %>
      <% } else if (block.type === 'newsletter' || block.type === 'form') { %>
        <%# Opens this block's popup (below the list). Its own link, /#subscribe-<id> or /#form-<id>, opens it from anywhere. %>
        <% var isForm = block.type === 'form'; var hash = (isForm ? '#form-' : '#subscribe-') + block.id; %>
        <div class="store-item">
          <a class="store-block store-block-link store-nl-trigger" href="<%= hash %>" aria-haspopup="dialog">
            <span class="store-nl-icon">
              <% if (isForm) { %>
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m22 7-10 6L2 7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              <% } %>
            </span>
            <span class="store-block-body">
              <span class="store-block-title"><%= block.title %></span>
              <% if (block.sub) { %><span class="store-block-sub"><%= block.sub %></span><% } %>
            </span>
            <% if (!isForm) { %><span class="store-nl-cta">Subscribe</span><% } %>
          </a>
          <% shareButton(hash, block.title) %>
        </div>
      <% } else if (block.socials) { %>
        <%# Social links module: the profile's icons (Profile → Social links), minus any switched off in the module. %>
        <% if (block.socials.length) { %>
          <section class="store-social-block">
            <% if (block.title && block.title !== block.label) { %><h2 class="store-social-heading"><%= block.title %></h2><% } %>
            <nav class="store-socials" aria-label="<%= block.title && block.title !== block.label ? block.title : 'Social links' %>">
              <% block.socials.forEach(function (s) { %>
                <a class="store-social" href="<%= s.href %>" title="<%= s.label %>" aria-label="<%= s.label %>"<% if (/^https?:/.test(s.href)) { %> target="_blank" rel="noopener noreferrer me"<% } %>>
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="19" height="19" aria-hidden="true"><%- s.icon %></svg>
                </a>
              <% }) %>
            </nav>
          </section>
        <% } %>
      <% } else if (block.type === 'video' && block.embed) { %>
        <%# A YouTube / Vimeo video: plays in its popup (#video-<id>), not off the store. %>
        <div class="store-item">
          <a class="store-block store-block-link store-video" href="#video-<%= block.id %>" aria-haspopup="dialog">
            <span class="store-video-thumb"<% if (block.embed.thumb) { %> style="background-image:url('<%= block.embed.thumb %>')"<% } %>>
              <span class="store-video-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
            </span>
            <span class="store-block-body">
              <span class="store-block-title"><%= block.title %></span>
              <span class="store-block-sub"><%= block.embed.provider %> · Play video</span>
            </span>
          </a>
          <% shareButton('#video-' + block.id, block.title) %>
        </div>
      <% } else if (block.href) { %>
        <%# Links off the store open in a new tab; the store's own pages (a booking block → /book) don't. %>
        <div class="store-item">
          <a class="store-block store-block-link" href="<%= block.href %>"<% if (/^https?:/.test(block.href)) { %> target="_blank" rel="noopener noreferrer nofollow"<% } %><% if (block.href.charAt(0) === '#') { %> aria-haspopup="dialog"<% } %>>
            <span class="store-block-body">
              <span class="store-block-title"><%= block.title %></span>
              <% if (block.sub) { %><span class="store-block-sub"><%= block.sub %></span><% } %>
            </span>
            <svg class="store-block-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <% shareButton(block.href, block.title) %>
        </div>
      <% } else { %>
        <div class="store-block">
          <span class="store-block-body">
            <span class="store-block-label"><%= block.label %></span>
            <span class="store-block-title"><%= block.title %></span>
            <% if (block.sub) { %><span class="store-block-sub"><%= block.sub %></span><% } %>
          </span>
          <% if (block.price) { %><span class="store-block-price"><%= block.price %></span><% } %>
        </div>
      <% } %>
    <% }) %>
  </div>

  <%# Popups — each opened by its own link: #subscribe-<id> (newsletter), #form-<id>, #video-<id>, #reviews-<id>,
      from a block above or from anywhere the link is shared. Newsletter and form popups post to the
      store home (lib/storefront.js newsletterSignup / formSubmit); people land in Audience. %>
  <% blocks.forEach(function (block) { %>
    <% var isReviews = block.type === 'testimonial' && block.items.length; %>
    <% if (block.type !== 'newsletter' && block.type !== 'form' && !(block.type === 'video' && block.embed) && !isReviews) return; %>
    <% var kind = block.type === 'newsletter' ? 'subscribe' : isReviews ? 'reviews' : block.type; %>
    <% var pid = kind + '-' + block.id; var result = signup && signup.blockId === block.id ? signup : null; %>
    <div class="store-popup<%= kind === 'video' ? ' store-popup-video' : '' %><%= result ? ' is-open' : '' %>" id="<%= pid %>" role="dialog" aria-modal="true" aria-labelledby="<%= pid %>-title">
      <a class="store-popup-backdrop" href="#" data-popup-close tabindex="-1" aria-hidden="true"></a>
      <div class="store-popup-card">
        <a class="store-popup-close" href="#" data-popup-close aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
        <% if (kind === 'reviews') { %>
          <% var many = block.items.length > 1; %>
          <div class="store-popup-reviews-head">
            <h2 class="store-popup-title store-popup-reviews-title" id="<%= pid %>-title"><%= block.title || 'What people say' %></h2>
            <% if (many) { %><span class="store-reviews-counter" data-slider-count aria-hidden="true">1 / <%= block.items.length %></span><% } %>
          </div>
          <section class="store-reviews<%= many ? ' is-many' : '' %>" data-slider aria-roledescription="carousel" aria-label="<%= block.title || 'Testimonials' %>">
            <div class="store-reviews-track" data-slider-track<% if (many) { %> tabindex="0"<% } %>>
              <% block.items.forEach(function (item, i) { %>
                <% var initials = (item.name || '').split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join(''); %>
                <figure class="store-review" aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= block.items.length %>">
                  <svg class="store-review-mark" viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M10 7H6a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v1a2 2 0 0 1-2 2H5v2h1a4 4 0 0 0 4-4V7zm10 0h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v1a2 2 0 0 1-2 2h-1v2h1a4 4 0 0 0 4-4V7z" fill="currentColor"/></svg>
                  <blockquote><%= item.quote %></blockquote>
                  <% if (item.name || item.detail) { %>
                    <figcaption>
                      <span class="store-review-avatar" aria-hidden="true"><%= initials || '“' %></span>
                      <span>
                        <% if (item.name) { %><strong><%= item.name %></strong><% } %>
                        <% if (item.detail) { %><small><%= item.detail %></small><% } %>
                      </span>
                    </figcaption>
                  <% } %>
                </figure>
              <% }) %>
            </div>
            <% if (many) { %>
              <div class="store-reviews-nav">
                <button type="button" class="store-reviews-arrow" data-slider-prev aria-label="Previous testimonial">
                  <svg viewBox="0 0 24 24" fill="none" width="16" height="16" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="store-reviews-dots">
                  <% block.items.forEach(function (item, i) { %>
                    <button type="button" data-slider-dot="<%= i %>" aria-label="Show testimonial <%= i + 1 %>"<% if (i === 0) { %> aria-current="true"<% } %>></button>
                  <% }) %>
                </div>
                <button type="button" class="store-reviews-arrow" data-slider-next aria-label="Next testimonial">
                  <svg viewBox="0 0 24 24" fill="none" width="16" height="16" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            <% } %>
          </section>
        <% } else if (kind === 'video') { %>
          <h2 class="store-popup-title store-popup-video-title" id="<%= pid %>-title"><%= block.title %></h2>
          <%# The player only loads when the popup opens (data-src), and is unloaded on close so it stops playing. %>
          <div class="store-video-frame">
            <iframe data-src="<%= block.embed.src %>" title="<%= block.title %>" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
          </div>
          <noscript><p class="store-popup-sub"><a href="<%= block.href %>">Watch on <%= block.embed.provider %></a></p></noscript>
        <% } else { %>
          <span class="store-popup-icon">
            <% if (kind === 'form') { %>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="22" height="22" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="22" height="22" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m22 7-10 6L2 7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <% } %>
          </span>
          <h2 class="store-popup-title" id="<%= pid %>-title"><%= block.title %></h2>
          <% if (block.sub) { %><p class="store-popup-sub"><%= block.sub %></p><% } %>
          <% if (result && result.ok) { %>
            <p class="store-newsletter-done" role="status"><%= result.message %></p>
            <a class="store-button store-popup-done-btn" href="#" data-popup-close>Done</a>
          <% } else if (kind === 'form') { %>
            <form class="store-form" method="post" action="/#<%= pid %>" novalidate>
              <input type="hidden" name="form" value="<%= block.id %>" />
              <% block.items.forEach(function (f) { %>
                <% var fid = pid + '-f' + f.index; var val = result && result.values ? (result.values[f.index] || '') : ''; %>
                <% var inputType = { email: 'email', phone: 'tel', number: 'text' }[f.kind] || 'text'; %>
                <% var auto = f.kind === 'email' ? 'email' : f.kind === 'phone' ? 'tel' : /name/i.test(f.label) ? 'name' : 'off'; %>
                <label class="store-field" for="<%= fid %>">
                  <span><%= f.label %><% if (!f.required) { %> <em>optional</em><% } %></span>
                  <% if (f.kind === 'textarea') { %>
                    <textarea class="store-input store-textarea" id="<%= fid %>" name="f_<%= f.index %>" rows="4" maxlength="1000"<% if (f.required) { %> required<% } %>><%= val %></textarea>
                  <% } else { %>
                    <input class="store-input" id="<%= fid %>" name="f_<%= f.index %>" type="<%= inputType %>" autocomplete="<%= auto %>"<% if (f.kind === 'number') { %> inputmode="decimal"<% } %> maxlength="200" value="<%= val %>"<% if (f.required) { %> required<% } %> />
                  <% } %>
                </label>
              <% }) %>
              <% if (result) { %><p class="store-newsletter-error" role="alert"><%= result.message %></p><% } %>
              <button class="store-button store-form-submit" type="submit">Send</button>
              <p class="store-form-fine">Your details go to <%= owner.name %> so they can reply.</p>
            </form>
          <% } else { %>
            <form class="store-newsletter-form" method="post" action="/#<%= pid %>">
              <input type="hidden" name="block" value="<%= block.id %>" />
              <label class="store-sr" for="<%= pid %>-email">Email address</label>
              <input class="store-input" id="<%= pid %>-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" value="<%= result ? result.email : '' %>"<% if (result) { %> aria-invalid="true" aria-describedby="<%= pid %>-error"<% } %> />
              <button class="store-button" type="submit">Subscribe</button>
            </form>
            <% if (result) { %><p class="store-newsletter-error" id="<%= pid %>-error" role="alert"><%= result.message %></p><% } %>
          <% } %>
        <% } %>
      </div>
    </div>
  <% }) %>

  <%# One share sheet for everything (the profile, and each card's share button); the script fills it in. %>
  <div class="store-popup store-share" id="share" role="dialog" aria-modal="true" aria-labelledby="share-title">
    <a class="store-popup-backdrop" href="#" data-popup-close tabindex="-1" aria-hidden="true"></a>
    <div class="store-popup-card">
      <a class="store-popup-close" href="#" data-popup-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </a>
      <h2 class="store-popup-title" id="share-title">Share</h2>
      <p class="store-popup-sub" data-share-name><%= owner.name %></p>
      <div class="store-share-link">
        <span data-share-url-text></span>
        <button type="button" class="store-button" data-share-copy>Copy</button>
      </div>
      <div class="store-share-grid">
        <a data-share-to="whatsapp" target="_blank" rel="noopener noreferrer"><span class="store-share-icon"><svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>WhatsApp</a>
        <a data-share-to="x" target="_blank" rel="noopener noreferrer"><span class="store-share-icon"><svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true"><path d="M4 4h4.5l11.5 16h-4.5zM20 4l-6.6 7.4M4 20l6.6-7.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg></span>X</a>
        <a data-share-to="facebook" target="_blank" rel="noopener noreferrer"><span class="store-share-icon"><svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true"><path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>Facebook</a>
        <a data-share-to="linkedin" target="_blank" rel="noopener noreferrer"><span class="store-share-icon"><svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>LinkedIn</a>
        <a data-share-to="email"><span class="store-share-icon"><svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m22 7-10 6L2 7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>Email</a>
        <button type="button" data-share-native hidden><span class="store-share-icon"><svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true"><circle cx="5" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="19" cy="12" r="1.6" fill="currentColor"/></svg></span>More</button>
      </div>
    </div>
  </div>

  <% if (owner.showBadge) { %>
    <footer class="store-badge">
      <a href="<%= mainSiteUrl %>">Made with <strong><%= siteName %></strong></a>
    </footer>
  <% } %>
</main>

<script>
// Popups (newsletter signup): any link to #<popup id> opens it, so
// handle.site/#subscribe-12 opens straight into that form. Without this
// script the same links still work through :target (store.css).
(function () {
  document.documentElement.classList.add('js');
  var current = null;
  var opener = null;
  function popupFor(hash) {
    var el = hash && hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    return el && el.classList.contains('store-popup') && el.id !== 'share' ? el : null;
  }
  // The address bar follows the popup, so it can be copied and shared.
  // (Not available in every sandboxed frame — the builder's preview.)
  function setHash(hash) {
    var search = location.search.replace(/([?&])(subscribed|sent)=\d+&?/g, '$1').replace(/[?&]$/, '');
    try { history.replaceState(null, '', location.pathname + search + hash); } catch (e) { /* preview */ }
  }
  function open(el, fromClick) {
    if (current === el) return;
    close(false);
    current = el;
    opener = fromClick ? document.activeElement : null;
    el.classList.add('is-open');
    var frame = el.querySelector('iframe[data-src]');
    if (frame) frame.src = frame.getAttribute('data-src');
    // Lets what's inside get ready (a testimonials slider goes back to the start).
    el.dispatchEvent(new CustomEvent('store:popup-open'));
    document.body.classList.add('store-popup-open');
    var focus = el.querySelector('.store-popup-card input:not([type=hidden]), .store-popup-card textarea, [data-share-copy]') || el.querySelector('.store-popup-close');
    setTimeout(function () { if (focus) focus.focus(); }, 40);
    // The share sheet has no link of its own, so it leaves the address alone.
    if (fromClick && el.id !== 'share') setHash('#' + el.id);
  }
  function close(clearHash) {
    if (!current) return;
    var playing = current.querySelector('iframe[data-src]');
    if (playing) playing.removeAttribute('src');
    current.classList.remove('is-open');
    current = null;
    document.body.classList.remove('store-popup-open');
    if (clearHash) setHash('');
    if (opener && opener.focus) opener.focus();
    opener = null;
  }
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('a[href^="#"]');
    if (!link) return;
    if (link.hasAttribute('data-popup-close')) { e.preventDefault(); close(true); return; }
    var el = popupFor(link.getAttribute('href'));
    if (el) { e.preventDefault(); open(el, true); }
  });
  document.addEventListener('keydown', function (e) {
    if (!current) return;
    if (e.key === 'Escape') { close(true); return; }
    // Keep Tab inside the open popup.
    if (e.key === 'Tab') {
      var f = Array.prototype.filter.call(
        current.querySelectorAll('.store-popup-card a[href], .store-popup-card input:not([type=hidden]), .store-popup-card textarea, .store-popup-card button, .store-popup-card iframe'),
        function (el) { return !el.hidden; }
      );
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  window.addEventListener('hashchange', function () {
    var el = popupFor(location.hash);
    if (el) open(el, false); else close(false);
  });
  window.storePopup = { open: open, close: close };
  var initial = popupFor(location.hash) || document.querySelector('.store-popup.is-open');
  if (initial) { initial.classList.remove('is-open'); open(initial, false); }
})();
</script>
<script>
// Share sheet: a card's share button (or the one by the profile) fills it
// with that link — a popup's own link for popups, the page for the
// profile — and opens it. "More" is the phone's own share menu, where
// there is one.
(function () {
  var sheet = document.getElementById('share');
  if (!sheet || !window.storePopup) return;
  var urlText = sheet.querySelector('[data-share-url-text]');
  var nameText = sheet.querySelector('[data-share-name]');
  var copyBtn = sheet.querySelector('[data-share-copy]');
  var nativeBtn = sheet.querySelector('[data-share-native]');
  var shareUrl = '';
  var shareTitle = '';
  var targets = {
    whatsapp: function (u, t) { return 'https://wa.me/?text=' + encodeURIComponent(t + ' ' + u); },
    x: function (u, t) { return 'https://x.com/intent/post?url=' + encodeURIComponent(u) + '&text=' + encodeURIComponent(t); },
    facebook: function (u) { return 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(u); },
    linkedin: function (u) { return 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(u); },
    email: function (u, t) { return 'mailto:?subject=' + encodeURIComponent(t) + '&body=' + encodeURIComponent(u); },
  };
  // The page's own address, without ?subscribed= / ?sent= and any #popup.
  function pageBase() {
    var search = location.search.replace(/([?&])(subscribed|sent)=\d+&?/g, '$1').replace(/[?&]$/, '');
    return location.origin + location.pathname + search;
  }
  function absolute(raw) {
    if (!raw || raw === '/') return pageBase();
    if (raw.charAt(0) === '#') return pageBase() + raw;
    try { return new URL(raw, location.href).href; } catch (e) { return raw; }
  }
  if (navigator.share) nativeBtn.hidden = false;
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.store-share-btn');
    if (!btn) return;
    e.preventDefault();
    shareUrl = absolute(btn.getAttribute('data-share-url'));
    shareTitle = btn.getAttribute('data-share-title') || document.title;
    nameText.textContent = shareTitle;
    urlText.textContent = shareUrl.replace(/^https?:\/\//, '');
    copyBtn.textContent = 'Copy';
    sheet.querySelectorAll('[data-share-to]').forEach(function (a) {
      a.href = targets[a.getAttribute('data-share-to')](shareUrl, shareTitle);
    });
    window.storePopup.open(sheet, true);
  });
  copyBtn.addEventListener('click', function () {
    var done = function (ok) { copyBtn.textContent = ok ? 'Copied' : 'Copy failed'; };
    if (navigator.clipboard) navigator.clipboard.writeText(shareUrl).then(function () { done(true); }, function () { done(false); });
    else done(false);
  });
  nativeBtn.addEventListener('click', function () {
    navigator.share({ title: shareTitle, url: shareUrl }).catch(function () {});
  });
})();
</script>
<script>
// Testimonial sliders (in their popups): the track scrolls (and snaps) on its own — swipe
// works with no script — this adds arrows, dots, and a slow auto-advance
// that stops for good once the visitor touches the slider, and never runs
// for people who asked for reduced motion.
(function () {
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-slider]').forEach(function (slider) {
    var track = slider.querySelector('[data-slider-track]');
    var dots = slider.querySelectorAll('[data-slider-dot]');
    var count = track.children.length;
    if (count < 2) return;
    // In a closed popup the track has no width yet: that's slide 0.
    // Where slide i sits (the last ones can't scroll past the end).
    function slideLeft(i) {
      var max = track.scrollWidth - track.clientWidth;
      return Math.min(track.children[i].offsetLeft - track.children[0].offsetLeft, max);
    }
    function current() {
      if (!track.clientWidth) return 0;
      var best = 0;
      for (var i = 1; i < count; i++) {
        if (Math.abs(slideLeft(i) - track.scrollLeft) < Math.abs(slideLeft(best) - track.scrollLeft)) best = i;
      }
      return best;
    }
    var counter = slider.closest('.store-popup') && slider.closest('.store-popup').querySelector('[data-slider-count]');
    // Where it's headed, so a quick second click goes one further even
    // while the first slide is still moving (current() would lag behind).
    // Arrows, dots and keys glide to a slide with our own short animation
    // (the browser's smooth scroll stalls on a snapping track, and a second
    // click mid-way would land short); snapping is paused while it runs.
    // While it runs, the slide it's headed to counts; a swipe takes over.
    var index = 0;
    var moving = false;
    var raf = null;
    function settle() {
      cancelAnimationFrame(raf);
      track.style.scrollSnapType = '';
      track.style.scrollBehavior = '';
      moving = false;
    }
    function go(i) {
      index = (i + count) % count;
      var to = slideLeft(index);
      cancelAnimationFrame(raf);
      moving = true;
      paint();
      if (reduceMotion) { track.scrollLeft = to; settle(); return; }
      var from = track.scrollLeft;
      var start = performance.now();
      track.style.scrollSnapType = 'none';
      track.style.scrollBehavior = 'auto';
      (function step(now) {
        var t = Math.min(1, (now - start) / 320);
        track.scrollLeft = from + (to - from) * (1 - Math.pow(1 - t, 3));
        if (t < 1) raf = requestAnimationFrame(step);
        else { settle(); paint(); }
      })(start);
    }
    function paint() {
      var i = moving ? index : current();
      index = i;
      if (counter) counter.textContent = (i + 1) + ' / ' + count;
      dots.forEach(function (dot, d) {
        if (d === i) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current');
      });
    }
    var timer = null;
    function stop() { clearInterval(timer); timer = null; }
    slider.querySelector('[data-slider-prev]').addEventListener('click', function () { stop(); go(index - 1); });
    slider.querySelector('[data-slider-next]').addEventListener('click', function () { stop(); go(index + 1); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () { stop(); go(Number(dot.getAttribute('data-slider-dot'))); });
    });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); stop(); go(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); stop(); go(index + 1); }
    });
    var scrollStopTimer = null;
    track.addEventListener('scroll', function () { clearTimeout(scrollStopTimer); scrollStopTimer = setTimeout(paint, 60); }, { passive: true });
    ['pointerdown', 'touchstart', 'wheel', 'focusin'].forEach(function (type) {
      slider.addEventListener(type, stop, { passive: true });
    });
    // A swipe or wheel on the track takes over from a scripted move.
    ['touchstart', 'wheel'].forEach(function (type) {
      track.addEventListener(type, function () { if (moving) settle(); }, { passive: true });
    });
    // In a popup: start from the first testimonial each time it opens, and
    // don't auto-advance — the visitor opened it to read.
    var popup = slider.closest('.store-popup');
    if (popup) {
      // The popup is already showing when this fires, so it can be done at
      // once (waiting a frame could undo a click made right after opening).
      popup.addEventListener('store:popup-open', function () {
        if (moving) settle();
        track.style.scrollBehavior = 'auto';
        track.scrollLeft = 0;
        track.style.scrollBehavior = '';
        index = 0;
        paint();
      });
    }
    if (!reduceMotion && !popup) {
      // Paused while the pointer rests on it (to read), and only runs
      // while it's on screen with the tab visible.
      var hovering = false;
      slider.addEventListener('mouseenter', function () { hovering = true; });
      slider.addEventListener('mouseleave', function () { hovering = false; });
      timer = setInterval(function () {
        var box = slider.getBoundingClientRect();
        if (hovering || document.hidden || !box.width || box.bottom < 0 || box.top > window.innerHeight) return;
        go(index + 1);
      }, 6000);
    }
  });
})();
</script>
</body>
</html>
