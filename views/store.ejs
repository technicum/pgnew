<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<% if (owner.bio) { %><meta name="description" content="<%= owner.bio %>" /><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
<link rel="stylesheet" href="/css/store.css?v=<%= assetVersion %>" />
</head>
<body style="--store-accent: <%= owner.accent %>;">

<main class="store">
  <header class="store-header">
    <div class="store-avatar" aria-hidden="true"><%= owner.initials %></div>
    <h1 class="store-name"><%= owner.name %></h1>
    <% if (owner.bio) { %><p class="store-bio"><%= owner.bio %></p><% } %>
    <% if (owner.socials.length) { %>
      <nav class="store-socials" aria-label="Find me on">
        <% owner.socials.forEach(function (s) { %>
          <a class="store-social" href="<%= s.href %>" title="<%= s.label %>" aria-label="<%= s.label %>"<% if (/^https?:/.test(s.href)) { %> target="_blank" rel="noopener noreferrer me"<% } %>>
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="19" height="19" aria-hidden="true"><%- s.icon %></svg>
          </a>
        <% }) %>
      </nav>
    <% } %>
  </header>

  <% if (!blocks.length) { %>
    <p class="store-empty">Nothing here yet — check back soon.</p>
  <% } %>

  <div class="store-blocks">
    <% blocks.forEach(function (block) { %>
      <% if (block.type === 'text') { %>
        <section class="store-text">
          <h2><%= block.title %></h2>
          <% if (block.sub) { %><p><%= block.sub %></p><% } %>
        </section>
      <% } else if (block.type === 'testimonial') { %>
        <figure class="store-quote">
          <blockquote><%= block.title %></blockquote>
          <% if (block.sub) { %><figcaption><%= block.sub %></figcaption><% } %>
        </figure>
      <% } else if (block.type === 'newsletter') { %>
        <%# Posts to the store home (lib/storefront.js newsletterSignup); the visitor lands in Audience. %>
        <% var result = signup && signup.blockId === block.id ? signup : null; %>
        <section class="store-newsletter" id="nl-<%= block.id %>">
          <div class="store-newsletter-head">
            <span class="store-newsletter-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m22 7-10 6L2 7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </span>
            <div>
              <h2 class="store-newsletter-title"><%= block.title %></h2>
              <% if (block.sub) { %><p class="store-newsletter-sub"><%= block.sub %></p><% } %>
            </div>
          </div>
          <% if (result && result.ok) { %>
            <p class="store-newsletter-done" role="status"><%= result.message %></p>
          <% } else { %>
            <form class="store-newsletter-form" method="post" action="/#nl-<%= block.id %>">
              <input type="hidden" name="block" value="<%= block.id %>" />
              <label class="store-sr" for="nl-email-<%= block.id %>">Email address</label>
              <input class="store-input" id="nl-email-<%= block.id %>" type="email" name="email" required autocomplete="email" placeholder="you@example.com" value="<%= result ? result.email : '' %>"<% if (result) { %> aria-invalid="true" aria-describedby="nl-error-<%= block.id %>"<% } %> />
              <button class="store-button" type="submit">Subscribe</button>
            </form>
            <% if (result) { %><p class="store-newsletter-error" id="nl-error-<%= block.id %>" role="alert"><%= result.message %></p><% } %>
          <% } %>
        </section>
      <% } else if (block.href) { %>
        <%# Links off the store open in a new tab; the store's own pages (a booking block → /book) don't. %>
        <a class="store-block store-block-link" href="<%= block.href %>"<% if (/^https?:/.test(block.href)) { %> target="_blank" rel="noopener noreferrer nofollow"<% } %>>
          <span class="store-block-body">
            <span class="store-block-title"><%= block.title %></span>
            <span class="store-block-sub"><%= block.sub %></span>
          </span>
          <svg class="store-block-arrow" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      <% } else { %>
        <div class="store-block">
          <span class="store-block-body">
            <span class="store-block-label"><%= block.label %></span>
            <span class="store-block-title"><%= block.title %></span>
            <% if (block.sub) { %><span class="store-block-sub"><%= block.sub %></span><% } %>
          </span>
          <% if (block.price) { %><span class="store-block-price"><%= block.price %></span><% } %>
        </div>
      <% } %>
    <% }) %>
  </div>

  <% if (owner.showBadge) { %>
    <footer class="store-badge">
      <a href="<%= mainSiteUrl %>">Made with <strong><%= siteName %></strong></a>
    </footer>
  <% } %>
</main>

</body>
</html>
