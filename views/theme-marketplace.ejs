<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · PageZaper</title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .tm-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1140px;
      margin: 0 auto;
      padding: 24px 24px 0;
    }
    .tm-logo { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; }
    .tm-nav a.btn { padding: 9px 18px; font-size: 0.88rem; }
    .tm-hero {
      max-width: 1140px;
      margin: 0 auto;
      padding: 40px 24px 8px;
      text-align: center;
    }
    .tm-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: 10px;
    }
    .tm-hero h1 { font-size: 2.1rem; margin: 0 0 10px; letter-spacing: -0.02em; }
    .tm-hero p { color: var(--color-muted); max-width: 480px; margin: 0 auto; line-height: 1.6; }
    .tm-grid {
      max-width: 1140px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }
    .tm-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .tm-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
    .tm-card-thumb {
      height: 140px;
      background: linear-gradient(135deg, var(--thumb-from), var(--thumb-to));
      position: relative;
    }
    .tm-card-price {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(255,255,255,0.92);
      color: #1a1a1a;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .tm-card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
    .tm-card-name { font-weight: 700; font-size: 1.05rem; margin-bottom: 6px; }
    .tm-card-desc { color: var(--color-muted); font-size: 0.88rem; line-height: 1.55; margin: 0 0 18px; flex: 1; }
    .tm-card-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .tm-card-actions a {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: var(--radius);
      border: 1px solid var(--color-border);
    }
    .tm-card-actions a.primary { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
    .tm-empty { text-align: center; color: var(--color-muted); padding: 60px 0; }
  </style>
</head>
<body>
  <div class="tm-nav">
    <div class="tm-logo">PageZaper</div>
    <a href="<%= rootUrl %>" class="btn" style="border:1px solid var(--color-border); background:transparent; color:var(--color-text);">Back to PageZaper</a>
  </div>

  <div class="tm-hero">
    <div class="tm-eyebrow">Theme Marketplace</div>
    <h1>Storefront themes for your PageZaper store</h1>
    <p>Every theme changes your store's structure, not just its colors — pick one, preview it live, and switch anytime without losing your pages or products.</p>
  </div>

  <div class="tm-grid">
    <% themes.forEach(function(t) { %>
      <div class="tm-card">
        <div class="tm-card-thumb" style="--thumb-from: <%= t.swatchFrom %>; --thumb-to: <%= t.swatchTo %>;">
          <span class="tm-card-price"><%= t.price_cents > 0 ? '₹' + (t.price_cents / 100).toFixed(2) : 'Free' %></span>
        </div>
        <div class="tm-card-body">
          <div class="tm-card-name"><%= t.name %></div>
          <% if (t.description) { %><p class="tm-card-desc"><%= t.description %></p><% } %>
          <div class="tm-card-actions">
            <% if (t.demoUrl) { %><a href="<%= t.demoUrl %>" target="_blank" rel="noopener">View demo ↗</a><% } %>
            <a href="<%= signupUrl %>" class="primary">Get started ↗</a>
          </div>
        </div>
      </div>
    <% }); %>
    <% if (themes.length === 0) { %>
      <p class="tm-empty">No themes published yet — check back shortly.</p>
    <% } %>
  </div>
</body>
</html>
