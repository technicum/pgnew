<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<% if (page.description) { %><meta name="description" content="<%= page.description.slice(0, 160) %>" /><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="/css/payment-page.css?v=<%= assetVersion %>" />
<script>document.documentElement.classList.add('js');</script>
</head>
<%
// Three designs, picked from the products (lib/paymentStorefront.js
// layoutFor) — there are no tabs: 'single' is one product with a checkout
// card beside it, 'multi' a product grid the buyer adds to a cart from,
// 'coffee' a single support card. All three sit under the same hero.
var ICONS = {
  digital: '<path d="M12 15V3"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/>',
  physical: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>',
  coffee: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  warn: '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
};
var svg = function (name, size) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="' + (size || 16) + '" height="' + (size || 16) + '" aria-hidden="true">' + ICONS[name] + '</svg>';
};
var TYPE_LABEL = { digital: 'Instant download', physical: 'Ships to you', coffee: 'Support' };
// Thumbnail gradients for products without a picture, in turn.
var THUMBS = [['#ffe1d4', '#ffbfa5'], ['#fdeecd', '#f7d394'], ['#dcf4e8', '#a9e2c6'], ['#e6e3fc', '#c6c0f4']];
var line = {};
q.lines.forEach(function (l) { line[l.id] = l; });
var initials = owner.name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (p) { return p[0].toUpperCase(); }).join('') || '?';
var physical = page.products.filter(function (p) { return p.type === 'physical'; });
var product = page.products[0];
var stockOf = function (p) { return p.type === 'physical' && p.stock !== null && p.stock !== undefined ? p.stock : null; };
var isSoldOut = function (p) { var s = stockOf(p); return s !== null && s < 1; };
var percentOff = function (p) { return p.pricing === 'fixed' && p.compareAt ? Math.round((1 - p.price / p.compareAt) * 100) : 0; };
// In the cart, only a quantity-priced product (or a coffee) goes past 1.
var cartMax = function (p) { return isSoldOut(p) ? 0 : (p.pricing === 'qty' ? maxQtyFor(p) : 1); };
var safeMedia = function (url) { return /^(https?:\/\/|\/uploads\/)/i.test(url || '') ? url : ''; };
var coverColor = /^#[0-9a-f]{6}$/i.test(page.cover_color || '') ? page.cover_color : '';
var cover = null;
if (page.show_cover) {
  if (page.cover_type === 'image' && safeMedia(page.cover_image_url)) cover = { kind: 'image', src: page.cover_image_url };
  else if (page.cover_type === 'video' && safeMedia(page.cover_video_url)) cover = { kind: 'video', src: page.cover_video_url };
}
var shipsOnly = physical.length === page.products.length;

// Facts under the hero title — only things that are true of these products.
var stats = [];
var saving = page.products.reduce(function (sum, p) { return sum + (p.pricing === 'fixed' && p.compareAt ? p.compareAt - p.price : 0); }, 0);
if (layout === 'multi') stats.push([page.products.length, 'products']);
if (layout === 'single' && percentOff(product)) stats.push([percentOff(product) + '% off', 'today']);
else if (saving) stats.push(['Save ' + formatINR(saving), layout === 'multi' ? 'across the store' : 'today']);
if (layout === 'coffee') stats.push([formatINR(product.price), 'a coffee']);
else if (shipsOnly) stats.push([physical.some(function (p) { return p.shipFee; }) ? 'Delivered' : 'Free', 'shipping']);
else stats.push(['Instant', physical.length ? 'access to downloads' : 'access']);
%>
<body class="cx-page" style="<%= lmThemeStyle(page) %>">

<%# ---------- pieces shared by the layouts ---------- %>
<% var creatorRow = function () { %>
  <div class="cx-creator">
    <span class="cx-pfp" aria-hidden="true"><%= initials %></span>
    <div><b><%= owner.name %></b><small>@<%= owner.handle %></small></div>
  </div>
<% }; %>
<% var notices = function () { %>
  <% if (mode === 'test') { %>
  <p class="cx-test-note"><%- svg('warn', 14) %>Test mode — no real payment is taken.</p>
  <% } %>
  <% if (error) { %><div class="cx-error" role="alert"><%= error %></div><% } %>
<% }; %>
<% var summaryHead = function (heading) { %>
  <div class="cx-summary-head">
    <span class="cx-shield"><%- svg('lock', 16) %></span>
    <h2><%= heading %></h2>
    <span class="cx-secure-tag">Secure</span>
  </div>
<% }; %>
<% var buyerFields = function (emailLabel) { %>
  <div class="cx-field">
    <label for="name">Full name</label>
    <input type="text" id="name" name="name" value="<%= values.name %>" placeholder="Your name" autocomplete="name" required />
  </div>
  <div class="cx-field">
    <label for="email"><%= emailLabel || 'Email' %></label>
    <input type="email" id="email" name="email" value="<%= values.email %>" placeholder="you@email.com" autocomplete="email" required />
  </div>
<% }; %>
<% var qtyStepper = function (p) {
     var max = maxQtyFor(p); var chosen = values.items[p.id] || {}; %>
  <div class="pp-qty" data-max="<%= Math.max(1, max) %>">
    <button type="button" class="pp-qty-btn" data-step="-1" aria-label="One fewer <%= p.title %>">−</button>
    <input type="number" name="qty_<%= p.id %>" value="<%= chosen.qty || 1 %>" min="1" max="<%= Math.max(1, max) %>" inputmode="numeric" aria-label="Quantity of <%= p.title %>"<%= isSoldOut(p) ? ' disabled' : '' %> />
    <button type="button" class="pp-qty-btn" data-step="1" aria-label="One more <%= p.title %>">+</button>
  </div>
<% }; %>
<% var amountInput = function (p) { var chosen = values.items[p.id] || {}; %>
  <div class="cx-amount">
    <span aria-hidden="true">₹</span>
    <input type="text" inputmode="decimal" name="amount_<%= p.id %>" value="<%= chosen.amount === undefined ? '' : chosen.amount %>" autocomplete="off" aria-label="Your amount for <%= p.title %>" />
  </div>
  <p class="cx-hint"><%= p.minimum ? 'Min ' + formatINR(p.minimum) : 'Any amount' %></p>
<% }; %>
<% var shippingFields = function () {
     // On a multi-product page the address is only asked for once the cart
     // holds something that ships (the script shows / hides it).
     var needed = layout !== 'multi' || q.hasPhysical;
     var useNew = values.addressId === 'new'; %>
  <div class="cx-ship" id="shipFields"<%= needed ? '' : ' hidden' %>>
    <div class="cx-ship-note">
      <%- svg('info', 14) %>
      <span><%= addresses.length ? 'Deliver to' : (layout === 'multi' ? 'Some of your order ships to you — add your address.' : 'This ships to you — add your address below.') %></span>
    </div>
    <% if (addresses.length) { %>
    <%# A signed-in buyer's saved addresses (lib/customers.js), the default first. %>
    <div class="cx-addresses" role="radiogroup" aria-label="Delivery address">
      <% addresses.forEach(function (a) { var on = values.addressId === String(a.id); %>
      <label class="cx-address<%= on ? ' active' : '' %>">
        <input type="radio" name="address_id" value="<%= a.id %>"<%= on ? ' checked' : '' %> />
        <span>
          <b><%= a.label || a.name || 'Address' %><% if (a.is_default) { %> <em>Default</em><% } %></b>
          <small><%= a.line %>, <%= a.city %> <%= a.pincode %><%= a.phone ? ' · ' + a.phone : '' %></small>
        </span>
      </label>
      <% }) %>
      <label class="cx-address cx-address-new<%= useNew ? ' active' : '' %>">
        <input type="radio" name="address_id" value="new"<%= useNew ? ' checked' : '' %> />
        <span><b>+ Deliver to a new address</b></span>
      </label>
    </div>
    <% } %>
    <div class="cx-new-address" id="newAddress"<%= useNew ? '' : ' hidden' %>>
      <div class="cx-field">
        <label for="address">Address line</label>
        <input type="text" id="address" name="address" value="<%= values.address %>" placeholder="House no, street, area" autocomplete="street-address" />
      </div>
      <div class="cx-field-row">
        <div class="cx-field">
          <label for="city">City</label>
          <input type="text" id="city" name="city" value="<%= values.city %>" placeholder="City" autocomplete="address-level2" />
        </div>
        <div class="cx-field">
          <label for="pincode">Pincode</label>
          <input type="text" id="pincode" name="pincode" value="<%= values.pincode %>" placeholder="Pincode" inputmode="numeric" maxlength="6" autocomplete="postal-code" />
        </div>
      </div>
      <div class="cx-field">
        <label for="phone">Phone <span class="cx-optional">(optional, for delivery updates)</span></label>
        <input type="tel" id="phone" name="phone" value="<%= values.phone %>" placeholder="+91 98765 43210" autocomplete="tel" />
      </div>
      <% if (customer) { %>
      <label class="cx-check"><input type="checkbox" name="save_address" value="1"<%= values.saveAddress ? ' checked' : '' %> /> Save this address to my account</label>
      <% } else { %>
      <p class="cx-hint"><a href="/account/login?next=/pay/<%= page.slug %>">Sign in</a> to save addresses for next time.</p>
      <% } %>
    </div>
  </div>
<% }; %>
<% var accountBar = function () { %>
  <%# Buyer sign-in (lib/customerAccount.js) — prefills checkout and saved addresses. %>
  <% if (customer) { %>
  <div class="cx-account is-in">
    <span class="cx-account-pfp" aria-hidden="true"><%= (customer.name || '?').trim().charAt(0).toUpperCase() %></span>
    <span class="cx-account-who">Signed in as <b><%= customer.name %></b><small><%= customer.email %></small></span>
    <span class="cx-account-links"><a href="/account">Addresses</a><button type="submit" form="logoutForm">Sign out</button></span>
  </div>
  <% } else { %>
  <div class="cx-account">
    <span aria-hidden="true">👤</span>
    <span>Have an account? <a href="/account/login?next=/pay/<%= page.slug %>">Sign in</a> for faster checkout<% if (page.has_physical) { %> with saved addresses<% } %>.</span>
  </div>
  <% } %>
<% }; %>
<% var couponBox = function () { %>
  <div class="cx-coupon">
    <input type="text" id="coupon" name="coupon" value="<%= values.coupon %>" placeholder="Coupon code" autocomplete="off" autocapitalize="characters" aria-label="Coupon code" />
    <button type="button" id="couponApply">Apply</button>
  </div>
  <p class="cx-coupon-msg" id="couponMsg" aria-live="polite"><% if (q.coupon) { %>🎉 <%= q.coupon.code %> applied — <%= q.coupon.label %><% } %></p>
<% }; %>
<% var totals = function (subtotalLabel) { %>
  <div class="cx-totals" id="paySummary" aria-live="polite">
    <div class="row"><span><%- subtotalLabel %></span><span id="sumSubtotal"><%= q.display.subtotal %></span></div>
    <div class="row" id="sumDiscountRow"<%= q.discount ? '' : ' hidden' %>><span>Coupon <b id="sumCoupon"><%= q.coupon ? q.coupon.code : '' %></b></span><span class="pos" id="sumDiscount">−<%= q.display.discount %></span></div>
    <% if (page.has_physical) { %><div class="row" id="sumShippingRow"<%= q.hasPhysical ? '' : ' hidden' %>><span>Shipping</span><span id="sumShipping"><%= q.display.shipping %></span></div><% } %>
    <div class="row grand"><span>Total</span><span id="sumTotal"><%= q.display.total %></span></div>
  </div>
<% }; %>
<% var payButton = function (label, trust) { %>
  <%# Problems with the amounts chosen (below a minimum, over stock) as you type — the server says the same again on submit. %>
  <p class="cx-live-error" id="liveError" role="status" hidden></p>
  <button type="submit" class="cx-pay-btn" id="payButton" data-label="<%= label %>">
    <span id="payButtonText"><%= label %> <%= q.display.total %></span> →
  </button>
  <div class="cx-trust">
    <span><%- svg('lock', 12) %>Secure checkout</span>
    <% trust.forEach(function (t) { %><span><%= t %></span><% }) %>
  </div>
<% }; %>
<% var aboutCard = function (heading) { %>
  <% if (aboutHtml) { %>
  <%# The page's long description — lib/richText.js has already escaped it and allows only a few safe tags. %>
  <section class="cx-card cx-about" aria-label="<%= heading %>">
    <h2><%= heading %></h2>
    <div class="cx-rich"><%- aboutHtml %></div>
  </section>
  <% } %>
<% }; %>
<% var mediaBlock = function (m, title, extraClass) { %>
  <%# A product's own picture or video (builder → Products tab). Embeds are YouTube / Vimeo players rebuilt from the video id in lib/paymentPages.js. %>
  <div class="cx-own-media cx-own-<%= m.kind %><%= extraClass ? ' ' + extraClass : '' %>">
    <% if (m.kind === 'image') { %>
    <img src="<%= m.src %>" alt="<%= title %>" loading="lazy" />
    <% } else if (m.kind === 'video') { %>
    <video src="<%= m.src %>" controls playsinline preload="metadata" aria-label="<%= title %>"></video>
    <% } else { %>
    <iframe src="<%= m.src %>" title="<%= title %>" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <% } %>
  </div>
<% }; %>

<%# ---------- hero ---------- %>
<header class="cx-hero" id="top"<% if (coverColor) { %> style="--cover-color:<%= coverColor %>;"<% } %>>
  <% if (cover && cover.kind === 'image') { %>
  <img class="cx-hero-cover" src="<%= cover.src %>" alt="" aria-hidden="true" decoding="async" />
  <% } else if (cover && cover.kind === 'video') { %>
  <video class="cx-hero-cover" src="<%= cover.src %>" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
  <% } %>
  <div class="cx-hero-wash<%= page.show_cover && page.cover_type === 'color' && coverColor ? ' cx-hero-color' : '' %>"></div>
  <div class="cx-hero-inner">
    <a class="cx-brand" href="#top">
      <span class="cx-brand-mark"><%= initials %></span>
      <span class="cx-brand-name"><%= owner.name %></span>
      <span class="cx-brand-tag"><%= siteName %> store</span>
    </a>
    <h1 class="cx-hero-title"><%= page.title %></h1>
    <% if (page.description) { %><p class="cx-hero-sub"><%= page.description %></p><% } %>
    <div class="cx-hero-actions">
      <a class="cx-hero-cta" href="#checkout"><%= layout === 'multi' ? 'Browse the store' : (layout === 'coffee' ? 'Buy a coffee' : 'Get it now') %> ↓</a>
      <span class="cx-hero-note"><%- svg('lock', 12) %> Secure checkout</span>
    </div>
    <ul class="cx-hero-stats">
      <% stats.forEach(function (s) { %><li><b><%= s[0] %></b><span><%= s[1] %></span></li><% }) %>
    </ul>
  </div>
</header>

<form method="POST" action="/pay/<%= page.slug %>" id="payForm" novalidate data-quote-url="/pay/<%= page.slug %>/quote" data-layout="<%= layout %>" data-draft-url="/pay/<%= page.slug %>/draft">
<input type="hidden" name="draft_key" value="<%= values.draftKey %>" />

<% if (layout === 'single') {
     var l1 = line[product.id]; var m1 = productMedia(product); var off = percentOff(product);
     var stock1 = stockOf(product); %>
<%# ================= SINGLE PRODUCT ================= %>
<main class="cx-wrap cx-grid" id="checkout">
  <div>
    <% creatorRow(); %>
    <div class="cx-eyebrow-row"><span class="cx-eyebrow"><%= TYPE_LABEL[product.type] %></span></div>
    <h2 class="cx-title"><%= product.title %></h2>
    <% if (product.description) { %><p class="cx-lead"><%= product.description %></p><% } %>
    <% if (stock1 !== null && stock1 <= 10) { %>
    <div class="cx-stock"><span class="lbl"><%= stock1 < 1 ? 'Sold out' : 'Selling fast' %></span><% if (stock1 > 0) { %><span class="seats">Only <%= stock1 %> left</span><% } %></div>
    <% } %>
    <% if (m1) { mediaBlock(m1, product.title); } else { %>
    <div class="cx-media">
      <div class="glow"></div>
      <span class="badge"><%= TYPE_LABEL[product.type] %></span>
      <span class="icon"><%- svg(product.type, 40) %></span>
      <h3><%= product.title %></h3>
      <p>Sold by <%= owner.name %></p>
    </div>
    <% } %>
    <ul class="cx-features">
      <% if (product.type === 'digital') { %><li><span class="tick">✓</span>Instant access after payment</li><% } %>
      <% if (product.type === 'physical') { %><li><span class="tick">✓</span><%= product.shipFee ? 'Shipped to your door (' + formatINR(product.shipFee) + ' delivery)' : 'Free shipping to your door' %></li><% } %>
      <% if (product.pricing === 'pwyw') { %><li><span class="tick">✓</span>Pay what you want<%= product.minimum ? ' — from ' + formatINR(product.minimum) : '' %></li><% } %>
      <% if (product.pricing === 'qty' && product.maxQty) { %><li><span class="tick">✓</span>Up to <%= product.maxQty %> per order</li><% } %>
      <% if (off) { %><li><span class="tick">✓</span>Save <%= formatINR(product.compareAt - product.price) %> on the usual price</li><% } %>
      <li><span class="tick">✓</span>Receipt emailed to you</li>
    </ul>
    <% aboutCard('About this ' + (product.type === 'physical' ? 'product' : 'purchase')); %>
  </div>

  <aside class="cx-card cx-summary-card">
    <% summaryHead('Checkout'); %>
    <div class="cx-price-row">
      <% if (product.pricing === 'pwyw') { %>
        <span class="cx-price-now cx-price-text">Pay what you want</span>
      <% } else { %>
        <span class="cx-price-now"><%= formatINR(product.price) %></span>
        <% if (product.pricing === 'qty') { %><span class="cx-price-plain">each</span><% } %>
        <% if (off) { %>
          <span class="cx-price-was"><%= formatINR(product.compareAt) %></span>
          <span class="cx-price-off"><%= off %>% OFF</span>
        <% } %>
      <% } %>
    </div>
    <% notices(); %>
    <% accountBar(); %>
    <% if (product.pricing === 'qty') { %>
    <div class="cx-field"><span class="cx-label">Quantity</span><% qtyStepper(product); %></div>
    <% } else if (product.pricing === 'pwyw') { %>
    <div class="cx-field"><span class="cx-label">Your amount</span><% amountInput(product); %></div>
    <% } %>
    <% buyerFields(); %>
    <% if (page.has_physical) { shippingFields(); } %>
    <% couponBox(); %>
    <% totals(product.pricing === 'qty' ? 'Price <span class="cx-muted" data-qty-label-for="' + product.id + '">× ' + l1.qty + '</span>' : 'Price'); %>
    <% payButton('Pay', [product.type === 'physical' ? '📦 Ships to you' : '⚡ Instant access']); %>
  </aside>
</main>

<% } else if (layout === 'multi') { %>
<%# ================= MULTIPLE PRODUCTS ================= %>
<main class="cx-wrap cx-grid" id="checkout">
  <div>
    <% creatorRow(); %>
    <div class="cx-eyebrow-row"><span class="cx-eyebrow">🛍️ <%= page.products.length %> products</span></div>
    <h2 class="cx-title">Pick your products</h2>
    <p class="cx-lead">Add what you want to your cart — everything is paid for in one checkout.</p>
    <div class="cx-product-grid">
      <% page.products.forEach(function (p, i) {
           var chosen = values.items[p.id] || {}; var max = cartMax(p);
           var qtyNow = Math.min(max, Math.max(0, Number(chosen.qty) || 0));
           var m = productMedia(p); var g = THUMBS[i % THUMBS.length]; var s = stockOf(p); var pOff = percentOff(p); %>
      <div class="cx-card cx-product<%= qtyNow > 0 ? ' added' : '' %><%= max < 1 ? ' sold-out' : '' %>" data-pid="<%= p.id %>" style="--g1:<%= g[0] %>;--g2:<%= g[1] %>">
        <div class="thumb">
          <% if (m && m.kind === 'image') { %><img src="<%= m.src %>" alt="<%= p.title %>" loading="lazy" /><% } else { %><span class="icon"><%- svg(p.type, 38) %></span><% } %>
          <% if (pOff) { %><span class="off"><%= pOff %>% off</span><% } %>
          <span class="tag"><%= max < 1 ? 'Sold out' : (s !== null && s <= 10 ? 'Only ' + s + ' left' : TYPE_LABEL[p.type]) %></span>
        </div>
        <div class="info">
          <div class="name"><%= p.title %></div>
          <% if (p.description) { %><div class="desc" title="<%= p.description %>"><%= p.description %></div><% } %>
          <div class="prices">
            <% if (p.pricing === 'pwyw') { %>
              <span class="p">Pay what you want</span>
            <% } else { %>
              <span class="p"><%= formatINR(p.price) %></span>
              <% if (p.pricing === 'qty') { %><span class="p-was p-each"><%= p.type === 'coffee' ? 'a coffee' : 'each' %></span><% } %>
              <% if (pOff) { %><span class="p-was"><%= formatINR(p.compareAt) %></span><% } %>
            <% } %>
          </div>
          <% if (p.pricing === 'pwyw') { %><div class="cx-pwyw"><% amountInput(p); %></div><% } %>
        </div>
        <div class="add-btn">
          <% if (max < 1) { %>
          <span class="add-label">Sold out</span>
          <input type="hidden" name="qty_<%= p.id %>" value="0" />
          <% } else { %>
          <button type="button" class="add-label" data-add>+ Add to cart</button>
          <span class="qty">
            <span class="qty-label">In cart</span>
            <button type="button" class="minus" data-step="-1" aria-label="One fewer <%= p.title %>">−</button>
            <input type="number" class="n" name="qty_<%= p.id %>" value="<%= qtyNow %>" min="0" max="<%= max %>" inputmode="numeric" aria-label="Quantity of <%= p.title %> in your cart" />
            <button type="button" class="plus" data-step="1" aria-label="One more <%= p.title %>"<%= qtyNow >= max ? ' disabled' : '' %>>+</button>
          </span>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% aboutCard('About this store'); %>
  </div>

  <aside class="cx-card cx-summary-card">
    <% summaryHead('Your order'); %>
    <% notices(); %>
    <% accountBar(); %>
    <div class="cx-cart-lines" id="cartLines">
      <% if (!q.lines.length) { %>
      <p class="cx-muted cx-small">Your cart is empty — add products to continue.</p>
      <% } %>
      <% q.lines.forEach(function (l) { %>
      <div class="cx-cart-line"><span><%= l.title %> <span class="cx-muted">× <%= l.qty %></span></span><b><%= q.display.lines[l.id] %></b></div>
      <% }) %>
    </div>
    <% buyerFields('Email for delivery'); %>
    <% if (page.has_physical) { shippingFields(); } %>
    <% couponBox(); %>
    <% totals('Items (<span id="cartCount">' + q.lines.reduce(function (n, l) { return n + l.qty; }, 0) + '</span>)'); %>
    <% payButton('Pay', [physical.length ? '📦 Tracked delivery' : '⚡ Instant delivery']); %>
  </aside>
</main>

<% } else {
     var coffee = product; var chosenCoffee = values.items[coffee.id] || {};
     var custom = chosenCoffee.amount !== undefined && chosenCoffee.amount !== '';
     var qtyNow = Number(chosenCoffee.qty) || 2; var mc = productMedia(coffee); %>
<%# ================= BUY ME A COFFEE ================= %>
<main class="cx-wrap" id="checkout">
  <div class="cx-coffee-hero">
    <div class="cup">☕</div>
    <h2 class="cx-title"><%= coffee.title %></h2>
    <p><%= coffee.description || 'If my work made you smile or saved you time, a small coffee keeps the ideas brewing.' %></p>
  </div>
  <div class="cx-card cx-coffee-card">
    <% if (mc) { mediaBlock(mc, coffee.title, 'cx-coffee-media'); } %>
    <% creatorRow(); %>
    <% notices(); %>
    <% accountBar(); %>
    <div class="cx-amounts" data-coffee="<%= coffee.id %>">
      <% [1, 2, 3, 5].forEach(function (n) { var on = !custom && qtyNow === n; %>
      <button type="button" class="<%= on ? 'active' : '' %>" data-qty="<%= n %>" aria-pressed="<%= on ? 'true' : 'false' %>">
        <span class="cups" aria-hidden="true"><%= '☕'.repeat(Math.min(n, 4)) %></span>
        <span class="amt"><%= formatINR(coffee.price * n) %></span>
        <span class="cx-sr"><%= n %> <%= n === 1 ? 'coffee' : 'coffees' %></span>
      </button>
      <% }) %>
    </div>
    <input type="hidden" name="qty_<%= coffee.id %>" value="<%= qtyNow %>" />
    <div class="cx-field cx-custom-amt<%= custom ? ' active' : '' %>">
      <span class="rupee" aria-hidden="true">₹</span>
      <input type="text" inputmode="decimal" name="amount_<%= coffee.id %>" value="<%= custom ? chosenCoffee.amount : '' %>" placeholder="Or enter a custom amount (min <%= formatINR(coffee.price) %>)" autocomplete="off" aria-label="Your own amount" />
    </div>
    <div class="cx-field">
      <label for="note">Say something nice <span class="cx-optional">(optional)</span></label>
      <textarea id="note" name="note" maxlength="300" placeholder="Leave a message of support…"><%= values.note %></textarea>
    </div>
    <% buyerFields('Email (for the receipt)'); %>
    <div class="cx-totals" id="paySummary" aria-live="polite">
      <div class="row"><span>Support</span><span id="sumSubtotal"><%= q.display.subtotal %></span></div>
      <div class="row"><span>Platform fee</span><span class="pos">₹0 — 100% to <%= owner.name.split(/\s+/)[0] %></span></div>
      <div class="row grand"><span>Total</span><span id="sumTotal"><%= q.display.total %></span></div>
    </div>
    <% payButton('Support with', ['💛 No account needed']); %>
  </div>
  <% aboutCard('More about this'); %>
</main>
<% } %>

</form>
<% if (customer) { %>
<form id="logoutForm" method="POST" action="/account/logout" hidden><input type="hidden" name="next" value="/pay/<%= page.slug %>" /></form>
<% } %>

<div class="cx-foot-note">Powered by <b><%= siteName %></b> · Secure checkout</div>

<script src="/js/payment-page.js?v=<%= assetVersion %>"></script>
</body>
</html>
