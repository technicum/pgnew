<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<% if (page.description) { %><meta name="description" content="<%= page.description.slice(0, 160) %>" /><% } %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css" />
<link rel="stylesheet" href="/css/auth.css" />
<link rel="stylesheet" href="/css/lead-magnet.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/payment-page.css?v=<%= assetVersion %>" />
</head>
<%
// Icons for each product type, shared with the receipt.
var ppIcons = {
  digital: '<path d="M12 15V3"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  physical: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>',
  coffee: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/>',
};
var ppTypeLabel = { digital: 'Instant download', physical: 'Ships to you', coffee: 'Support' };
var ppLine = {};
q.lines.forEach(function (l) { ppLine[l.id] = l; });
var ppKicker = 'Secure checkout';
%>
<body class="lm-page" style="<%= lmThemeStyle(page) %>">

<main class="lm-shell">

  <div class="lm-head">
    <a href="/" class="logo lm-brand"><%= owner.name %></a>
  </div>

  <article class="lm-card">
    <% if (page.show_cover) { %>
    <header class="lm-hero">
      <%- include('partials/lm-banner', { magnet: page }) %>
      <div class="lm-hero-text">
        <span class="lm-kicker"><span class="dot"></span><%= ppKicker %></span>
        <h1><%= page.title %></h1>
      </div>
    </header>
    <% } %>

    <form method="POST" action="/pay/<%= page.slug %>" id="payForm" novalidate data-quote-url="/pay/<%= page.slug %>/quote">
      <div class="lm-card-body pp-body">
        <% if (!page.show_cover) { %>
        <span class="lm-kicker"><span class="dot"></span><%= ppKicker %></span>
        <h1><%= page.title %></h1>
        <% } %>
        <% if (page.description) { %><p class="pp-desc"><%= page.description %></p><% } %>

        <% if (mode === 'test') { %>
        <p class="pp-test-note">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          Test mode — no real payment is taken.
        </p>
        <% } %>

        <% if (error) { %>
          <div class="auth-error" role="alert"><%= error %></div>
        <% } %>

        <ul class="pp-items" aria-label="What you’re buying">
          <% page.products.forEach(function (p) {
               var chosen = values.items[p.id] || {};
               var line = ppLine[p.id];
               var max = maxQtyFor(p);
               var soldOut = p.type === 'physical' && p.stock !== null && p.stock !== undefined && p.stock < 1; %>
          <li class="pp-item" data-pid="<%= p.id %>">
            <span class="pp-item-thumb pp-thumb-<%= p.type %>" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- ppIcons[p.type] %></svg>
            </span>
            <div class="pp-item-main">
              <p class="pp-item-title"><%= p.title %></p>
              <p class="pp-item-type">
                <%= ppTypeLabel[p.type] %><% if (p.pricing === 'pwyw') { %> · name your price<% } %>
                <% if (p.pricing === 'qty' && p.type !== 'coffee') { %> · <%= formatINR(p.price) %> each<% } %>
                <% if (p.type === 'coffee') { %> · <%= formatINR(p.price) %> a coffee<% } %>
                <% if (p.type === 'physical' && p.stock !== null && p.stock !== undefined && p.stock > 0 && p.stock <= 10) { %> · <span class="pp-stock-low">only <%= p.stock %> left</span><% } %>
                <% if (soldOut) { %> · <span class="pp-stock-low">sold out</span><% } %>
              </p>

              <% if (p.type === 'coffee') { %>
              <div class="pp-coffee" data-qty-for="<%= p.id %>">
                <% [1, 3, 5].forEach(function (n) { %>
                <button type="button" class="pp-coffee-pill<%= Number(chosen.qty || 1) === n ? ' active' : '' %>" data-set-qty="<%= n %>">×<%= n %></button>
                <% }) %>
                <label class="pp-coffee-custom">
                  <span>or</span>
                  <input type="number" name="qty_<%= p.id %>" value="<%= chosen.qty || 1 %>" min="1" max="<%= max %>" inputmode="numeric" aria-label="How many coffees" />
                </label>
              </div>
              <% } else if (p.pricing === 'qty') { %>
              <div class="pp-qty" data-qty-for="<%= p.id %>" data-max="<%= max %>">
                <button type="button" class="pp-qty-btn" data-step="-1" aria-label="One fewer <%= p.title %>">−</button>
                <input type="number" name="qty_<%= p.id %>" value="<%= chosen.qty || 1 %>" min="1" max="<%= Math.max(1, max) %>" inputmode="numeric" aria-label="Quantity of <%= p.title %>"<%= soldOut || max < 1 ? ' disabled' : '' %> />
                <button type="button" class="pp-qty-btn" data-step="1" aria-label="One more <%= p.title %>">+</button>
              </div>
              <% } else if (p.pricing === 'pwyw') { %>
              <div class="pp-amount">
                <span aria-hidden="true">₹</span>
                <input type="text" inputmode="decimal" name="amount_<%= p.id %>" value="<%= chosen.amount === undefined ? '' : chosen.amount %>" autocomplete="off" aria-label="Your amount for <%= p.title %>" />
              </div>
              <% if (p.minimum) { %><p class="pp-hint">Minimum <%= formatINR(p.minimum) %></p><% } %>
              <% } %>
            </div>
            <div class="pp-item-price">
              <% if (p.pricing === 'fixed' && p.compareAt) { %><s><%= formatINR(p.compareAt) %></s><% } %>
              <strong data-line-for="<%= p.id %>"><%= formatINR(line.amount) %></strong>
            </div>
          </li>
          <% }) %>
        </ul>

        <p class="pp-section-label">Your details</p>
        <div class="field">
          <label for="name">Your name<span class="lm-req" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" value="<%= values.name %>" placeholder="Full name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Your email<span class="lm-req" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" value="<%= values.email %>" placeholder="you@example.com" autocomplete="email" required />
        </div>

        <% if (page.has_physical) { %>
        <p class="pp-section-label">Shipping address</p>
        <div class="field">
          <label for="address">Address<span class="lm-req" aria-hidden="true">*</span></label>
          <input type="text" id="address" name="address" value="<%= values.address %>" placeholder="House, street, area" autocomplete="street-address" required />
        </div>
        <div class="pp-field-row">
          <div class="field">
            <label for="city">City<span class="lm-req" aria-hidden="true">*</span></label>
            <input type="text" id="city" name="city" value="<%= values.city %>" autocomplete="address-level2" required />
          </div>
          <div class="field">
            <label for="pincode">Pincode<span class="lm-req" aria-hidden="true">*</span></label>
            <input type="text" id="pincode" name="pincode" value="<%= values.pincode %>" inputmode="numeric" maxlength="6" autocomplete="postal-code" required />
          </div>
        </div>
        <div class="field">
          <label for="phone">Phone number<span class="lm-req" aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone %>" placeholder="For the delivery" autocomplete="tel" required />
        </div>
        <% } %>

        <details class="pp-coupon"<%= values.coupon ? ' open' : '' %>>
          <summary>Have a coupon code?</summary>
          <div class="pp-coupon-row">
            <input type="text" id="coupon" name="coupon" value="<%= values.coupon %>" placeholder="Enter code" autocomplete="off" autocapitalize="characters" aria-label="Coupon code" />
            <button type="button" class="pp-coupon-apply" id="couponApply">Apply</button>
          </div>
          <p class="pp-coupon-msg" id="couponMsg" aria-live="polite"><% if (q.coupon) { %><%= q.coupon.code %> applied — <%= q.coupon.label %><% } %></p>
        </details>

        <dl class="pp-summary" id="paySummary" aria-live="polite">
          <div><dt>Subtotal</dt><dd id="sumSubtotal"><%= q.display.subtotal %></dd></div>
          <div id="sumDiscountRow"<%= q.discount ? '' : ' hidden' %>><dt>Discount <span id="sumCoupon"><%= q.coupon ? q.coupon.code : '' %></span></dt><dd id="sumDiscount">−<%= q.display.discount %></dd></div>
          <% if (page.has_physical) { %><div><dt>Shipping</dt><dd id="sumShipping"><%= q.display.shipping %></dd></div><% } %>
          <div class="pp-summary-total"><dt>Total</dt><dd id="sumTotal"><%= q.display.total %></dd></div>
        </dl>

        <button type="submit" class="btn btn-primary pp-pay-btn" id="payButton">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="17" height="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          <span id="payButtonText">Pay <%= q.display.total %></span>
        </button>
      </div>
    </form>

    <p class="lm-card-foot">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="13" height="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      <span>Secure checkout. Your details go only to <%= owner.name %>.</span>
    </p>
  </article>

</main>

<script src="/js/payment-page.js?v=<%= assetVersion %>"></script>
</body>
</html>
