<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/lead-magnets.css?v=<%= assetVersion %>" />
<%# The live preview's canvas and device frame (studio.css), the real page in it (live-preview.css). %>
<link rel="stylesheet" href="/css/studio.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/live-preview.css?v=<%= assetVersion %>" />
</head>
<body>
<div class="min-h-screen bg-background">

  <%- include('partials/dashboard-sidebar', { navActive: '/dashboard/lead-magnets' }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <div>
        <p class="text-sm font-semibold text-primary" style="line-height:1;">Lead magnets</p>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <span class="pz-save-status" id="saveStatus"><span class="dot"></span><span id="saveStatusText">Saved</span></span>
        <div class="mx-1 h-7 w-px bg-border"></div>
        <div class="flex items-center gap-2 rounded-md p-1.5">
          <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[1500px] px-4 py-7 md:px-8 md:py-9">

      <section class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-primary">Grow your audience</p>
          <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Lead magnets</h1>
          <p class="mt-2 text-sm text-muted-foreground">Give away a free download in exchange for a name and email — every signup lands straight in your <a href="/dashboard/audience" style="color:var(--primary); text-decoration:underline;">Audience</a> list.</p>
        </div>
      </section>

      <section class="mt-6 pz-builder">
        <div class="pz-builder-form rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
          <h2 class="text-lg font-bold" id="builderHeading">Build a lead magnet</h2>
          <p class="mt-1 text-sm text-muted-foreground">Link to the file — a Google Drive or Dropbox share link works fine to start.</p>

          <div class="pz-tabs">
            <button type="button" class="pz-tab-btn active" data-btab="content">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="11" height="4" rx="1"/></svg>
              Content
            </button>
            <button type="button" class="pz-tab-btn" data-btab="form">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>
              Form
            </button>
            <button type="button" class="pz-tab-btn" data-btab="design">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Design
            </button>
          </div>

          <form id="createMagnetForm" class="mt-4" novalidate>

            <div class="pz-btabpanel active" id="btab-content">
              <div style="display:flex; flex-wrap:wrap; gap:10px;">
                <input type="text" id="magnetTitle" class="pz-field-input" placeholder="Title — e.g. Free pricing checklist" style="flex:1.4; min-width:220px;" required />
                <input type="text" id="magnetCta" class="pz-field-input" placeholder="Button text (optional)" style="flex:1; min-width:160px;" />
              </div>
              <textarea id="magnetDescription" class="pz-field-input" rows="2" placeholder="What is it, and why should someone want it? (optional)" style="height:auto; padding:9px 11px; resize:vertical;"></textarea>
              <input type="url" id="magnetFileUrl" class="pz-field-input" placeholder="Link to the file (https://…)" required />
              <div class="pz-builder-option">
                <label for="magnetSuccessMessage">Thank-you message <span class="pz-option-hint">(optional — shown right after signup)</span></label>
                <textarea id="magnetSuccessMessage" class="pz-field-input" rows="2" maxlength="300" placeholder="Leave blank for the default." style="height:auto; padding:9px 11px; resize:vertical;"></textarea>
              </div>
            </div>

            <div class="pz-btabpanel" id="btab-form">
              <p class="pz-section-label">Form fields</p>
              <p class="pz-section-sub">Switch off anything you don’t need — just keep email or phone on so you can reach people.</p>
              <div class="pz-field-toggles">
                <div class="pz-option-row">
                  <button type="button" class="pz-switch on" id="magnetCollectName" aria-label="Ask for a full name" aria-pressed="true"></button>
                  <span>Full name</span>
                </div>
                <div class="pz-option-row">
                  <button type="button" class="pz-switch on" id="magnetCollectEmail" aria-label="Ask for an email" aria-pressed="true"></button>
                  <span>Email</span>
                </div>
                <div class="pz-option-row">
                  <button type="button" class="pz-switch on" id="magnetCollectPhone" aria-label="Ask for a phone number" aria-pressed="true"></button>
                  <span>Phone number <span class="pz-option-hint" id="magnetPhoneHint">(optional for the visitor)</span></span>
                </div>
              </div>
              <p class="pz-field-error" id="magnetFieldsError"></p>
              <div class="pz-divider"></div>
              <p class="pz-section-label">Extra questions</p>
              <p class="pz-section-sub">Asked after the fields above. Drag to reorder.</p>
              <div class="q-list" id="magnetQList"><!-- injected --></div>
              <div class="add-q-menu">
                <button type="button" class="add-q-btn" id="magnetAddQBtn">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
                  Add question
                </button>
              </div>
            </div>

            <div class="pz-btabpanel" id="btab-design">
              <p class="pz-section-label">Top of the page</p>
              <p class="pz-section-sub">Show your brand name, or your logo.</p>
              <div class="cover-choice" id="magnetBrandChoice">
                <button type="button" class="cover-opt active" data-brand="text">Brand name</button>
                <button type="button" class="cover-opt" data-brand="logo">Logo</button>
              </div>
              <input type="text" id="magnetBrandText" class="pz-field-input pz-brand-input" maxlength="60" placeholder="Your brand name — blank shows <%= siteName %>" />
              <input type="url" id="magnetBrandLogo" class="pz-field-input pz-brand-input" placeholder="Link to your logo image (https://…)" style="display:none;" />
              <p class="pz-option-hint" id="magnetBrandLogoHint" style="display:none;">A PNG or SVG with a transparent background looks best on the colored panel.</p>
              <p class="pz-field-error" id="magnetBrandError"></p>
              <div class="pz-divider"></div>
              <p class="pz-section-label">Accent color</p>
              <p class="pz-section-sub">Used for the button, badge and background on the public page.</p>
              <div class="swatch-row" id="magnetSwatchRow">
                <button type="button" class="swatch active" data-accent="#1261ef" style="background:#1261ef;" aria-label="Blue"></button>
                <button type="button" class="swatch" data-accent="#c0322a" style="background:#ff6c62;" aria-label="Coral"></button>
                <button type="button" class="swatch" data-accent="#12733f" style="background:#2fae6b;" aria-label="Green"></button>
                <button type="button" class="swatch" data-accent="#7048e8" style="background:#7048e8;" aria-label="Violet"></button>
                <button type="button" class="swatch" data-accent="#07134f" style="background:#07134f;" aria-label="Navy"></button>
                <span class="swatch swatch-custom" title="Custom color">
                  <input type="color" id="magnetCustomColor" value="#1261ef" />
                </span>
              </div>
              <div class="pz-divider"></div>
              <p class="pz-section-label">Cover</p>
              <p class="pz-section-sub">The banner across the top of the card.</p>
              <div class="cover-choice cover-choice-wrap" id="magnetCoverChoice">
                <button type="button" class="cover-opt active" data-cover="art">Artwork</button>
                <button type="button" class="cover-opt" data-cover="image">Image</button>
                <button type="button" class="cover-opt" data-cover="video">Video</button>
                <button type="button" class="cover-opt" data-cover="color">Color</button>
                <button type="button" class="cover-opt" data-cover="none">None</button>
              </div>

              <!-- Image / video: upload a file, or paste a link to one. -->
              <div class="pz-cover-media" id="magnetCoverImagePanel" style="display:none;">
                <div class="pz-cover-upload">
                  <label class="pz-card-btn pz-upload-btn">
                    <input type="file" id="magnetCoverImageFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m6 10 6-6 6 6"/><path d="M5 20h14"/></svg>
                    <span>Upload image</span>
                  </label>
                  <button type="button" class="pz-cover-clear" data-clear="image">Remove</button>
                </div>
                <input type="text" id="magnetCoverImage" class="pz-field-input pz-brand-input" maxlength="500" placeholder="…or paste an image link (https://…)" />
                <p class="pz-option-hint">JPG, PNG, WebP or GIF, up to 5 MB. 1500 × 750 fits the banner exactly; your title sits on top of it.</p>
              </div>
              <div class="pz-cover-media" id="magnetCoverVideoPanel" style="display:none;">
                <div class="pz-cover-upload">
                  <label class="pz-card-btn pz-upload-btn">
                    <input type="file" id="magnetCoverVideoFile" accept="video/mp4,video/webm" hidden />
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m6 10 6-6 6 6"/><path d="M5 20h14"/></svg>
                    <span>Upload video</span>
                  </label>
                  <button type="button" class="pz-cover-clear" data-clear="video">Remove</button>
                </div>
                <input type="text" id="magnetCoverVideo" class="pz-field-input pz-brand-input" maxlength="500" placeholder="…or paste a link to an .mp4 (https://…)" />
                <p class="pz-option-hint">MP4 or WebM, up to 30 MB. Plays muted on a loop, so a short clip works best.</p>
              </div>
              <p class="pz-field-error" id="magnetCoverError"></p>

              <!-- Fills the banner for "Color"; shows behind an image or video while it loads. -->
              <div class="pz-cover-color" id="magnetCoverColorRow">
                <span class="swatch swatch-custom" title="Banner background color">
                  <input type="color" id="magnetCoverColor" value="#0a2f9e" />
                </span>
                <div>
                  <p class="pz-cover-color-label">Background color</p>
                  <p class="pz-option-hint" id="magnetCoverColorHint">Matches your accent color.</p>
                </div>
                <button type="button" class="pz-cover-clear" id="magnetCoverColorReset" style="display:none;">Use accent</button>
              </div>
            </div>

            <div style="margin-top:16px; display:flex; align-items:center; gap:10px;">
              <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-10 px-4">
                <svg id="builderSubmitIcon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
                <span id="builderSubmitLabel">Create lead magnet</span>
              </button>
              <!-- Shown only while a card's Edit button has a magnet loaded in here. -->
              <button type="button" class="pz-card-btn" id="builderCancelBtn" style="display:none; height:40px; padding:0 14px; font-size:13.5px;">Cancel</button>
            </div>
          </form>
          <p class="pz-field-error" id="createFormError"></p>
        </div>

        <%# Live preview: the real lead magnet page (views/lead-magnet.ejs), drawn by the
            server from what's in the builder now — lib/livePreview.js, public/js/live-preview.js. %>
        <div class="pz-builder-preview">
          <div class="st-canvas is-docked">
            <div class="st-canvas-head">
              <h2>Preview<small>The real page visitors see — updates as you type</small></h2>
              <div class="st-devices" role="group" aria-label="Preview size">
                <button type="button" data-st-view="desktop" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>Desktop</button>
                <button type="button" data-st-view="mobile" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>Mobile</button>
              </div>
            </div>
            <p class="lp-status" data-live-status hidden></p>
            <div class="st-device is-mobile" data-st-device>
              <div class="st-chrome"><i></i><i></i><i></i><span class="st-url" id="previewSlugUrl"><%= storeUrlFor(user.handle).replace(/^https?:\/\//, '') %>/…</span></div>
              <div class="st-screen lp-box" id="magnetPreview"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-6 rounded-lg border border-border bg-card shadow-sm">
        <div class="flex items-center justify-between border-b border-border p-5 md:px-6">
          <div>
            <h2 class="text-lg font-bold">Your lead magnets</h2>
            <p class="mt-1 text-sm text-muted-foreground"><span id="magnetCount"><%= magnets.length %></span> <span id="magnetCountLabel"><%= magnets.length === 1 ? 'lead magnet' : 'lead magnets' %></span></p>
          </div>
        </div>

        <div id="magnetsList"><!-- injected --></div>

        <div id="emptyMagnets" class="flex flex-col items-center justify-center gap-3 p-6" style="padding:56px 24px; text-align:center; display:none;">
          <div class="grid size-10 place-items-center rounded-md bg-muted text-muted-foreground">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <p class="text-sm font-semibold">No lead magnets yet</p>
          <p class="text-sm text-muted-foreground" style="max-width:360px;">Create one above — share the link on Instagram, WhatsApp, anywhere — and every signup shows up here.</p>
        </div>
      </section>

    </div>
  </main>
</div>

<!-- "Add question" popup — opened from the create form and from each
     magnet's Page options; the type tiles are injected by lead-magnets.js. -->
<div class="pz-modal-backdrop" id="qTypeModal" aria-hidden="true">
  <div class="pz-modal" role="dialog" aria-modal="true" aria-labelledby="qTypeModalTitle">
    <div class="pz-modal-head">
      <div>
        <h3 id="qTypeModalTitle">Add a question</h3>
        <p>Pick the kind of answer you want from visitors.</p>
      </div>
      <button type="button" class="pz-modal-close" id="qTypeModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="q-type-grid" id="qTypeGrid"><!-- injected --></div>
  </div>
</div>

<script>
  window.__PZ_INITIAL_MAGNETS__ = <%- JSON.stringify(magnets).replace(/</g, '\\u003c') %>;
  window.__PZ_STORE_URL__ = <%- JSON.stringify(storeUrlFor(user.handle)) %>;
</script>
<script src="/js/live-preview.js?v=<%= assetVersion %>"></script>
<script src="/js/studio.js?v=<%= assetVersion %>"></script>
<script src="/js/lead-magnets.js?v=<%= assetVersion %>"></script>
</body>
</html>
