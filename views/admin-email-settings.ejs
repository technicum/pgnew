<%- include('partials/admin-top') %>
<%# Platform admin → Emails → Settings (lib/mailer.js): the SMTP account emails go out through. The
    password is never sent back to the page — a blank field keeps the saved one. %>

<header class="adm-head">
  <div>
    <a class="adm-crumb" href="/admin/emails">← Emails</a>
    <h1>Email settings</h1>
    <p>The mail account emails are sent from. Your email provider lists these as its SMTP settings.</p>
  </div>
</header>

<form method="POST" action="/admin/emails/settings" autocomplete="off">
  <section class="ax-panel">
    <div class="ax-panel-head"><h2>SMTP server</h2><span class="ax-count"><%= smtp.host ? 'Saved' : 'Not set' %></span></div>
    <div class="ax-grid ax-pad">
      <label class="ax-field"><span>Host</span>
        <input class="ax-input" name="host" value="<%= smtp.host %>" placeholder="smtp.hostinger.com" spellcheck="false" /></label>
      <label class="ax-field"><span>Port</span>
        <input class="ax-input" name="port" value="<%= smtp.port %>" inputmode="numeric" placeholder="587" /></label>
      <label class="ax-field"><span>Username</span>
        <input class="ax-input" name="user" value="<%= smtp.user %>" spellcheck="false" autocomplete="off" /></label>
      <label class="ax-field"><span>Password</span>
        <input class="ax-input" type="password" name="password" placeholder="<%= smtp.password ? 'Saved (' + smtp.password + ') — blank keeps it' : 'Paste the password' %>" autocomplete="new-password" /></label>
    </div>
  </section>

  <section class="ax-panel">
    <div class="ax-panel-head"><h2>Sender</h2><span class="ax-count">What people see</span></div>
    <div class="ax-grid ax-pad">
      <label class="ax-field"><span>From name</span>
        <input class="ax-input" name="from_name" value="<%= smtp.fromName %>" maxlength="100" placeholder="<%= siteName %>" /></label>
      <label class="ax-field"><span>From address</span>
        <input class="ax-input" type="email" name="from_email" value="<%= smtp.fromEmail %>" maxlength="190" placeholder="hello@<%= siteDomain %>" /></label>
    </div>
    <p class="ax-hint ax-pad">Use an address on your own domain with SPF and DKIM set up at your provider, or emails are likely to land in spam.</p>
  </section>

  <section class="ax-panel ax-savebar">
    <span class="ax-sub">Saving signs in to the mail server to check these work. Leave the host blank to clear these and use the server’s .env instead.</span>
    <button class="ax-btn ax-btn-primary">Save</button>
  </section>
</form>

<%- include('partials/admin-bottom') %>
