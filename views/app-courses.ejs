<%# Courses app home (lib/appDashboard.js → /dashboard/courses): the creator's courses with lesson and student counts, and a form to add one. %>
<%- include('partials/app-dash-top', { navActive: '/dashboard/courses', section: 'Courses', heading: 'Courses', intro: 'Sell or give away courses of video and text lessons, grouped into modules. Students get their own link, track their progress, and land in your Audience.' }) %>
<% var storeUrl = storeUrlFor(user.handle); %>

<section class="ax-panel">
  <div class="ax-panel-head"><h2>Your courses</h2><span class="ax-count"><%= courses.length %></span></div>
  <% if (!courses.length) { %>
  <p class="ax-empty">No courses yet. Name your first one below, then add lessons.</p>
  <% } else { %>
  <ul class="ax-list">
    <% courses.forEach(function (c) { var link = storeUrl + '/course/' + c.slug; %>
    <li class="ax-row<%= c.visible ? '' : ' is-off' %>">
      <div class="ax-main">
        <a class="ax-title" href="/dashboard/courses/<%= c.id %>"><%= c.title %></a>
        <span class="ax-sub ax-block"><%= c.priceLabel %> · <%= c.contentLabel %> · <%= c.student_count %> student<%= c.student_count === 1 ? '' : 's' %><%= c.visible ? '' : ' · Hidden' %></span>
        <span class="ax-link"><a href="<%= link %>" target="_blank" rel="noopener"><%= link.replace(/^https?:\/\//, '') %></a></span>
      </div>
      <%- include('partials/ax-row-menu', { label: c.title, editHref: '/dashboard/courses/' + c.id, link: link, base: '/dashboard/courses/' + c.id, visible: c.visible }) %>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <form method="POST" action="/dashboard/courses" class="ax-new">
    <h3>New course</h3>
    <div class="ax-grid">
      <label class="ax-field ax-span-3"><span>Name</span><input class="ax-input" name="title" placeholder="Instagram growth in 7 days" required maxlength="200" /></label>
    </div>
    <button class="ax-btn ax-btn-primary">Create course</button>
  </form>
</section>

<%# People who started buying a paid course and didn't pay — followed up from here or Dashboard → Abandoned carts (partials/abandoned-carts). Shown once there's a paid course or a cart. %>
<% if (ab.carts.length || courses.some(function (c) { return c.price; })) { %>
<div id="abandoned">
  <%- include('partials/abandoned-carts', { ab: ab, title: 'Didn’t finish paying', intro: 'Started buying a paid course and didn’t pay within 30 minutes. A quick WhatsApp often brings them back.' }) %>
  <p class="ab-more"><a href="/dashboard/abandoned">All abandoned carts — payment pages, courses and bookings →</a></p>
</div>
<% } %>

<%- include('partials/app-dash-bottom') %>
