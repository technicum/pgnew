<%# Edit one booking service (lib/appDashboard.js → /dashboard/bookings/services/:id). Field names match lib/bookings.js: hours (partials/ax-hours, used when custom_hours is 1), questions as q_label_<n> / q_type_<n> / q_options_<n> / q_required_<n>. Images upload through /dashboard/uploads (the small script below) or take a pasted link. %>
<%- include('partials/app-dash-top', { navActive: '/dashboard/bookings', section: 'Bookings', heading: service.title, back: { href: '/dashboard/bookings#services', label: 'Booking page' } }) %>
<% var link = storeUrlFor(user.handle) + '/book/' + service.slug;
var priceRupees = service.price ? String(service.price / 100) : '0'; %>

<div class="ax-linkbar">
  <span>Booking link</span>
  <a href="<%= link %>" target="_blank" rel="noopener"><%= link.replace(/^https?:\/\//, '') %></a>
  <button type="button" class="ax-btn ax-btn-quiet" data-copy="<%= link %>">Copy</button>
</div>

<form method="POST" action="/dashboard/bookings/services/<%= service.id %>">
  <section class="ax-panel">
    <div class="ax-panel-head"><h2>Details</h2></div>
    <div class="ax-grid">
      <label class="ax-field ax-span-2"><span>Name</span><input class="ax-input" name="title" value="<%= service.title %>" required maxlength="200" /></label>
      <label class="ax-field"><span>Link ending</span><input class="ax-input" name="slug" value="<%= service.slug %>" maxlength="60" pattern="[a-z0-9-]+" /></label>
      <label class="ax-field"><span>Length (minutes)</span><input class="ax-input" type="number" name="duration_min" value="<%= service.duration_min %>" min="5" max="480" step="5" /></label>
      <label class="ax-field"><span>Price (₹) <small>0 = free</small></span><input class="ax-input" name="price" value="<%= priceRupees %>" inputmode="decimal" /></label>
      <span></span>
      <%- include('partials/ax-rich-field', { name: 'description', label: 'Description', value: service.description, rows: 6, maxlength: 2000, placeholder: 'What you’ll cover, who it’s for, what to bring…' }) %>
    </div>
  </section>

  <%# Where it happens — attend / location (address) / meeting_url (lib/bookings.js ATTEND).
      A service from before this (attend '') starts on "In person" with its old text as the address. %>
  <% var attend = service.attend || (service.location ? 'in_person' : 'online'); %>
  <section class="ax-panel" data-attend-panel>
    <div class="ax-panel-head"><h2>Where it happens</h2></div>
    <div class="ax-pad ax-pad-top ax-hours-choice">
      <label class="ax-check"><input type="radio" name="attend" value="online"<%= attend === 'online' ? ' checked' : '' %> /> <span>Online <small class="ax-sub">— video call (Google Meet, Zoom…)</small></span></label>
      <label class="ax-check"><input type="radio" name="attend" value="in_person"<%= attend === 'in_person' ? ' checked' : '' %> /> <span>In person <small class="ax-sub">— at your clinic, salon, studio…</small></span></label>
      <label class="ax-check"><input type="radio" name="attend" value="either"<%= attend === 'either' ? ' checked' : '' %> /> <span>Both <small class="ax-sub">— the booker chooses</small></span></label>
    </div>
    <div class="ax-grid">
      <label class="ax-field ax-span-3" data-attend-show="in_person either"><span>Address</span><input class="ax-input" name="location" value="<%= service.location %>" maxlength="300" placeholder="Smile Dental Clinic, 2nd floor, 14 MG Road, Indore 452001" />
        <small>Shown on the booking page with a “Get directions” link to Google Maps.</small></label>
      <label class="ax-field ax-span-3" data-attend-show="online either"><span>Meeting link <small>(optional)</small></span><input class="ax-input" name="meeting_url" value="<%= service.meeting_url %>" maxlength="500" placeholder="https://meet.google.com/abc-defg-hij" />
        <small>Only shown to people once they’ve booked (and paid, if there’s anything to pay online). Leave blank to send each person a link yourself.</small></label>
    </div>
  </section>

  <%# How it's paid for — pay_option / deposit (lib/bookings.js PAY_OPTIONS). Only matters with a price. %>
  <section class="ax-panel" data-pay-panel>
    <div class="ax-panel-head"><h2>Payment</h2><span class="ax-count">For a paid service</span></div>
    <div class="ax-pad ax-pad-top ax-hours-choice">
      <label class="ax-check"><input type="radio" name="pay_option" value="online"<%= service.pay_option === 'online' ? ' checked' : '' %> /> <span>Full price online <small class="ax-sub">— paid when booking</small></span></label>
      <label class="ax-check"><input type="radio" name="pay_option" value="deposit"<%= service.pay_option === 'deposit' ? ' checked' : '' %> /> <span>Advance online <small class="ax-sub">— the rest at the appointment; fewer no-shows</small></span></label>
      <label class="ax-check"><input type="radio" name="pay_option" value="later"<%= service.pay_option === 'later' ? ' checked' : '' %> /> <span>Pay at the appointment <small class="ax-sub">— nothing online; booked straight away</small></span></label>
    </div>
    <div class="ax-grid" data-pay-show="deposit">
      <label class="ax-field"><span>Advance (₹)</span><input class="ax-input" name="deposit" value="<%= service.deposit ? String(service.deposit / 100) : '' %>" inputmode="decimal" placeholder="200" /></label>
    </div>
    <p class="ax-hint ax-pad">
      <% if (paymentMode === 'test') { %><b>Paid sessions run in test mode</b> — no payment gateway is connected yet, so bookers see a “Complete test payment” step and nothing is charged.
      <% } else if (paymentMode === 'cashfree') { %><b>Paid sessions are collected online</b> — bookers pay through Cashfree and the booking confirms itself once the payment goes through.
      <% } else { %><b>Paid sessions are manual for now</b> — the slot is held as “awaiting payment” until you mark it paid under Upcoming bookings or in Orders. Tell bookers how to pay (UPI ID, bank details) in <a href="/dashboard/bookings/settings/payments">Settings</a>.<% } %>
    </p>
  </section>

  <section class="ax-panel">
    <div class="ax-panel-head"><h2>Photos</h2><span class="ax-count">Optional</span></div>
    <div class="ax-grid">
      <%- include('partials/ax-image-field', { name: 'cover_url', label: 'Cover image', value: service.cover_url, hint: 'Wide image across the top — about 1500 × 700. Blank uses the one in Settings.' }) %>
      <%- include('partials/ax-image-field', { name: 'photo_url', label: 'Your photo', value: service.photo_url, hint: 'Blank uses the one in Settings, else your initials.', round: true }) %>
    </div>
  </section>

  <section class="ax-panel" id="hours">
    <div class="ax-panel-head"><h2>When it can be booked</h2><span class="ax-count"><%= fmt.tz(bookingSettings.timezone) %></span></div>
    <div class="ax-pad ax-pad-top ax-hours-choice">
      <label class="ax-check"><input type="radio" name="custom_hours" value="0"<%= service.custom_hours ? '' : ' checked' %> data-hours-mode /> <span>My availability <small class="ax-sub">— <%= fmt.hours(bookingSettings.hours) %> ·<a href="/dashboard/bookings/settings">change in Settings</a></small></span></label>
      <label class="ax-check"><input type="radio" name="custom_hours" value="1"<%= service.custom_hours ? ' checked' : '' %> data-hours-mode /> <span>Different hours for this service</span></label>
    </div>
    <div data-custom-hours<%= service.custom_hours ? '' : ' hidden' %>>
      <%- include('partials/ax-hours', { hours: service.hours, weekdays: weekdays, maxRanges: maxRanges }) %>
    </div>
    <p class="ax-hint ax-pad">Whichever hours it uses, a time is only offered if no other booking — for any of your services — is already in it.</p>
  </section>

  <section class="ax-panel">
    <div class="ax-panel-head"><h2>Scheduling</h2></div>
    <div class="ax-grid">
      <label class="ax-field"><span>Gap between sessions (minutes)</span><input class="ax-input" type="number" name="buffer_min" value="<%= service.buffer_min %>" min="0" max="240" step="5" /></label>
      <label class="ax-field"><span>Most bookings a day <small>(0 = no limit)</small></span><input class="ax-input" type="number" name="max_per_day" value="<%= service.max_per_day %>" min="0" max="100" /></label>
      <span></span>
      <label class="ax-field"><span>Minimum notice (hours)</span><input class="ax-input" type="number" name="min_notice_hours" value="<%= service.min_notice_hours %>" min="0" max="720" /></label>
      <label class="ax-field"><span>Bookable up to (days ahead)</span><input class="ax-input" type="number" name="days_ahead" value="<%= service.days_ahead %>" min="1" max="180" /></label>
    </div>
    <p class="ax-hint ax-pad">Days off (holidays, travel) apply to every service — set them in <a href="/dashboard/bookings/settings#days-off">Settings</a>.</p>
  </section>

  <section class="ax-panel">
    <div class="ax-panel-head"><h2>Booking questions</h2><span class="ax-count">Up to <%= maxQuestions %> · asked after name, email and phone</span></div>
    <div class="ax-questions" data-questions>
      <% for (var n = 0; n < maxQuestions; n++) { var q = service.questions[n] || {}; var shown = !!q.label || (n === 0 && !service.questions.length); %>
      <div class="ax-question"<%= shown ? '' : ' hidden' %>>
        <input class="ax-input" name="q_label_<%= n %>" value="<%= q.label || '' %>" placeholder="<%= n === 0 ? 'e.g. What would you like to talk about?' : 'Another question' %>" maxlength="120" aria-label="Question <%= n + 1 %>" />
        <select class="ax-input" name="q_type_<%= n %>" aria-label="Answer type">
          <% Object.keys(questionTypes).forEach(function (t) { %><option value="<%= t %>"<%= q.type === t ? ' selected' : '' %>><%= questionTypes[t] %></option><% }) %>
        </select>
        <input class="ax-input ax-q-options" name="q_options_<%= n %>" value="<%= (q.options || []).join(', ') %>" placeholder="Choices, separated by commas" maxlength="400" aria-label="Choices" />
        <label class="ax-check"><input type="checkbox" name="q_required_<%= n %>" value="1"<%= q.required ? ' checked' : '' %> /> <span>Required</span></label>
        <button type="button" class="ax-q-remove" data-q-remove aria-label="Remove question" title="Remove question">×</button>
      </div>
      <% } %>
      <button type="button" class="ax-btn ax-btn-quiet ax-q-add" data-q-add>+ Add question</button>
      <p class="ax-hint">Answers show on each booking. For example “What would you like help with?”, “First visit?” (Choose one) or “Which treatment?” (Dropdown).</p>
    </div>
  </section>

  <section class="ax-panel ax-savebar">
    <label class="ax-check"><input type="checkbox" name="visible" value="1"<%= service.visible ? ' checked' : '' %> /> <span>Taking bookings (page is live)</span></label>
    <label class="ax-check"><input type="checkbox" name="marketplace" value="1"<%= service.marketplace ? ' checked' : '' %> /> <span>List on the <%= siteName %> marketplace <small class="ax-sub">— people browsing <a href="/explore" target="_blank" rel="noopener">Explore</a> can find this service</small></span></label>
    <button class="ax-btn ax-btn-primary">Save changes</button>
  </section>
</form>

<form method="POST" action="/dashboard/bookings/services/<%= service.id %>/delete" class="ax-danger">
  <span>Deleting the service takes its page down. Bookings already made stay in your list.</span>
  <button class="ax-btn ax-btn-danger" data-confirm="Click again to delete">Delete service</button>
</form>

<script>
  (function () {
    // Hours: the weekly editor only shows for "different hours".
    var custom = document.querySelector('[data-custom-hours]');
    document.querySelectorAll('[data-hours-mode]').forEach(function (radio) {
      radio.addEventListener('change', function () { custom.hidden = radio.value !== '1'; });
    });

    // Where / Payment: show only the fields the picked option uses.
    [['attend', 'data-attend-show'], ['pay_option', 'data-pay-show']].forEach(function (pair) {
      var radios = document.querySelectorAll('input[name="' + pair[0] + '"]');
      var sync = function () {
        var picked = (document.querySelector('input[name="' + pair[0] + '"]:checked') || {}).value;
        document.querySelectorAll('[' + pair[1] + ']').forEach(function (el) {
          el.hidden = el.getAttribute(pair[1]).split(' ').indexOf(picked) < 0;
        });
      };
      radios.forEach(function (r) { r.addEventListener('change', sync); });
      sync();
    });

    // Questions: choices only for dropdown / choose-one. "+ Add question"
    // shows the next hidden row; × clears a row and hides it (a blank
    // question isn't saved). Rows keep their place, so answers already
    // given keep matching their question.
    var qBox = document.querySelector('[data-questions]');
    var qRows = Array.prototype.slice.call(qBox.querySelectorAll('.ax-question'));
    var qAdd = qBox.querySelector('[data-q-add]');
    var syncAdd = function () { qAdd.hidden = qRows.every(function (r) { return !r.hidden; }); };
    qRows.forEach(function (row) {
      var type = row.querySelector('select');
      var opts = row.querySelector('.ax-q-options');
      var sync = function () { opts.hidden = type.value !== 'dropdown' && type.value !== 'radio'; };
      type.addEventListener('change', sync);
      sync();
      row.querySelector('[data-q-remove]').addEventListener('click', function () {
        row.querySelectorAll('input[type=text], input:not([type]), .ax-q-options').forEach(function (i) { i.value = ''; });
        row.querySelector('input[type=checkbox]').checked = false;
        type.selectedIndex = 0;
        sync();
        row.hidden = true;
        syncAdd();
      });
    });
    qAdd.addEventListener('click', function () {
      var next = qRows.filter(function (r) { return r.hidden; })[0];
      if (!next) return;
      next.hidden = false;
      next.querySelector('input').focus();
      syncAdd();
    });
    syncAdd();
  })();
</script>

<%- include('partials/app-dash-bottom') %>
