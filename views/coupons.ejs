<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#fbfaf6" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="<%= siteName %>" />
<link rel="manifest" href="/manifest.webmanifest" />
<%- include('partials/brand-icon') %>
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/lead-magnets.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/payments-dashboard.css?v=<%= assetVersion %>" />
</head>
<body>
<%# Coupons (Payment pages app): discount codes buyers enter at checkout. The list and every
    change go through the JSON endpoints in server.js — public/js/coupons.js. %>
<div class="min-h-screen bg-background">

  <%- include('partials/dashboard-sidebar', { navActive: '/dashboard/coupons' }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <div>
        <p class="text-sm font-semibold text-primary" style="line-height:1;">Coupons</p>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <span class="pz-save-status" id="saveStatus"><span class="dot"></span><span id="saveStatusText">Saved</span></span>
        <%- include('partials/dashboard-header-help') %>
        <div class="mx-1 h-7 w-px bg-border"></div>
        <div class="flex items-center gap-2 rounded-md p-1.5">
          <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-[760px] px-4 py-7 md:px-8 md:py-9 cp-page">

      <section>
        <p class="cp-eyebrow">Sales</p>
        <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Coupons</h1>
        <p class="cp-lede">Discount codes buyers enter at checkout on your <a href="/dashboard/payment-pages">payment pages</a> — taken off the products, not shipping. A code counts as used once its order is paid.</p>
      </section>

      <section class="cp-stats" aria-label="Totals">
        <div class="cp-stat">
          <span class="cp-stat-icon is-blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="17" height="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="M13 5v2"></path><path d="M13 17v2"></path><path d="M13 11v2"></path></svg></span>
          <span class="cp-stat-text"><strong id="statActive">0</strong><span>Active codes</span></span>
        </div>
        <div class="cp-stat">
          <span class="cp-stat-icon is-green" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="17" height="17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
          <span class="cp-stat-text"><strong id="statUses">0</strong><span>Times used</span></span>
        </div>
        <div class="cp-stat">
          <span class="cp-stat-icon is-grey" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="17" height="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m5.7 5.7 12.6 12.6"/></svg></span>
          <span class="cp-stat-text"><strong id="statOff">0</strong><span>Switched off or expired</span></span>
        </div>
      </section>

      <section class="cp-card">
        <div class="cp-card-head">
          <h2>New coupon</h2>
          <p>Buyers enter this code at checkout to get the discount.</p>
        </div>
        <form id="couponForm" class="cp-form" novalidate>
          <div class="cp-box cp-box-main">
            <label class="cp-cell">
              <span class="cp-label">Code</span>
              <input type="text" id="couponCode" class="cp-input" maxlength="30" placeholder="LAUNCH20" autocapitalize="characters" spellcheck="false" autocomplete="off" />
            </label>
            <div class="cp-cell">
              <label class="cp-label" for="couponValue">Discount</label>
              <div class="cp-discount">
                <input type="text" inputmode="decimal" id="couponValue" class="cp-input" placeholder="20" autocomplete="off" />
                <input type="hidden" id="couponType" value="percent" />
                <div class="cp-seg" role="group" aria-label="Discount type">
                  <button type="button" data-type="percent" aria-pressed="true">% off</button>
                  <button type="button" data-type="flat" aria-pressed="false">₹ off</button>
                </div>
              </div>
            </div>
          </div>

          <details class="cp-limits" id="couponLimits">
            <summary>
              <svg class="cp-chev" viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              Limit where and how it’s used
            </summary>
            <div class="cp-box cp-box-limits">
              <label class="cp-cell">
                <span class="cp-label">Works on</span>
                <select id="couponPage" class="cp-input">
                  <option value="">All payment pages</option>
                </select>
              </label>
              <label class="cp-cell">
                <span class="cp-label">Max uses <em>optional</em></span>
                <input type="number" id="couponMaxUses" class="cp-input" min="1" placeholder="Unlimited" />
              </label>
              <label class="cp-cell">
                <span class="cp-label">Expires <em>optional</em></span>
                <input type="date" id="couponExpires" class="cp-input" />
              </label>
            </div>
          </details>

          <p class="pz-field-error" id="couponFormError"></p>
          <div class="cp-form-foot">
            <button type="submit" class="cp-add" id="couponAdd" disabled>
              <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
              Add code
            </button>
          </div>
        </form>
      </section>

      <section class="cp-card">
        <div class="cp-list-head">
          <div>
            <h2>Your codes</h2>
            <p id="couponCountLine"></p>
          </div>
          <label class="cp-search">
            <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
            <input type="search" id="couponSearch" placeholder="Search codes…" aria-label="Search codes" />
          </label>
        </div>
        <div id="couponsList"><!-- injected --></div>
        <div id="emptyCoupons" class="cp-empty" hidden>
          <span class="cp-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="22" height="22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="M13 5v2"></path><path d="M13 17v2"></path><path d="M13 11v2"></path></svg></span>
          <p id="emptyCouponsText"></p>
        </div>
      </section>

    </div>
  </main>
</div>

<script>
  window.__PZ_COUPONS__ = <%- JSON.stringify(coupons).replace(/</g, '\\u003c') %>;
  window.__PZ_COUPON_PAGES__ = <%- JSON.stringify(pages).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/coupons.js?v=<%= assetVersion %>"></script>
</body>
</html>
