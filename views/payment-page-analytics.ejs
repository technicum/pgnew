<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/lead-magnets.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/payments-dashboard.css?v=<%= assetVersion %>" />
</head>
<%
// One payment page's analytics (server.js → /dashboard/payment-pages/:id/analytics).
// Three tabs, each a plain link (?tab=): Overview, Customers, Abandoned carts.
var pageUrl = storeUrlFor(user.handle) + '/pay/' + page.slug;
var base = '/dashboard/payment-pages/' + page.id + '/analytics';
var STATUS_LABEL = { paid: 'Paid', pending: 'Pending', cancelled: 'Cancelled' };
var shortDate = function (v) { return new Date(v).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }); };
var dayMonth = function (v) { return new Date(v).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }); };
var ago = function (v) {
  var mins = Math.max(0, Math.round((Date.now() - new Date(v).getTime()) / 60000));
  if (mins < 60) return mins + ' min ago';
  var hours = Math.round(mins / 60);
  if (hours < 24) return hours + (hours === 1 ? ' hour ago' : ' hours ago');
  var days = Math.round(hours / 24);
  return days < 30 ? days + (days === 1 ? ' day ago' : ' days ago') : shortDate(v);
};
var addressLine = function (a) { return a ? [a.line, a.city, a.pincode].filter(Boolean).join(', ') : ''; };
var abandonedValue = abandoned.reduce(function (n, a) { return n + a.total; }, 0);
var STAGE = { details: 'Left at checkout', payment: 'Left at payment', cancelled: 'Cancelled payment' };
var reminderLink = function (a) {
  var first = (a.name || '').trim().split(/\s+/)[0] || 'there';
  var items = a.items.map(function (i) { return i.qty > 1 ? i.title + ' × ' + i.qty : i.title; }).join(', ');
  var body = 'Hi ' + first + ',\n\nYou were checking out ' + items + ' on ' + page.title + ' but didn’t finish.'
    + ' Your cart came to ' + formatINR(a.total) + ' — you can pick up where you left off here:\n\n' + pageUrl
    + '\n\nAny questions, just reply to this email.\n\n— ' + user.name;
  return 'mailto:' + encodeURIComponent(a.email) + '?subject=' + encodeURIComponent('Still thinking about ' + page.title + '?') + '&body=' + encodeURIComponent(body);
};
%>
<body>
<div class="min-h-screen bg-background">

  <%- include('partials/dashboard-sidebar', { navActive: '/dashboard/payment-pages' }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <a href="/dashboard/payment-pages" class="pa-back">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Payment pages
      </a>
      <div class="ml-auto flex items-center gap-2">
        <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
      </div>
    </header>

    <div class="mx-auto max-w-[1100px] px-4 py-7 md:px-8 md:py-9">

      <section class="pa-head">
        <div style="min-width:0;">
          <p class="text-sm font-semibold text-primary">Analytics</p>
          <h1 class="mt-1 text-3xl font-extrabold md:text-4xl" style="overflow-wrap:anywhere;"><%= page.title %></h1>
          <p class="mt-2 text-sm text-muted-foreground">
            <a href="<%= pageUrl %>" target="_blank" rel="noopener" class="pa-link"><%= pageUrl.replace(/^https?:\/\//, '') %></a>
            · <%= page.visible ? 'Live' : 'Unpublished' %>
          </p>
        </div>
        <a class="pb-primary" href="/dashboard/payment-pages#edit-<%= page.id %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          <span>Edit page</span>
        </a>
      </section>

      <nav class="pa-tabs" aria-label="Analytics sections">
        <a href="<%= base %>" class="<%= tab === 'overview' ? 'active' : '' %>"<%= tab === 'overview' ? ' aria-current="page"' : '' %>>Overview</a>
        <a href="<%= base %>?tab=customers" class="<%= tab === 'customers' ? 'active' : '' %>"<%= tab === 'customers' ? ' aria-current="page"' : '' %>>Customers <span><%= stats.customers.length %></span></a>
        <a href="<%= base %>?tab=abandoned" class="<%= tab === 'abandoned' ? 'active' : '' %>"<%= tab === 'abandoned' ? ' aria-current="page"' : '' %>>Abandoned carts <span<%= abandoned.length ? ' class="warn"' : '' %>><%= abandoned.length %></span></a>
      </nav>

      <% if (tab === 'overview') { %>
      <%# ================= OVERVIEW ================= %>
      <section class="pb-an-tiles">
        <div class="pb-an-tile"><span>Revenue</span><strong><%= formatINR(stats.revenue) %></strong><small><%= stats.discount ? 'after ' + formatINR(stats.discount) + ' in coupons' : 'from paid orders' %></small></div>
        <div class="pb-an-tile"><span>Sales</span><strong><%= stats.orders.paid %></strong><small><%= stats.orders.pending %> pending · <%= stats.orders.cancelled %> cancelled</small></div>
        <div class="pb-an-tile"><span>Visits</span><strong><%= visits %></strong><small><%= conversion === null ? 'no visits yet' : conversion + '% bought' %></small></div>
        <div class="pb-an-tile"><span>Avg. order</span><strong><%= formatINR(stats.averageOrder) %></strong><small>per paid order</small></div>
      </section>

      <section class="pa-card">
        <div class="pb-an-section-head"><h2>Last 30 days</h2><span><%= stats.lastDays.orders %> <%= stats.lastDays.orders === 1 ? 'sale' : 'sales' %> · <%= formatINR(stats.lastDays.revenue) %></span></div>
        <% var max = Math.max.apply(null, stats.daily.map(function (d) { return d.revenue; }).concat([0])); %>
        <% if (!max) { %>
        <p class="pb-an-empty">No paid orders in the last 30 days yet.</p>
        <% } else { var w = 100 / stats.daily.length; %>
        <svg class="pb-an-chart" viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label="Revenue per day, last 30 days">
          <% stats.daily.forEach(function (d, i) { var h = d.revenue ? Math.max(2, d.revenue / max * 100) : 0; %>
          <rect x="<%= (i * w + w * .15).toFixed(2) %>" y="<%= (100 - h).toFixed(2) %>" width="<%= (w * .7).toFixed(2) %>" height="<%= h.toFixed(2) %>"><title><%= dayMonth(d.date) %> — <%= d.orders %> <%= d.orders === 1 ? 'sale' : 'sales' %>, <%= formatINR(d.revenue) %></title></rect>
          <% }) %>
        </svg>
        <div class="pb-an-axis"><span><%= dayMonth(stats.daily[0].date) %></span><span>Best day <%= formatINR(max) %></span><span>Today</span></div>
        <% } %>
      </section>

      <div class="pa-two">
        <section class="pa-card">
          <div class="pb-an-section-head"><h2>What sold</h2></div>
          <% if (stats.products.length) { %>
          <table class="pb-an-table">
            <thead><tr><th>Product</th><th class="pb-num">Sold</th><th class="pb-num">Revenue</th></tr></thead>
            <tbody>
              <% stats.products.forEach(function (p) { %><tr><td><%= p.title %></td><td class="pb-num">× <%= p.qty %></td><td class="pb-num"><%= formatINR(p.revenue) %></td></tr><% }) %>
            </tbody>
          </table>
          <% } else { %><p class="pb-an-empty">Nothing sold yet.</p><% } %>
        </section>
        <section class="pa-card">
          <div class="pb-an-section-head"><h2>Recent orders</h2><a href="/dashboard/orders">All orders →</a></div>
          <% if (stats.recent.length) { %>
          <table class="pb-an-table">
            <tbody>
              <% stats.recent.forEach(function (o) { %>
              <tr><td><%= o.buyer || '—' %></td><td><%= dayMonth(o.created_at) %></td><td><span class="pb-an-status <%= o.status %>"><%= STATUS_LABEL[o.status] || o.status %></span></td><td class="pb-num"><%= formatINR(o.total) %></td></tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %><p class="pb-an-empty">No orders yet — share the link to get your first sale.</p><% } %>
        </section>
      </div>

      <% } else if (tab === 'customers') { %>
      <%# ================= CUSTOMERS ================= %>
      <section class="pa-card pa-flush">
        <div class="pa-card-head">
          <div>
            <h2>Customers</h2>
            <p><%= stats.customers.length %> <%= stats.customers.length === 1 ? 'person has' : 'people have' %> ordered from this page. Click a customer for their orders.</p>
          </div>
          <% if (stats.customers.length) { %>
          <input type="search" class="pz-field-input pa-search" id="customerSearch" placeholder="Search name, email, phone, city…" aria-label="Search customers" />
          <% } %>
        </div>
        <% if (!stats.customers.length) { %>
        <p class="pb-an-empty pa-pad">No customers yet — they’ll show up here after their first order.</p>
        <% } else { %>
        <div class="pa-customers" id="customerList">
          <div class="pa-cust-row pa-cust-headrow" aria-hidden="true">
            <span>Customer</span><span>Contact</span><span class="pb-num">Orders</span><span class="pb-num">Spent</span><span>Last order</span>
          </div>
          <% stats.customers.forEach(function (c) { %>
          <details class="pa-customer" data-search="<%= [c.name, c.email, c.phone, addressLine(c.address)].join(' ').toLowerCase() %>">
            <summary class="pa-cust-row">
              <span class="pa-cust-name">
                <span class="pa-avatar" aria-hidden="true"><%= (c.name || c.email || '?').trim().charAt(0).toUpperCase() %></span>
                <span><b><%= c.name || '—' %></b><% if (c.products.length) { %><small><%= c.products.map(function (p) { return p.qty > 1 ? p.title + ' × ' + p.qty : p.title; }).join(', ') %></small><% } %></span>
              </span>
              <span class="pa-cust-contact"><a href="mailto:<%= c.email %>"><%= c.email %></a><% if (c.phone) { %><small><%= c.phone %></small><% } %></span>
              <span class="pb-num" data-label="Orders"><%= c.orders.length %><% if (c.paidCount !== c.orders.length) { %> <small>(<%= c.paidCount %> paid)</small><% } %></span>
              <span class="pb-num" data-label="Spent"><b><%= formatINR(c.spent) %></b></span>
              <span data-label="Last order"><%= dayMonth(c.lastAt) %></span>
            </summary>
            <div class="pa-cust-detail">
              <dl class="pa-facts">
                <div><dt>Email</dt><dd><a href="mailto:<%= c.email %>"><%= c.email %></a></dd></div>
                <div><dt>Phone</dt><dd><%= c.phone || '—' %></dd></div>
                <div><dt>Delivery address</dt><dd><%= addressLine(c.address) || '—' %></dd></div>
                <div><dt>Customer since</dt><dd><%= shortDate(c.firstAt) %></dd></div>
              </dl>
              <table class="pb-an-table">
                <thead><tr><th>Order</th><th>Date</th><th>Items</th><th>Status</th><th class="pb-num">Total</th></tr></thead>
                <tbody>
                  <% c.orders.forEach(function (o) { %>
                  <tr>
                    <td>#<%= o.id %></td>
                    <td><%= shortDate(o.created_at) %></td>
                    <td><%= o.items.map(function (i) { return i.qty > 1 ? i.title + ' × ' + i.qty : i.title; }).join(', ') %><% if (o.coupon) { %> <small class="pa-muted">· <%= o.coupon %></small><% } %><% if (o.note) { %><small class="pa-note">“<%= o.note %>”</small><% } %></td>
                    <td><span class="pb-an-status <%= o.status %>"><%= STATUS_LABEL[o.status] || o.status %></span><% if (o.fulfillment === 'unfulfilled') { %> <span class="pb-an-status pending">To ship</span><% } else if (o.fulfillment === 'shipped') { %> <span class="pb-an-status">Shipped</span><% } %></td>
                    <td class="pb-num"><%= formatINR(o.total) %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </details>
          <% }) %>
          <p class="pb-an-empty pa-pad" id="customerNoMatch" hidden>No customers match that search.</p>
        </div>
        <% } %>
      </section>

      <% } else { %>
      <%# ================= ABANDONED CARTS ================= %>
      <section class="pb-an-tiles pa-tiles-3">
        <div class="pb-an-tile"><span>Abandoned carts</span><strong><%= abandoned.length %></strong><small>not paid for</small></div>
        <div class="pb-an-tile"><span>Value left behind</span><strong><%= formatINR(abandonedValue) %></strong><small>across those carts</small></div>
        <div class="pb-an-tile"><span>Left at payment</span><strong><%= abandoned.filter(function (a) { return a.stage !== 'details'; }).length %></strong><small>placed the order, didn’t pay</small></div>
      </section>

      <section class="pa-card pa-flush">
        <div class="pa-card-head">
          <div>
            <h2>Abandoned carts</h2>
            <p>Buyers who entered their email and had something in their cart, but didn’t pay within 30 minutes. Send a reminder, or dismiss carts you’ve dealt with.</p>
          </div>
        </div>
        <% if (!abandoned.length) { %>
        <p class="pb-an-empty pa-pad">No abandoned carts — everyone who started checking out finished. 🎉</p>
        <% } else { %>
        <ul class="pa-abandoned">
          <% abandoned.forEach(function (a) { %>
          <li class="pa-ab-row">
            <div class="pa-ab-who">
              <span class="pa-avatar" aria-hidden="true"><%= (a.name || a.email).trim().charAt(0).toUpperCase() %></span>
              <span>
                <b><%= a.name || 'No name given' %></b>
                <small><a href="mailto:<%= a.email %>"><%= a.email %></a><%= a.phone ? ' · ' + a.phone : '' %></small>
              </span>
            </div>
            <div class="pa-ab-cart">
              <span><%= a.items.map(function (i) { return i.qty > 1 ? i.title + ' × ' + i.qty : i.title; }).join(', ') %></span>
              <small><span class="pb-an-status <%= a.stage === 'details' ? 'pending' : 'cancelled' %>"><%= STAGE[a.stage] %></span> · <%= ago(a.updatedAt) %></small>
            </div>
            <div class="pa-ab-total"><b><%= formatINR(a.total) %></b></div>
            <div class="pa-ab-actions">
              <a class="pz-card-btn" href="<%= reminderLink(a) %>">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                Send reminder
              </a>
              <form method="POST" action="/dashboard/payment-pages/<%= page.id %>/abandoned/<%= a.id %>/dismiss">
                <button type="submit" class="pz-card-btn" title="Remove from this list">Dismiss</button>
              </form>
            </div>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </section>
      <% } %>

    </div>
  </main>
</div>

<% if (tab === 'customers' && stats.customers.length) { %>
<script>
  // Filters the customer list as you type.
  (function () {
    var input = document.getElementById('customerSearch');
    var rows = document.querySelectorAll('.pa-customer');
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (row) {
        var match = !q || row.dataset.search.indexOf(q) !== -1;
        row.hidden = !match;
        if (match) shown += 1;
      });
      document.getElementById('customerNoMatch').hidden = shown > 0;
    });
  })();
</script>
<% } %>
</body>
</html>
