<%# Events app home (lib/appDashboard.js → /dashboard/events): upcoming and past events with RSVP counts, and a form to add one. %>
<%- include('partials/app-dash-top', { navActive: '/dashboard/events', section: 'Events', heading: 'Events', intro: 'Workshops, webinars and meetups. Share an event’s link and people RSVP — each one also lands in your Audience.' }) %>
<% var storeUrl = storeUrlFor(user.handle);
function eventRow(e) { var link = storeUrl + '/event/' + e.slug; %>
    <li class="ax-row<%= e.visible ? '' : ' is-off' %>">
      <div class="ax-when"><b><%= fmt.date(e.date) %></b><span><%= fmt.time(e.start_time) %></span></div>
      <div class="ax-main">
        <a class="ax-title" href="/dashboard/events/<%= e.id %>"><%= e.title %></a>
        <span class="ax-sub ax-block"><%= e.mode === 'online' ? 'Online' : (e.location || 'Venue') %> · <%= e.going %><%= e.capacity ? ' / ' + e.capacity : '' %> going<%= e.visible ? '' : ' · Hidden' %></span>
        <span class="ax-link"><a href="<%= link %>" target="_blank" rel="noopener"><%= link.replace(/^https?:\/\//, '') %></a></span>
      </div>
      <button type="button" class="ax-btn ax-btn-quiet" data-copy="<%= link %>">Copy link</button>
      <a class="ax-btn" href="/dashboard/events/<%= e.id %>">Manage</a>
    </li>
<% } %>

<section class="ax-panel">
  <div class="ax-panel-head"><h2>Upcoming</h2><span class="ax-count"><%= upcoming.length %></span></div>
  <% if (upcoming.length) { %>
  <ul class="ax-list"><% upcoming.forEach(eventRow) %></ul>
  <% } else { %>
  <p class="ax-empty">Nothing scheduled. Add your first event below.</p>
  <% } %>
  <form method="POST" action="/dashboard/events" class="ax-new">
    <h3>New event</h3>
    <div class="ax-grid">
      <label class="ax-field ax-span-3"><span>Name</span><input class="ax-input" name="title" placeholder="Live Q&amp;A: pricing your first product" required maxlength="200" /></label>
      <label class="ax-field"><span>Date</span><input class="ax-input" type="date" name="date" value="<%= defaultDate %>" required /></label>
      <label class="ax-field"><span>Starts (IST)</span><input class="ax-input" type="time" name="start_time" value="18:00" required /></label>
      <label class="ax-field"><span>Where</span>
        <select class="ax-input" name="mode"><option value="online">Online</option><option value="venue">At a venue</option></select></label>
    </div>
    <button class="ax-btn ax-btn-primary">Create event</button>
  </form>
</section>

<% if (past.length) { %>
<section class="ax-panel">
  <details>
    <summary class="ax-panel-head"><h2>Past events</h2><span class="ax-count"><%= past.length %></span></summary>
    <ul class="ax-list"><% past.forEach(eventRow) %></ul>
  </details>
</section>
<% } %>

<%- include('partials/app-dash-bottom') %>
