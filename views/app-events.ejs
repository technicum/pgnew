<%# Events app home (lib/appDashboard.js → /dashboard/events): upcoming and past events with RSVP counts. "Create event" (beside the heading, as on Payment pages) makes a hidden draft and opens it in the full-screen editor (app-event-edit). %>
<% var createBtn = '<form method="POST" action="/dashboard/events"><button class="ax-btn ax-btn-primary ax-create"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg><span>Create event</span></button></form>'; %>
<%- include('partials/app-dash-top', { navActive: '/dashboard/events', section: 'Events', heading: 'Events', intro: 'Workshops, webinars and meetups. Share an event’s link and people RSVP — each one also lands in your Audience.', headAction: createBtn }) %>
<% var storeUrl = storeUrlFor(user.handle);
function eventRow(e) { var link = storeUrl + '/event/' + e.slug; %>
    <li class="ax-row<%= e.visible ? '' : ' is-off' %>">
      <div class="ax-when"><b><%= fmt.date(e.date) %></b><span><%= fmt.time(e.start_time) %></span></div>
      <div class="ax-main">
        <a class="ax-title" href="/dashboard/events/<%= e.id %>"><%= e.title %></a>
        <span class="ax-sub ax-block"><%= e.mode === 'online' ? 'Online' : (e.location || 'Venue') %> · <%= e.going %><%= e.capacity ? ' / ' + e.capacity : '' %> going<%= e.visible ? '' : ' · Hidden' %></span>
        <span class="ax-link"><a href="<%= link %>" target="_blank" rel="noopener"><%= link.replace(/^https?:\/\//, '') %></a></span>
      </div>
      <button type="button" class="ax-btn ax-btn-quiet" data-copy="<%= link %>">Copy link</button>
      <a class="ax-btn" href="/dashboard/events/<%= e.id %>">Edit</a>
    </li>
<% } %>

<section class="ax-panel">
  <div class="ax-panel-head"><h2>Upcoming</h2><span class="ax-count"><%= upcoming.length %></span></div>
  <% if (upcoming.length) { %>
  <ul class="ax-list"><% upcoming.forEach(eventRow) %></ul>
  <% } else { %>
  <div class="ax-empty">
    <p style="margin:0 0 12px">Nothing scheduled yet.</p>
    <%- createBtn %>
  </div>
  <% } %>
</section>

<% if (past.length) { %>
<section class="ax-panel">
  <details>
    <summary class="ax-panel-head"><h2>Past events</h2><span class="ax-count"><%= past.length %></span></summary>
    <ul class="ax-list"><% past.forEach(eventRow) %></ul>
  </details>
</section>
<% } %>

<%- include('partials/app-dash-bottom') %>
