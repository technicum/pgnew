<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Nunito:wght@600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/builder.css?v=<%= assetVersion %>" />
<%# The live preview's canvas and device frame (the editors' studio.css), the real store page in it (live-preview.css). %>
<link rel="stylesheet" href="/css/studio.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/live-preview.css?v=<%= assetVersion %>" />
</head>
<body class="bg-background">

<div class="pz-promo" id="promoBar">
  Your store is on the free plan — <strong>upgrade for custom domains and more themes</strong>
  <button type="button" class="pz-promo-close" id="promoClose" aria-label="Dismiss">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="13" height="13"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </button>
</div>

<div class="pz-shell">

  <aside class="pz-rail">
    <a href="/dashboard" class="pz-rail-logo" aria-label="Back to dashboard">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><path d="M5 12.5L10 17L19 7" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <nav class="pz-rail-nav" aria-label="Store editor sections">
      <button type="button" class="pz-rail-btn active" data-tab="content">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="11" height="4" rx="1"/></svg>
        Content
      </button>
      <button type="button" class="pz-rail-btn" data-tab="profile">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
        Profile
      </button>
      <button type="button" class="pz-rail-btn" data-tab="design">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Design
      </button>
      <button type="button" class="pz-rail-btn" data-tab="seo">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        SEO
      </button>
    </nav>
    <div class="pz-rail-bottom">
      <a href="/dashboard" class="pz-rail-btn" style="text-decoration:none;" aria-label="Settings">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
        Settings
      </a>
    </div>
  </aside>

  <div class="pz-main">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <a href="/dashboard" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold border border-border bg-background text-foreground hover:bg-muted h-10 px-4" style="text-decoration:none;" aria-label="Exit store builder and return to dashboard">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        Exit
      </a>
      <div class="pz-topbar-switcher">
        <span class="pz-topbar-avatar" id="switcherInitials"><%= user.name.split(/\s+/).filter(Boolean).slice(0,2).map(function(p){return p[0].toUpperCase();}).join('') || 'U' %></span>
        <span class="text-sm font-semibold" id="switcherHandle">@<%= user.handle %></span>
      </div>
      <span class="pz-save-status" id="saveStatus"><span class="dot"></span><span id="saveStatusText">Saved</span></span>
      <div class="ml-auto flex items-center gap-2">
        <a href="<%= storeUrlFor(user.handle) %>" id="viewLiveBtn" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold border border-border bg-background text-foreground hover:bg-muted h-10 px-4" style="text-decoration:none;" target="_blank" rel="noopener">View live</a>
        <button type="button" class="pz-save-btn inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold border border-border bg-background text-foreground hover:bg-muted active:translate-y-px h-10 px-4" id="saveBtn" title="Save now (Ctrl+S)" disabled>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
          Save
        </button>
        <button type="button" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 active:translate-y-px h-10 px-4">Publish</button>
      </div>
    </header>

    <div class="mx-auto max-w-[1500px] px-4 py-7 md:px-8 md:py-9">
      <div class="pz-builder-grid">

        <div>

          <!-- CONTENT TAB -->
          <div class="pz-tabpanel active" id="tab-content">
            <%# Announcement bar across the top of the store (lib/storeSettings.js). %>
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6 mb-4">
              <div class="flex items-center justify-between" style="gap:12px;">
                <div>
                  <h2 class="text-lg font-bold">Announcement bar</h2>
                  <p class="mt-1 text-sm text-muted-foreground">A slim bar across the top of your store — a launch, a sale, a new video</p>
                </div>
                <button type="button" class="pz-switch<%= settings.announceOn ? ' on' : '' %>" id="announceToggle" role="switch" aria-checked="<%= settings.announceOn %>" aria-label="Show announcement bar"></button>
              </div>
              <div class="pz-grid-2 mt-4" id="announceFields"<%= settings.announceOn ? '' : ' hidden' %>>
                <div>
                  <div class="pz-label-row">
                    <label class="pz-label" for="set-announceText">Message</label>
                    <span class="pz-counter" data-counter-for="set-announceText"></span>
                  </div>
                  <input type="text" id="set-announceText" class="pz-field-input" data-setting="announceText" value="<%= settings.announceText %>" maxlength="<%= limits.announceText %>" placeholder="e.g. New course launching Friday" />
                </div>
                <div>
                  <label class="pz-label" for="set-announceUrl">Link <span class="pz-optional">optional</span></label>
                  <input type="text" id="set-announceUrl" class="pz-field-input" data-setting="announceUrl" value="<%= settings.announceUrl %>" maxlength="<%= limits.announceUrl %>" placeholder="https://… or #subscribe-12" />
                </div>
              </div>
            </article>

            <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-lg font-bold">Content</h2>
                  <p class="mt-1 text-sm text-muted-foreground">What you're selling, in the order visitors see it</p>
                </div>
                <button type="button" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-semibold bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 h-10 px-4" id="addMenuBtn" aria-haspopup="dialog" aria-controls="addModal">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
                  Add content
                </button>
              </div>

              <div class="mt-5" id="blocksList" style="display:flex; flex-direction:column; gap:10px;"><!-- injected --></div>

              <div id="emptyBlocks" class="text-sm text-muted-foreground" style="display:none; text-align:center; padding:32px 18px; border:1px dashed var(--border); border-radius:calc(var(--radius) - 2px); margin-top:10px;">
                Nothing on your store yet — tap "Add content" to add a course, booking, download, link and more.
              </div>
            </article>
          </div>

          <!-- PROFILE TAB -->
          <div class="pz-tabpanel" id="tab-profile">
            <div class="pz-stack">
              <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
                <h2 class="text-lg font-bold">Profile</h2>
                <p class="mt-1 text-sm text-muted-foreground">How you're introduced at the top of your store</p>

                <%# Cover and photo: uploads (POST /dashboard/uploads), saved with the store settings. %>
                <div class="pz-cover mt-5<%= settings.cover ? ' has-image' : '' %>" data-image-field="cover">
                  <img src="<%= settings.cover %>" alt="" data-image-preview />
                  <div class="pz-cover-empty">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>
                    <span><strong>Cover image</strong> · wide, at least 1200×400</span>
                  </div>
                  <div class="pz-cover-actions">
                    <label class="pz-chip-btn">
                      <span data-upload-label><%= settings.cover ? 'Change' : 'Upload cover' %></span>
                      <input type="file" accept="image/jpeg,image/png,image/webp" hidden data-upload />
                    </label>
                    <button type="button" class="pz-chip-btn" data-image-remove<%= settings.cover ? '' : ' hidden' %>>Remove</button>
                  </div>
                </div>

                <div class="pz-profile-row mt-5">
                  <div class="pz-photo<%= settings.photo ? ' has-image' : '' %>" data-image-field="photo">
                    <div class="pz-profile-avatar font-display" id="avatarInitials"><%= user.name.split(/\s+/).filter(Boolean).slice(0,2).map(function(p){return p[0].toUpperCase();}).join('') || 'U' %></div>
                    <img src="<%= settings.photo %>" alt="" data-image-preview />
                    <label class="pz-photo-btn" title="Upload a profile photo" aria-label="Upload a profile photo">
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3"/></svg>
                      <input type="file" accept="image/jpeg,image/png,image/webp" hidden data-upload />
                    </label>
                    <button type="button" class="pz-photo-remove" data-image-remove<%= settings.photo ? '' : ' hidden' %>>Remove</button>
                  </div>
                  <div class="pz-profile-fields">
                    <div>
                      <label class="pz-label" for="displayName">Display name</label>
                      <input type="text" id="displayName" class="pz-field-input" value="<%= user.name %>" maxlength="120" />
                    </div>
                    <div>
                      <label class="pz-label" for="handle">Your link</label>
                      <div class="pz-input-group">
                        <input type="text" id="handle" value="<%= user.handle %>" autocomplete="off" spellcheck="false" />
                        <span class="pz-input-suffix">.<%= siteDomain %></span>
                      </div>
                      <p class="pz-field-error" id="handleError"></p>
                    </div>
                  </div>
                </div>

                <div class="pz-grid-2 mt-4">
                  <div>
                    <div class="pz-label-row">
                      <label class="pz-label" for="set-tagline">Tagline</label>
                      <span class="pz-counter" data-counter-for="set-tagline"></span>
                    </div>
                    <input type="text" id="set-tagline" class="pz-field-input" data-setting="tagline" value="<%= settings.tagline %>" maxlength="<%= limits.tagline %>" placeholder="e.g. Career coach · Ex-Google" />
                  </div>
                  <div>
                    <div class="pz-label-row">
                      <label class="pz-label" for="set-location">Location</label>
                    </div>
                    <input type="text" id="set-location" class="pz-field-input" data-setting="location" value="<%= settings.location %>" maxlength="<%= limits.location %>" placeholder="e.g. Bengaluru, India" />
                  </div>
                </div>

                <div class="mt-4">
                  <div class="pz-label-row">
                    <label class="pz-label" for="bio">Bio</label>
                    <span class="pz-counter" id="bioCount"><%= (user.bio || '').length %>/280</span>
                  </div>
                  <textarea id="bio" rows="3" maxlength="280" class="pz-field-input pz-textarea" placeholder="A line or two about who you are and what you offer"><%= user.bio || '' %></textarea>
                </div>
              </article>

              <%# Contact button: a WhatsApp or email button under the socials (lib/storeSettings.js). %>
              <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
                <h2 class="text-lg font-bold">Contact button</h2>
                <p class="mt-1 text-sm text-muted-foreground">A big button under your profile so visitors can reach you in one tap</p>
                <div class="pz-segmented mt-5" role="radiogroup" aria-label="Contact button">
                  <% [['none','Off'],['whatsapp','WhatsApp'],['email','Email']].forEach(function (o) { %>
                    <button type="button" role="radio" data-choice="contactType" data-value="<%= o[0] %>" aria-checked="<%= settings.contactType === o[0] %>"><%= o[1] %></button>
                  <% }) %>
                </div>
                <div class="pz-grid-2 mt-4" id="contactFields"<%= settings.contactType === 'none' ? ' hidden' : '' %>>
                  <div>
                    <label class="pz-label" for="set-contactValue" id="contactValueLabel"><%= settings.contactType === 'email' ? 'Email address' : 'WhatsApp number' %></label>
                    <input type="text" id="set-contactValue" class="pz-field-input" data-setting="contactValue" value="<%= settings.contactValue %>" maxlength="<%= limits.contactValue %>" placeholder="<%= settings.contactType === 'email' ? 'you@example.com' : '+91 98765 43210' %>" />
                  </div>
                  <div>
                    <label class="pz-label" for="set-contactLabel">Button text</label>
                    <input type="text" id="set-contactLabel" class="pz-field-input" data-setting="contactLabel" value="<%= settings.contactLabel %>" maxlength="<%= limits.contactLabel %>" placeholder="<%= settings.contactType === 'email' ? 'Email me' : 'Message me on WhatsApp' %>" />
                  </div>
                </div>
              </article>

              <%# Social links: lib/socials.js — saved with the profile. Shown by a Social links module
                  (Content), and under the bio only if switched on below. %>
              <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
                <div class="flex items-center justify-between" style="gap:12px;">
                  <div>
                    <h2 class="text-lg font-bold">Social links</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Paste a link or just your handle. Add a Social links module in Content to show them on your store.</p>
                  </div>
                  <span class="pz-pill" id="socialCount"></span>
                </div>
                <div class="pz-inline-toggle mt-4">
                  <div>
                    <strong class="text-sm" style="display:block;">Also show under my bio</strong>
                    <span class="text-xs text-muted-foreground">Icons at the top of your store, under your name</span>
                  </div>
                  <button type="button" class="pz-switch<%= settings.socialsInHeader ? ' on' : '' %>" data-setting-switch="socialsInHeader" role="switch" aria-checked="<%= settings.socialsInHeader %>" aria-label="Show social icons under my bio"></button>
                </div>
                <div class="pz-social-list mt-5">
                  <% socialPlatforms.forEach(function (p) { %>
                    <label class="pz-social-row" for="social-<%= p.id %>">
                      <span class="pz-social-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><%- p.icon %></svg>
                      </span>
                      <span class="pz-social-name"><%= p.label %></span>
                      <input type="<%= p.kind === 'email' ? 'email' : p.kind === 'phone' ? 'tel' : 'text' %>" class="pz-field-input" id="social-<%= p.id %>" data-social="<%= p.id %>" value="<%= socials[p.id] || '' %>" placeholder="<%= p.placeholder %>" maxlength="200" autocomplete="off" spellcheck="false" />
                    </label>
                  <% }) %>
                </div>
              </article>
            </div>
          </div>

          <!-- DESIGN TAB -->
          <div class="pz-tabpanel" id="tab-design">
            <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
              <h2 class="text-lg font-bold">Design</h2>
              <p class="mt-1 text-sm text-muted-foreground">One accent color for the buttons, icons and highlights on your store</p>
              <div class="pz-label mt-5">Accent color</div>
              <div class="pz-swatch-row" id="swatchRow" role="radiogroup" aria-label="Accent color">
                <% [['#ff6b4a','Coral'],['#0f8b6c','Teal'],['#2451c9','Ocean'],['#8b3fd6','Plum'],['#d6336c','Rose'],['#e08a00','Amber'],['#12181f','Ink']].forEach(function (c) { %>
                  <button type="button" class="pz-swatch" role="radio" aria-checked="false" data-color="<%= c[0] %>" data-name="<%= c[1] %>">
                    <span class="pz-swatch-dot" style="background:<%= c[0] %>;">
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <%= c[1] %>
                  </button>
                <% }) %>
              </div>

              <%# Theme (lib/storeSettings.js): background, font, button shape. %>
              <div class="pz-label mt-6">Background</div>
              <div class="pz-option-grid" role="radiogroup" aria-label="Background">
                <% [['light','Light'],['tinted','Tinted'],['dark','Dark']].forEach(function (o) { %>
                  <button type="button" class="pz-option" role="radio" data-choice="theme" data-value="<%= o[0] %>" aria-checked="<%= settings.theme === o[0] %>">
                    <span class="pz-theme-swatch is-<%= o[0] %>"><i></i><i></i></span>
                    <%= o[1] %>
                  </button>
                <% }) %>
              </div>

              <div class="pz-label mt-5">Font</div>
              <div class="pz-option-grid" role="radiogroup" aria-label="Font">
                <% [['serif','Classic',"'Fraunces', Georgia, serif"],['sans','Modern',"'IBM Plex Sans', sans-serif"],['rounded','Friendly',"'Nunito', 'IBM Plex Sans', sans-serif"]].forEach(function (o) { %>
                  <button type="button" class="pz-option" role="radio" data-choice="font" data-value="<%= o[0] %>" aria-checked="<%= settings.font === o[0] %>">
                    <span class="pz-font-sample" style="font-family:<%= o[2] %>;">Aa</span>
                    <%= o[1] %>
                  </button>
                <% }) %>
              </div>

              <div class="pz-label mt-5">Buttons &amp; cards</div>
              <div class="pz-option-grid" role="radiogroup" aria-label="Button shape">
                <% [['rounded','Rounded','10px'],['pill','Pill','999px'],['square','Square','3px']].forEach(function (o) { %>
                  <button type="button" class="pz-option" role="radio" data-choice="buttons" data-value="<%= o[0] %>" aria-checked="<%= settings.buttons === o[0] %>">
                    <span class="pz-shape-sample" style="border-radius:<%= o[2] %>;"></span>
                    <%= o[1] %>
                  </button>
                <% }) %>
              </div>

              <div class="pz-footer-toggle-row">
                <div>
                  <strong class="text-sm" style="display:block;">Show "Made with PageZaper" badge</strong>
                  <span class="text-xs text-muted-foreground">Free plan stores carry a small badge at the bottom</span>
                </div>
                <button type="button" class="pz-switch<%= user.show_badge ? ' on' : '' %>" id="badgeToggle" role="switch" aria-checked="<%= user.show_badge ? 'true' : 'false' %>" aria-label="Show badge"></button>
              </div>
            </article>
          </div>

          <!-- SEO TAB -->
          <%# Search and link-preview fields (lib/storeSettings.js) — the <title>, description and og: tags in views/store.ejs. %>
          <div class="pz-tabpanel" id="tab-seo">
            <div class="pz-stack">
              <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
                <h2 class="text-lg font-bold">SEO &amp; sharing</h2>
                <p class="mt-1 text-sm text-muted-foreground">How your store shows up on Google and when your link is shared. Leave blank to use your name and bio.</p>

                <div class="mt-5">
                  <div class="pz-label-row">
                    <label class="pz-label" for="set-seoTitle">Page title</label>
                    <span class="pz-counter" data-counter-for="set-seoTitle"></span>
                  </div>
                  <input type="text" id="set-seoTitle" class="pz-field-input" data-setting="seoTitle" value="<%= settings.seoTitle %>" maxlength="<%= limits.seoTitle %>" placeholder="<%= user.name %> — <%= siteName %>" />
                </div>
                <div class="mt-4">
                  <div class="pz-label-row">
                    <label class="pz-label" for="set-seoDescription">Description</label>
                    <span class="pz-counter" data-counter-for="set-seoDescription"></span>
                  </div>
                  <textarea id="set-seoDescription" rows="3" class="pz-field-input pz-textarea" data-setting="seoDescription" maxlength="<%= limits.seoDescription %>" placeholder="One or two sentences on what visitors will find here"><%= settings.seoDescription %></textarea>
                </div>

                <div class="pz-label mt-4">Share image</div>
                <div class="pz-share-field<%= settings.shareImage ? ' has-image' : '' %>" data-image-field="shareImage">
                  <div class="pz-share-thumb"><img src="<%= settings.shareImage %>" alt="" data-image-preview /></div>
                  <div>
                    <p class="text-xs text-muted-foreground">Shown in WhatsApp, X and LinkedIn previews. 1200×630 works best. Without one, your cover or photo is used.</p>
                    <div class="flex items-center gap-2 mt-2">
                      <label class="pz-chip-btn is-solid">
                        <span data-upload-label><%= settings.shareImage ? 'Change' : 'Upload image' %></span>
                        <input type="file" accept="image/jpeg,image/png,image/webp" hidden data-upload />
                      </label>
                      <button type="button" class="pz-chip-btn is-solid" data-image-remove<%= settings.shareImage ? '' : ' hidden' %>>Remove</button>
                    </div>
                  </div>
                </div>
              </article>

              <article class="rounded-lg border border-border bg-card p-5 shadow-sm md:p-6">
                <h2 class="text-lg font-bold">Preview</h2>
                <p class="mt-1 text-sm text-muted-foreground">Roughly how it will look — each site draws it a little differently</p>
                <div class="pz-label mt-5">Google</div>
                <div class="pz-serp">
                  <span class="pz-serp-url" id="serpUrl"><%= user.handle %>.<%= siteDomain %></span>
                  <span class="pz-serp-title" id="serpTitle"></span>
                  <span class="pz-serp-desc" id="serpDesc"></span>
                </div>
                <div class="pz-label mt-5">Link preview</div>
                <div class="pz-share-card">
                  <div class="pz-share-card-img" id="shareCardImg"></div>
                  <div class="pz-share-card-body">
                    <span class="pz-share-card-host" id="shareCardHost"><%= user.handle %>.<%= siteDomain %></span>
                    <span class="pz-share-card-title" id="shareCardTitle"></span>
                    <span class="pz-share-card-desc" id="shareCardDesc"></span>
                  </div>
                </div>
              </article>
            </div>
          </div>


        </div>

        <div>
          <%# Live preview: the real store page (views/store.ejs), drawn by the server from
              what's on screen now — lib/livePreview.js, public/js/live-preview.js. %>
          <div class="st-canvas is-docked">
            <div class="st-canvas-head">
              <h2>Preview<small>Your real store page — updates as you edit</small></h2>
              <div class="st-devices" role="group" aria-label="Preview size">
                <button type="button" data-st-view="desktop" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>Desktop</button>
                <button type="button" data-st-view="mobile" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>Mobile</button>
              </div>
            </div>
            <p class="lp-status" data-live-status hidden></p>
            <div class="st-device is-mobile" data-st-device>
              <div class="st-chrome"><i></i><i></i><i></i><span class="st-url" id="previewUrl"><%= user.handle %>.<%= siteDomain %></span></div>
              <div class="st-screen lp-box" id="storePreview"></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<div class="pz-modal-backdrop" id="addModal" hidden>
  <div class="pz-modal" role="dialog" aria-modal="true" aria-labelledby="addModalTitle">
    <div class="pz-modal-head">
      <div class="pz-modal-title-row">
        <div>
          <h2 class="text-lg font-bold" id="addModalTitle">Add content</h2>
          <p class="text-xs text-muted-foreground" style="margin-top:2px;">Pick a module to add to your store</p>
        </div>
        <button type="button" class="pz-icon-btn" id="addModalClose" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="pz-modal-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" class="pz-field-input" id="moduleSearch" placeholder="Search modules — course, video, tips…" autocomplete="off" aria-label="Search modules" />
      </div>
    </div>
    <div class="pz-modal-body" id="moduleList"><!-- injected --></div>
  </div>
</div>

<script>
  // Escaping "<" keeps a block title containing a closing script tag from
  // ending this tag early and running as HTML. (Never write that tag
  // literally in here, even in a comment — the browser ends the script at it.)
  window.__PZ_INITIAL_BLOCKS__ = <%- JSON.stringify(blocks).replace(/</g, '\\u003c') %>;
  window.__PZ_ACCENT__ = <%- JSON.stringify(user.accent_color || '#ff6b4a') %>;
  window.__PZ_SETTINGS__ = <%- JSON.stringify(settings).replace(/</g, '\\u003c') %>;
  window.__PZ_SITE_NAME__ = <%- JSON.stringify(siteName) %>;
  window.__PZ_SITE_DOMAIN__ = <%- JSON.stringify(siteDomain) %>;
  // "{handle}" is swapped for the new handle after a profile save.
  window.__PZ_STORE_URL__ = <%- JSON.stringify(storeUrlFor('{handle}')) %>;
</script>
<script src="/js/live-preview.js?v=<%= assetVersion %>"></script>
<script src="/js/studio.js?v=<%= assetVersion %>"></script>
<script src="/js/builder.js?v=<%= assetVersion %>"></script>
</body>
</html>
