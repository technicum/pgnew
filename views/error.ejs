<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/auth.css?v=<%= assetVersion %>" />
<%- include('partials/brand-icon') %>
</head>
<body class="auth-page">

<div class="auth-top">
  <a href="/" class="logo">
    <%- include('partials/brand-app') %>
  </a>
</div>

<div class="auth-wrap">
  <div class="auth-card" style="text-align:center;">
    <h1><%= heading %></h1>
    <p class="auth-sub"><%= message %></p>
    <a href="/" class="btn btn-primary" style="width:100%; text-decoration:none;">Back to homepage</a>
    <%# Store pages render this before currentUser is set, hence the typeof check. %>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <div class="auth-switch"><a href="/dashboard">Go to your dashboard</a></div>
    <% } else { %>
    <div class="auth-switch"><a href="/login">Log in</a> · <a href="/signup">Create your store</a></div>
    <% } %>
  </div>
</div>

</body>
</html>
