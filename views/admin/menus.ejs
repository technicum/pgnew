<%- include('partials/header') %>

<div class="panel" style="max-width:480px; margin-bottom:20px;">
  <h2>Create a menu</h2>
  <form action="/admin/menus" method="POST" class="menu-create-form">
    <input type="text" name="name" placeholder="e.g. Main menu" maxlength="100" required />
    <button type="submit" class="btn btn-primary">Create menu</button>
  </form>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Name</th><th>Last updated</th><th></th></tr>
  </thead>
  <tbody>
    <% menus.forEach(function (m) { %>
      <tr>
        <td><a href="/admin/menus/<%= m.id %>"><%= m.name %></a></td>
        <td><%= new Date(m.updated_at).toLocaleDateString() %></td>
        <td class="admin-row-actions">
          <a href="/admin/menus/<%= m.id %>">Edit</a>
          <form action="/admin/menus/<%= m.id %>/delete" method="POST" onsubmit="return confirm('Delete this menu? Any Nav menu section using it will show no links until you pick another.');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (menus.length === 0) { %>
      <tr><td colspan="3" class="empty-state">No menus yet — create one above, then add pages, categories, products, or custom links to it. A "Nav menu" section (in the header or footer builder) can then display it.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
