<%- include('partials/header') %>

<form action="/admin/discounts/new" method="POST" class="admin-form">
  <label>Code *
    <input type="text" name="code" required placeholder="WELCOME10" style="text-transform:uppercase;" />
  </label>

  <div class="form-row">
    <label>Type
      <select name="type">
        <option value="percent">Percentage off</option>
        <option value="flat">Flat amount off (₹)</option>
      </select>
    </label>
    <label>Value *
      <input type="number" step="0.01" min="0" name="value" required placeholder="10" />
    </label>
  </div>

  <button type="submit" class="btn btn-primary">Create discount</button>
</form>

<%- include('partials/footer') %>
