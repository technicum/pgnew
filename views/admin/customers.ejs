<%- include('partials/header') %>

<table class="admin-table">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Orders</th><th>Total spent</th><th>Last order</th></tr>
  </thead>
  <tbody>
    <% customers.forEach(function(c) { %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.email %></td>
        <td><%= c.orderCount %></td>
        <td>₹<%= c.totalSpent.toFixed(2) %></td>
        <td><%= new Date(c.lastOrderAt).toLocaleDateString() %></td>
      </tr>
    <% }); %>
    <% if (customers.length === 0) { %>
      <tr><td colspan="5" class="empty-state">No customers yet — they show up here once you get your first order.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
