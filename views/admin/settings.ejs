<%- include('partials/header') %>

<div class="dashboard-grid">
  <section class="panel">
    <h2>Site</h2>
    <form action="/admin/settings/store" method="POST" class="admin-form">
      <label>Site name
        <input type="text" name="name" value="<%= store.name %>" required />
      </label>

      <label>Site type
        <select name="category">
          <option value="" <%= !store.category ? 'selected' : '' %>>Not set (treated as Online Store)</option>
          <% storeCategories.forEach(function(c) { %>
            <option value="<%= c %>" <%= store.category === c ? 'selected' : '' %>><%= categoryLabels[c] %></option>
          <% }); %>
        </select>
      </label>
      <p class="field-hint">Only "Online Store" has a product catalog — every other site type hides Product grid, Product spotlight and Collection list from the page builder.</p>

      <label>Theme</label>
      <div class="theme-picker">
        <% themes.forEach(function(t) { %>
          <label class="theme-swatch theme-swatch-<%= t %>">
            <input type="radio" name="theme" value="<%= t %>" <%= store.theme === t ? 'checked' : '' %> />
            <span class="swatch-dot"></span>
            <span class="swatch-label"><%= t.charAt(0).toUpperCase() + t.slice(1) %></span>
          </label>
        <% }); %>
      </div>

      <label>WhatsApp number
        <input type="text" name="whatsapp_number" value="<%= store.whatsapp_number || '' %>" placeholder="e.g. 919876543210 (country code + number, digits only)" />
      </label>
      <p class="field-hint">Powers the storefront's "Chat to order on WhatsApp" product-page button and lets you log sales made over WhatsApp from Orders &gt; New order (WhatsApp). Leave blank to hide both.</p>

      <button type="submit" class="btn btn-primary" style="margin-top:8px;">Save site settings</button>
    </form>
  </section>

  <section class="panel">
    <h2>Change password</h2>
    <form action="/admin/settings/password" method="POST" class="admin-form">
      <label>Current password
        <input type="password" name="currentPassword" required />
      </label>
      <label>New password
        <input type="password" name="newPassword" required minlength="6" />
      </label>
      <label>Confirm new password
        <input type="password" name="confirmPassword" required minlength="6" />
      </label>
      <button type="submit" class="btn btn-primary">Change password</button>
    </form>
  </section>

  <section class="panel">
    <h2>Team</h2>
    <table class="admin-table">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
      <tbody>
        <% team.forEach(function(t) { %>
          <tr>
            <td><%= t.name %></td>
            <td><%= t.email %></td>
            <td><span class="status-pill"><%= t.role %></span></td>
            <td class="admin-row-actions">
              <% if (admin && admin.role === 'admin') { %>
                <form action="/admin/settings/team/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Remove ' + <%- JSON.stringify(t.name) %> + ' from this site?');">
                  <button type="submit" class="link-btn danger">Remove</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (team.length === 0) { %>
          <tr><td colspan="4" class="empty-state">No team members yet.</td></tr>
        <% } %>
      </tbody>
    </table>

    <form action="/admin/settings/team" method="POST" class="admin-form" style="margin-top:16px;">
      <label>Name
        <input type="text" name="name" required />
      </label>
      <label>Email
        <input type="email" name="email" required />
      </label>
      <label>Password
        <input type="password" name="password" minlength="6" placeholder="Leave blank if they already have a PageZaper login" />
      </label>
      <label>Role
        <select name="role">
          <option value="manager">Manager</option>
          <option value="admin">Admin</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary" style="margin-top:8px;">Add to team</button>
    </form>
    <% if (!(admin && admin.role === 'admin')) { %>
      <p style="color:#6b7280; margin-top:8px; font-size: 0.9em;">As a Manager, you can add teammates but only an Admin can remove them.</p>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
