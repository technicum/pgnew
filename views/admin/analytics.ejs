<%- include('partials/header') %>

<div class="dashboard-grid">
  <section class="panel">
    <h2>Revenue by day (last 30 days)</h2>
    <% if (days.length === 0) { %>
      <p class="empty-state">No orders in the last 30 days yet.</p>
    <% } else { %>
      <div class="bar-chart">
        <% days.forEach(function(d) { %>
          <div class="bar-chart-row">
            <span class="bar-chart-label"><%= new Date(d.day).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %></span>
            <div class="bar-chart-track">
              <div class="bar-chart-fill" style="width: <%= Math.max(4, Math.round((d.revenue / maxRevenue) * 100)) %>%;"></div>
            </div>
            <span class="bar-chart-value">₹<%= d.revenue.toFixed(0) %> · <%= d.orders %> order<%= d.orders === 1 ? '' : 's' %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <h2>Top products (by units sold)</h2>
    <% if (topProducts.length === 0) { %>
      <p class="empty-state">No sales yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Product</th><th>Units sold</th><th>Revenue</th></tr></thead>
        <tbody>
          <% topProducts.forEach(function(p) { %>
            <tr>
              <td><%= p.title %></td>
              <td><%= p.unitsSold %></td>
              <td>₹<%= p.revenue.toFixed(2) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
