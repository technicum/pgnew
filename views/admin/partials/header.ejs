<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %><%= typeof store !== 'undefined' && store ? ' · ' + store.name + ' Admin' : ' · PageZaper Admin' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body theme-<%= typeof store !== 'undefined' && store && store.theme ? store.theme : 'default' %>">
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-logo"><%= typeof store !== 'undefined' && store ? store.name : 'PageZaper' %> <small>Admin</small></div>
      <nav class="admin-nav">
        <a href="/admin" class="<%= title === 'Dashboard' ? 'active' : '' %>">Home</a>
        <a href="/admin/orders" class="<%= title && (title === 'Orders' || title.startsWith('Order ')) ? 'active' : '' %>">Orders</a>
        <a href="/admin/products" class="<%= title && (title === 'Products' || title === 'New Product' || title === 'Edit Product') ? 'active' : '' %>">Products</a>
        <a href="/admin/customers" class="<%= title === 'Customers' ? 'active' : '' %>">Customers</a>
        <a href="/admin/discounts" class="<%= title && (title === 'Discounts' || title === 'New Discount') ? 'active' : '' %>">Discounts</a>

        <% var isMenusScreen = title && (title === 'Menus' || title.startsWith('Edit menu: ')); %>
        <% var editStoreOpen = title && (title === 'Themes' || title.startsWith('Customize ') || title === 'Pages' || title === 'New Page' || (title.startsWith('Edit ') && !isMenusScreen) || title === 'Header' || title === 'Footer' || title.indexOf(' override — ') !== -1 || isMenusScreen || title === 'Media'); %>
        <a href="/admin/store/themes" class="<%= editStoreOpen ? 'active' : '' %>">Edit Store</a>
        <% if (editStoreOpen) { %>
          <a href="/admin/store/themes" class="admin-nav-sub <%= title && (title === 'Themes' || title.startsWith('Customize ')) ? 'active' : '' %>">Themes</a>
          <a href="/admin/pages" class="admin-nav-sub <%= title && (title === 'Pages' || title === 'New Page' || (title.startsWith('Edit ') && !isMenusScreen)) ? 'active' : '' %>">Pages</a>
          <a href="/admin/layout/header" class="admin-nav-sub <%= title === 'Header' ? 'active' : '' %>">Header</a>
          <a href="/admin/layout/footer" class="admin-nav-sub <%= title === 'Footer' ? 'active' : '' %>">Footer</a>
          <a href="/admin/menus" class="admin-nav-sub <%= isMenusScreen ? 'active' : '' %>">Menus</a>
          <a href="/admin/media" class="admin-nav-sub <%= title === 'Media' ? 'active' : '' %>">Media</a>
          <a href="/" target="_blank" class="admin-nav-sub">View store ↗</a>
        <% } %>

        <div class="admin-nav-divider"></div>
        <a href="/admin/markets" class="<%= title === 'Markets' ? 'active' : '' %>">Markets</a>
        <a href="/admin/finance" class="<%= title === 'Finance' ? 'active' : '' %>">Finance</a>
        <a href="/admin/analytics" class="<%= title === 'Analytics' ? 'active' : '' %>">Analytics</a>

        <a href="/admin/apps" class="<%= title === 'Apps' ? 'active' : '' %>">Apps</a>
        <% if (title === 'Apps') { %>
          <a href="/admin/apps" class="admin-nav-sub active">Manage apps</a>
          <a href="https://apps.pagezaper.com" target="_blank" rel="noopener" class="admin-nav-sub">Add new app ↗</a>
        <% } %>

        <div class="admin-nav-divider"></div>
        <a href="/admin/settings" class="<%= title === 'Settings' ? 'active' : '' %>">Settings</a>
      </nav>
      <form action="/admin/logout" method="POST" class="admin-logout-form">
        <button type="submit" class="link-btn">Log out</button>
      </form>
    </aside>
    <div class="admin-main">
      <% if (typeof impersonation !== 'undefined' && impersonation) { %>
        <div class="impersonation-banner">
          <span>You're viewing this store's admin as <strong><%= admin ? admin.name : '' %></strong>, logged in by platform admin <%= impersonation.platformAdminName %>.</span>
          <form action="/admin/exit-impersonation" method="POST">
            <button type="submit" class="link-btn">Return to Platform Admin</button>
          </form>
        </div>
      <% } %>
      <header class="admin-topbar">
        <h1><%= title %></h1>
        <% if (admin) { %><span class="admin-user">Hi, <%= admin.name %></span><% } %>
      </header>

      <% if (success && success.length) { %>
        <div class="flash flash-success"><%= success[0] %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="flash flash-error"><%= error[0] %></div>
      <% } %>

      <div class="admin-content">
