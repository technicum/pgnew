<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %><%= typeof store !== 'undefined' && store ? ' · ' + store.name + ' Admin' : ' · PageZaper Admin' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body theme-<%= typeof store !== 'undefined' && store && store.theme ? store.theme : 'default' %>">
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-logo"><%= typeof store !== 'undefined' && store ? store.name : 'PageZaper' %> <small>Admin</small></div>
      <nav class="admin-nav">
        <a href="/admin" class="<%= title === 'Dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/admin/pages" class="<%= title && (title === 'Pages' || title.includes('Page') || title.startsWith('Edit ') || title === 'New Page') ? 'active' : '' %>">Pages</a>
        <a href="/admin/products" class="<%= title && title.includes('Product') ? 'active' : '' %>">Products</a>
        <a href="/admin/orders" class="<%= title && title.includes('Order') ? 'active' : '' %>">Orders</a>
        <a href="/" target="_blank">View store ↗</a>
      </nav>
      <form action="/admin/logout" method="POST" class="admin-logout-form">
        <button type="submit" class="link-btn">Log out</button>
      </form>
    </aside>
    <div class="admin-main">
      <% if (typeof impersonation !== 'undefined' && impersonation) { %>
        <div class="impersonation-banner">
          <span>You're viewing this store's admin as <strong><%= admin ? admin.name : '' %></strong>, logged in by platform admin <%= impersonation.platformAdminName %>.</span>
          <form action="/admin/exit-impersonation" method="POST">
            <button type="submit" class="link-btn">Return to Platform Admin</button>
          </form>
        </div>
      <% } %>
      <header class="admin-topbar">
        <h1><%= title %></h1>
        <% if (admin) { %><span class="admin-user">Hi, <%= admin.name %></span><% } %>
      </header>

      <% if (success && success.length) { %>
        <div class="flash flash-success"><%= success[0] %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="flash flash-error"><%= error[0] %></div>
      <% } %>

      <div class="admin-content">
