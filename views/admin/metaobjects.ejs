<%- include('partials/header') %>

<div class="panel" style="max-width:560px; margin-bottom:20px;">
  <h2>Create a metaobject type</h2>
  <p class="form-hint" style="margin-top:0;">A custom content type with its own fields — e.g. "Property" with Bedrooms, Bathrooms and Price, for a real-estate site.</p>
  <form action="/admin/metaobjects" method="POST" class="menu-create-form">
    <input type="text" name="name" placeholder="e.g. Property" maxlength="100" required />
    <button type="submit" class="btn btn-primary">Create type</button>
  </form>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Name</th><th>Handle</th><th>Entries</th><th></th></tr>
  </thead>
  <tbody>
    <% definitions.forEach(function(d) { %>
      <tr>
        <td><a href="/admin/metaobjects/<%= d.id %>"><%= d.name %></a></td>
        <td><code>/<%= d.handle %>/…</code></td>
        <td><%= d.entry_count %></td>
        <td class="admin-row-actions">
          <a href="/admin/metaobjects/<%= d.id %>">Manage</a>
          <form action="/admin/metaobjects/<%= d.id %>/delete" method="POST" onsubmit="return confirm('Delete the ' + <%- JSON.stringify(d.name) %> + ' type? This also deletes its ' + <%= d.entry_count %> + ' entries and can\'t be undone.');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (definitions.length === 0) { %>
      <tr><td colspan="4" class="empty-state">No metaobject types yet — create one above.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
