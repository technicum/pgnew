<%- include('partials/header') %>

<div class="panel-toolbar">
  <a href="/admin/discounts/new" class="btn btn-primary">+ New discount</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Code</th><th>Type</th><th>Value</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% discounts.forEach(function(d) { %>
      <tr>
        <td><strong><%= d.code %></strong></td>
        <td><%= d.type === 'percent' ? 'Percentage off' : 'Flat amount off' %></td>
        <td><%= d.type === 'percent' ? d.value + '%' : '₹' + d.value.toFixed(2) %></td>
        <td><span class="status-pill <%= d.active ? 'status-delivered' : 'status-cancelled' %>"><%= d.active ? 'active' : 'inactive' %></span></td>
        <td class="admin-row-actions">
          <form action="/admin/discounts/<%= d.id %>/toggle" method="POST">
            <button type="submit" class="link-btn"><%= d.active ? 'Deactivate' : 'Activate' %></button>
          </form>
          <form action="/admin/discounts/<%= d.id %>/delete" method="POST" onsubmit="return confirm('Delete this discount code?');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (discounts.length === 0) { %>
      <tr><td colspan="5" class="empty-state">No discount codes yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
