<%- include('partials/header') %>

<form
  action="<%= product ? `/admin/products/${product.id}/edit` : '/admin/products/new' %>"
  method="POST"
  class="admin-form"
>
  <label>Title *
    <input type="text" name="title" value="<%= product ? product.title : '' %>" required />
  </label>

  <label>Description
    <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>
  </label>

  <div class="form-row">
    <label>Price *
      <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required />
    </label>
    <label>Compare-at price
      <input type="number" step="0.01" name="compare_at_price" value="<%= product && product.compare_at_price ? product.compare_at_price : '' %>" />
    </label>
  </div>

  <div class="form-row">
    <label>Stock
      <input type="number" name="stock" value="<%= product ? product.stock : 0 %>" />
    </label>
    <label>Status
      <select name="status">
        <option value="active" <%= product && product.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="draft" <%= product && product.status === 'draft' ? 'selected' : '' %>>Draft</option>
      </select>
    </label>
  </div>

  <div class="admin-form-field">
    <span class="field-label">Categories</span>
    <% if (!categories.length) { %>
      <div class="form-hint">No categories yet — <a href="/admin/categories">create one</a> first, then come back here to assign it.</div>
    <% } else { %>
      <div class="category-checkbox-group">
        <% categories.forEach(function(c) { %>
          <label class="category-checkbox">
            <input type="checkbox" name="category_ids" value="<%= c.id %>" <%= selectedCategoryIds.includes(c.id) ? 'checked' : '' %> />
            <%= c.name %>
          </label>
        <% }); %>
      </div>
    <% } %>
  </div>

  <label>Image URL
    <div class="media-field-row">
      <input type="text" id="productImageUrl" name="image_url" value="<%= product ? product.image_url : '' %>" placeholder="https://..." />
      <button type="button" id="productImagePickBtn" class="btn btn-secondary">Choose from library</button>
    </div>
    <img id="productImagePreview" class="media-field-preview" src="<%= product && product.image_url ? product.image_url : '' %>" alt="" <%= product && product.image_url ? '' : 'hidden' %> />
  </label>

  <button type="submit" class="btn btn-primary"><%= product ? 'Save changes' : 'Create product' %></button>
</form>

<script src="/js/media-picker.js"></script>
<script>
(function () {
  var input = document.getElementById('productImageUrl');
  var btn = document.getElementById('productImagePickBtn');
  var preview = document.getElementById('productImagePreview');

  function updatePreview() {
    if (input.value) {
      preview.src = input.value;
      preview.hidden = false;
    } else {
      preview.hidden = true;
    }
  }
  input.addEventListener('change', updatePreview);

  btn.addEventListener('click', function () {
    MediaPicker.open(function (file) {
      input.value = file.url;
      updatePreview();
    }, { accept: 'image/' });
  });
})();
</script>

<%- include('partials/footer') %>
