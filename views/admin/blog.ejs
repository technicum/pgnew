<%- include('partials/header') %>

<div class="panel-toolbar">
  <a href="/admin/blog/new" class="btn btn-primary">+ New blog post</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Cover</th><th>Title</th><th>Status</th><th>Created</th><th></th></tr>
  </thead>
  <tbody>
    <% posts.forEach(function(p) { %>
      <tr>
        <td><% if (p.cover_image_url) { %><img class="admin-thumb" src="<%= p.cover_image_url %>" alt="" /><% } %></td>
        <td><%= p.title %></td>
        <td><span class="status-pill status-<%= p.status === 'published' ? 'active' : 'draft' %>"><%= p.status %></span></td>
        <td><%= new Date(p.created_at).toLocaleDateString() %></td>
        <td class="admin-row-actions">
          <a href="/admin/blog/<%= p.id %>/edit">Edit</a>
          <form action="/admin/blog/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this blog post?');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (posts.length === 0) { %>
      <tr><td colspan="5" class="empty-state">No blog posts yet. Write your first one.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
