<%- include('partials/header') %>

<div class="panel-toolbar" style="justify-content: space-between; align-items: center;">
  <p id="mediaCount" style="margin: 0; color: #6b7280; font-size: 0.9rem;">
    <%= total %> file<%= total === 1 ? '' : 's' %> · images and PDFs, up to 15MB each
  </p>
  <form id="mediaUploadForm" action="/admin/media/upload" method="POST" enctype="multipart/form-data">
    <input type="file" id="mediaFileInput" name="files" multiple accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/pdf" hidden />
    <button type="button" id="mediaUploadBtn" class="btn btn-primary">Upload files</button>
  </form>
</div>

<div id="mediaError" class="flash flash-error" hidden></div>

<div id="mediaDropzone" class="media-dropzone">
  <div id="mediaGrid" class="media-grid">
    <% files.forEach(function(f) { %>
      <div class="media-card" data-media-id="<%= f.id %>">
        <div class="media-card-thumb">
          <% if (f.mime_type.startsWith('image/')) { %>
            <img src="<%= f.url %>" alt="<%= f.original_name %>" loading="lazy" />
          <% } else { %>
            <div class="media-card-filetype">PDF</div>
          <% } %>
        </div>
        <div class="media-card-body">
          <div class="media-card-name" title="<%= f.original_name %>"><%= f.original_name %></div>
          <div class="media-card-meta"><%= (f.size / 1024).toFixed(0) %> KB</div>
          <div class="media-card-actions">
            <button type="button" class="link-btn media-copy-url" data-url="<%= f.url %>">Copy URL</button>
            <button type="button" class="link-btn danger media-delete-btn" data-media-id="<%= f.id %>">Delete</button>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
  <p id="mediaEmpty" class="empty-state" <%= files.length ? 'hidden' : '' %>>No files yet. Upload your first one, or drag and drop files here.</p>
</div>

<div id="mediaLightbox" class="media-lightbox-overlay" hidden>
  <div class="media-lightbox-inner">
    <button type="button" id="mediaLightboxClose" class="media-lightbox-close" aria-label="Close">&times;</button>
    <img id="mediaLightboxImg" src="" alt="" />
    <div id="mediaLightboxName" class="media-lightbox-name"></div>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('mediaUploadForm');
  var input = document.getElementById('mediaFileInput');
  var btn = document.getElementById('mediaUploadBtn');
  var dropzone = document.getElementById('mediaDropzone');
  var grid = document.getElementById('mediaGrid');
  var emptyState = document.getElementById('mediaEmpty');
  var countEl = document.getElementById('mediaCount');
  var errorEl = document.getElementById('mediaError');
  var lightbox = document.getElementById('mediaLightbox');
  var lightboxImg = document.getElementById('mediaLightboxImg');
  var lightboxName = document.getElementById('mediaLightboxName');
  var lightboxClose = document.getElementById('mediaLightboxClose');
  var fileCount = <%- JSON.stringify(total) %>;

  function openLightbox(url, name) {
    lightboxImg.src = url;
    lightboxImg.alt = name || '';
    lightboxName.textContent = name || '';
    lightbox.hidden = false;
  }
  function closeLightbox() {
    lightbox.hidden = true;
    lightboxImg.src = '';
  }
  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
  });

  // Clicking a card's thumbnail previews it — an image opens in the
  // lightbox above, a PDF (no inline preview here) just opens in a new
  // tab, same as clicking its Copy URL link's target would.
  function wireThumbClick(thumb) {
    thumb.addEventListener('click', function () {
      var img = thumb.querySelector('img');
      if (img) {
        openLightbox(img.src, img.alt);
        return;
      }
      var card = thumb.closest('.media-card');
      var copyBtn = card && card.querySelector('.media-copy-url');
      var url = copyBtn && copyBtn.getAttribute('data-url');
      if (url) window.open(url, '_blank', 'noopener');
    });
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }
  function clearError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }
  function updateCount() {
    countEl.textContent = fileCount + ' file' + (fileCount === 1 ? '' : 's') + ' · images and PDFs, up to 15MB each';
  }

  function cardFor(f) {
    var card = document.createElement('div');
    card.className = 'media-card';
    card.dataset.mediaId = f.id;

    var thumb = document.createElement('div');
    thumb.className = 'media-card-thumb';
    if ((f.mime_type || '').indexOf('image/') === 0) {
      var img = document.createElement('img');
      img.src = f.url;
      img.alt = f.original_name;
      img.loading = 'lazy';
      thumb.appendChild(img);
    } else {
      var badge = document.createElement('div');
      badge.className = 'media-card-filetype';
      badge.textContent = 'PDF';
      thumb.appendChild(badge);
    }
    wireThumbClick(thumb);

    var body = document.createElement('div');
    body.className = 'media-card-body';

    var name = document.createElement('div');
    name.className = 'media-card-name';
    name.title = f.original_name;
    name.textContent = f.original_name;

    var meta = document.createElement('div');
    meta.className = 'media-card-meta';
    meta.textContent = Math.round(f.size / 1024) + ' KB';

    var actions = document.createElement('div');
    actions.className = 'media-card-actions';

    var copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'link-btn media-copy-url';
    copyBtn.dataset.url = f.url;
    copyBtn.textContent = 'Copy URL';
    wireCopyBtn(copyBtn);

    var delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'link-btn danger media-delete-btn';
    delBtn.dataset.mediaId = f.id;
    delBtn.textContent = 'Delete';
    wireDeleteBtn(delBtn);

    actions.appendChild(copyBtn);
    actions.appendChild(delBtn);
    body.appendChild(name);
    body.appendChild(meta);
    body.appendChild(actions);
    card.appendChild(thumb);
    card.appendChild(body);
    return card;
  }

  function wireCopyBtn(b) {
    b.addEventListener('click', function () {
      var url = b.getAttribute('data-url');
      var abs = window.location.origin + url;
      var done = function () { var orig = b.textContent; b.textContent = 'Copied!'; setTimeout(function () { b.textContent = orig; }, 1200); };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(abs).then(done, done);
      } else {
        done();
      }
    });
  }

  function wireDeleteBtn(b) {
    b.addEventListener('click', function () {
      if (!confirm('Delete this file? Nothing that already references its URL will change, but the file itself will be gone.')) return;
      var id = b.getAttribute('data-media-id');
      clearError();
      fetch('/admin/media/' + id + '/delete', {
        method: 'POST',
        headers: { Accept: 'application/json' },
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.ok) {
            var card = grid.querySelector('.media-card[data-media-id="' + id + '"]');
            if (card) card.remove();
            fileCount = Math.max(0, fileCount - 1);
            updateCount();
            if (fileCount === 0) emptyState.hidden = false;
          } else {
            showError('Could not delete that file — it may already be gone.');
          }
        })
        .catch(function () { showError('Delete failed — check your connection and try again.'); });
    });
  }

  // Upload — via fetch, so the page never reloads or navigates away; new
  // files are dropped straight into the grid and the count updates in
  // place. Both the click-to-upload button and drag-and-drop funnel
  // through this same function.
  function uploadFiles(fileList) {
    if (!fileList || !fileList.length) return;
    clearError();
    var originalLabel = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Uploading…';

    var formData = new FormData();
    Array.prototype.forEach.call(fileList, function (file) { formData.append('files', file); });

    fetch('/admin/media/upload', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: formData,
    })
      .then(function (r) { return r.json().then(function (data) { return { status: r.status, data: data }; }); })
      .then(function (res) {
        if (res.data && res.data.ok && res.data.files) {
          res.data.files.forEach(function (f) {
            grid.insertBefore(cardFor(f), grid.firstChild);
          });
          fileCount += res.data.files.length;
          updateCount();
          if (fileCount > 0) emptyState.hidden = true;
        } else {
          showError((res.data && res.data.error) || 'Upload failed.');
        }
      })
      .catch(function () { showError('Upload failed — check your connection and try again.'); })
      .then(function () {
        btn.disabled = false;
        btn.textContent = originalLabel;
        input.value = '';
      });
  }

  btn.addEventListener('click', function () { input.click(); });
  input.addEventListener('change', function () { uploadFiles(input.files); });

  ['dragenter', 'dragover'].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.add('is-dragover'); });
  });
  ['dragleave', 'drop'].forEach(function (evt) {
    dropzone.addEventListener(evt, function (e) { e.preventDefault(); dropzone.classList.remove('is-dragover'); });
  });
  dropzone.addEventListener('drop', function (e) {
    var dt = e.dataTransfer;
    if (dt && dt.files && dt.files.length) uploadFiles(dt.files);
  });

  document.querySelectorAll('.media-copy-url').forEach(wireCopyBtn);
  document.querySelectorAll('.media-delete-btn').forEach(wireDeleteBtn);
  document.querySelectorAll('.media-card-thumb').forEach(wireThumbClick);
})();
</script>

<%- include('partials/footer') %>
