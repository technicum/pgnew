<%- include('partials/header') %>

<p class="crm-back-link" style="display:block; margin-bottom:12px;"><a href="/admin/metaobjects/<%= definition.id %>">&larr; <%= definition.name %></a></p>

<form
  action="<%= entry ? `/admin/metaobjects/${definition.id}/entries/${entry.id}/edit` : `/admin/metaobjects/${definition.id}/entries/new` %>"
  method="POST"
  class="admin-form"
>
  <label>Title *
    <input type="text" name="title" value="<%= entry ? entry.title : '' %>" required />
  </label>

  <label>Status
    <select name="status">
      <option value="active" <%= !entry || entry.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="draft" <%= entry && entry.status === 'draft' ? 'selected' : '' %>>Draft</option>
    </select>
  </label>

  <label>Cover image
    <div class="media-field-row">
      <input type="text" id="entryImageUrl" name="image_url" value="<%= entry ? entry.image_url : '' %>" placeholder="https://..." />
      <button type="button" id="entryImagePickBtn" class="btn btn-secondary">Choose from library</button>
    </div>
    <img id="entryImagePreview" class="media-field-preview" src="<%= entry && entry.image_url ? entry.image_url : '' %>" alt="" <%= entry && entry.image_url ? '' : 'hidden' %> />
  </label>

  <% if (fields.length === 0) { %>
    <p class="form-hint">This type has no fields yet — <a href="/admin/metaobjects/<%= definition.id %>">add some</a> to collect more than just a title.</p>
  <% } %>

  <% fields.forEach(function(f) { %>
    <% var v = values[f.field_key]; %>
    <label>
      <%= f.label %><% if (f.required) { %> *<% } %>

      <% if (f.type === 'textarea') { %>
        <textarea name="field_<%= f.field_key %>" rows="4" <%= f.required ? 'required' : '' %>><%= v || '' %></textarea>

      <% } else if (f.type === 'number') { %>
        <input type="number" step="any" name="field_<%= f.field_key %>" value="<%= v !== undefined && v !== null ? v : '' %>" <%= f.required ? 'required' : '' %> />

      <% } else if (f.type === 'boolean') { %>
        <div style="margin-top:6px;">
          <label class="category-checkbox" style="display:inline-flex !important;">
            <input type="checkbox" name="field_<%= f.field_key %>" value="1" <%= v ? 'checked' : '' %> /> Yes
          </label>
        </div>

      <% } else if (f.type === 'date') { %>
        <input type="date" name="field_<%= f.field_key %>" value="<%= v || '' %>" <%= f.required ? 'required' : '' %> />

      <% } else if (f.type === 'url') { %>
        <input type="url" name="field_<%= f.field_key %>" value="<%= v || '' %>" placeholder="https://..." <%= f.required ? 'required' : '' %> />

      <% } else if (f.type === 'image') { %>
        <div class="media-field-row" data-media-field>
          <input type="text" name="field_<%= f.field_key %>" class="mo-image-input" value="<%= v || '' %>" placeholder="https://..." <%= f.required ? 'required' : '' %> />
          <button type="button" class="btn btn-secondary mo-image-pick-btn">Choose from library</button>
        </div>
        <img class="media-field-preview mo-image-preview" src="<%= v || '' %>" alt="" <%= v ? '' : 'hidden' %> />

      <% } else if (f.type === 'select') { %>
        <select name="field_<%= f.field_key %>" <%= f.required ? 'required' : '' %>>
          <option value="">Choose…</option>
          <% (f.options || []).forEach(function(opt) { %>
            <option value="<%= opt %>" <%= v === opt ? 'selected' : '' %>><%= opt %></option>
          <% }); %>
        </select>

      <% } else { %>
        <input type="text" name="field_<%= f.field_key %>" value="<%= v || '' %>" <%= f.required ? 'required' : '' %> />
      <% } %>
    </label>
  <% }); %>

  <button type="submit" class="btn btn-primary"><%= entry ? 'Save changes' : `Create ${definition.name}` %></button>
</form>

<% if (entry) { %>
  <form action="/admin/metaobjects/<%= definition.id %>/entries/<%= entry.id %>/delete" method="POST" onsubmit="return confirm('Delete this entry?');" style="margin-top:16px;">
    <button type="submit" class="link-btn danger">Delete entry</button>
  </form>
<% } %>

<script src="/js/media-picker.js"></script>
<script>
(function () {
  // The fixed cover-image field -- exact same pattern as product-form.ejs.
  var input = document.getElementById('entryImageUrl');
  var btn = document.getElementById('entryImagePickBtn');
  var preview = document.getElementById('entryImagePreview');
  function updateCoverPreview() {
    if (input.value) { preview.src = input.value; preview.hidden = false; }
    else { preview.hidden = true; }
  }
  input.addEventListener('change', updateCoverPreview);
  btn.addEventListener('click', function () {
    MediaPicker.open(function (file) { input.value = file.url; updateCoverPreview(); }, { accept: 'image/' });
  });

  // Any number of custom 'image' type fields -- same wiring, generalized
  // since (unlike the cover image above) there can be more than one on a
  // page, so each needs its own scoped lookup rather than a fixed id.
  document.querySelectorAll('[data-media-field]').forEach(function (wrap) {
    var fieldInput = wrap.querySelector('.mo-image-input');
    var fieldBtn = wrap.querySelector('.mo-image-pick-btn');
    var fieldPreview = wrap.parentElement.querySelector('.mo-image-preview');
    function updateFieldPreview() {
      if (fieldInput.value) { fieldPreview.src = fieldInput.value; fieldPreview.hidden = false; }
      else { fieldPreview.hidden = true; }
    }
    fieldInput.addEventListener('change', updateFieldPreview);
    fieldBtn.addEventListener('click', function () {
      MediaPicker.open(function (file) { fieldInput.value = file.url; updateFieldPreview(); }, { accept: 'image/' });
    });
  });
})();
</script>

<%- include('partials/footer') %>
