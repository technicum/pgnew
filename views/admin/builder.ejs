<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= store.name %> Admin</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/builder.css" />
</head>
<body class="builder-body">
  <div class="b-app" id="bApp">
    <aside class="b-rail">
      <a href="/admin" class="b-rail-logo" title="Back to admin">Z</a>
      <button class="b-rail-btn active" data-panel="library" title="Add sections" aria-label="Section library">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="6" height="6" rx="1.2"/><rect x="11" y="3" width="6" height="6" rx="1.2"/><rect x="3" y="11" width="6" height="6" rx="1.2"/><rect x="11" y="11" width="6" height="6" rx="1.2"/></svg>
      </button>
      <button class="b-rail-btn" data-panel="layers" title="Page layers" aria-label="Page layers">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M10 2.5 3 6.5l7 4 7-4-7-4Z"/><path d="M3 10.2 10 14l7-3.8"/><path d="M3 13.8 10 17.5l7-3.7"/></svg>
      </button>
      <button class="b-rail-btn" data-panel="components" title="Your saved components" aria-label="Component library">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="m10 2.5 6.5 3.4v8.2L10 17.5l-6.5-3.4V5.9L10 2.5Z"/><path d="M3.5 5.9 10 9.3l6.5-3.4M10 9.3v8.2"/></svg>
      </button>
      <div class="b-rail-spacer"></div>
    </aside>

    <div class="b-side-panel" id="bPanelLibrary">
      <div class="b-side-panel-head">
        <h2>Add a section</h2>
        <p>Drag a block onto the page</p>
      </div>
      <div class="b-side-search">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M16.5 16.5l-3.8-3.8"/></svg>
        <input type="text" id="bLibSearch" placeholder="Search sections…" autocomplete="off" aria-label="Search sections" />
        <button type="button" class="b-side-search-clear" id="bLibSearchClear" title="Clear search" hidden>&times;</button>
      </div>
      <div class="b-side-panel-body" id="bLibraryBody"></div>
    </div>

    <div class="b-side-panel" id="bPanelLayers" hidden>
      <div class="b-side-panel-head">
        <h2>Page structure</h2>
        <p>Drag to reorder, or search to jump to one</p>
      </div>
      <div class="b-side-search">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M16.5 16.5l-3.8-3.8"/></svg>
        <input type="text" id="bLayerSearch" placeholder="Search this page's sections…" autocomplete="off" aria-label="Search page sections" />
        <button type="button" class="b-side-search-clear" id="bLayerSearchClear" title="Clear search" hidden>&times;</button>
      </div>
      <div class="b-side-panel-body" id="bLayersBody"></div>
    </div>

    <div class="b-side-panel" id="bPanelComponents" hidden>
      <div class="b-side-panel-head">
        <h2>Components</h2>
        <p>Rows you've saved from any page — click Insert to add one here</p>
      </div>
      <div class="b-side-panel-body" id="bComponentsBody"></div>
    </div>

    <div class="b-main">
      <%
        // context is 'page' (a page's own body content), 'header' or
        // 'footer' — the latter two cover BOTH the store's global
        // header/footer (page is null) and one page's override of it (page
        // is set) — see routes/admin.js's GET /layout/:region, GET
        // /pages/:id/edit and GET /pages/:id/layout/:region/edit, which are
        // the only three routes that render this template.
        var regionLabel = context === 'header' ? 'Header' : 'Footer';
        var crumbRight = context === 'page'
          ? page.name
          : (page ? (page.name + ' — ' + regionLabel + ' override') : regionLabel);
        var exitHref = context !== 'page' && page ? ('/admin/pages/' + page.id + '/edit') : '/admin/pages';
        var previewHref = page ? (page.is_home ? '/' : '/pages' + page.path) : '/';
      %>
      <header class="b-topbar">
        <div class="b-topbar-left">
          <a class="b-btn-outline b-exit-btn" href="<%= exitHref %>" title="Exit editor">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 6 10l6 6"/></svg>
            Exit editor
          </a>
          <div class="b-crumb"><span class="b-crumb-store"><%= store.name %></span><span class="b-crumb-sep">/</span><span class="b-crumb-page"><%= crumbRight %></span></div>
          <div class="b-history-toggle">
            <button id="bUndoBtn" title="Undo (Ctrl+Z)" aria-label="Undo" disabled>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8H12.5a4 4 0 0 1 0 8H8"/><path d="M8 4.5 4.5 8 8 11.5"/></svg>
            </button>
            <button id="bRedoBtn" title="Redo (Ctrl+Y)" aria-label="Redo" disabled>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8H7.5a4 4 0 0 0 0 8H12"/><path d="M12 4.5 15.5 8 12 11.5"/></svg>
            </button>
          </div>
        </div>
        <div class="b-topbar-center">
          <div class="b-viewport-toggle" id="bViewportToggle">
            <button data-vp="desktop" class="active" title="Desktop" aria-label="Desktop preview">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="4" width="15" height="9.5" rx="1.3"/><path d="M7 17h6M10 13.5V17"/></svg>
            </button>
            <button data-vp="tablet" title="Tablet" aria-label="Tablet preview">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4.5" y="2.5" width="11" height="15" rx="1.6"/><path d="M9 15.2h2"/></svg>
            </button>
            <button data-vp="mobile" title="Mobile" aria-label="Mobile preview">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="6" y="1.8" width="8" height="16.4" rx="1.6"/><path d="M9 15.6h2"/></svg>
            </button>
          </div>
        </div>
        <div class="b-topbar-right">
          <span class="b-save-indicator" id="bSaveIndicator"><span class="b-save-dot"></span><span id="bSaveText">Saved</span></span>
          <a class="b-btn-outline" id="bPreviewLink" href="<%= previewHref %>" target="_blank">Preview</a>
          <% if (context === 'page') { %>
            <button class="b-btn-solid" id="bPublishBtn"></button>
          <% } %>
        </div>
      </header>

      <% if (context === 'page') { %>
        <div class="b-layout-override-bar">
          <% ['header', 'footer'].forEach(function (region) { %>
            <div class="b-layout-override-item">
              <span class="b-layout-override-label"><%= region === 'header' ? 'Header' : 'Footer' %>:</span>
              <% if (layoutOverrides[region]) { %>
                <span class="b-layout-override-state">Custom for this page</span>
                <a class="b-btn-text" href="/admin/pages/<%= page.id %>/layout/<%= region %>/edit">Edit</a>
                <button type="button" class="b-btn-text" data-layout-disable="<%= region %>">Use global instead</button>
              <% } else { %>
                <span class="b-layout-override-state">Using global <%= region %></span>
                <button type="button" class="b-btn-text" data-layout-enable="<%= region %>">Customize for this page</button>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>

      <div class="b-canvas-scroll">
        <div class="b-canvas-frame" id="bCanvasFrame" data-vp="desktop">
          <%
            // The fake header/footer "chrome" bars are just visual framing —
            // a rough sense of where the real thing sits — so they're
            // skipped on whichever canvas IS the real thing being built
            // right now, and a plain "Page content" placeholder stands in
            // for the page body on a header/footer canvas.
          %>
          <div class="b-canvas" id="bCanvas">
            <% if (context !== 'header') { %>
              <div class="b-canvas-chrome b-canvas-chrome-header">
                <div><%= store.name %></div>
                <div class="b-ch-nav"><span>Shop all</span><span>About</span><span>Contact</span></div>
                <div class="b-ch-cart">Cart (0)</div>
              </div>
            <% } %>
            <% if (context === 'header') { %>
              <div id="bSortable"></div>
              <div class="b-canvas-chrome-placeholder">Page content</div>
            <% } else if (context === 'footer') { %>
              <div class="b-canvas-chrome-placeholder">Page content</div>
              <div id="bSortable"></div>
            <% } else { %>
              <div id="bSortable"></div>
            <% } %>
            <% if (context !== 'footer') { %>
              <div class="b-canvas-chrome b-canvas-chrome-footer" style="padding-top:22px;padding-bottom:22px;">© <%= new Date().getFullYear() %> <%= store.name %>. Powered by PageZaper.</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <aside class="b-inspector" id="bInspector" hidden>
      <div class="b-inspector-head">
        <div class="b-inspector-head-icon" id="bInspectorIcon"></div>
        <div>
          <h3 id="bInspectorTitle">Section</h3>
          <p id="bInspectorType">type</p>
        </div>
      </div>
      <div class="b-inspector-body" id="bInspectorBody"></div>
    </aside>
  </div>

  <div class="b-drag-ghost" id="bDragGhost" hidden></div>
  <div class="b-toast" id="bToast"><span class="b-toast-dot"></span><span id="bToastText"></span></div>

  <script>
    window.__BUILDER__ = {
      page: <%- JSON.stringify(page ? { id: page.id, name: page.name, path: page.path, is_home: !!page.is_home, status: page.status } : null).split('/').join(String.fromCharCode(92) + '/') %>,
      store: <%- JSON.stringify({ name: store.name }).split('/').join(String.fromCharCode(92) + '/') %>,
      context: <%- JSON.stringify(context) %>,
      sectionsBase: <%- JSON.stringify(sectionsBase) %>,
      sectionTypes: <%- JSON.stringify(sectionTypes).split('/').join(String.fromCharCode(92) + '/') %>,
      nestableTypes: <%- JSON.stringify(nestableTypes).split('/').join(String.fromCharCode(92) + '/') %>,
      textElementFields: <%- JSON.stringify(textElementFields).split('/').join(String.fromCharCode(92) + '/') %>,
      sections: <%- JSON.stringify(sections.map(function (s) {
        return {
          id: s.id, type: s.type, fields: s.fields, hidden: !!s.hidden,
          custom_class: s.custom_class || '', custom_css: s.custom_css || '', min_height: s.min_height || 0,
          hide_desktop: !!s.hide_desktop, hide_tablet: !!s.hide_tablet, hide_mobile: !!s.hide_mobile,
          margin_top: s.margin_top || 0, margin_bottom: s.margin_bottom || 0,
          margin_left: s.margin_left || 0, margin_right: s.margin_right || 0,
          padding_top: s.padding_top || 0, padding_bottom: s.padding_bottom || 0,
          padding_left: s.padding_left || 0, padding_right: s.padding_right || 0,
          element_styles: s.element_styles || {},
        };
      })).split('/').join(String.fromCharCode(92) + '/') %>,
      products: <%- JSON.stringify(products).split('/').join(String.fromCharCode(92) + '/') %>,
      categories: <%- JSON.stringify(categories).split('/').join(String.fromCharCode(92) + '/') %>,
      components: <%- JSON.stringify(components).split('/').join(String.fromCharCode(92) + '/') %>
    };
  </script>
  <script src="/js/admin-builder.js"></script>
</body>
</html>
