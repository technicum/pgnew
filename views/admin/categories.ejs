<%- include('partials/header') %>

<div class="panel" style="max-width:480px; margin-bottom:20px;">
  <h2>Create a category</h2>
  <form action="/admin/categories" method="POST" class="menu-create-form">
    <input type="text" name="name" placeholder="e.g. Apparel" maxlength="255" required />
    <button type="submit" class="btn btn-primary">Create category</button>
  </form>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Name</th><th>Products</th><th></th></tr>
  </thead>
  <tbody>
    <% categories.forEach(function (c) { %>
      <tr data-category-row="<%= c.id %>">
        <td>
          <span class="cat-name-display"><%= c.name %></span>
          <form class="cat-name-edit-form" action="/admin/categories/<%= c.id %>/edit" method="POST" hidden>
            <input type="text" class="cat-name-edit-input" name="name" value="<%= c.name %>" maxlength="255" required />
            <button type="submit" class="link-btn">Save</button>
            <button type="button" class="link-btn cat-edit-cancel">Cancel</button>
          </form>
        </td>
        <td><%= c.product_count %></td>
        <%
          // No category name in the confirm text -- keeps this safe against
          // an apostrophe in the name breaking the onsubmit attribute's own
          // quoting, without needing to escape anything.
          var confirmMsg = c.product_count > 0
            ? 'Delete this category? ' + c.product_count + ' product' + (c.product_count === 1 ? '' : 's') + ' using it will just lose this category -- nothing else changes.'
            : 'Delete this category?';
        %>
        <td class="admin-row-actions">
          <button type="button" class="link-btn cat-edit-btn">Edit</button>
          <form action="/admin/categories/<%= c.id %>/delete" method="POST" onsubmit="return confirm('<%= confirmMsg %>');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (categories.length === 0) { %>
      <tr><td colspan="3" class="empty-state">No categories yet — create one above, then assign it to products from each product's edit page.</td></tr>
    <% } %>
  </tbody>
</table>

<script>
(function () {
  // Inline rename -- click Edit on a row to swap its name for a text field
  // in place, Cancel (or a successful Save, which just reloads the page) to
  // swap it back. Only one field, so a whole separate edit page felt like
  // more clicks than this deserves.
  document.querySelectorAll('[data-category-row]').forEach(function (row) {
    var display = row.querySelector('.cat-name-display');
    var editForm = row.querySelector('.cat-name-edit-form');
    var editBtn = row.querySelector('.cat-edit-btn');
    var cancelBtn = row.querySelector('.cat-edit-cancel');
    var input = row.querySelector('.cat-name-edit-input');

    editBtn.addEventListener('click', function () {
      display.hidden = true;
      editBtn.hidden = true;
      editForm.hidden = false;
      input.focus();
      input.select();
    });
    cancelBtn.addEventListener('click', function () {
      input.value = display.textContent;
      editForm.hidden = true;
      display.hidden = false;
      editBtn.hidden = false;
    });
  });
})();
</script>

<%- include('partials/footer') %>
