<%- include('partials/header') %>

<div class="stat-cards">
  <div class="stat-card">
    <span class="stat-label">Total Revenue</span>
    <span class="stat-value">₹<%= revenue.toFixed(2) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Collected</span>
    <span class="stat-value">₹<%= collected.toFixed(2) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Pending COD</span>
    <span class="stat-value">₹<%= pendingCOD.toFixed(2) %></span>
  </div>
</div>

<p style="color:#6b7280; margin: 0 0 20px;">PageZaper checkout is Cash on Delivery only right now — "Collected" is orders marked paid or further along; "Pending COD" is orders still awaiting payment on delivery.</p>

<div class="dashboard-grid">
  <section class="panel">
    <h2>By status</h2>
    <table class="admin-table">
      <thead><tr><th>Status</th><th>Orders</th><th>Total</th></tr></thead>
      <tbody>
        <% byStatus.forEach(function(s) { %>
          <tr>
            <td><span class="status-pill status-<%= s.status %>"><%= s.status %></span></td>
            <td><%= s.c %></td>
            <td>₹<%= s.total.toFixed(2) %></td>
          </tr>
        <% }); %>
        <% if (byStatus.length === 0) { %>
          <tr><td colspan="3" class="empty-state">No orders yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <section class="panel">
    <h2>Recent transactions</h2>
    <table class="admin-table">
      <thead><tr><th>Order</th><th>Total</th><th>Status</th></tr></thead>
      <tbody>
        <% recentOrders.forEach(function(o) { %>
          <tr>
            <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td>
            <td>₹<%= o.total.toFixed(2) %></td>
            <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
          </tr>
        <% }); %>
        <% if (recentOrders.length === 0) { %>
          <tr><td colspan="3" class="empty-state">No orders yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>
</div>

<%- include('partials/footer') %>
