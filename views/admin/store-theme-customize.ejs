<%- include('partials/header') %>

<p style="margin: 0 0 16px; color: #6b7280; font-size: 0.9rem;">
  <a href="/admin/store/themes" style="color: inherit; text-decoration: underline;">&larr; Themes</a>
</p>

<form action="/admin/store/themes/<%= storeTheme.store_theme_id %>/customize" method="POST" class="admin-form">
  <div class="form-row">
    <label>Primary color
      <input type="color" name="color_primary" value="<%= tokens.color_primary %>" />
    </label>
    <label>Primary color (hover / dark)
      <input type="color" name="color_primary_dark" value="<%= tokens.color_primary_dark %>" />
    </label>
  </div>

  <div class="form-row">
    <label>Page background
      <input type="color" name="color_bg" value="<%= tokens.color_bg %>" />
    </label>
    <label>Card / surface background
      <input type="color" name="color_surface" value="<%= tokens.color_surface %>" />
    </label>
  </div>

  <div class="form-row">
    <label>Text color
      <input type="color" name="color_text" value="<%= tokens.color_text %>" />
    </label>
    <label>Muted text color
      <input type="color" name="color_muted" value="<%= tokens.color_muted %>" />
    </label>
  </div>

  <label>Border color
    <input type="color" name="color_border" value="<%= tokens.color_border %>" />
  </label>

  <label>Corner style
    <select name="radius_style">
      <% Object.keys(radiusOptions).forEach(function(key) { %>
        <option value="<%= key %>" <%= tokens.radius_style === key ? 'selected' : '' %>><%= key.charAt(0).toUpperCase() + key.slice(1) %></option>
      <% }); %>
    </select>
  </label>

  <button type="submit" class="btn btn-primary" style="margin-top: 8px;">Save appearance</button>
</form>

<form action="/admin/store/themes/<%= storeTheme.store_theme_id %>/customize" method="POST" style="margin-top: 12px;">
  <input type="hidden" name="reset" value="1" />
  <button type="submit" class="link-btn" onclick="return confirm('Reset to this theme\'s default appearance?');">Reset to theme defaults</button>
</form>

<%- include('partials/footer') %>
