<%- include('partials/header') %>

<div class="panel-toolbar">
  <a href="/admin/pages/new" class="btn btn-primary">+ New page</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Name</th><th>Path</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% pages.forEach(function(p) { %>
      <tr>
        <td>
          <a href="/admin/pages/<%= p.id %>/edit"><%= p.name %></a>
          <% if (p.is_home) { %><span class="status-pill status-paid">Home</span><% } %>
        </td>
        <td><%= p.path %></td>
        <td><span class="status-pill <%= p.status === 'published' ? 'status-delivered' : 'status-pending' %>"><%= p.status %></span></td>
        <td class="admin-row-actions">
          <a href="/admin/pages/<%= p.id %>/edit">Edit</a>
          <% if (!p.is_home) { %>
            <form action="/admin/pages/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this page?');">
              <button type="submit" class="link-btn danger">Delete</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    <% if (pages.length === 0) { %>
      <tr><td colspan="4" class="empty-state">No pages yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
