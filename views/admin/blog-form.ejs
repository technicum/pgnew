<%- include('partials/header') %>

<form
  action="<%= post ? `/admin/blog/${post.id}/edit` : '/admin/blog/new' %>"
  method="POST"
  class="admin-form"
>
  <label>Title *
    <input type="text" name="title" value="<%= post ? post.title : '' %>" required />
  </label>

  <label>Excerpt
    <textarea name="excerpt" rows="2" placeholder="A short summary shown on the blog index"><%= post ? post.excerpt : '' %></textarea>
  </label>

  <label>Body
    <textarea name="body" rows="12"><%= post ? post.body : '' %></textarea>
  </label>

  <label>Cover image
    <div class="media-field-row">
      <input type="text" id="blogCoverUrl" name="cover_image_url" value="<%= post ? post.cover_image_url : '' %>" placeholder="https://..." />
      <button type="button" id="blogCoverPickBtn" class="btn btn-secondary">Choose from library</button>
    </div>
    <img id="blogCoverPreview" class="media-field-preview" src="<%= post && post.cover_image_url ? post.cover_image_url : '' %>" alt="" <%= post && post.cover_image_url ? '' : 'hidden' %> />
  </label>

  <label>Status
    <select name="status">
      <option value="draft" <%= !post || post.status === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
    </select>
  </label>

  <button type="submit" class="btn btn-primary"><%= post ? 'Save changes' : 'Create blog post' %></button>
</form>

<script src="/js/media-picker.js"></script>
<script>
(function () {
  var input = document.getElementById('blogCoverUrl');
  var btn = document.getElementById('blogCoverPickBtn');
  var preview = document.getElementById('blogCoverPreview');

  function updatePreview() {
    if (input.value) {
      preview.src = input.value;
      preview.hidden = false;
    } else {
      preview.hidden = true;
    }
  }
  input.addEventListener('change', updatePreview);

  btn.addEventListener('click', function () {
    MediaPicker.open(function (file) {
      input.value = file.url;
      updatePreview();
    }, { accept: 'image/' });
  });
})();
</script>

<%- include('partials/footer') %>
