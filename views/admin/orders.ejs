<%- include('partials/header') %>

<table class="admin-table">
  <thead>
    <tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th></tr>
  </thead>
  <tbody>
    <% orders.forEach(function(o) { %>
      <tr>
        <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td>
        <td><%= o.customer_name %><br /><small><%= o.customer_email %></small></td>
        <td><%= o.created_at %></td>
        <td>₹<%= o.subtotal.toFixed(2) %></td>
        <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
      </tr>
    <% }); %>
    <% if (orders.length === 0) { %>
      <tr><td colspan="5" class="empty-state">No orders yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
