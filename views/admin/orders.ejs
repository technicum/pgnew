<%- include('partials/header') %>

<div class="panel-toolbar" style="justify-content:space-between;">
  <form action="/admin/orders" method="GET" class="order-source-filter">
    <select name="source" onchange="this.form.submit()">
      <option value="" <%= !sourceFilter ? 'selected' : '' %>>All sources</option>
      <option value="storefront" <%= sourceFilter === 'storefront' ? 'selected' : '' %>>Website</option>
      <option value="whatsapp" <%= sourceFilter === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
    </select>
  </form>
  <a href="/admin/orders/new-whatsapp" class="btn btn-primary">+ New order (WhatsApp)</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Source</th><th>Status</th></tr>
  </thead>
  <tbody>
    <% orders.forEach(function(o) { %>
      <tr>
        <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td>
        <td><%= o.customer_name %><br /><small><%= o.customer_email %></small></td>
        <td><%= o.created_at %></td>
        <td>₹<%= o.total.toFixed(2) %></td>
        <td><span class="status-pill status-source-<%= o.source %>"><%= o.source === 'whatsapp' ? 'WhatsApp' : 'Website' %></span></td>
        <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
      </tr>
    <% }); %>
    <% if (orders.length === 0) { %>
      <tr><td colspan="6" class="empty-state">No orders yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
