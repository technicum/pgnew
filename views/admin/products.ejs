<%- include('partials/header') %>

<div class="panel-toolbar">
  <a href="/admin/products/new" class="btn btn-primary">+ New product</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Image</th><th>Title</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% products.forEach(function(p) { %>
      <tr>
        <td><img class="admin-thumb" src="<%= p.image_url %>" alt="" /></td>
        <td><%= p.title %></td>
        <td><%= p.category_names || '—' %></td>
        <td>₹<%= p.price.toFixed(2) %></td>
        <td><%= p.stock %></td>
        <td><span class="status-pill status-<%= p.status %>"><%= p.status %></span></td>
        <td class="admin-row-actions">
          <a href="/admin/products/<%= p.id %>/edit">Edit</a>
          <form action="/admin/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this product?');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
    <% if (products.length === 0) { %>
      <tr><td colspan="7" class="empty-state">No products yet. Add your first one.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
