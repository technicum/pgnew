<%- include('partials/header') %>

<form action="/admin/orders/new-whatsapp" method="POST" class="admin-form">
  <% if (!products.length) { %>
    <p class="form-hint">No active products yet — <a href="/admin/products/new">add one</a> first, then come back here to log a WhatsApp order.</p>
  <% } else { %>
    <label>Product *
      <input type="text" id="whatsappProductSearch" placeholder="Search products..." autocomplete="off" />
      <select id="whatsappProductSelect" name="product_id" size="8" required>
        <% products.forEach(function(p) { %>
          <option value="<%= p.id %>" data-search="<%= p.title.toLowerCase() %>">
            <%= p.title %> — ₹<%= p.price.toFixed(2) %> (<%= p.stock %> in stock)
          </option>
        <% }); %>
      </select>
    </label>

    <label>Quantity *
      <input type="number" name="quantity" value="1" min="1" required />
    </label>

    <label>Customer name *
      <input type="text" name="customer_name" required />
    </label>

    <label>Customer phone *
      <input type="text" name="customer_phone" placeholder="e.g. 9876543210" required />
    </label>

    <label>Address (optional)
      <textarea name="address" rows="3"></textarea>
    </label>

    <label>Payment status
      <select name="paid">
        <option value="cod">Cash on delivery / unpaid</option>
        <option value="paid">Already paid</option>
      </select>
    </label>

    <button type="submit" class="btn btn-primary">Create order</button>
  <% } %>
</form>

<script>
(function () {
  var search = document.getElementById('whatsappProductSearch');
  var select = document.getElementById('whatsappProductSelect');
  if (!search || !select) return;
  var options = Array.prototype.slice.call(select.options);

  search.addEventListener('input', function () {
    var q = search.value.trim().toLowerCase();
    options.forEach(function (opt) {
      opt.hidden = q.length > 0 && opt.getAttribute('data-search').indexOf(q) === -1;
    });
  });
})();
</script>

<%- include('partials/footer') %>
