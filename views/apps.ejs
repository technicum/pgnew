<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/apps.css?v=<%= assetVersion %>" />
</head>
<%# Explore apps (server.js → /dashboard/apps, catalog in lib/apps.js): a small card per app with an on/off switch. The Store is built in and always on. %>
<body>
<div class="min-h-screen bg-background">

  <%- include('partials/dashboard-sidebar', { navActive: '/dashboard/apps' }) %>

  <main class="lg:ml-64">
    <header class="sticky top-0 z-20 flex h-20 items-center border-b border-border bg-background/95 px-4 backdrop-blur md:px-8" style="gap:12px;">
      <p class="text-sm font-semibold text-primary" style="line-height:1;">Explore apps</p>
      <div class="ml-auto flex items-center gap-2">
        <span class="grid size-8 place-items-center rounded-md bg-secondary font-display text-xs font-bold text-secondary-foreground"><%= user.initials %></span>
      </div>
    </header>

    <div class="mx-auto max-w-[1100px] px-4 py-7 md:px-8 md:py-9">
      <section>
        <p class="text-sm font-semibold text-primary">Apps</p>
        <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Explore apps</h1>
        <p class="mt-2 text-sm text-muted-foreground" style="max-width:64ch;">Switch on the apps you need and they appear in your sidebar. Switching one off only hides it — anything it published stays live.</p>
      </section>

      <% if (highlight && installed.indexOf(highlight) === -1) { %>
      <div class="ap-flash" role="status">Switch on <b><%= apps.find(function (a) { return a.id === highlight; }).name %></b> to open that page.</div>
      <% } %>

      <div class="ap-grid">
        <% apps.forEach(function (a) { var on = a.core || installed.indexOf(a.id) !== -1; %>
        <article class="ap-card<%= on ? ' ap-on' : '' %><%= highlight === a.id ? ' ap-highlight' : '' %>" id="<%= a.id %>" data-app="<%= a.id %>">
          <div class="ap-card-row">
            <span class="ap-icon" style="--app:<%= a.color %>"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- a.icon %></svg></span>
            <span class="ap-text">
              <h2><%= a.name %></h2>
              <p><%= a.tagline %></p>
            </span>
            <% if (a.core) { %>
            <span class="ap-switch is-on is-locked" role="switch" aria-checked="true" aria-disabled="true" title="Built in — always on"><span class="ap-sr"><%= a.name %> is always on</span></span>
            <% } else { %>
            <form method="POST" action="/dashboard/apps/<%= a.id %>" class="ap-toggle">
              <input type="hidden" name="action" value="<%= on ? 'remove' : 'add' %>" />
              <button type="submit" class="ap-switch<%= on ? ' is-on' : '' %>" role="switch" aria-checked="<%= on ? 'true' : 'false' %>" aria-label="<%= a.name %>"></button>
            </form>
            <% } %>
          </div>
          <div class="ap-card-foot">
            <span class="ap-state"><%= a.core ? 'Built in' : (on ? 'On' : 'Off') %></span>
            <a class="ap-open" href="<%= a.href %>"<%= on ? '' : ' hidden' %>>Open →</a>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
  </main>
</div>
<script>
  // The switches save without a page load, then swap in the new sidebar
  // (fetched from this same page) so the app appears / disappears there.
  (function () {
    document.querySelectorAll('.ap-toggle').forEach(function (form) {
      var btn = form.querySelector('.ap-switch');
      var action = form.querySelector('input[name="action"]');
      var card = form.closest('.ap-card');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (btn.disabled) return;
        var turningOn = action.value === 'add';
        btn.disabled = true;
        try {
          var res = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            body: 'action=' + action.value,
          });
          if (!res.ok) throw new Error('Could not save');
          action.value = turningOn ? 'remove' : 'add';
          btn.classList.toggle('is-on', turningOn);
          btn.setAttribute('aria-checked', turningOn ? 'true' : 'false');
          card.classList.toggle('ap-on', turningOn);
          card.classList.remove('ap-highlight');
          card.querySelector('.ap-state').textContent = turningOn ? 'On' : 'Off';
          card.querySelector('.ap-open').hidden = !turningOn;
          var flash = document.querySelector('.ap-flash');
          if (flash) flash.remove();
          var page = await (await fetch('/dashboard/apps', { headers: { Accept: 'text/html' } })).text();
          var fresh = new DOMParser().parseFromString(page, 'text/html').querySelector('nav[aria-label="Dashboard navigation"]');
          var nav = document.querySelector('nav[aria-label="Dashboard navigation"]');
          if (fresh && nav) nav.replaceWith(fresh);
        } catch (err) {
          card.classList.add('ap-error');
          setTimeout(function () { card.classList.remove('ap-error'); }, 1500);
        } finally {
          btn.disabled = false;
        }
      });
    });
  })();
</script>
</body>
</html>
