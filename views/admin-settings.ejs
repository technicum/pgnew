<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/app-dashboard.css?v=<%= assetVersion %>" />
</head>
<%# Platform admin (server.js /admin/settings, lib/platform.js) — only for ADMIN_EMAILS. %>
<body>
<div class="min-h-screen bg-background">
  <%- include('partials/dashboard-sidebar', { navActive: '/admin/settings' }) %>
  <main class="lg:ml-64">
    <div class="mx-auto max-w-[900px] px-4 py-7 md:px-8 md:py-9">
      <p class="text-sm font-semibold text-primary">Admin</p>
      <h1 class="mt-1 text-3xl font-extrabold md:text-4xl">Platform settings</h1>
      <p class="mt-2 text-sm text-muted-foreground">Only admins see this page. Changes apply to new orders; past orders keep the commission they were placed with.</p>

      <% if (error) { %><div class="ax-flash ax-flash-error" role="alert" style="margin-top:18px;"><%= error %></div><% } %>
      <% if (saved) { %><div class="ax-flash ax-flash-ok" role="status" style="margin-top:18px;">Saved.</div><% } %>

      <form method="POST" action="/admin/settings">
        <section class="ax-panel" style="margin-top:22px;">
          <div class="ax-panel-head"><h2>Commission</h2><span class="ax-count">Taken on each paid order</span></div>
          <div class="ax-grid">
            <label class="ax-field"><span>Marketplace sales (%)</span><input class="ax-input" name="marketplace_pct" value="<%= fees.marketplace_pct %>" inputmode="decimal" required />
              <small>Buyer came from Explore or the homepage search.</small></label>
            <label class="ax-field"><span>Direct sales (%)</span><input class="ax-input" name="direct_pct" value="<%= fees.direct_pct %>" inputmode="decimal" required />
              <small>Buyer came from the creator’s own link.</small></label>
            <span></span>
          </div>
          <p class="ax-hint ax-pad">
            Example: a ₹250 product earns <b>₹<%= (250 * fees.direct_pct / 100).toFixed(2).replace(/\.00$/, '') %></b> direct, or <b>₹<%= (250 * fees.marketplace_pct / 100).toFixed(2).replace(/\.00$/, '') %></b> through the marketplace.
            Sessions paid at the appointment take this commission as their online advance.
            A marketplace visit counts for <%= attributionDays %> days on that creator’s store.
          </p>
        </section>

        <section class="ax-panel">
          <div class="ax-panel-head"><h2>Earnings so far</h2><span class="ax-count">Paid orders</span></div>
          <div class="ax-grid">
            <div class="ax-field"><span>Marketplace</span><b style="font-size:20px;"><%= totals.marketplace.fee %></b><small>on <%= totals.marketplace.sales %> of sales · <%= totals.marketplace.count %> orders</small></div>
            <div class="ax-field"><span>Direct</span><b style="font-size:20px;"><%= totals.direct.fee %></b><small>on <%= totals.direct.sales %> of sales · <%= totals.direct.count %> orders</small></div>
            <span></span>
          </div>
        </section>

        <section class="ax-panel ax-savebar">
          <span class="ax-sub">Admins: ADMIN_EMAILS in .env</span>
          <button class="ax-btn ax-btn-primary">Save</button>
        </section>
      </form>
    </div>
  </main>
</div>
</body>
</html>
