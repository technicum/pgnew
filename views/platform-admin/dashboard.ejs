<%- include('partials/header') %>

<div class="stat-cards">
  <div class="stat-card">
    <span class="stat-label">Total Stores</span>
    <span class="stat-value"><%= totalStores %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Active Stores</span>
    <span class="stat-value"><%= activeStores %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Total Orders</span>
    <span class="stat-value"><%= totalOrders %></span>
  </div>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Store</th><th>Subdomain</th><th>Plan</th><th>Products</th><th>Orders</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
    <% stores.forEach(function(s) { %>
      <tr>
        <td><a href="/platform-admin/stores/<%= s.id %>"><%= s.name %></a></td>
        <td><%= s.subdomain %></td>
        <td><%= s.plan %></td>
        <td><%= s.productCount %></td>
        <td><%= s.orderCount %></td>
        <td><span class="status-pill <%= s.status === 'active' ? 'status-delivered' : 'status-cancelled' %>"><%= s.status %></span></td>
        <td class="admin-row-actions">
          <a href="/platform-admin/stores/<%= s.id %>">Manage</a>
        </td>
      </tr>
    <% }); %>
    <% if (stores.length === 0) { %>
      <tr><td colspan="7" class="empty-state">No stores yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
