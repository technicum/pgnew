<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · PageZaper Platform</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body theme-default">
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-logo">PageZaper <small>Platform</small></div>
      <nav class="admin-nav">
        <a href="/platform-admin" class="<%= title === 'All Stores' ? 'active' : '' %>">All stores</a>
        <a href="/platform-admin/users" class="<%= (title === 'Users' || (typeof activeNav !== 'undefined' && activeNav === 'users')) ? 'active' : '' %>">Users</a>
        <a href="/platform-admin/leads" class="<%= title === 'Leads' ? 'active' : '' %>">Leads</a>
        <a href="/platform-admin/plans"class="<%= title === 'Plans' ? 'active' : '' %>">Plans</a>
      </nav>
      <form action="/platform-admin/logout" method="POST" class="admin-logout-form">
        <button type="submit" class="link-btn">Log out</button>
      </form>
    </aside>
    <div class="admin-main">
      <header class="admin-topbar">
        <h1><%= title %></h1>
        <% if (platformAdmin) { %><span class="admin-user">Hi, <%= platformAdmin.name %></span><% } %>
      </header>

      <% if (success && success.length) { %>
        <div class="flash flash-success"><%= success[0] %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="flash flash-error"><%= error[0] %></div>
      <% } %>

      <div class="admin-content">
