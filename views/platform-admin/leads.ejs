<%- include('partials/header') %>

<div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
  <a href="<%= tabUrls.all %>" class="btn <%= !filters.kind ? 'btn-primary' : 'btn-secondary' %>">All (<%= counts.lead + counts.customer %>)</a>
  <a href="<%= tabUrls.lead %>" class="btn <%= filters.kind === 'lead' ? 'btn-primary' : 'btn-secondary' %>">Leads (<%= counts.lead %>)</a>
  <a href="<%= tabUrls.customer %>" class="btn <%= filters.kind === 'customer' ? 'btn-primary' : 'btn-secondary' %>">Customers (<%= counts.customer %>)</a>
</div>

<form action="/platform-admin/leads" method="GET" class="panel-toolbar" style="justify-content:flex-start; gap:8px; flex-wrap:wrap; align-items:center;">
  <% if (filters.kind) { %><input type="hidden" name="kind" value="<%= filters.kind %>" /><% } %>
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search name, email or phone" style="min-width:240px;" />
  <select name="site">
    <option value="">All sites</option>
    <option value="none" <%= filters.site === 'none' ? 'selected' : '' %>>General inquiries (no site)</option>
    <% stores.forEach(function(s) { %>
      <option value="<%= s.id %>" <%= Number(filters.site) === s.id ? 'selected' : '' %>><%= s.name %></option>
    <% }); %>
  </select>
  <select name="source">
    <option value="">Any source</option>
    <% sources.forEach(function(src) { %>
      <option value="<%= src %>" <%= filters.source === src ? 'selected' : '' %>><%= src.replace('_', ' ') %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-secondary">Filter</button>
  <% if (filters.q || filters.site || filters.source) { %><a href="<%= clearUrl %>" class="btn btn-secondary">Clear</a><% } %>
</form>

<table class="admin-table">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th>Site</th><th>Tags</th><th>Source</th><th>Added</th></tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr>
        <td><strong><%= r.name %></strong></td>
        <td><%= r.email %></td>
        <td><%= r.phone || '—' %></td>
        <td><span class="status-pill <%= r.kind === 'customer' ? 'status-delivered' : '' %>"><%= r.kind %></span></td>
        <td>
          <% if (r.store_id) { %>
            <a href="/platform-admin/stores/<%= r.store_id %>"><%= r.store_name %></a>
          <% } else { %>
            General inquiry<%= r.owner_name ? ' · ' + r.owner_name : '' %>
          <% } %>
        </td>
        <td class="crm-tags">
          <% r.tags.slice(0, 3).forEach(function(t) { %><span class="crm-tag crm-tag-slate"><%= t %></span><% }); %>
          <% if (r.tags.length > 3) { %><span class="crm-tag crm-tag-more">+<%= r.tags.length - 3 %></span><% } %>
          <% if (r.tags.length === 0) { %>—<% } %>
        </td>
        <td><span class="status-pill status-paid"><%= String(r.source).replace('_', ' ') %></span></td>
        <td><%= new Date(r.created_at).toLocaleDateString() %></td>
      </tr>
    <% }); %>
    <% if (rows.length === 0) { %>
      <tr><td colspan="8" class="empty-state">No leads or customers match these filters.</td></tr>
    <% } %>
  </tbody>
</table>

<% if (totalPages > 1) { %>
  <div style="display:flex; align-items:center; justify-content:space-between; margin-top:16px;">
    <span class="muted">Page <%= page %> of <%= totalPages %> · <%= total %> total</span>
    <div style="display:flex; gap:8px;">
      <% if (prevUrl) { %><a href="<%= prevUrl %>" class="btn btn-secondary">&larr; Previous</a><% } %>
      <% if (nextUrl) { %><a href="<%= nextUrl %>" class="btn btn-secondary">Next &rarr;</a><% } %>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
