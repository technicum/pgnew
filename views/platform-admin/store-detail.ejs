<%- include('partials/header') %>

<div class="stat-cards">
  <div class="stat-card">
    <span class="stat-label">Revenue</span>
    <span class="stat-value">₹<%= revenue.toFixed(2) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Orders</span>
    <span class="stat-value"><%= orderCount %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Products</span>
    <span class="stat-value"><%= productCount %></span>
  </div>
</div>

<div class="dashboard-grid">
  <section class="panel">
    <h2>Store details</h2>
    <table class="admin-table">
      <tbody>
        <tr><td>Subdomain</td><td><%= store.subdomain %></td></tr>
        <tr><td>Plan</td><td><%= store.plan %></td></tr>
        <tr>
          <td>Change plan</td>
          <td>
            <form action="/platform-admin/stores/<%= store.id %>/plan" method="POST" style="display:flex; gap:8px;">
              <select name="plan">
                <% plans.forEach(function(p) { %>
                  <option value="<%= p %>" <%= store.plan === p ? 'selected' : '' %>><%= p %></option>
                <% }); %>
              </select>
              <button type="submit" class="link-btn">Save</button>
            </form>
          </td>
        </tr>
        <tr><td>Theme</td><td><%= store.theme %></td></tr>
        <tr><td>Status</td><td><span class="status-pill <%= store.status === 'active' ? 'status-delivered' : 'status-cancelled' %>"><%= store.status %></span></td></tr>
        <tr><td>Created</td><td><%= new Date(store.created_at).toLocaleDateString() %></td></tr>
      </tbody>
    </table>

    <% if (store.status === 'active') { %>
      <form action="/platform-admin/stores/<%= store.id %>/status" method="POST" style="margin-top:16px;" onsubmit="return confirm('Suspend this store? Its storefront and admin will stop working.');">
        <input type="hidden" name="status" value="suspended" />
        <button type="submit" class="btn" style="border:1px solid var(--color-danger); color: var(--color-danger);">Suspend store</button>
      </form>
    <% } else { %>
      <form action="/platform-admin/stores/<%= store.id %>/status" method="POST" style="margin-top:16px;">
        <input type="hidden" name="status" value="active" />
        <button type="submit" class="btn btn-primary">Reactivate store</button>
      </form>
    <% } %>
  </section>

  <section class="panel">
    <h2>Store team</h2>
    <% if (admins.length === 0) { %>
      <p class="empty-state">No admin or manager accounts yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Since</th><th></th></tr></thead>
        <tbody>
          <% admins.forEach(function(a) { %>
            <tr>
              <td><%= a.name %></td>
              <td><%= a.email %></td>
              <td><span class="status-pill"><%= a.role %></span></td>
              <td><%= new Date(a.created_at).toLocaleDateString() %></td>
              <td class="admin-row-actions">
                <form action="/platform-admin/users/<%= a.id %>/login-as" method="POST">
                  <button type="submit" class="link-btn">Log in as</button>
                </form>
                <form action="/platform-admin/users/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete this user? They will no longer be able to log in as this store\'s admin/manager.');">
                  <button type="submit" class="link-btn danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
