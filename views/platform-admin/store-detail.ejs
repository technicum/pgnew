<%- include('partials/header') %>

<div class="stat-cards">
  <div class="stat-card">
    <span class="stat-label">Revenue</span>
    <span class="stat-value">₹<%= revenue.toFixed(2) %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Orders</span>
    <span class="stat-value"><%= orderCount %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Products</span>
    <span class="stat-value"><%= productCount %></span>
  </div>
</div>

<div class="dashboard-grid">
  <section class="panel">
    <h2>Store details</h2>
    <table class="admin-table">
      <tbody>
        <tr><td>Subdomain</td><td><%= store.subdomain %></td></tr>
        <tr><td>Plan</td><td><%= store.plan %></td></tr>
        <tr>
          <td>Change plan</td>
          <td>
            <form action="/platform-admin/stores/<%= store.id %>/plan" method="POST" style="display:flex; gap:8px;">
              <select name="plan">
                <% plans.forEach(function(p) { %>
                  <option value="<%= p %>" <%= store.plan === p ? 'selected' : '' %>><%= p %></option>
                <% }); %>
              </select>
              <button type="submit" class="link-btn">Save</button>
            </form>
          </td>
        </tr>
        <tr><td>Theme</td><td><%= store.theme %></td></tr>
        <tr><td>Status</td><td><span class="status-pill <%= store.status === 'active' ? 'status-delivered' : 'status-cancelled' %>"><%= store.status %></span></td></tr>
        <tr><td>Created</td><td><%= new Date(store.created_at).toLocaleDateString() %></td></tr>
      </tbody>
    </table>

    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;">
      <a href="<%= storefrontUrl %>" target="_blank" rel="noopener" class="btn btn-secondary">Open storefront</a>
      <form action="/platform-admin/stores/<%= store.id %>/login-as-owner" method="POST">
        <button type="submit" class="btn btn-secondary" <%= store.status === 'active' && admins.length ? '' : 'disabled' %>>Log in as owner</button>
      </form>
    </div>

    <% if (store.status === 'active') { %>
      <form action="/platform-admin/stores/<%= store.id %>/status" method="POST" style="margin-top:16px;" onsubmit="return confirm('Suspend this store? Its storefront and admin will stop working.');">
        <input type="hidden" name="status" value="suspended" />
        <button type="submit" class="btn" style="border:1px solid var(--color-danger); color: var(--color-danger);">Suspend store</button>
      </form>
    <% } else { %>
      <form action="/platform-admin/stores/<%= store.id %>/status" method="POST" style="margin-top:16px;">
        <input type="hidden" name="status" value="active" />
        <button type="submit" class="btn btn-primary">Reactivate store</button>
      </form>
    <% } %>
  </section>

  <section class="panel">
    <h2>Store team</h2>
    <% if (admins.length === 0) { %>
      <p class="empty-state">No admin or manager accounts yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Since</th><th></th></tr></thead>
        <tbody>
          <% admins.forEach(function(a) { %>
            <tr>
              <td><%= a.name %></td>
              <td><%= a.email %></td>
              <td><span class="status-pill"><%= a.role %></span></td>
              <td><%= new Date(a.created_at).toLocaleDateString() %></td>
              <td class="admin-row-actions">
                <form action="/platform-admin/users/<%= a.id %>/login-as" method="POST">
                  <button type="submit" class="link-btn">Log in as</button>
                </form>
                <form action="/platform-admin/users/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete this user? They will no longer be able to log in as this store\'s admin/manager.');">
                  <button type="submit" class="link-btn danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<div class="dashboard-grid" style="margin-top:20px;">
  <section class="panel">
    <h2>Edit store</h2>
    <form action="/platform-admin/stores/<%= store.id %>/edit" method="POST" style="display:grid; gap:12px;"
          onsubmit="var s = this.subdomain; if (s.value.trim().toLowerCase() !== s.defaultValue) { return confirm('Change the subdomain? The old address (<%= store.subdomain %>) will stop working immediately, and any links to it will break.'); }">
      <label>Store name
        <input type="text" name="name" value="<%= store.name %>" maxlength="255" required />
      </label>
      <label>Subdomain
        <input type="text" name="subdomain" value="<%= store.subdomain %>" maxlength="63" required />
      </label>
      <label>Theme
        <select name="theme">
          <% themes.forEach(function(t) { %>
            <option value="<%= t %>" <%= store.theme === t ? 'selected' : '' %>><%= t %></option>
          <% }); %>
        </select>
      </label>
      <div><button type="submit" class="btn btn-primary">Save changes</button></div>
    </form>
  </section>

  <section class="panel">
    <h2 style="color: var(--color-danger);">Delete store</h2>
    <% if (!canDelete) { %>
      <p class="muted">This is a reserved platform store (it backs the theme demos) and can't be deleted here.</p>
    <% } else { %>
      <p>Permanently deletes this store and everything in it — products, orders, pages, contacts and uploaded files. Its owners' accounts are kept. This can't be undone.</p>
      <form action="/platform-admin/stores/<%= store.id %>/delete" method="POST" style="display:grid; gap:12px;">
        <label>Type <strong><%= store.subdomain %></strong> to confirm
          <input type="text" name="confirm" autocomplete="off" required />
        </label>
        <div><button type="submit" class="btn" style="border:1px solid var(--color-danger); color: var(--color-danger);">Delete this store</button></div>
      </form>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
