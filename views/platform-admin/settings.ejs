<%- include('partials/header') %>

<p class="muted" style="margin-top:0;">
  Values saved here take priority over the server's <code>.env</code>. Leave a field blank to fall back to the <code>.env</code> value (or the default).
</p>

<% groups.forEach(function(g) { %>
  <section class="panel" id="<%= g.id %>" style="margin-bottom:20px;">
    <h2><%= g.title %></h2>
    <p class="muted"><%= g.description %></p>

    <form action="/platform-admin/settings/<%= g.id %>" method="POST" style="display:grid; gap:14px; max-width:560px;">
      <% g.fields.forEach(function(f) {
           var name = f.key.replace('.', '_');
           var fromAdmin = f.source === 'admin';
      %>
        <label>
          <%= f.label %>
          <% if (f.type === 'select') { %>
            <select name="<%= name %>">
              <% f.options.forEach(function(o) { %>
                <option value="<%= o.value %>" <%= f.value === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }); %>
            </select>
          <% } else if (f.secret) { %>
            <input type="password" name="<%= name %>" autocomplete="new-password"
                   placeholder="<%= f.isSet ? '•••••••• saved — type to replace' : '' %>" />
            <% if (fromAdmin) { %>
              <span style="display:block; font-weight:400; margin-top:4px;">
                <input type="checkbox" name="clear_<%= name %>" value="1" /> Remove the saved value
              </span>
            <% } %>
          <% } else { %>
            <input type="<%= f.type %>" name="<%= name %>"
                   value="<%= fromAdmin ? f.value : '' %>"
                   placeholder="<%= (f.source === 'env' || f.source === 'default') ? f.value : (f.placeholder || '') %>"
                   <% if (f.max) { %>maxlength="<%= f.max %>"<% } %>
                   <% if (f.autocomplete) { %>autocomplete="<%= f.autocomplete %>"<% } %> />
          <% } %>
          <% if (f.source === 'env') { %>
            <span class="muted" style="display:block; font-weight:400;">Using the value from the server's .env — save a value here to override it.</span>
          <% } %>
          <% if (f.hint) { %><span class="muted" style="display:block; font-weight:400;"><%= f.hint %></span><% } %>
        </label>
      <% }); %>
      <div><button type="submit" class="btn btn-primary">Save <%= g.title %></button></div>
    </form>

    <% if (g.id === 'smtp') { %>
      <hr style="margin:20px 0;" />
      <h3 style="margin:0 0 8px; font-size:0.95rem;">Send a test email</h3>
      <p class="muted" style="margin-top:0;">Uses the saved settings above — save first, then test.</p>
      <form action="/platform-admin/settings/smtp-test" method="POST" style="display:flex; gap:8px; flex-wrap:wrap; max-width:560px;">
        <input type="email" name="to" value="<%= testEmailDefault %>" required style="flex:1; min-width:220px;" />
        <button type="submit" class="btn btn-secondary">Send test</button>
      </form>
    <% } %>
  </section>
<% }); %>

<%- include('partials/footer') %>
