<%# Bookings app → Settings tab (lib/appDashboard.js → /dashboard/bookings/settings[/:section]). Split into sub-tabs so each screen stays short: Availability (weekly hours + days off), Booking page (how /book looks), Payments. Each form saves one lib/bookings.js saveSettings group. %>
<%- include('partials/app-dash-top', { navActive: '/dashboard/bookings', section: 'Bookings', heading: 'Bookings' }) %>
<%- include('partials/booking-tabs', { tab: 'settings' }) %>
<% var s = bookingSettings;
var sections = [
  ['availability', 'Availability', 'When people can book you'],
  ['page', 'Booking page', 'How your page looks'],
  ['payments', 'Payments', 'How bookers pay you'],
]; %>

<div class="ax-settings">
  <nav class="ax-subtabs" aria-label="Booking settings">
    <% sections.forEach(function (t) { %>
    <a href="/dashboard/bookings/settings/<%= t[0] %>"<%- section === t[0] ? ' aria-current="page"' : '' %>><b><%= t[1] %></b><small><%= t[2] %></small></a>
    <% }) %>
  </nav>

  <div class="ax-settings-body">
  <% if (section === 'availability') { %>

    <form method="POST" action="/dashboard/bookings/availability">
      <section class="ax-panel ax-panel-flush">
        <div class="ax-panel-head"><h2>Weekly hours</h2><span class="ax-count"><%= fmt.tz(s.timezone) %></span></div>
        <div class="ax-tz ax-pad ax-pad-top">
          <label class="ax-field">
            <span>Timezone</span>
            <select class="ax-input" name="timezone" data-pick data-pick-search>
              <% var tzSaved = timezoneAliases[s.timezone] || s.timezone;
              timezones.forEach(function (tz) { %><option value="<%= tz.value %>"<%= tz.value === tzSaved ? ' selected' : '' %>><%= tz.label %></option><% }) %>
            </select>
          </label>
          <button type="button" class="ax-btn ax-btn-quiet" data-tz-detect data-aliases="<%= JSON.stringify(timezoneAliases) %>" hidden></button>
        </div>
        <p class="ax-hint ax-pad">Your hours, notice and days off are all on this clock. Visitors elsewhere also see each time in their own timezone. Bookings already made keep the timezone they were made in. Every service uses these hours unless you give it its own; once any service is booked at a time, it’s taken for all of them.</p>
        <%- include('partials/ax-hours', { hours: s.hours, weekdays: weekdays, maxRanges: maxRanges }) %>
        <div class="ax-savebar ax-savebar-in">
          <span class="ax-sub">Currently: <%= fmt.hours(s.hours) %></span>
          <button class="ax-btn ax-btn-primary">Save hours</button>
        </div>
      </section>
    </form>

    <section class="ax-panel" id="days-off">
      <div class="ax-panel-head"><h2>Days off</h2><span class="ax-count">No bookings on these days</span></div>
      <% if (daysOff.length) { %>
      <ul class="ax-chips">
        <% daysOff.forEach(function (d) { %>
        <li><span><b><%= fmt.date(d.date) %></b><%= d.note ? ' · ' + d.note : '' %></span>
          <form method="POST" action="/dashboard/bookings/days-off/<%= d.id %>/delete"><button aria-label="Remove <%= fmt.date(d.date) %>">×</button></form></li>
        <% }) %>
      </ul>
      <% } %>
      <form method="POST" action="/dashboard/bookings/days-off" class="ax-new">
        <div class="ax-grid">
          <label class="ax-field"><span>From</span><input class="ax-input" type="date" name="from" min="<%= today %>" required /></label>
          <label class="ax-field"><span>Until <small>(optional)</small></span><input class="ax-input" type="date" name="to" min="<%= today %>" /></label>
          <label class="ax-field"><span>Note <small>(only you see it)</small></span><input class="ax-input" name="note" maxlength="100" placeholder="Diwali, travelling…" /></label>
        </div>
        <p class="ax-hint">Bookings already made on those days stay — cancel them under Upcoming bookings if you need to.</p>
        <button class="ax-btn ax-btn-primary">Add days off</button>
      </form>
    </section>

  <% } else if (section === 'page') { %>

    <form method="POST" action="/dashboard/bookings/page">
      <section class="ax-panel ax-panel-flush">
        <div class="ax-panel-head"><h2>Booking page</h2><span class="ax-count">All your services on one link</span></div>
        <div class="ax-pad ax-pad-top">
          <label class="ax-check"><input type="checkbox" name="listing_visible" value="1"<%= s.listing_visible ? ' checked' : '' %> /> <span>Show my booking page</span></label>
          <p class="ax-hint" style="margin-top:6px;">When it’s off, each service’s own link still works, and “Booking” blocks on your store don’t link anywhere.</p>
        </div>
        <div class="ax-grid">
          <label class="ax-field ax-span-3"><span>Headline</span><input class="ax-input" name="headline" value="<%= s.headline %>" maxlength="120" placeholder="Book time with <%= user.name %>" /></label>
          <%- include('partials/ax-rich-field', { name: 'intro', label: 'Intro', value: s.intro, rows: 4, maxlength: 1000, placeholder: 'Who you help and what a session gets them. Blank shows your store bio.' }) %>
          <%- include('partials/ax-image-field', { name: 'photo_url', label: 'Your photo', value: s.photo_url, hint: 'Also used on any service without its own photo.', round: true }) %>
          <%- include('partials/ax-image-field', { name: 'cover_url', label: 'Cover image', value: s.cover_url, hint: 'About 1500 × 700. Also the default for services.' }) %>
        </div>
        <div class="ax-savebar ax-savebar-in">
          <span class="ax-sub">Changes show on your booking page straight away.</span>
          <button class="ax-btn ax-btn-primary">Save page</button>
        </div>
      </section>
    </form>

  <% } else { %>

    <form method="POST" action="/dashboard/bookings/settings">
      <section class="ax-panel ax-panel-flush">
        <div class="ax-panel-head"><h2>Payments</h2><span class="ax-count">For paid services</span></div>
        <div class="ax-mode ax-mode-<%= paymentMode %>">
          <% if (paymentMode === 'test') { %><b>Test mode</b> — no payment gateway is connected yet, so bookers see a “Complete test payment” step and nothing is charged. Unpaid holds free up after 30 minutes.
          <% } else if (paymentMode === 'cashfree' || paymentMode === 'razorpay') { %><b><%= paymentMode === 'razorpay' ? 'Razorpay' : 'Cashfree' %></b> — bookers pay online (UPI, cards, net banking) and their booking confirms itself. Unpaid holds free up after 30 minutes.
          <% } else { %><b>Manual payments</b> — a paid booking holds its slot as “awaiting payment” until you mark it paid under Upcoming bookings (or in Orders).<% } %>
        </div>
        <div class="ax-grid">
          <label class="ax-field ax-span-3"><span>How to pay you</span><textarea class="ax-input" name="payment_note" rows="4" maxlength="500" placeholder="UPI: yourname@okbank — or bank transfer to A/C 1234567890, IFSC ABCD0001234"><%= s.payment_note %></textarea>
            <small>Shown to bookers while their paid booking waits for payment<%= paymentMode === 'test' ? ' (once you’re out of test mode)' : (paymentMode === 'cashfree' || paymentMode === 'razorpay' ? ' (only if online payments are switched off)' : '') %>.</small></label>
        </div>
        <div class="ax-savebar ax-savebar-in">
          <span class="ax-sub">Shown on paid bookings straight away.</span>
          <button class="ax-btn ax-btn-primary">Save payments</button>
        </div>
      </section>
    </form>

  <% } %>
  </div>
</div>

<%- include('partials/app-dash-bottom') %>
