<%- include('partials/header') %>

<section class="product-detail listing-detail">
  <div class="product-detail-img" style="background-image: url('<%= entry.image_url %>')"></div>
  <div class="product-detail-info">
    <h1><%= entry.title %></h1>
    <% if (entry.description) { %><p class="product-description"><%= entry.description %></p><% } %>

    <dl class="listing-fields">
      <% fields.forEach(function(f) { %>
        <% var v = values[f.field_key]; %>
        <% if (v !== undefined && v !== null && v !== '') { %>
          <dt><%= f.label %></dt>
          <dd>
            <% if (f.type === 'boolean') { %><%= v ? 'Yes' : 'No' %>
            <% } else if (f.type === 'url') { %><a href="<%= v %>" target="_blank" rel="noopener"><%= v %></a>
            <% } else if (f.type === 'image') { %><img src="<%= v %>" alt="" class="listing-field-img" />
            <% } else { %><%= v %>
            <% } %>
          </dd>
        <% } %>
      <% }); %>
    </dl>
  </div>
</section>

<%- include('partials/footer') %>
