<%- include('partials/header') %>

<h1>Checkout</h1>

<div class="checkout-layout">
  <%# The checkout hook — see views/storefront/partials/checkout-form.ejs.
      This is the one piece of checkout every theme shares unchanged;
      everything else on this page (heading, layout, order summary) is
      ordinary theme content. %>
  <%- include('../../partials/checkout-form') %>

  <aside class="order-summary">
    <h2>Order summary</h2>
    <% items.forEach(function(item) { %>
      <div class="order-summary-row">
        <span><%= item.title %> × <%= item.quantity %></span>
        <span>₹<%= item.lineTotal.toFixed(2) %></span>
      </div>
    <% }); %>
    <div class="order-summary-row total">
      <span>Total</span>
      <span>₹<%= subtotal.toFixed(2) %></span>
    </div>
  </aside>
</div>

<%- include('partials/footer') %>
