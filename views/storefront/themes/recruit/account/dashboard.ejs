<%- include('../partials/header') %>

<div class="account-dashboard">
  <div class="account-dashboard-head">
    <h1>My account</h1>
    <form action="/account/logout" method="POST">
      <button type="submit" class="link-btn">Log out</button>
    </form>
  </div>
  <p class="auth-hint" style="text-align:left;">Signed in as <strong><%= customer.name %></strong> (<%= customer.email %>)</p>

  <h2>Order history</h2>
  <% if (orders.length === 0) { %>
    <p class="empty-state">You haven't placed any orders yet.</p>
  <% } else { %>
    <div class="order-summary" style="max-width:640px;">
      <% orders.forEach(function(o) { %>
        <div class="order-summary-row">
          <span>
            <strong><%= o.order_number %></strong><br />
            <span style="color:var(--color-muted); font-size:0.85rem;"><%= new Date(o.created_at).toLocaleDateString() %> · <%= o.status %></span>
          </span>
          <span>₹<%= o.total.toFixed(2) %></span>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
