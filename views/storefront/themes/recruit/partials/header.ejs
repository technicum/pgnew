<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %><%= typeof store !== 'undefined' && store ? ' · ' + store.name : ' · PageZaper' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <%# Serif display font for headings only -- this theme's one deliberate
      typographic difference from the sans-serif default/pz-starter themes,
      matching the corporate/established feel of a recruitment agency's
      headline type. Body copy stays the shared sans-serif stack (style.css's
      plain `body` rule) for readability; only .rec-theme's own heading rule
      below (public/css/style.css) actually applies this. %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&display=swap" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<%# rec-theme scopes this theme's own CSS (public/css/style.css) -- kept
    separate from the theme-<slug> class below, which is the OLDER per-store
    color-preset system (gold/red/default) and unrelated to this structural
    theme. %>
<body class="rec-theme theme-<%= typeof store !== 'undefined' && store && store.theme ? store.theme : 'default' %>" style="<%= typeof themeTokenStyle !== 'undefined' ? themeTokenStyle : '' %>">
  <%- include('../../../partials/preview-banner') %>
  <header class="site-header">
    <% if (typeof headerSections !== 'undefined' && headerSections.length) { %>
      <% headerSections.forEach(function (section) { %>
        <%- include('../../../partials/section', { section: section, categories: typeof categories !== 'undefined' ? categories : [] }) %>
      <% }); %>
    <% } else { %>
      <%# No header sections saved yet for this store (shouldn't normally
          happen — every store is seeded one on creation, see
          db/database.js's migrateDefaultHeaderFooter) — a plain fallback
          bar so the storefront never ships with a missing header. %>
      <div class="container header-inner">
        <a href="/" class="logo"><%= typeof store !== 'undefined' && store ? store.name : 'PageZaper' %></a>
        <div class="header-actions">
          <% if (typeof customer !== 'undefined' && customer) { %>
            <a href="/account">My account</a>
          <% } else { %>
            <a href="/account/login">Log in</a>
          <% } %>
          <a href="/cart" class="cart-link">
            Cart
            <% if (cartItemCount > 0) { %><span class="badge"><%= cartItemCount %></span><% } %>
          </a>
        </div>
      </div>
    <% } %>
  </header>

  <% if (success && success.length) { %>
    <div class="flash flash-success container"><%= success[0] %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="flash flash-error container"><%= error[0] %></div>
  <% } %>

  <main class="container">
