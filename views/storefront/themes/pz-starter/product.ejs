<%- include('partials/header') %>

<section class="product-detail">
  <div class="product-detail-img" style="background-image: url('<%= product.image_url %>')"></div>
  <div class="product-detail-info">
    <h1><%= product.title %></h1>
    <div class="price-row">
      <span class="price">₹<%= product.price.toFixed(2) %></span>
      <% if (product.compare_at_price) { %>
        <span class="compare-price">₹<%= product.compare_at_price.toFixed(2) %></span>
      <% } %>
    </div>
    <p class="product-description"><%= product.description %></p>

    <% if (product.stock > 0) { %>
      <p class="stock-note"><%= product.stock %> in stock</p>
      <form action="/cart/add" method="POST" class="add-to-cart-form">
        <input type="hidden" name="productId" value="<%= product.id %>" />
        <input type="hidden" name="redirectTo" value="/products/<%= product.slug %>" />
        <label for="quantity">Qty</label>
        <input type="number" id="quantity" name="quantity" value="1" min="1" max="<%= product.stock %>" />
        <button type="submit" class="btn btn-primary">Add to cart</button>
      </form>
    <% } else { %>
      <p class="tag tag-out">Out of stock</p>
    <% } %>
  </div>
</section>

<% if (related.length > 0) { %>
  <section>
    <h2 class="section-title">You may also like</h2>
    <div class="product-grid">
      <% related.forEach(function(p) { %>
        <a class="product-card" href="/products/<%= p.slug %>">
          <div class="product-card-img" style="background-image: url('<%= p.image_url %>')"></div>
          <div class="product-card-body">
            <h3><%= p.title %></h3>
            <div class="price-row">
              <span class="price">₹<%= p.price.toFixed(2) %></span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
