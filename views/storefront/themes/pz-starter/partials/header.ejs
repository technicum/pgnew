<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %><%= typeof store !== 'undefined' && store ? ' · ' + store.name : ' · PageZaper' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/themes/pz-starter/theme.css" />
</head>
<body class="pzs theme-<%= typeof store !== 'undefined' && store && store.theme ? store.theme : 'default' %>" style="<%= typeof themeTokenStyle !== 'undefined' ? themeTokenStyle : '' %>">
  <%- include('../../../partials/preview-banner') %>

  <header class="pzs-header">
    <% if (typeof headerSections !== 'undefined' && headerSections.length) { %>
      <% headerSections.forEach(function (section) { %>
        <%- include('../../../partials/section', { section: section, categories: typeof categories !== 'undefined' ? categories : [] }) %>
      <% }); %>
    <% } else { %>
      <%# No header sections saved yet for this store (shouldn't normally
          happen — every store is seeded one on creation, see
          db/database.js's migrateDefaultHeaderFooter) — a plain fallback
          bar so the storefront never ships with a missing header. %>
      <div class="container pzs-header-top">
        <nav class="pzs-page-links">
          <% if (typeof storePages !== 'undefined' && storePages.length) { %>
            <% storePages.forEach(function(pg) { %>
              <a href="/pages<%= pg.path %>"><%= pg.name %></a>
            <% }); %>
          <% } %>
        </nav>
        <a href="/" class="pzs-logo"><%= typeof store !== 'undefined' && store ? store.name : 'PageZaper' %></a>
        <div class="pzs-header-actions">
          <% if (typeof customer !== 'undefined' && customer) { %>
            <a href="/account">My account</a>
          <% } else { %>
            <a href="/account/login">Log in</a>
          <% } %>
          <a href="/cart" class="pzs-cart-link">
            Cart
            <% if (cartItemCount > 0) { %><span class="pzs-badge"><%= cartItemCount %></span><% } %>
          </a>
        </div>
      </div>
    <% } %>
  </header>

  <% if (success && success.length) { %>
    <div class="flash flash-success container"><%= success[0] %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="flash flash-error container"><%= error[0] %></div>
  <% } %>

  <main class="container">
