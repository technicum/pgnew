<%- include('partials/header') %>

<h1 class="section-title">Blog</h1>

<% if (posts.length > 0) { %>
  <div class="blog-grid">
    <% posts.forEach(function(p) { %>
      <a class="blog-card" href="/blog/<%= p.slug %>">
        <% if (p.cover_image_url) { %>
          <div class="blog-card-img" style="background-image: url('<%= p.cover_image_url %>')"></div>
        <% } %>
        <div class="blog-card-body">
          <h3><%= p.title %></h3>
          <% if (p.excerpt) { %><p class="blog-card-excerpt"><%= p.excerpt %></p><% } %>
          <div class="blog-card-date"><%= new Date(p.published_at || p.created_at).toLocaleDateString() %></div>
        </div>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <p class="empty-state">No posts yet — check back soon.</p>
<% } %>

<%- include('partials/footer') %>
