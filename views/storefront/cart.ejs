<%- include('partials/header') %>

<h1>Your Cart</h1>

<% if (items.length === 0) { %>
  <p class="empty-state">Your cart is empty. <a href="/store">Continue shopping</a></p>
<% } else { %>
  <table class="cart-table">
    <thead>
      <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
        <tr>
          <td class="cart-product-cell">
            <img src="<%= item.image_url %>" alt="<%= item.title %>" />
            <span><%= item.title %></span>
          </td>
          <td>₹<%= item.price.toFixed(2) %></td>
          <td>
            <form action="/cart/update" method="POST" class="qty-form">
              <input type="hidden" name="productId" value="<%= item.id %>" />
              <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.stock %>" onchange="this.form.submit()" />
            </form>
          </td>
          <td>₹<%= item.lineTotal.toFixed(2) %></td>
          <td>
            <form action="/cart/remove" method="POST">
              <input type="hidden" name="productId" value="<%= item.id %>" />
              <button type="submit" class="link-btn">Remove</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="cart-summary">
    <div class="cart-summary-row">
      <span>Subtotal</span>
      <span>₹<%= subtotal.toFixed(2) %></span>
    </div>
    <a href="/checkout" class="btn btn-primary btn-block">Proceed to checkout</a>
  </div>
<% } %>

<%- include('partials/footer') %>
