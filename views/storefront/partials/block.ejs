<%
  // Renders one nested block inside a row's column (see the 'row' case in
  // section.ejs, which includes this once per block). A block is a cut-down
  // section: same per-type fields/rendering as a top-level section of that
  // type, but no id-based hiding, no custom class/CSS, and no section-level
  // margin/padding — those are top-level-only concerns. Only the types in
  // lib/sections.js's NESTABLE_SECTION_TYPES can appear here (enforced by
  // sanitizeRowBlock server-side), so this only ever needs to cover that
  // subset, not all 16 section types.
  //
  // position:relative so a freely-positioned text field inside this block
  // (see pzElStyle below) measures its left/top from the block's own box,
  // the same way a top-level section does for its own text fields.
  function pzElStyle(field) {
    var st = b.element_styles && b.element_styles[field];
    if (!st) return '';
    var s = '';
    if (st.positioned) {
      s += 'position:absolute;left:' + (st.pos_left || 0) + 'px;top:' + (st.pos_top || 0) + 'px;margin:0;';
      if (st.el_width) s += 'width:' + st.el_width + 'px;';
    }
    if (st.min_height) s += 'min-height:' + st.min_height + 'px;';
    if (st.margin_top) s += 'margin-top:' + st.margin_top + 'px;';
    if (st.margin_bottom) s += 'margin-bottom:' + st.margin_bottom + 'px;';
    if (st.margin_left) s += 'margin-left:' + st.margin_left + 'px;';
    if (st.margin_right) s += 'margin-right:' + st.margin_right + 'px;';
    if (st.padding_top) s += 'padding-top:' + st.padding_top + 'px;';
    if (st.padding_bottom) s += 'padding-bottom:' + st.padding_bottom + 'px;';
    if (st.padding_left) s += 'padding-left:' + st.padding_left + 'px;';
    if (st.padding_right) s += 'padding-right:' + st.padding_right + 'px;';
    return s;
  }
  // Mirrors section.ejs's pzHeroBgStyle — see the comment there.
  function pzHeroBgStyle(fields) {
    if (fields.bg_type === 'color' && fields.bg_color) return 'background-color:' + fields.bg_color + ';';
    if (fields.bg_type === 'image' && fields.bg_image_url) {
      return "background-image:url('" + fields.bg_image_url.replace(/'/g, '%27') + "');background-size:cover;background-position:center;";
    }
    return '';
  }
%>
<div class="pz-block pz-block-<%= b.type %>" style="position:relative;">
  <% if (b.type === 'hero') { %>
    <% var pzHeroLight = b.fields.bg_type !== 'none' && b.fields.text_theme === 'light'; %>
    <div class="hero<%= pzHeroLight ? ' hero-text-light' : '' %>" style="<%= pzHeroBgStyle(b.fields) %>">
      <% if (b.fields.bg_type === 'video' && b.fields.bg_video_url) { %>
        <video class="hero-bg-video" src="<%= b.fields.bg_video_url %>" autoplay muted loop playsinline></video>
      <% } %>
      <% if ((b.fields.bg_type === 'image' || b.fields.bg_type === 'video') && b.fields.bg_overlay) { %>
        <div class="hero-bg-overlay"></div>
      <% } %>
      <h1 style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h1>
      <p style="<%= pzElStyle('subheading') %>"><%= b.fields.subheading %></p>
    </div>

  <% } else if (b.type === 'heading') { %>
    <div class="pz-heading pz-heading-<%= b.fields.size || 'l' %>" style="text-align:<%= b.fields.align || 'left' %>;">
      <h2 style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
    </div>

  <% } else if (b.type === 'richtext') { %>
    <div class="richtext richtext-<%= b.fields.width === 'wide' ? 'wide' : 'narrow' %>" style="text-align:<%= b.fields.align === 'left' ? 'left' : 'center' %>;">
      <h2 style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <p style="<%= pzElStyle('body') %>"><%= b.fields.body %></p>
    </div>

  <% } else if (b.type === 'text_image') { %>
    <div class="text-image text-image-<%= b.fields.side === 'left' ? 'left' : 'right' %>">
      <div class="text-image-media" style="<%= b.fields.image_url ? `background-image:url('${b.fields.image_url}')` : '' %>"></div>
      <div class="text-image-copy">
        <h2 style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
        <p style="<%= pzElStyle('body') %>"><%= b.fields.body %></p>
      </div>
    </div>

  <% } else if (b.type === 'gallery' && b.fields.images && b.fields.images.length) { %>
    <div class="gallery">
      <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <div class="gallery-grid" data-cols="<%= b.fields.cols === '2' ? '2' : '3' %>">
        <% b.fields.images.forEach(function(url) { %>
          <div class="gallery-tile" style="background-image:url('<%= url %>')"></div>
        <% }); %>
      </div>
    </div>

  <% } else if (b.type === 'video' && b.fields.embed_url) { %>
    <div class="video-section">
      <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <div class="video-frame">
        <iframe src="<%= b.fields.embed_url %>" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>

  <% } else if (b.type === 'testimonials') { %>
    <div class="testimonials">
      <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <div class="testimonial-grid">
        <% b.fields.quotes.forEach(function(q) { %>
          <blockquote class="testimonial-card">
            <p>&ldquo;<%= q.quote %>&rdquo;</p>
            <cite>&mdash; <%= q.author %></cite>
          </blockquote>
        <% }); %>
      </div>
    </div>

  <% } else if (b.type === 'logos' && b.fields.names && b.fields.names.length) { %>
    <div class="logostrip">
      <% b.fields.names.forEach(function(n) { %><span><%= n %></span><% }); %>
    </div>

  <% } else if (b.type === 'newsletter') { %>
    <div class="newsletter">
      <h2 style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <p style="<%= pzElStyle('subtext') %>"><%= b.fields.subtext %></p>
      <form class="newsletter-form" action="/newsletter" method="POST">
        <input type="email" name="email" placeholder="you@example.com" required />
        <button type="submit" class="btn btn-primary" style="<%= pzElStyle('button') %>"><%= b.fields.button %></button>
      </form>
    </div>

  <% } else if (b.type === 'faq' && b.fields.items && b.fields.items.length) { %>
    <div class="faq">
      <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <% b.fields.items.forEach(function(f) { %>
        <details class="faq-item">
          <summary><%= f.q %></summary>
          <p><%= f.a %></p>
        </details>
      <% }); %>
    </div>

  <% } else if (b.type === 'countdown' && b.fields.end_at) { %>
    <div class="countdown" data-end="<%= b.fields.end_at %>">
      <h2 style="<%= pzElStyle('heading') %>"><%= b.fields.heading %></h2>
      <div class="countdown-timers">
        <div><b data-u="d">00</b><small>Days</small></div>
        <div><b data-u="h">00</b><small>Hrs</small></div>
        <div><b data-u="m">00</b><small>Min</small></div>
        <div><b data-u="s">00</b><small>Sec</small></div>
      </div>
    </div>
    <script>
      (function () {
        var els = document.querySelectorAll('.countdown[data-end]:not([data-pz-wired])');
        Array.prototype.forEach.call(els, function (el) {
          el.setAttribute('data-pz-wired', '1');
          var end = new Date(el.dataset.end).getTime();
          if (!end || isNaN(end)) return;
          var d = el.querySelector('[data-u="d"]'), h = el.querySelector('[data-u="h"]'),
              m = el.querySelector('[data-u="m"]'), s = el.querySelector('[data-u="s"]');
          function tick() {
            var diff = Math.max(0, end - Date.now());
            var days = Math.floor(diff / 86400000);
            var hrs = Math.floor((diff % 86400000) / 3600000);
            var min = Math.floor((diff % 3600000) / 60000);
            var sec = Math.floor((diff % 60000) / 1000);
            d.textContent = String(days).padStart(2, '0');
            h.textContent = String(hrs).padStart(2, '0');
            m.textContent = String(min).padStart(2, '0');
            s.textContent = String(sec).padStart(2, '0');
            if (diff <= 0) { clearInterval(timer); el.classList.add('is-ended'); }
          }
          tick();
          var timer = setInterval(tick, 1000);
        });
      })();
    </script>

  <% } else if (b.type === 'logo') { %>
    <div class="pz-logo-block">
      <a href="/" class="pz-logo-link">
        <% if (b.fields.image_url) { %>
          <img class="pz-logo-img" src="<%= b.fields.image_url %>" alt="<%= typeof store !== 'undefined' && store ? store.name : '' %>" style="height:<%= b.fields.height || 32 %>px;" />
        <% } else { %>
          <span class="pz-logo-text"><%= typeof store !== 'undefined' && store ? store.name : '' %></span>
        <% } %>
      </a>
    </div>

  <% } else if (b.type === 'nav_menu') { %>
    <nav class="pz-nav-block">
      <div class="pz-nav-links">
        <% // See partials/section.ejs's 'nav_menu' case -- same resolved-menu
           // lookup, just reached via `b.fields` since this is a block
           // (nested inside a row) rather than a top-level section. %>
        <% var pzMenuItems = (b.fields.menu_id && typeof resolvedMenus !== 'undefined' && resolvedMenus[b.fields.menu_id]) || []; %>
        <% pzMenuItems.forEach(function (item) { %>
          <% if (item.children && item.children.length) { %>
            <div class="pz-nav-dropdown">
              <a href="<%= item.url || '#' %>"><%= item.label %> <span class="pz-nav-caret">&#9662;</span></a>
              <div class="pz-nav-dropdown-menu">
                <% item.children.forEach(function (c) { %>
                  <a href="<%= c.url || '#' %>"><%= c.label %></a>
                <% }); %>
              </div>
            </div>
          <% } else { %>
            <a href="<%= item.url || '#' %>"><%= item.label %></a>
          <% } %>
        <% }); %>
      </div>
      <div class="pz-nav-icons">
        <% if (b.fields.show_search) { %>
          <form class="pz-nav-search" action="/" method="GET">
            <input type="search" name="q" placeholder="Search" aria-label="Search" />
          </form>
        <% } %>
        <% if (b.fields.show_account) { %>
          <% if (typeof customer !== 'undefined' && customer) { %>
            <a href="/account" class="pz-nav-account">My account</a>
          <% } else { %>
            <a href="/account/login" class="pz-nav-account">Log in</a>
          <% } %>
        <% } %>
        <% if (b.fields.show_cart) { %>
          <a href="/cart" class="pz-nav-cart">
            Cart<% if (typeof cartItemCount !== 'undefined' && cartItemCount > 0) { %><span class="badge"><%= cartItemCount %></span><% } %>
          </a>
        <% } %>
      </div>
    </nav>

  <% } else if (b.type === 'promo_bar' && b.fields.text) { %>
    <div class="pz-promo-bar" style="background:<%= b.fields.bg_color || '#111111' %>;color:<%= b.fields.text_color || '#ffffff' %>;">
      <span class="pz-promo-text" style="<%= pzElStyle('text') %>"><%= b.fields.text %></span>
      <% if (b.fields.link_url && b.fields.link_text) { %>
        <a class="pz-promo-link" href="<%= b.fields.link_url %>"><%= b.fields.link_text %></a>
      <% } %>
      <% if (b.fields.dismissible) { %>
        <button type="button" class="pz-promo-close" aria-label="Dismiss">&times;</button>
      <% } %>
    </div>

  <% } else if (b.type === 'link_columns' && b.fields.columns && b.fields.columns.length) { %>
    <div class="pz-linkcols">
      <% b.fields.columns.forEach(function (c) { %>
        <div class="pz-linkcol">
          <h4><%= c.heading %></h4>
          <% (c.links || []).forEach(function (l) { %>
            <a href="<%= l.url || '#' %>"><%= l.label %></a>
          <% }); %>
        </div>
      <% }); %>
    </div>

  <% } else if (b.type === 'social_icons' && b.fields.links && b.fields.links.length) { %>
    <div class="pz-social-icons">
      <% b.fields.links.forEach(function (l) { %>
        <%
          // See partials/section.ejs's identical block for why this falls
          // back to the generic "custom" glyph rather than rendering nothing.
          var pzBlockSocIcons = typeof socialIcons !== 'undefined' ? socialIcons : {};
          var pzBlockSocSvg = pzBlockSocIcons[l.platform] || pzBlockSocIcons.custom || '';
        %>
        <a href="<%= l.url || '#' %>" class="pz-social-icon" target="_blank" rel="noopener noreferrer" aria-label="<%= l.platform %>" title="<%= l.platform %>"><%- pzBlockSocSvg %></a>
      <% }); %>
    </div>

  <% } else if (b.type === 'copyright') { %>
    <div class="pz-copyright">
      <div style="<%= pzElStyle('text') %>"><%= b.fields.text || ('© ' + new Date().getFullYear() + ' ' + (typeof store !== 'undefined' && store ? store.name : '') + '. All rights reserved.') %></div>
      <% if (b.fields.show_powered_by || b.fields.show_admin_link) { %>
        <div class="pz-copyright-links">
          <% if (b.fields.show_powered_by) { %><span>Powered by <a href="//<%= typeof baseDomain !== 'undefined' ? baseDomain : 'pagezaper.com' %>/">PageZaper</a></span><% } %>
          <% if (b.fields.show_admin_link) { %><span><a href="<%= typeof loginUrl !== 'undefined' ? loginUrl : '/admin/login' %>">Store admin</a></span><% } %>
        </div>
      <% } %>
    </div>

  <% } else if (b.type === 'spacer') { %>
    <div class="section-spacer section-spacer-<%= b.fields.height %>"></div>

  <% } else if (b.type === 'divider') { %>
    <% if (b.fields.style === 'dots') { %>
      <div class="section-divider section-divider-dots">&bull;&nbsp; &bull;&nbsp; &bull;&nbsp; &bull;&nbsp; &bull;</div>
    <% } else { %>
      <hr class="section-divider" />
    <% } %>

  <% } else if (b.type === 'row') { %>
    <%
      // A row nested inside another row's column — b.fields.columns has
      // exactly the same shape as a top-level row section's own (see
      // section.ejs's 'row' case), so this mirrors that case exactly, just
      // rooted at `b` instead of `section`. Including this same block.ejs
      // partial again for each of ITS blocks is what lets nesting go as many
      // levels deep as lib/sections.js's sanitizeRowBlock allowed when this
      // page was saved (MAX_ROW_DEPTH) — EJS includes can reference their
      // own partial recursively without any special handling.
      var pzNestedCols = Array.isArray(b.fields.columns) ? b.fields.columns : [];
      var pzNestedTemplate = pzNestedCols.map(function (c) { return (c.width || 1) + 'fr'; }).join(' ') || '1fr';
    %>
    <div class="pz-row-inner" style="grid-template-columns:<%= pzNestedTemplate %>;">
      <% pzNestedCols.forEach(function (col) { %>
        <div class="pz-row-col">
          <% (col.blocks || []).forEach(function (nb) { %>
            <%- include('block', { b: nb }) %>
          <% }); %>
        </div>
      <% }); %>
    </div>

  <% } else if (b.type === 'html' && (b.fields.html || b.fields.css)) { %>
    <%
      // Mirrors section.ejs's 'html' case — see the comment there for why
      // the escaping output tag is the correct choice for a srcdoc
      // attribute, and why sandbox="allow-scripts" alone is the safe default.
      var pzNestedHtmlDoc = (b.fields.html || '') + (b.fields.css ? '<style>' + b.fields.css + '</style>' : '');
    %>
    <div class="pz-html-block">
      <iframe class="pz-html-frame" sandbox="allow-scripts" loading="lazy" title="Custom HTML block" srcdoc="<%= pzNestedHtmlDoc %>"></iframe>
    </div>
  <% } %>
</div>
