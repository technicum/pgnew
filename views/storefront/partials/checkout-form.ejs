<%
  // The checkout HOOK — shared and theme-agnostic, same as section.ejs/
  // block.ejs. Every theme's checkout.ejs must include this for its actual
  // <form> rather than writing one itself: the field set, the POST action,
  // and payment handling stay identical no matter which theme is active.
  // A theme controls everything AROUND this include (headings, layout,
  // order summary styling) but never this partial's contents.
%>
<form action="/checkout" method="POST" class="checkout-form">
  <h2>Shipping details</h2>
  <label>Full name *
    <input type="text" name="name" required />
  </label>
  <label>Email *
    <input type="email" name="email" required />
  </label>
  <label>Phone
    <input type="tel" name="phone" />
  </label>
  <label>Address *
    <input type="text" name="address" required />
  </label>
  <div class="form-row">
    <label>City
      <input type="text" name="city" />
    </label>
    <label>ZIP / PIN
      <input type="text" name="zip" />
    </label>
  </div>

  <h2>Discount code</h2>
  <label>Code (optional)
    <input type="text" name="discountCode" placeholder="e.g. WELCOME10" style="text-transform:uppercase;" />
  </label>

  <h2>Payment</h2>
  <p class="payment-note">Cash on Delivery (payment gateway integration can be added later — Stripe, Razorpay, etc.)</p>

  <button type="submit" class="btn btn-primary btn-block">Place order</button>
</form>
