<%
  // Site-wide WhatsApp chat bubble + mobile sticky Call/WhatsApp bar, shown
  // on every page of every theme once a store sets its WhatsApp number
  // (Settings > whatsapp_number — the same number already used by the
  // "Chat to order on WhatsApp" button on product pages, see
  // views/storefront/themes/*/product.ejs). Renders nothing at all when
  // that number isn't set, so a store with no WhatsApp number keeps
  // rendering exactly as it did before this partial existed. Included from
  // each theme's own footer.ejs, right before </body>, so it sits fixed on
  // top of the whole page rather than scoped to any one section.
  var pzWaNumber = typeof store !== 'undefined' && store ? (store.whatsapp_number || '') : '';
%>
<% if (pzWaNumber) { %>
  <a class="pz-wa-float" href="https://wa.me/<%= pzWaNumber %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.25.7-1.45 1.35-2 1.4-.52.06-1.05.28-3.5-.75-2.95-1.24-4.85-4.2-5-4.4-.14-.2-1.2-1.6-1.2-3.05 0-1.45.77-2.15 1.04-2.45.27-.3.6-.36.8-.36h.55c.18 0 .42-.03.65.5.25.6.85 2.05.92 2.2.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.3.4-.44.53-.15.15-.3.3-.13.6.17.3.77 1.28 1.65 2.07 1.14 1.02 2.1 1.34 2.4 1.5.3.15.47.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.24.66-.15.27.1 1.7.8 2 .95.3.15.5.22.57.35.07.13.07.75-.18 1.45Z"/></svg>
  </a>
  <div class="pz-mobile-cta-bar">
    <a href="tel:<%= pzWaNumber %>">Call now</a>
    <a href="https://wa.me/<%= pzWaNumber %>" target="_blank" rel="noopener">WhatsApp</a>
  </div>
<% } %>
