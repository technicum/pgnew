<% var pzId = 'pz-section-' + section.id; %>
<%
  var pzHideClasses = '';
  if (section.hide_desktop) pzHideClasses += ' pz-hide-desktop';
  if (section.hide_tablet) pzHideClasses += ' pz-hide-tablet';
  if (section.hide_mobile) pzHideClasses += ' pz-hide-mobile';
%>
<% var pzExtra = (section.custom_class ? ' ' + section.custom_class : '') + pzHideClasses; %>
<%
  // position:relative unconditionally — it's the anchor a freely-positioned
  // text element inside this section (see pzElStyle below) measures its
  // left/top from, and it's a no-op for every section that doesn't have one.
  var pzHeightStyle = 'position:relative;';
  pzHeightStyle += section.min_height && section.min_height > 0
    ? ('min-height:' + section.min_height + 'px;display:flex;flex-direction:column;justify-content:center;')
    : '';
  // Vertical spacing set from the builder's Section settings: margin (the
  // gap before/after this section, dragged from the gutter handles on the
  // canvas) and padding (inset from its own top/bottom edge, numeric-only).
  if (section.margin_top) pzHeightStyle += 'margin-top:' + section.margin_top + 'px;';
  if (section.margin_bottom) pzHeightStyle += 'margin-bottom:' + section.margin_bottom + 'px;';
  if (section.margin_left) pzHeightStyle += 'margin-left:' + section.margin_left + 'px;';
  if (section.margin_right) pzHeightStyle += 'margin-right:' + section.margin_right + 'px;';
  if (section.padding_top) pzHeightStyle += 'padding-top:' + section.padding_top + 'px;';
  if (section.padding_bottom) pzHeightStyle += 'padding-bottom:' + section.padding_bottom + 'px;';
  if (section.padding_left) pzHeightStyle += 'padding-left:' + section.padding_left + 'px;';
  if (section.padding_right) pzHeightStyle += 'padding-right:' + section.padding_right + 'px;';
%>
<%
  // Per-element spacing: margin/padding on a single text field inside this
  // section (e.g. just the heading), set from the builder's inspector when
  // that field is selected on the canvas — independent of, and layered on
  // top of, the section-wide spacing above. See lib/sections.js's
  // TEXT_ELEMENT_FIELDS for which fields on which types support this.
  function pzElStyle(field) {
    var st = section.element_styles && section.element_styles[field];
    if (!st) return '';
    var s = '';
    // Free positioning — dragged off the normal flow onto an explicit spot
    // inside this section (see the move handle in the builder). Width is
    // frozen at the moment it left flow so the box doesn't shrink to fit
    // its own text once it's no longer stretched by its siblings.
    if (st.positioned) {
      s += 'position:absolute;left:' + (st.pos_left || 0) + 'px;top:' + (st.pos_top || 0) + 'px;margin:0;';
      if (st.el_width) s += 'width:' + st.el_width + 'px;';
    }
    if (st.min_height) s += 'min-height:' + st.min_height + 'px;';
    if (st.margin_top) s += 'margin-top:' + st.margin_top + 'px;';
    if (st.margin_bottom) s += 'margin-bottom:' + st.margin_bottom + 'px;';
    if (st.margin_left) s += 'margin-left:' + st.margin_left + 'px;';
    if (st.margin_right) s += 'margin-right:' + st.margin_right + 'px;';
    if (st.padding_top) s += 'padding-top:' + st.padding_top + 'px;';
    if (st.padding_bottom) s += 'padding-bottom:' + st.padding_bottom + 'px;';
    if (st.padding_left) s += 'padding-left:' + st.padding_left + 'px;';
    if (st.padding_right) s += 'padding-right:' + st.padding_right + 'px;';
    return s;
  }
  // A hero's background (see lib/sections.js's bg_type/bg_color/bg_image_url/
  // bg_video_url fields): 'none' leaves the theme's plain background alone —
  // every hero created before this existed keeps rendering exactly as it did.
  // Color/image go straight on the section's own style; video is rendered as
  // an absolutely-positioned <video> behind the heading/subheading, which is
  // why .hero always has position:relative (see style.css) regardless of
  // which background is chosen.
  function pzHeroBgStyle(fields) {
    if (fields.bg_type === 'color' && fields.bg_color) return 'background-color:' + fields.bg_color + ';';
    if (fields.bg_type === 'image' && fields.bg_image_url) {
      return "background-image:url('" + fields.bg_image_url.replace(/'/g, '%27') + "');background-size:cover;background-position:center;";
    }
    return '';
  }
%>
<% if (section.type === 'hero') { %>
  <% var pzHeroLight = section.fields.bg_type !== 'none' && section.fields.text_theme === 'light'; %>
  <section id="<%= pzId %>" class="hero<%= pzHeroLight ? ' hero-text-light' : '' %><%= pzExtra %>" style="<%= pzHeightStyle + pzHeroBgStyle(section.fields) %>">
    <% if (section.fields.bg_type === 'video' && section.fields.bg_video_url) { %>
      <video class="hero-bg-video" src="<%= section.fields.bg_video_url %>" autoplay muted loop playsinline></video>
    <% } %>
    <% if ((section.fields.bg_type === 'image' || section.fields.bg_type === 'video') && section.fields.bg_overlay) { %>
      <div class="hero-bg-overlay"></div>
    <% } %>
    <h1 style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h1>
    <p style="<%= pzElStyle('subheading') %>"><%= section.fields.subheading %></p>
  </section>

<% } else if (section.type === 'heading') { %>
  <section id="<%= pzId %>" class="pz-heading pz-heading-<%= section.fields.size || 'l' %><%= pzExtra %>" style="<%= pzHeightStyle %>text-align:<%= section.fields.align || 'left' %>;">
    <h2 style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
  </section>

<% } else if (section.type === 'products') { %>
  <section id="<%= pzId %>" class="product-grid-section<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <div class="product-grid">
      <% if (section.products.length === 0) { %>
        <p class="empty-state">No products found in this category yet.</p>
      <% } %>
      <% section.products.forEach(function(p) { %>
        <a class="product-card" href="/products/<%= p.slug %>">
          <div class="product-card-img" style="background-image: url('<%= p.image_url %>')"></div>
          <div class="product-card-body">
            <h3><%= p.title %></h3>
            <div class="price-row">
              <span class="price">₹<%= p.price.toFixed(2) %></span>
              <% if (p.compare_at_price) { %><span class="compare-price">₹<%= p.compare_at_price.toFixed(2) %></span><% } %>
            </div>
            <% if (p.stock <= 0) { %><span class="tag tag-out">Out of stock</span><% } %>
          </div>
        </a>
      <% }); %>
    </div>
  </section>

<% } else if (section.type === 'text_image') { %>
  <section id="<%= pzId %>" class="text-image text-image-<%= section.fields.side === 'left' ? 'left' : 'right' %><%= pzExtra %>" style="<%= pzHeightStyle %>">
    <div class="text-image-media" style="<%= section.fields.image_url ? `background-image:url('${section.fields.image_url}')` : '' %>"></div>
    <div class="text-image-copy">
      <h2 style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
      <p style="<%= pzElStyle('body') %>"><%= section.fields.body %></p>
    </div>
  </section>

<% } else if (section.type === 'testimonials') { %>
  <section id="<%= pzId %>" class="testimonials<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <div class="testimonial-grid">
      <% section.fields.quotes.forEach(function(q) { %>
        <blockquote class="testimonial-card">
          <p>&ldquo;<%= q.quote %>&rdquo;</p>
          <cite>&mdash; <%= q.author %></cite>
        </blockquote>
      <% }); %>
    </div>
  </section>

<% } else if (section.type === 'newsletter') { %>
  <section id="<%= pzId %>" class="newsletter<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <h2 style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <p style="<%= pzElStyle('subtext') %>"><%= section.fields.subtext %></p>
    <form class="newsletter-form" action="/newsletter" method="POST">
      <input type="email" name="email" placeholder="you@example.com" required />
      <button type="submit" class="btn btn-primary" style="<%= pzElStyle('button') %>"><%= section.fields.button %></button>
    </form>
  </section>

<% } else if (section.type === 'richtext') { %>
  <section id="<%= pzId %>" class="richtext richtext-<%= section.fields.width === 'wide' ? 'wide' : 'narrow' %><%= pzExtra %>" style="<%= pzHeightStyle %>text-align:<%= section.fields.align === 'left' ? 'left' : 'center' %>;">
    <h2 style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <p style="<%= pzElStyle('body') %>"><%= section.fields.body %></p>
  </section>

<% } else if (section.type === 'gallery' && section.fields.images && section.fields.images.length) { %>
  <section id="<%= pzId %>" class="gallery<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <div class="gallery-grid" data-cols="<%= section.fields.cols === '2' ? '2' : '3' %>">
      <% section.fields.images.forEach(function(url) { %>
        <div class="gallery-tile" style="background-image:url('<%= url %>')"></div>
      <% }); %>
    </div>
  </section>

<% } else if (section.type === 'video' && section.fields.embed_url) { %>
  <section id="<%= pzId %>" class="video-section<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <div class="video-frame">
      <iframe src="<%= section.fields.embed_url %>" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  </section>

<% } else if (section.type === 'spotlight' && section.product) { %>
  <section id="<%= pzId %>" class="spotlight spotlight-<%= section.fields.side === 'left' ? 'left' : 'right' %><%= pzExtra %>" style="<%= pzHeightStyle %>">
    <div class="spotlight-media" style="<%= section.product.image_url ? `background-image:url('${section.product.image_url}')` : '' %>"></div>
    <div class="spotlight-copy">
      <h2><%= section.product.title %></h2>
      <div class="price-row">
        <span class="price">₹<%= section.product.price.toFixed(2) %></span>
        <% if (section.product.compare_at_price) { %><span class="compare-price">₹<%= section.product.compare_at_price.toFixed(2) %></span><% } %>
      </div>
      <p style="<%= pzElStyle('body') %>"><%= section.fields.body %></p>
      <a class="btn btn-primary" href="/products/<%= section.product.slug %>" style="<%= pzElStyle('button') %>"><%= section.fields.button %></a>
    </div>
  </section>

<% } else if (section.type === 'collections' && typeof categories !== 'undefined' && categories.length) { %>
  <section id="<%= pzId %>" class="collections<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <div class="collections-grid" data-cols="<%= section.fields.cols === '2' ? '2' : '3' %>">
      <% categories.forEach(function(c) { %>
        <a class="collection-card" href="/?category=<%= encodeURIComponent(c.name) %>"><span><%= c.name %></span></a>
      <% }); %>
    </div>
  </section>

<% } else if (section.type === 'logos' && section.fields.names && section.fields.names.length) { %>
  <section id="<%= pzId %>" class="logostrip<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <% section.fields.names.forEach(function(n) { %><span><%= n %></span><% }); %>
  </section>

<% } else if (section.type === 'faq' && section.fields.items && section.fields.items.length) { %>
  <section id="<%= pzId %>" class="faq<%= pzExtra %>" style="<%= pzHeightStyle %>max-width:640px;margin:0 auto;">
    <h2 class="section-title" style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <% section.fields.items.forEach(function(f) { %>
      <details class="faq-item">
        <summary><%= f.q %></summary>
        <p><%= f.a %></p>
      </details>
    <% }); %>
  </section>

<% } else if (section.type === 'countdown' && section.fields.end_at) { %>
  <section id="<%= pzId %>" class="countdown<%= pzExtra %>" data-end="<%= section.fields.end_at %>" style="<%= pzHeightStyle %>">
    <h2 style="<%= pzElStyle('heading') %>"><%= section.fields.heading %></h2>
    <div class="countdown-timers">
      <div><b data-u="d">00</b><small>Days</small></div>
      <div><b data-u="h">00</b><small>Hrs</small></div>
      <div><b data-u="m">00</b><small>Min</small></div>
      <div><b data-u="s">00</b><small>Sec</small></div>
    </div>
  </section>
  <script>
    (function () {
      var els = document.querySelectorAll('.countdown[data-end]');
      Array.prototype.forEach.call(els, function (el) {
        var end = new Date(el.dataset.end).getTime();
        if (!end || isNaN(end)) return;
        var d = el.querySelector('[data-u="d"]'), h = el.querySelector('[data-u="h"]'),
            m = el.querySelector('[data-u="m"]'), s = el.querySelector('[data-u="s"]');
        function tick() {
          var diff = Math.max(0, end - Date.now());
          var days = Math.floor(diff / 86400000);
          var hrs = Math.floor((diff % 86400000) / 3600000);
          var min = Math.floor((diff % 3600000) / 60000);
          var sec = Math.floor((diff % 60000) / 1000);
          d.textContent = String(days).padStart(2, '0');
          h.textContent = String(hrs).padStart(2, '0');
          m.textContent = String(min).padStart(2, '0');
          s.textContent = String(sec).padStart(2, '0');
          if (diff <= 0) { clearInterval(timer); el.classList.add('is-ended'); }
        }
        tick();
        var timer = setInterval(tick, 1000);
      });
    })();
  </script>

<% } else if (section.type === 'row') { %>
  <%
    var pzCols = Array.isArray(section.fields.columns) ? section.fields.columns : [];
    var pzTemplate = pzCols.map(function (c) { return (c.width || 1) + 'fr'; }).join(' ') || '1fr';
  %>
  <section id="<%= pzId %>" class="pz-row<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <div class="pz-row-inner" style="grid-template-columns:<%= pzTemplate %>;">
      <% pzCols.forEach(function (col) { %>
        <div class="pz-row-col">
          <% (col.blocks || []).forEach(function (b) { %>
            <%- include('block', { b: b }) %>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </section>

<% } else if (section.type === 'html' && (section.fields.html || section.fields.css)) { %>
  <%
    // Escaped (not raw) on purpose: EJS's escaping output tag HTML-entity-
    // encodes the merchant's markup/CSS so it can sit safely inside the
    // srcdoc="..." attribute
    // (entities keep a stray " from closing the attribute early) — the
    // browser decodes those entities back out when it parses srcdoc as the
    // iframe's own document, so the merchant's HTML/CSS renders normally
    // inside the frame. sandbox="allow-scripts" (no allow-same-origin) gives
    // that document a unique, opaque origin: any script in it can run, but
    // can't reach this page's cookies, storage, or DOM.
    var pzHtmlDoc = (section.fields.html || '') + (section.fields.css ? '<style>' + section.fields.css + '</style>' : '');
  %>
  <div id="<%= pzId %>" class="pz-html-block<%= pzExtra %>" style="<%= pzHeightStyle %>">
    <iframe class="pz-html-frame" sandbox="allow-scripts" loading="lazy" title="Custom HTML block" srcdoc="<%= pzHtmlDoc %>"></iframe>
  </div>

<% } else if (section.type === 'spacer') { %>
  <div id="<%= pzId %>" class="section-spacer section-spacer-<%= section.fields.height %><%= pzExtra %>"></div>

<% } else if (section.type === 'divider') { %>
  <% if (section.fields.style === 'dots') { %>
    <div id="<%= pzId %>" class="section-divider section-divider-dots<%= pzExtra %>">&bull;&nbsp; &bull;&nbsp; &bull;&nbsp; &bull;&nbsp; &bull;</div>
  <% } else { %>
    <hr id="<%= pzId %>" class="section-divider<%= pzExtra %>" />
  <% } %>
<% } %>

<% if (section.custom_css) { %>
  <style id="<%= pzId %>-css"></style>
  <script>
    document.getElementById(<%- JSON.stringify(pzId + '-css').split('/').join(String.fromCharCode(92) + '/') %>).textContent =
      <%- JSON.stringify(section.custom_css).split('/').join(String.fromCharCode(92) + '/') %>;
  </script>
<% } %>
