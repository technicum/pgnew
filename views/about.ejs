<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<%- include('partials/seo-meta') %>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/explore.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/about.css?v=<%= assetVersion %>" />
</head>
<%# About (server.js GET /about): what PageZaper is, who builds it, and how to reach him. Shares the marketplace's header, hero and footer (explore.css); the rest is about.css. %>
<%
var contact = {
  name: 'Abhishek Bhardwaj',
  email: 'abhi.technicum@gmail.com',
  phone: '+91 78891 73606',
  tel: '+917889173606',
  whatsapp: 'https://wa.me/917889173606',
};
var features = [
  { icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/>', title: 'Payment pages', text: 'One checkout link for a download, a physical product, a bundle — or a “buy me a coffee”. Coupons, shipping and receipts included.' },
  { icon: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/>', title: 'Courses', text: 'Video and text lessons in modules, quizzes and downloads. Students get their own link and track their progress.' },
  { icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>', title: 'Bookings', text: 'Sessions people book straight from your calendar — free, paid upfront, or with an advance to cut no-shows.' },
  { icon: '<path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7Z"/>', title: 'Events', text: 'Workshops, webinars and meetups with free registration or paid tickets, seat limits and the join link sent after.' },
  { icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>', title: 'Audience', text: 'Everyone who buys, books, registers or grabs a freebie lands in one list — ready for a follow-up.' },
  { icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>', title: 'Marketplace', text: 'List what you sell on Explore, where people looking for a coach, a class or a course can find you.' },
];
var svg = function (paths) { return '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + paths + '</svg>'; };
%>
<body class="mk-page">
  <header class="mk-nav">
    <div class="mk-nav-in">
      <a class="mk-brand" href="/"><span class="mark">ϟ</span><span>page<b>zaper</b></span></a>
      <nav class="mk-nav-links" aria-label="Main">
        <a href="/explore">Explore</a>
        <a href="/blog">Blog</a>
        <a href="/about" aria-current="page">About</a>
        <% if (currentUser) { %><a class="mk-cta" href="/dashboard">Dashboard</a><% } else { %><a href="/login">Log in</a><a class="mk-cta" href="/signup">Start selling</a><% } %>
      </nav>
    </div>
  </header>

  <section class="mk-hero">
    <div class="mk-hero-glow" aria-hidden="true"></div>
    <div class="mk-hero-in">
      <span class="mk-pill">✦ About <%= siteName %></span>
      <h1>One page to <em>sell what you know.</em></h1>
      <p><%= siteName %> gives creators, coaches, doctors and studios a single link for everything they sell — bookings, courses, events, digital and physical products — with payments built in.</p>
      <div class="ab-hero-actions">
        <a class="mk-btn mk-btn-lime" href="<%= currentUser ? '/dashboard' : '/signup' %>"><%= currentUser ? 'Go to dashboard →' : 'Start for free →' %></a>
        <a class="ab-ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <main class="ab-main">
    <section class="ab-section">
      <div class="ab-head">
        <span class="ab-kicker">What it does</span>
        <h2>Everything you sell, <em>on one link.</em></h2>
        <p>No juggling a booking tool, a course platform, a payment link and a spreadsheet of customers. Set it up once, share one link in your bio, WhatsApp or email.</p>
      </div>
      <div class="ab-grid">
        <% features.forEach(function (f) { %>
        <article class="ab-card">
          <span class="ab-icon"><%- svg(f.icon) %></span>
          <h3><%= f.title %></h3>
          <p><%= f.text %></p>
        </article>
        <% }) %>
      </div>
    </section>

    <section class="ab-section ab-founder" id="contact">
      <div class="ab-person">
        <span class="ab-avatar" aria-hidden="true">AB</span>
        <div>
          <span class="ab-kicker">Who’s behind it</span>
          <h2><%= contact.name %></h2>
          <p><%= siteName %> is built and run by <%= contact.name %>. If you have a question, an idea, or want a hand setting up your page, reach out directly — you’ll hear back from me, not a ticket queue.</p>
        </div>
      </div>
      <div class="ab-contact">
        <a class="ab-contact-row" href="mailto:<%= contact.email %>">
          <span class="ab-icon"><%- svg('<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>') %></span>
          <span><small>Email</small><b><%= contact.email %></b></span>
        </a>
        <a class="ab-contact-row" href="tel:<%= contact.tel %>">
          <span class="ab-icon"><%- svg('<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>') %></span>
          <span><small>Phone</small><b><%= contact.phone %></b></span>
        </a>
        <a class="ab-contact-row" href="<%= contact.whatsapp %>" target="_blank" rel="noopener">
          <span class="ab-icon"><%- svg('<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5Z"/>') %></span>
          <span><small>WhatsApp</small><b><%= contact.phone %></b></span>
        </a>
      </div>
    </section>
  </main>

  <section class="mk-sell">
    <div>
      <span class="mk-pill mk-pill-dark">For creators</span>
      <h2>Ready to <em>get paid</em> for what you know?</h2>
      <p>Make your page in minutes. Add a session, a course or a product, share the link, and start selling.</p>
    </div>
    <a class="mk-btn mk-btn-lime" href="<%= currentUser ? '/dashboard' : '/signup' %>"><%= currentUser ? 'Go to dashboard →' : 'Start selling →' %></a>
  </section>

  <footer class="mk-footer">
    <span>© <%= new Date().getFullYear() %> <%= siteName %></span>
    <nav><a href="/">Home</a><a href="/explore">Explore</a><a href="/blog">Blog</a><a href="/about">About</a><a href="mailto:<%= contact.email %>">Contact</a></nav>
  </footer>
</body>
</html>
