<%# Public booking page (lib/appStorefront.js → /book/:slug): pick a day, pick a time, add your details. Works without JavaScript — days are links (?date=), times are radio buttons. %>
<%- include('partials/app-public-top') %>

  <article class="lm-card">
    <div class="lm-card-body">
      <span class="lm-kicker"><span class="dot"></span>Book a session</span>
      <h1><%= service.title %></h1>
      <p class="ax-meta">
        <span><%= service.duration_min %> min</span>
        <% if (service.location) { %><span><%= service.location %></span><% } %>
      </p>
      <% if (service.description) { %><div class="lm-desc ax-rich"><%- descriptionHtml %></div><% } %>

      <% if (error) { %><div class="auth-error"><%= error %></div><% } %>

      <% if (!days.length) { %>
      <div class="ax-empty">No open times right now — check back soon.</div>
      <% } else { %>
      <h2 class="ax-step">1. Pick a day</h2>
      <nav class="ax-days" aria-label="Days with open times">
        <% days.forEach(function (d) { %>
        <a href="?date=<%= d.date %>" class="ax-day<%= d.date === date ? ' is-on' : '' %>"<%= d.date === date ? ' aria-current="date"' : '' %>>
          <b><%= d.label %></b><small><%= d.count %> open</small>
        </a>
        <% }) %>
      </nav>

      <form method="POST" action="/book/<%= service.slug %>" novalidate>
        <input type="hidden" name="date" value="<%= date %>" />
        <h2 class="ax-step">2. Pick a time <small><%= dateLabel %> · IST</small></h2>
        <div class="ax-slots">
          <% slots.forEach(function (s) { %>
          <label class="ax-slot">
            <input type="radio" name="start" value="<%= s.time %>"<%= values.start === s.time && values.date === date ? ' checked' : '' %> required />
            <span><%= s.label %></span>
          </label>
          <% }) %>
        </div>

        <h2 class="ax-step">3. Your details</h2>
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" value="<%= values.name || '' %>" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Your email</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="phone">Phone <span class="lm-opt">(optional)</span></label>
          <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="note">Anything to share beforehand? <span class="lm-opt">(optional)</span></label>
          <textarea id="note" name="note" rows="3" maxlength="500"><%= values.note || '' %></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Confirm booking</button>
      </form>
      <% } %>
    </div>
    <p class="lm-card-foot"><span>Your details go to <%= owner.name %> only, to arrange this session.</span></p>
  </article>

<%- include('partials/app-public-bottom') %>
