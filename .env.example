PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Prefix applied to every database table (pz_stores, pz_products, ...). If
# this database already has un-prefixed tables from before this existed,
# they're renamed in place automatically on startup — no data is lost.
DB_PREFIX=pz_

# The root domain stores are hosted under, e.g. pagezaper.com in production.
# A store "acme" is then reachable at acme.pagezaper.com. Leave as
# "localhost" for local development — test store subdomains locally with
# curl -H "Host: demo.localhost:3000" http://localhost:3000/
BASE_DOMAIN=localhost

DB_HOST=localhost
DB_PORT=3306
DB_USER=pagezaper_user
DB_PASSWORD=change-this-password
DB_NAME=pagezaper

# Platform super-admin: one account (separate from every store's own admin
# accounts) that can see and manage all stores at yourdomain.com/platform-admin.
# Seeded automatically on first boot if it doesn't exist yet — set these
# before first boot in production, or log in with the defaults and note this
# account has no way to change its own password from the UI yet.
PLATFORM_ADMIN_EMAIL=superadmin@pagezaper.com
PLATFORM_ADMIN_PASSWORD=changeme123

# Optional: lets a merchant import CRM leads straight from Google Drive
# (Leads > Import leads > Import from Google Drive) via Google's own file
# picker, instead of only uploading a file from their computer. Both values
# are public/client-side identifiers, not secrets — they're sent to the
# browser as-is (see views/platform/crm-contacts.ejs) and safe to have in
# your app's public source. Leave both unset to hide that button entirely;
# file/Excel/CSV import still works with neither set.
# To get them: console.cloud.google.com -> create a project -> enable the
# "Google Picker API" and "Google Drive API" -> Credentials -> create an
# OAuth 2.0 Client ID (type "Web application", add your domain under
# Authorized JavaScript origins) for GOOGLE_DRIVE_CLIENT_ID, and an API key
# for GOOGLE_DRIVE_API_KEY.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=
