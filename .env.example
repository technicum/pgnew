# Instagram (lib/instagram.js). All of the first four are needed, or Instagram stays switched off.
# The app ID and secret come from Meta: Use cases → Instagram → API setup with Instagram login.
# They are not the main Meta App ID and secret.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any long random string. Type the same value into Meta's webhook settings.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Encrypts tokens. Generate with: openssl rand -hex 32
# If INSTAGRAM_TOKEN_KEY is already set on a server, keep it: changing it means everyone has to reconnect.
TOKEN_ENC_KEY=

INSTAGRAM_REDIRECT_URI=https://pagezaper.com/auth/instagram/callback
GRAPH_API_VERSION=v26.0
