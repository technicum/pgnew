# Instagram (lib/instagram.js): Instagram API with Unified Login.
# All of the first five are needed, or Instagram stays switched off.
# Use the Meta app ID and secret from App settings → Basic, not the Instagram ones.
META_APP_ID=1644372183822778
META_APP_SECRET=
# Facebook Login for Business → Configurations. Choose a system-user token that never expires.
FB_LOGIN_CONFIG_ID=1203749041975668
# Any long random string. Type the same value into Meta's webhook settings.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Encrypts tokens. Generate with: openssl rand -hex 32
# If INSTAGRAM_TOKEN_KEY is already set on a server, keep it: changing it means everyone has to reconnect.
TOKEN_ENC_KEY=

META_REDIRECT_URI=https://pagezaper.com/auth/instagram/callback
GRAPH_API_VERSION=v26.0
