PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Prefix applied to every database table (pz_stores, pz_products, ...). If
# this database already has un-prefixed tables from before this existed,
# they're renamed in place automatically on startup — no data is lost.
DB_PREFIX=pz_

# The root domain stores are hosted under, e.g. pagezaper.com in production.
# A store "acme" is then reachable at acme.pagezaper.com. Leave as
# "localhost" for local development — test store subdomains locally with
# curl -H "Host: demo.localhost:3000" http://localhost:3000/
BASE_DOMAIN=localhost

DB_HOST=localhost
DB_PORT=3306
DB_USER=pagezaper_user
DB_PASSWORD=change-this-password
DB_NAME=pagezaper
